{
  "$defs": {
    "common": {
      "$defs": {
        "actor": {
          "additionalProperties": false,
          "description": "Recorded actor identity, not host-authenticated authority.",
          "properties": {
            "id": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "kind": {
              "enum": [
                "user",
                "agent",
                "tool",
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/common/$defs/criterion"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "criterion": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            }
          },
          "required": [
            "id",
            "description"
          ],
          "type": "object"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "file": {
          "additionalProperties": false,
          "description": "A staged file relative to the work directory. The consumer verifies its actual bytes against sha256.",
          "properties": {
            "mediaType": {
              "$ref": "#/$defs/common/$defs/mediaType"
            },
            "path": {
              "$ref": "#/$defs/common/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/common/$defs/digest"
            }
          },
          "required": [
            "path",
            "sha256",
            "mediaType"
          ],
          "type": "object"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "idList": {
          "items": {
            "$ref": "#/$defs/common/$defs/id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "mediaType": {
          "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$",
          "type": "string"
        },
        "relativePath": {
          "description": "A slash-separated file path relative to the work directory; no absolute path, dot segment, parent traversal, drive prefix or backslash.",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "excluded": {
              "items": {
                "$ref": "#/$defs/common/$defs/text"
              },
              "type": "array",
              "uniqueItems": true
            },
            "included": {
              "items": {
                "$ref": "#/$defs/common/$defs/text"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "included",
            "excluded"
          ],
          "type": "object"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      }
    },
    "context": {
      "additionalProperties": false,
      "description": "Supporting notes and reference files used to understand the task, separate from its inputs. Empty collections explicitly mean no extra context. Context does not grant additional execution authority.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/common/$defs/file"
          },
          "type": "array"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/common/$defs/text"
          },
          "type": "array"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        }
      },
      "required": [
        "notes",
        "files"
      ],
      "title": "Request context",
      "type": "object"
    },
    "decision": {
      "additionalProperties": false,
      "description": ".works/<workId>/decisions/<id>.json: an attributed decision on an exact work revision and subject digest. Identity and authority are not authenticated by this schema.",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        },
        "decidedBy": {
          "$ref": "#/$defs/common/$defs/actor"
        },
        "id": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "kind": {
          "const": "decision"
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected",
            "changes-requested"
          ],
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        },
        "sourceRef": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "subject": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            },
            "kind": {
              "enum": [
                "work",
                "request",
                "response",
                "evidence"
              ],
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/common/$defs/digest"
            }
          },
          "required": [
            "kind",
            "id",
            "sha256"
          ],
          "type": "object"
        },
        "workId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "workRevision": {
          "$ref": "#/$defs/common/$defs/revision"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "workId",
        "workRevision",
        "subject",
        "outcome",
        "decidedBy",
        "sourceRef",
        "rationale",
        "createdAt"
      ],
      "title": "Decision",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "description": ".works/<workId>/evidence/<id>.json: artifact metadata. Existence, actual digest and evidentiary relevance require separate checks.",
      "properties": {
        "capturedAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        },
        "capturedBy": {
          "$ref": "#/$defs/common/$defs/actor"
        },
        "description": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "id": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "kind": {
          "const": "evidence"
        },
        "mediaType": {
          "$ref": "#/$defs/common/$defs/mediaType"
        },
        "path": {
          "$ref": "#/$defs/common/$defs/relativePath"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        },
        "sha256": {
          "$ref": "#/$defs/common/$defs/digest"
        },
        "workId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "workRevision": {
          "$ref": "#/$defs/common/$defs/revision"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "workId",
        "workRevision",
        "path",
        "sha256",
        "mediaType",
        "description",
        "capturedBy",
        "capturedAt"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "image-generation": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "baseline": {
                "$ref": "#/$defs/common/$defs/file",
                "properties": {
                  "mediaType": {
                    "pattern": "^image/"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "new"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "baseline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/common/$defs/file"
            }
          ]
        },
        "image": {
          "$ref": "#/$defs/common/$defs/file",
          "properties": {
            "mediaType": {
              "const": "image/png"
            }
          }
        },
        "mode": {
          "enum": [
            "new",
            "extend",
            "revise"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/common/$defs/file",
          "properties": {
            "mediaType": {
              "const": "text/plain"
            }
          }
        },
        "requestId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "attemptId",
        "mode",
        "baseline",
        "prompt",
        "image"
      ],
      "title": "Retained image generation context",
      "type": "object"
    },
    "index": {
      "description": "Version 1 of the proposed .works document format. A document must match exactly one kind. This contract does not migrate or reinterpret legacy session records.",
      "oneOf": [
        {
          "$ref": "#/$defs/work"
        },
        {
          "$ref": "#/$defs/request"
        },
        {
          "$ref": "#/$defs/response"
        },
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "$ref": "#/$defs/decision"
        }
      ],
      "title": "Works document contract"
    },
    "inputs": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "prompts": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "files": {
              "minItems": 1
            }
          }
        }
      ],
      "description": "The prompts and files the request asks the skill to act on. At least one prompt or file is required.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/common/$defs/file"
          },
          "type": "array"
        },
        "prompts": {
          "items": {
            "$ref": "#/$defs/common/$defs/text"
          },
          "type": "array"
        }
      },
      "required": [
        "prompts",
        "files"
      ],
      "title": "Request inputs",
      "type": "object"
    },
    "output": {
      "description": "One produced output. Text is inline; commits identify a repository and full object ID; images and other files bind persisted artifacts. Output metadata alone does not prove correctness or publication.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "plain",
                "markdown"
              ],
              "type": "string"
            },
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            },
            "text": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "type": {
              "const": "text"
            }
          },
          "required": [
            "id",
            "type",
            "text",
            "format"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            },
            "message": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "repository": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "sha": {
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
              "type": "string"
            },
            "type": {
              "const": "commit"
            }
          },
          "required": [
            "id",
            "type",
            "repository",
            "sha"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "alt": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "file": {
              "$ref": "#/$defs/common/$defs/file",
              "properties": {
                "mediaType": {
                  "pattern": "^image/"
                }
              }
            },
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            },
            "type": {
              "const": "image"
            }
          },
          "required": [
            "id",
            "type",
            "file",
            "alt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "description": {
              "$ref": "#/$defs/common/$defs/text"
            },
            "file": {
              "$ref": "#/$defs/common/$defs/file"
            },
            "id": {
              "$ref": "#/$defs/common/$defs/id"
            },
            "type": {
              "const": "file"
            }
          },
          "required": [
            "id",
            "type",
            "file",
            "description"
          ],
          "type": "object"
        }
      ],
      "title": "Response output"
    },
    "request": {
      "additionalProperties": false,
      "description": ".works/<workId>/requests/<id>.json: prompts and files to act on, with supporting context kept separate, against one work revision. This record alone grants no execution permission.",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "createdAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        },
        "expected": {
          "$ref": "#/$defs/common/$defs/criteria"
        },
        "id": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "kind": {
          "const": "request"
        },
        "operation": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "requestedBy": {
          "$ref": "#/$defs/common/$defs/actor"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        },
        "workId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "workRevision": {
          "$ref": "#/$defs/common/$defs/revision"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "workId",
        "workRevision",
        "operation",
        "expected",
        "inputs",
        "context",
        "requestedBy",
        "createdAt"
      ],
      "title": "Request",
      "type": "object"
    },
    "response": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "mismatch",
                  "blocked",
                  "waiting"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ],
      "description": ".works/<workId>/responses/<id>.json: typed outputs produced for one request. Optional verification observations describe their checks separately; delivering an output is not a claim that the work is proved complete.",
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        },
        "criteriaResults": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "criterionId": {
                "$ref": "#/$defs/common/$defs/id"
              },
              "note": {
                "$ref": "#/$defs/common/$defs/text"
              },
              "outputIds": {
                "$ref": "#/$defs/common/$defs/idList"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not-checked"
                ]
              }
            },
            "required": [
              "criterionId",
              "result",
              "outputIds",
              "note"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "feedbackRound": {
          "description": "Completed feedback-and-repair rounds for this request. Initial candidate is round zero; the caller maintains truthful history.",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "kind": {
          "const": "response"
        },
        "observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "criterionId": {
                "$ref": "#/$defs/common/$defs/id"
              },
              "evidenceIds": {
                "$ref": "#/$defs/common/$defs/idList"
              },
              "note": {
                "$ref": "#/$defs/common/$defs/text"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not-checked"
                ],
                "type": "string"
              }
            },
            "required": [
              "criterionId",
              "result",
              "evidenceIds",
              "note"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/output"
          },
          "type": "array"
        },
        "reason": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "requestId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        },
        "status": {
          "enum": [
            "done",
            "mismatch",
            "blocked",
            "waiting"
          ],
          "type": "string"
        },
        "workId": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "workRevision": {
          "$ref": "#/$defs/common/$defs/revision"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "workId",
        "workRevision",
        "requestId",
        "status",
        "outputs",
        "createdAt"
      ],
      "title": "Response",
      "type": "object"
    },
    "visual": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "baselinePath"
              ]
            }
          },
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "extend",
                  "revise"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "preserve": {
                "minItems": 1
              }
            },
            "required": [
              "baselinePath"
            ]
          }
        }
      ],
      "properties": {
        "baselinePath": {
          "$ref": "#/$defs/common/$defs/relativePath"
        },
        "change": {
          "items": {
            "$ref": "#/$defs/common/$defs/text"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "new",
            "extend",
            "revise"
          ]
        },
        "preserve": {
          "items": {
            "$ref": "#/$defs/common/$defs/text"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "preserve",
        "change"
      ],
      "title": "Visual context",
      "type": "object"
    },
    "work": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "completion": false
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completion"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "cancelled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ],
      "description": ".works/<id>/work.json: goal, declared scope, acceptance criteria and current lifecycle.",
      "properties": {
        "acceptanceCriteria": {
          "$ref": "#/$defs/common/$defs/criteria"
        },
        "completion": {
          "additionalProperties": false,
          "properties": {
            "completedAt": {
              "$ref": "#/$defs/common/$defs/timestamp"
            },
            "evidenceIds": {
              "$ref": "#/$defs/common/$defs/idList",
              "minItems": 1
            }
          },
          "required": [
            "evidenceIds",
            "completedAt"
          ],
          "type": "object"
        },
        "createdAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        },
        "goal": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "id": {
          "$ref": "#/$defs/common/$defs/id"
        },
        "kind": {
          "const": "work"
        },
        "reason": {
          "$ref": "#/$defs/common/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/common/$defs/revision"
        },
        "schemaVersion": {
          "$ref": "#/$defs/common/$defs/version"
        },
        "scope": {
          "$ref": "#/$defs/common/$defs/scope"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "blocked",
            "completed",
            "cancelled"
          ],
          "type": "string"
        },
        "updatedAt": {
          "$ref": "#/$defs/common/$defs/timestamp"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "revision",
        "goal",
        "status",
        "scope",
        "acceptanceCriteria",
        "createdAt",
        "updatedAt"
      ],
      "title": "Work",
      "type": "object"
    }
  },
  "$ref": "#/$defs/index",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
