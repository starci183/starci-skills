{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-architecture-design/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "selection",
    "requestRef",
    "artifactRefs",
    "evidenceRefs",
    "scope",
    "options"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "interactionPolicy",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 2
        },
        "skillId": {
          "const": "starci-architecture-design"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "interactionPolicy": {
          "const": "ask-only-when-stuck"
        },
        "activeInputRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1
        },
        "passiveContextRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "requestRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "artifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRefs",
        "writeRoots",
        "externalMutation",
        "approvalRef"
      ],
      "properties": {
        "targetRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1
        },
        "writeRoots": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "externalMutation": {
          "type": "boolean"
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentMode",
        "resumeTarget",
        "prerequisiteRefs",
        "receipt",
        "receiptHistory"
      ],
      "properties": {
        "intentMode": {
          "enum": [
            "discover",
            "design",
            "challenge",
            "realize",
            "resume"
          ]
        },
        "resumeTarget": {
          "oneOf": [
            {
              "enum": [
                "discover",
                "design",
                "challenge",
                "realize"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "prerequisiteRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "receipt": {
          "oneOf": [
            {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "receiptId",
                  "type",
                  "missionId",
                  "skillId",
                  "operatorId",
                  "parentId",
                  "childId",
                  "timestamp",
                  "progressFingerprint",
                  "trace"
                ],
                "properties": {
                  "version": {
                    "const": "7.0.0"
                  },
                  "receiptId": {
                    "type": "string",
                    "pattern": "^receipt:[A-Za-z0-9._-]+$"
                  },
                  "type": {
                    "enum": [
                      "CALL",
                      "RETURN",
                      "TRANSITION",
                      "WAIT",
                      "RESUME",
                      "SKIP",
                      "ERROR"
                    ]
                  },
                  "missionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "skillId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "operatorId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "childId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "progressFingerprint": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "trace": {
                    "type": "object"
                  }
                }
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptHistory": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "receiptId",
              "type",
              "missionId",
              "skillId",
              "operatorId",
              "parentId",
              "childId",
              "timestamp",
              "progressFingerprint",
              "trace"
            ],
            "properties": {
              "version": {
                "const": "7.0.0"
              },
              "receiptId": {
                "type": "string",
                "pattern": "^receipt:[A-Za-z0-9._-]+$"
              },
              "type": {
                "enum": [
                  "CALL",
                  "RETURN",
                  "TRANSITION",
                  "WAIT",
                  "RESUME",
                  "SKIP",
                  "ERROR"
                ]
              },
              "missionId": {
                "type": "string",
                "minLength": 1
              },
              "skillId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "operatorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "childId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "progressFingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "trace": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
