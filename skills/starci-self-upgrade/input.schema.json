{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-self-upgrade/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "project", "selection", "requestRef", "artifactRefs", "evidenceRefs", "scope", "options"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzerVersion", "skillId", "confidence", "interactionPolicy", "activeInputRefs", "passiveContextRefs"],
      "properties": {
        "analyzerVersion": { "const": 2 },
        "skillId": { "const": "starci-self-upgrade" },
        "confidence": { "enum": ["exact", "clarified"] },
        "interactionPolicy": { "const": "ask-only-when-stuck" },
        "activeInputRefs": { "$ref": "#/$defs/refs" },
        "passiveContextRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "requestRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "artifactRefs": { "$ref": "#/$defs/refs" },
    "evidenceRefs": { "$ref": "#/$defs/refs" },
    "scope": { "$ref": "#/$defs/missionScope" },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intentMode", "benchmarkRefs", "fixtureRefs", "metricNames", "requiredLayerNames", "stabilityPolicy"],
      "properties": {
        "intentMode": { "enum": ["calibrate", "upgrade"] },
        "observationMode": { "enum": ["single", "multi-task"] },
        "actorSpecs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actorId", "role", "taskRef", "actionRef", "expectedSkillId", "scopeRef", "writeRootRefs", "productMutationAuthorityRef"],
            "properties": {
              "actorId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "role": { "enum": ["primary", "discriminator"] },
              "taskRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "actionRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "expectedSkillId": { "type": "string", "pattern": "^starci-[a-z0-9-]+$" },
              "scopeRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "writeRootRefs": { "$ref": "#/$defs/nonEmptyRefs" },
              "productMutationAuthorityRef": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        },
        "supervisionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minPrimaryActors", "maxActors", "independentContexts", "requirePerActorPasses", "runtimeReloadOnChange", "discriminatorPolicy", "communicationMode"],
          "properties": {
            "minPrimaryActors": { "const": 2 },
            "maxActors": { "const": 3 },
            "independentContexts": { "const": true },
            "requirePerActorPasses": { "const": true },
            "runtimeReloadOnChange": { "const": true },
            "discriminatorPolicy": { "const": "user-requested-or-asymmetric-inconclusive" },
            "communicationMode": { "const": "codex-task" }
          }
        },
        "benchmarkRefs": { "$ref": "#/$defs/nonEmptyRefs" },
        "fixtureRefs": { "$ref": "#/$defs/nonEmptyRefs" },
        "metricNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["elapsed-ms", "time-to-first-action-ms", "step-count", "context-bytes", "redundant-step-count", "visual-verdict", "product-write-count"]
          }
        },
        "requiredLayerNames": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/layerName" }
        },
        "stabilityPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredConsecutivePasses", "maxRepairAttempts", "freshEvidenceEachAttempt", "stopOnRepeatedFingerprint"],
          "properties": {
            "requiredConsecutivePasses": { "const": 2 },
            "maxRepairAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
            "freshEvidenceEachAttempt": { "const": true },
            "stopOnRepeatedFingerprint": { "const": true }
          }
        }
      }
    }
  },
  "$defs": {
    "layerName": {
      "enum": ["objective-scope", "input", "prompt", "state-machine", "execute-logic", "knowledge", "grammar-ui", "validation", "output-contract", "tool-model", "proof"]
    },
    "refs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "nonEmptyRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "missionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unit", "targetRefs", "inclusionRefs", "exclusionRefs", "writeRoots", "externalMutation", "approvalRef", "completionProofRefs", "dimensions", "ambiguityRefs"],
      "properties": {
        "status": { "const": "frozen" },
        "unit": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "targetRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "inclusionRefs": { "$ref": "#/$defs/refs" },
        "exclusionRefs": { "$ref": "#/$defs/refs" },
        "writeRoots": { "$ref": "#/$defs/refs" },
        "externalMutation": { "type": "boolean" },
        "approvalRef": { "type": ["string", "null"], "minLength": 1 },
        "completionProofRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value", "authorityRef"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
              "value": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "authorityRef": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        },
        "ambiguityRefs": { "type": "array", "maxItems": 0, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      }
    }
  }
}
