{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-quality-readiness",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "inventory",
          "label": "enter inventory"
        }
      ]
    },
    "inventory": {
      "kind": "operator",
      "ref": "quality/readiness-inventory",
      "on": [
        {
          "when": {
            "decision": "green"
          },
          "target": "complete",
          "label": "green"
        },
        {
          "when": {
            "decision": "findings"
          },
          "target": "repair-approval",
          "label": "findings"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "repair-approval": {
      "kind": "wait",
      "approval": {
        "prompt": "Approve one exact measured finding and repair boundary.",
        "approve": "OK REPAIR <finding>",
        "reject": "REJECT REPAIR <finding>",
        "bypassTarget": "repair"
      },
      "on": [
        {
          "when": {
            "stage": "quality.repair.review",
            "status": "approved"
          },
          "target": "repair"
        },
        {
          "when": {
            "stage": "quality.repair.review",
            "status": "rejected"
          },
          "target": "rejected"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "repair": {
      "kind": "operator",
      "ref": "quality/finding-repair",
      "on": [
        {
          "when": {
            "decision": "repaired"
          },
          "target": "inventory",
          "label": "repaired"
        },
        {
          "when": {
            "decision": "stale-finding"
          },
          "target": "inventory",
          "label": "stale-finding"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "blocked",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "rejected": {
      "kind": "terminal",
      "result": "rejected"
    }
  }
}
