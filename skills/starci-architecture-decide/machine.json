{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-architecture-decide",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "route",
          "label": "enter route"
        }
      ]
    },
    "route": {
      "kind": "operator",
      "ref": "workspace/route-verify",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-staleness",
          "label": "ready"
        },
        {
          "when": {
            "decision": "initialize-required"
          },
          "target": "blocked",
          "label": "initialize-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "business-staleness": {
      "kind": "operator",
      "ref": "business/staleness-check",
      "on": [
        {
          "when": {
            "decision": "fresh"
          },
          "target": "frame",
          "label": "fresh"
        },
        {
          "when": {
            "decision": "initialize-required"
          },
          "target": "business-evidence",
          "label": "initialize-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "frame": {
      "kind": "operator",
      "ref": "architecture/decision-frame",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "current",
          "label": "ready"
        }
      ]
    },
    "business-evidence": {
      "kind": "operator",
      "ref": "business/evidence-normalize",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-model",
          "label": "ready"
        }
      ]
    },
    "current": {
      "kind": "operator",
      "ref": "architecture/current-state",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "alternatives",
          "label": "ready"
        }
      ]
    },
    "business-model": {
      "kind": "operator",
      "ref": "business/model",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-approval",
          "label": "ready"
        }
      ]
    },
    "alternatives": {
      "kind": "operator",
      "ref": "architecture/alternatives",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "challenge",
          "label": "ready"
        }
      ]
    },
    "business-approval": {
      "kind": "wait",
      "approval": {
        "prompt": "Approve the regenerated business authority before architecture analysis.",
        "approve": "OK BUSINESS <hash>",
        "reject": "REJECT BUSINESS <hash>"
      },
      "on": [
        {
          "when": {
            "stage": "business.model.review",
            "status": "approved"
          },
          "target": "business-publish"
        },
        {
          "when": {
            "stage": "business.model.review",
            "status": "rejected"
          },
          "target": "business-evidence"
        }
      ]
    },
    "challenge": {
      "kind": "operator",
      "ref": "architecture/decision-challenge",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "decision-selection",
          "label": "ready"
        },
        {
          "when": {
            "decision": "revise"
          },
          "target": "alternatives",
          "label": "revise"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "business-publish": {
      "kind": "operator",
      "ref": "business/publish",
      "on": [
        {
          "when": {
            "decision": "direct-plan"
          },
          "target": "business-staleness",
          "label": "direct-plan"
        },
        {
          "when": {
            "decision": "architecture-required"
          },
          "target": "business-staleness",
          "label": "architecture-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "decision-selection": {
      "kind": "wait",
      "approval": {
        "prompt": "Approve the recommended architecture decision and exact option-set hash.",
        "approve": "OK ARCHITECTURE <decision>",
        "reject": "REJECT ARCHITECTURE <decision>"
      },
      "on": [
        {
          "when": {
            "stage": "architecture.decision.handoff",
            "status": "ready"
          },
          "target": "handoff"
        },
        {
          "when": {
            "stage": "architecture.decision.alternatives",
            "status": "ready"
          },
          "target": "alternatives"
        }
      ]
    },
    "handoff": {
      "kind": "operator",
      "ref": "architecture/decision-handoff",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "complete",
          "label": "ready"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
