{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-fe-process/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "outcome",
    "missionRef",
    "artifactRefs",
    "handoff",
    "runtimeFingerprint",
    "sourceFingerprint",
    "terminalEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "skillId": {
      "const": "starci-fe-process"
    },
    "outcome": {
      "enum": [
        "complete",
        "handoff",
        "waiting-choice",
        "blocked"
      ]
    },
    "missionRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skillId",
            "inputRef",
            "resumeSkillId",
            "resumeState",
            "missionRef"
          ],
          "properties": {
            "skillId": {
              "type": "string",
              "minLength": 1
            },
            "inputRef": {
              "type": "string",
              "minLength": 1
            },
            "resumeSkillId": {
              "type": "string",
              "minLength": 1
            },
            "resumeState": {
              "type": "string",
              "minLength": 1
            },
            "missionRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "runtimeFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "sourceFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "terminalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "operatorReceiptRefs",
        "directionQualityReceiptRef",
        "representativeRasterRef",
        "representativeRasterArtifactRef",
        "visualFidelityReceiptRef",
        "qualityReceiptRef",
        "uatReceiptRef",
        "testEvidenceRefs",
        "buildEvidenceRef"
      ],
      "properties": {
        "stage": { "enum": ["live-complete", "fixture-passed", "pre-proof-handoff", "waiting-choice", "blocked"] },
        "operatorReceiptRefs": { "$ref": "#/$defs/refs" },
        "directionQualityReceiptRef": { "$ref": "#/$defs/nullableRef" },
        "representativeRasterRef": { "anyOf": [{ "type": "string", "pattern": "^raster://sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
        "representativeRasterArtifactRef": { "anyOf": [{ "type": "string", "pattern": "^artifact://raster/sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
        "visualFidelityReceiptRef": { "$ref": "#/$defs/nullableRef" },
        "qualityReceiptRef": { "$ref": "#/$defs/nullableRef" },
        "uatReceiptRef": { "$ref": "#/$defs/nullableRef" },
        "testEvidenceRefs": { "$ref": "#/$defs/refs" },
        "buildEvidenceRef": { "$ref": "#/$defs/nullableRef" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nullableRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 }
  }
}
