{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-fe-process/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "selection",
    "intent",
    "uxUiChangeLevel",
    "directionMode",
    "objective",
    "auditTargetScore",
    "auditScoreHistory",
    "targetHints",
    "authorityRefs",
    "resume",
    "returnReceipt",
    "progressHistory",
    "mutationAuthorizationRef",
    "verifiedFrontendRoute",
    "exactFiles",
    "layoutOwnerCeiling",
    "approvedContractFingerprint",
    "receiptType",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "interactionPolicy",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 2
        },
        "skillId": {
          "const": "starci-fe-process"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "interactionPolicy": {
          "const": "ask-only-when-stuck"
        },
        "activeInputRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        },
        "passiveContextRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        }
      }
    },
    "intent": {
      "enum": [
        "create",
        "audit",
        "repair",
        "redesign",
        "debug",
        "reconcile"
      ]
    },
    "uxUiChangeLevel": {
      "description": "Top-level projection of the frozen frontend.ux-ui.change-level dimension used by the executable machine.",
      "enum": [
        "refine",
        "reconstruct",
        "new"
      ]
    },
    "directionMode": {
      "description": "Validated direction projection supplied to request-compile: none for refine, dominant when evidence selects one action, or alternatives when valid Grammar leaves material visual ambiguity or the user explicitly requests comparison. The machine routes the invocation-bound compiled result, not this raw field.",
      "enum": [
        "none",
        "dominant",
        "alternatives"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "auditTargetScore": {
      "description": "Requested noncanonical audit progress target. Null when the user did not request numeric scoring; 9 is the highest routable target because 10 is reserved for exceptional polish rather than mission closure.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9
    },
    "auditScoreHistory": {
      "description": "Ordered immutable progress ledger appended after every complete latest-source visual review.",
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "score", "delta", "typedVerdict", "sourceFingerprint", "evidenceFingerprint", "findingBatchFingerprint"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "score": { "type": "integer", "minimum": 0, "maximum": 10 },
          "delta": { "type": ["integer", "null"], "minimum": -10, "maximum": 10 },
          "typedVerdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "sourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "evidenceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "findingBatchFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "targetHints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorityRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resume": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missionRef",
            "fromSkillId",
            "receiptRef",
            "expectedCallReceiptRef",
            "resumeState",
            "directionChoice"
          ],
          "properties": {
            "missionRef": {
              "type": "string",
              "minLength": 1
            },
            "fromSkillId": {
              "enum": [
                "starci-business-process",
                "starci-backend-process",
                "starci-quality-assure",
                "starci-uat-verify",
                "user-choice"
              ]
            },
            "receiptRef": {
              "type": "string",
              "minLength": 1
            },
            "expectedCallReceiptRef": {
              "description": "Exact runtime CALL receipt that owns this RETURN or RESUME continuation.",
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "resumeState": {
              "type": "string",
              "minLength": 1
            },
            "directionChoice": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["decision", "selectedDirectionId", "reason", "generatedDirectionReceiptRef", "comparisonArtifactRef"],
                  "properties": {
                    "decision": { "enum": ["approve", "reject"] },
                    "selectedDirectionId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
                    "reason": { "type": ["string", "null"], "minLength": 1 },
                    "generatedDirectionReceiptRef": { "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
                    "comparisonArtifactRef": { "type": "string", "pattern": "\\.html$" }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "returnReceipt": {
      "description": "Typed runtime RETURN receipt for executable resume.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "receiptId",
            "type",
            "missionId",
            "skillId",
            "operatorId",
            "parentId",
            "childId",
            "timestamp",
            "progressFingerprint",
            "trace"
          ],
          "properties": {
            "version": {
              "const": "7.6.0-beta.1"
            },
            "receiptId": {
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "type": {
              "enum": [
                "CALL",
                "RETURN",
                "TRANSITION",
                "WAIT",
                "RESUME",
                "SKIP",
                "ERROR"
              ]
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": [
                "string",
                "null"
              ]
            },
            "operatorId": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "childId": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "progressFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "progressHistory": {
      "description": "Closed history used to reject no-progress cycles.",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "mutationAuthorizationRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifiedFrontendRoute": {
      "type": "string",
      "minLength": 1
    },
    "exactFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "beforeSha256",
          "ownerRef"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "beforeSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "ownerRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "layoutOwnerCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetOwnerRef",
        "directInteractionOwnerRefs",
        "mutableNestedLayoutRefs",
        "mutableAncestorLayoutRefs",
        "immutableAncestorLayoutRefs"
      ],
      "properties": {
        "targetOwnerRef": { "type": "string", "minLength": 1 },
        "directInteractionOwnerRefs": {
          "description": "Feature-owned or directly nested page/modal/drawer owners included automatically by feature audit; excludes shared branches and ancestors.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        },
        "mutableNestedLayoutRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "mutableAncestorLayoutRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "immutableAncestorLayoutRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approvedContractFingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptType": {
      "enum": [
        "NONE",
        "RETURN",
        "RESUME"
      ]
    },
    "scope": {
      "$ref": "#/$defs/missionScope"
    }
  },
  "$defs": {
    "missionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "targetRefs",
        "inclusionRefs",
        "exclusionRefs",
        "writeRoots",
        "externalMutation",
        "approvalRef",
        "completionProofRefs",
        "dimensions",
        "ambiguityRefs"
      ],
      "properties": {
        "status": {
          "const": "frozen"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "inclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "exclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "writeRoots": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "externalMutation": {
          "type": "boolean"
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "completionProofRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "authorityRef"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "authorityRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "ambiguityRefs": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
