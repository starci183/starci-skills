{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-fe-process",
  "start": "analyze-input",
  "states": {
    "compile": {
      "kind": "operator",
      "ref": "fe/request-compile",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "compiled"
            }
          },
          "target": "resolve"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "resolve": {
      "kind": "operator",
      "ref": "fe/target-resolve",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "resolved"
            }
          },
          "target": "business-bind"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "business-bind": {
      "kind": "operator",
      "ref": "fe/business-bind",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "bound"
            }
          },
          "target": "observe"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "observe": {
      "kind": "operator",
      "ref": "fe/runtime-observe",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "observed"
            }
          },
          "target": "product-potential"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "product-potential": {
      "kind": "operator",
      "ref": "fe/product-potential",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "assessed"
            }
          },
          "target": "semantic-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "semantic-audit": {
      "kind": "operator",
      "ref": "fe/semantic-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ux-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "ux-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "ux-audit": {
      "kind": "operator",
      "ref": "fe/ux-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "grammar-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "grammar-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "ui-audit": {
      "kind": "operator",
      "ref": "fe/ui-audit",
      "on": [
        {
          "when": {
            "inputEquals": {
              "intent": "audit"
            },
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "baseline-review"
        },
        {
          "when": {
            "inputEquals": {
              "intent": "audit"
            },
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "baseline-review"
        },
        {
          "when": {
            "inputEquals": {
              "intent": "create"
            },
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": {
              "intent": "create"
            },
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "repair" },
            "outputEquals": { "outcome": "passed" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "repair" },
            "outputEquals": { "outcome": "findings" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "redesign" },
            "outputEquals": { "outcome": "passed" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "redesign" },
            "outputEquals": { "outcome": "findings" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "debug" },
            "outputEquals": { "outcome": "passed" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "debug" },
            "outputEquals": { "outcome": "findings" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "reconcile" },
            "outputEquals": { "outcome": "passed" }
          },
          "target": "classify"
        },
        {
          "when": {
            "inputEquals": { "intent": "reconcile" },
            "outputEquals": { "outcome": "findings" }
          },
          "target": "classify"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "baseline-review": {
      "kind": "operator",
      "ref": "fe/baseline-visual-review",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "failed" } },
          "target": "classify"
        },
        {
          "when": { "outputEquals": { "outcome": "ready-for-closure" } },
          "target": "capture-preflight"
        },
        {
          "when": { "outputEquals": { "outcome": "insufficient-evidence" } },
          "target": "blocked"
        }
      ]
    },
    "grammar-audit": {
      "kind": "operator",
      "ref": "fe/grammar-convergence",
      "on": [
        { "when": { "outputEquals": { "outcome": "converged" } }, "target": "ui-audit" },
        { "when": { "outputEquals": { "outcome": "grammar-gap" } }, "target": "blocked" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "classify": {
      "kind": "operator",
      "ref": "fe/authority-gap-classify",
      "on": [
        {
          "when": {
            "inputEquals": {
              "intent": "audit"
            },
            "outputEquals": {
              "outcome": "dominant"
            }
          },
          "target": "score-route"
        },
        {
          "when": {
            "inputEquals": { "intent": "create" },
            "outputEquals": { "outcome": "dominant" }
          },
          "target": "dominant-generate"
        },
        {
          "when": {
            "inputEquals": { "intent": "repair" },
            "outputEquals": { "outcome": "dominant" }
          },
          "target": "dominant-generate"
        },
        {
          "when": {
            "inputEquals": { "intent": "redesign" },
            "outputEquals": { "outcome": "dominant" }
          },
          "target": "dominant-generate"
        },
        {
          "when": {
            "inputEquals": { "intent": "debug" },
            "outputEquals": { "outcome": "dominant" }
          },
          "target": "dominant-generate"
        },
        {
          "when": {
            "inputEquals": { "intent": "reconcile" },
            "outputEquals": { "outcome": "dominant" }
          },
          "target": "dominant-generate"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "choice-required"
            }
          },
          "target": "generate"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "no-change"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "generate": {
      "kind": "operator",
      "ref": "fe/direction-generate",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "generated"
            }
          },
          "target": "rank"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "rank": {
      "kind": "operator",
      "ref": "fe/direction-rank",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ranked"
            }
          },
          "target": "direction-choice"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "direction-choice": {
      "kind": "wait",
      "approval": {
        "prompt": "Choose one of the three or four frontend directions after reviewing the rendered visualize comparison.",
        "approve": "Use the selected direction.",
        "reject": "Reject the direction set.",
        "resumeTarget": "analyze-input"
      },
      "on": [
        {
          "when": {
            "allFacts": [
              "frontend-direction-visual-preview-ready"
            ]
          },
          "target": "analyze-input"
        }
      ]
    },
    "freeze": {
      "kind": "operator",
      "ref": "fe/contract-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "mutation-freeze"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "grammar-bind": {
      "kind": "operator",
      "ref": "fe/grammar-convergence",
      "on": [
        { "when": { "outputEquals": { "outcome": "converged" } }, "target": "freeze" },
        { "when": { "outputEquals": { "outcome": "grammar-gap" } }, "target": "blocked" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "apply": {
      "kind": "operator",
      "ref": "fe/source-apply",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "applied"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "capture-preflight": {
      "kind": "operator",
      "ref": "fe/capture-preflight",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "ready" } },
          "target": "capture"
        },
        {
          "when": { "outputEquals": { "outcome": "source-repair" } },
          "target": "repair"
        },
        {
          "when": { "outputEquals": { "outcome": "backend-required" } },
          "target": "backend-handoff"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "capture": {
      "kind": "operator",
      "ref": "fe/render-capture",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "captured"
            }
          },
          "target": "visual-fidelity"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "visual-fidelity": {
      "kind": "operator",
      "ref": "fe/visual-fidelity",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "quality-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "repair"
            }
          },
          "target": "score-route"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "insufficient-evidence"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "score-route": {
      "kind": "operator",
      "ref": "fe/audit-route",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "repair" } },
          "target": "finding-classify"
        },
        {
          "when": { "outputEquals": { "outcome": "reconstruct" } },
          "target": "dominant-generate"
        },
        {
          "when": { "outputEquals": { "outcome": "shared-authority-required" } },
          "target": "finding-classify"
        },
        {
          "when": { "outputEquals": { "outcome": "business-required" } },
          "target": "business-handoff"
        },
        {
          "when": { "outputEquals": { "outcome": "backend-required" } },
          "target": "backend-handoff"
        },
        {
          "when": { "outputEquals": { "outcome": "session-recovery" } },
          "target": "session-continuity"
        },
        {
          "when": { "outputEquals": { "outcome": "authorization-required" } },
          "target": "mutation-choice"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "session-continuity": {
      "kind": "operator",
      "ref": "fe/session-continuity",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "recovered" } },
          "target": "capture-preflight"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "dominant-generate": {
      "kind": "operator",
      "ref": "fe/dominant-direction-generate",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "generated" } },
          "target": "grammar-bind"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "finding-classify": {
      "kind": "operator",
      "ref": "fe/finding-classify",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "repair"
            }
          },
          "target": "repair"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-repair"
            }
          },
          "target": "authority-reconcile"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "authority-reconcile": {
      "kind": "operator",
      "ref": "fe/authority-reconcile",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "reconciled"
            }
          },
          "target": "repair"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "repair": {
      "kind": "operator",
      "ref": "fe/source-repair",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "repaired"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authorization-required"
            }
          },
          "target": "mutation-choice"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "business-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "backend-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "quality-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {
            "inputEquals": {
              "receiptType": "RETURN"
            }
          },
          "target": "consume-return"
        },
        {
          "when": {
            "inputEquals": {
              "receiptType": "RESUME"
            }
          },
          "target": "consume-choice-resume"
        },
        {
          "when": {
            "inputEquals": {
              "receiptType": "NONE"
            }
          },
          "target": "compile"
        }
      ]
    },
    "consume-return": {
      "kind": "operator",
      "ref": "fe/return-consume",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "consumed"
            }
          },
          "target": "peer-guard"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "peer-guard": {
      "kind": "operator",
      "ref": "fe/progress-guard",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "progress"
            }
          },
          "target": "resume-route"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "cycle"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "resume-route": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "business-bind"
            }
          },
          "target": "business-bind"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "observe"
            }
          },
          "target": "observe"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "apply"
            }
          },
          "target": "apply"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "quality-return"
            }
          },
          "target": "uat-handoff"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "uat-return"
            }
          },
          "target": "complete"
        }
      ]
    },
    "mutation-freeze": {
      "kind": "operator",
      "ref": "fe/mutation-boundary-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "apply"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authorization-required"
            }
          },
          "target": "mutation-choice"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "mutation-choice": {
      "kind": "wait",
      "approval": {
        "prompt": "Authorize this exact frontend mutation boundary.",
        "approve": "Authorize the frozen files and before hashes.",
        "reject": "Do not mutate source.",
        "resumeTarget": "analyze-input"
      },
      "on": [
        {
          "when": {},
          "target": "analyze-input"
        }
      ]
    },
    "uat-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "consume-choice-resume": {
      "kind": "operator",
      "ref": "fe/return-consume",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "consumed"
            }
          },
          "target": "choice-resume-route"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "choice-resume-route": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "direction-choice"
            }
          },
          "target": "grammar-bind"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "mutation-choice"
            }
          },
          "target": "apply"
        }
      ]
    }
  }
}
