{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-fe-process",
  "start": "analyze-input",
  "states": {
    "compile": {
      "kind": "operator",
      "ref": "fe/request-compile",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "compiled"
            }
          },
          "target": "resolve"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "resolve": {
      "kind": "operator",
      "ref": "fe/target-resolve",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "resolved"
            }
          },
          "target": "business-bind"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "business-bind": {
      "kind": "operator",
      "ref": "fe/business-bind",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "bound"
            }
          },
          "target": "observe"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "observe": {
      "kind": "operator",
      "ref": "fe/runtime-observe",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "observed"
            }
          },
          "target": "product-potential"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "product-potential": {
      "kind": "operator",
      "ref": "fe/product-potential",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "assessed"
            }
          },
          "target": "semantic-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "semantic-audit": {
      "kind": "operator",
      "ref": "fe/semantic-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ux-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "ux-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "ux-audit": {
      "kind": "operator",
      "ref": "fe/ux-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ui-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "ui-audit"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "ui-audit": {
      "kind": "operator",
      "ref": "fe/ui-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "classify"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "classify"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-gap"
            }
          },
          "target": "classify"
        }
      ]
    },
    "classify": {
      "kind": "operator",
      "ref": "fe/authority-gap-classify",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "dominant"
            }
          },
          "target": "principle-compile"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "choice-required"
            }
          },
          "target": "generate"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "no-change"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "generate": {
      "kind": "operator",
      "ref": "fe/direction-generate",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "generated"
            }
          },
          "target": "rank"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "rank": {
      "kind": "operator",
      "ref": "fe/direction-rank",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ranked"
            }
          },
          "target": "direction-choice"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "direction-choice": {
      "kind": "wait",
      "approval": {
        "prompt": "Choose one of the three or four frontend directions after reviewing the rendered visualize comparison.",
        "approve": "Use the selected direction.",
        "reject": "Reject the direction set.",
        "resumeTarget": "analyze-input"
      },
      "on": [
        {
          "when": {
            "allFacts": [
              "frontend-direction-visual-preview-ready"
            ]
          },
          "target": "analyze-input"
        }
      ]
    },
    "principle-compile": {
      "kind": "operator",
      "ref": "fe/principle-compile",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "compiled" } },
          "target": "ui-detail-freeze"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "layout-compile": {
      "kind": "operator",
      "ref": "fe/layout",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "compiled" } },
          "target": "grammar-core-compile"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "grammar-core-compile": {
      "kind": "operator",
      "ref": "fe/grammar-convergence",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "converged" } },
          "target": "freeze"
        },
        {
          "when": { "outputEquals": { "outcome": "refused" } },
          "target": "blocked"
        }
      ]
    },
    "ui-detail-freeze": {
      "kind": "operator",
      "ref": "fe/ui-detail-freeze",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "detail-frozen" } },
          "target": "layout-compile"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "freeze": {
      "kind": "operator",
      "ref": "fe/contract-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "mutation-freeze"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "apply": {
      "kind": "operator",
      "ref": "fe/source-apply",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "applied"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "capture-preflight": {
      "kind": "operator",
      "ref": "fe/capture-preflight",
      "on": [
        {
          "when": { "outputEquals": { "outcome": "ready" } },
          "target": "capture"
        },
        {
          "when": { "outputEquals": { "outcome": "source-repair" } },
          "target": "repair"
        },
        {
          "when": { "outputEquals": { "outcome": "backend-required" } },
          "target": "backend-handoff"
        },
        {
          "when": { "outputEquals": { "outcome": "blocked" } },
          "target": "blocked"
        }
      ]
    },
    "capture": {
      "kind": "operator",
      "ref": "fe/render-capture",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "captured"
            }
          },
          "target": "visual-fidelity"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "visual-fidelity": {
      "kind": "operator",
      "ref": "fe/visual-fidelity",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "quality-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "fixture-passed"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "repair"
            }
          },
          "target": "finding-classify"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "finding-classify": {
      "kind": "operator",
      "ref": "fe/finding-classify",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "repair"
            }
          },
          "target": "repair"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authority-repair"
            }
          },
          "target": "authority-reconcile"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "business-required"
            }
          },
          "target": "business-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "authority-reconcile": {
      "kind": "operator",
      "ref": "fe/authority-reconcile",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "reconciled"
            }
          },
          "target": "repair"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "repair": {
      "kind": "operator",
      "ref": "fe/source-repair",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "repaired"
            }
          },
          "target": "capture-preflight"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "backend-required"
            }
          },
          "target": "backend-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "business-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "backend-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "quality-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {
            "inputEquals": {
              "receiptType": "RETURN"
            }
          },
          "target": "consume-return"
        },
        {
          "when": {
            "inputEquals": {
              "receiptType": "RESUME"
            }
          },
          "target": "consume-choice-resume"
        },
        {
          "when": {
            "inputEquals": {
              "receiptType": "NONE"
            }
          },
          "target": "compile"
        }
      ]
    },
    "consume-return": {
      "kind": "operator",
      "ref": "fe/return-consume",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "consumed"
            }
          },
          "target": "peer-guard"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "peer-guard": {
      "kind": "operator",
      "ref": "fe/progress-guard",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "progress"
            }
          },
          "target": "resume-route"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "cycle"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "resume-route": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "business-bind"
            }
          },
          "target": "business-bind"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "observe"
            }
          },
          "target": "observe"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "apply"
            }
          },
          "target": "apply"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "quality-return"
            }
          },
          "target": "uat-handoff"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "uat-return"
            }
          },
          "target": "complete"
        }
      ]
    },
    "mutation-freeze": {
      "kind": "operator",
      "ref": "fe/mutation-boundary-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "apply"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "authorization-required"
            }
          },
          "target": "mutation-choice"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "mutation-choice": {
      "kind": "wait",
      "approval": {
        "prompt": "Authorize this exact frontend mutation boundary.",
        "approve": "Authorize the frozen files and before hashes.",
        "reject": "Do not mutate source.",
        "resumeTarget": "analyze-input"
      },
      "on": [
        {
          "when": {},
          "target": "analyze-input"
        }
      ]
    },
    "uat-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "consume-choice-resume": {
      "kind": "operator",
      "ref": "fe/return-consume",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "consumed"
            }
          },
          "target": "choice-resume-route"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "choice-resume-route": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "direction-choice"
            }
          },
          "target": "principle-compile"
        },
        {
          "when": {
            "inputEquals": {
              "resume.resumeState": "mutation-choice"
            }
          },
          "target": "apply"
        }
      ]
    }
  }
}
