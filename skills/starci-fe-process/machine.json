{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-fe-process",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        { "when": { "inputEquals": { "receiptType": "NONE" } }, "target": "request-compile" },
        { "when": { "inputEquals": { "receiptType": "RETURN" } }, "target": "consume-return" },
        { "when": { "inputEquals": { "receiptType": "RESUME" } }, "target": "consume-return" }
      ]
    },
    "consume-return": {
      "kind": "operator",
      "ref": "fe/return-consume",
      "on": [
        { "when": { "outputEquals": { "outcome": "consumed" } }, "target": "progress-guard" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "progress-guard": {
      "kind": "operator",
      "ref": "fe/progress-guard",
      "on": [
        { "when": { "outputEquals": { "outcome": "progress" } }, "target": "resume-route" },
        { "when": { "outputEquals": { "outcome": "cycle" } }, "target": "blocked" }
      ]
    },
    "resume-route": {
      "kind": "choice",
      "on": [
        { "when": { "inputEquals": { "resume.resumeState": "request-compile" } }, "target": "request-compile" },
        { "when": { "inputEquals": { "resume.resumeState": "apply" } }, "target": "apply" },
        { "when": { "inputEquals": { "resume.resumeState": "reapply" } }, "target": "reapply" },
        { "when": { "inputEquals": { "resume.resumeState": "capture-preflight" } }, "target": "capture-preflight" },
        { "when": { "inputEquals": { "resume.resumeState": "recapture-preflight" } }, "target": "recapture-preflight" },
        { "when": { "inputEquals": { "resume.resumeState": "direction-choice", "resume.directionChoice.decision": "approve" } }, "target": "apply" },
        { "when": { "inputEquals": { "resume.resumeState": "direction-choice", "resume.directionChoice.decision": "reject" } }, "target": "blocked" },
        { "when": { "inputEquals": { "resume.resumeState": "quality-return" } }, "target": "uat-handoff" },
        { "when": { "inputEquals": { "resume.resumeState": "uat-return" } }, "target": "complete" }
      ]
    },
    "request-compile": {
      "kind": "operator",
      "ref": "fe/request-compile",
      "on": [
        { "when": { "outputEquals": { "outcome": "compiled", "result.directionMode": "none" } }, "target": "apply" },
        { "when": { "outputEquals": { "outcome": "compiled", "result.directionMode": "dominant" } }, "target": "generate-dominant" },
        { "when": { "outputEquals": { "outcome": "compiled", "result.directionMode": "alternatives" } }, "target": "generate-alternatives" },
        { "when": { "outputEquals": { "outcome": "grammar-required" } }, "target": "grammar-repair-publish" },
        { "when": { "outputEquals": { "outcome": "business-required" } }, "target": "business-handoff" },
        { "when": { "outputEquals": { "outcome": "backend-required" } }, "target": "backend-handoff" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "grammar-repair-publish": {
      "kind": "operator",
      "ref": "fe/authority-reconcile",
      "on": [
        { "when": { "outputEquals": { "outcome": "reconciled" } }, "target": "request-compile" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "generate-dominant": {
      "kind": "operator",
      "ref": "fe/direction-generate",
      "on": [
        { "when": { "outputEquals": { "outcome": "generated" } }, "target": "apply" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "generate-alternatives": {
      "kind": "operator",
      "ref": "fe/direction-generate",
      "on": [
        { "when": { "outputEquals": { "outcome": "generated" } }, "target": "direction-choice" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "direction-choice": {
      "kind": "wait",
      "approval": {
        "prompt": "Choose one of the three or four rendered frontend directions.",
        "approve": "OK DIRECTION <direction-id>",
        "reject": "REJECT DIRECTION <reason>",
        "resumeTarget": "apply"
      },
      "on": [
        { "when": { "decision": "approve" }, "target": "apply", "label": "apply the exact selected generated direction" },
        { "when": { "decision": "reject" }, "target": "blocked", "label": "stop without applying an unapproved direction" }
      ]
    },
    "apply": {
      "kind": "operator",
      "ref": "fe/source-apply",
      "on": [
        { "when": { "outputEquals": { "outcome": "applied" } }, "target": "capture-preflight" },
        { "when": { "outputEquals": { "outcome": "backend-required" } }, "target": "backend-handoff" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "capture-preflight": {
      "kind": "operator",
      "ref": "fe/capture-preflight",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "capture" },
        { "when": { "outputEquals": { "outcome": "source-repair" } }, "target": "reapply" },
        { "when": { "outputEquals": { "outcome": "backend-required" } }, "target": "backend-handoff" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "capture": {
      "kind": "operator",
      "ref": "fe/render-capture",
      "on": [
        { "when": { "outputEquals": { "outcome": "captured" } }, "target": "visual-fidelity" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "visual-fidelity": {
      "kind": "operator",
      "ref": "fe/visual-fidelity",
      "on": [
        { "when": { "outputEquals": { "outcome": "passed" } }, "target": "quality-handoff" },
        { "when": { "outputEquals": { "outcome": "repair" } }, "target": "reapply" },
        { "when": { "outputEquals": { "outcome": "insufficient-evidence" } }, "target": "recapture-preflight" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "reapply": {
      "kind": "operator",
      "ref": "fe/source-apply",
      "on": [
        { "when": { "outputEquals": { "outcome": "applied" } }, "target": "recapture-preflight" },
        { "when": { "outputEquals": { "outcome": "backend-required" } }, "target": "backend-handoff" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "recapture-preflight": {
      "kind": "operator",
      "ref": "fe/capture-preflight",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "recapture" },
        { "when": { "outputEquals": { "outcome": "source-repair" } }, "target": "blocked" },
        { "when": { "outputEquals": { "outcome": "backend-required" } }, "target": "backend-handoff" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "recapture": {
      "kind": "operator",
      "ref": "fe/render-capture",
      "on": [
        { "when": { "outputEquals": { "outcome": "captured" } }, "target": "final-visual-fidelity" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "final-visual-fidelity": {
      "kind": "operator",
      "ref": "fe/visual-fidelity",
      "on": [
        { "when": { "outputEquals": { "outcome": "passed" } }, "target": "quality-handoff" },
        { "when": { "outputEquals": { "outcome": "repair" } }, "target": "blocked" },
        { "when": { "outputEquals": { "outcome": "insufficient-evidence" } }, "target": "blocked" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "business-handoff": { "kind": "terminal", "result": "handoff" },
    "backend-handoff": { "kind": "terminal", "result": "handoff" },
    "quality-handoff": { "kind": "terminal", "result": "handoff" },
    "uat-handoff": { "kind": "terminal", "result": "handoff" },
    "blocked": { "kind": "terminal", "result": "blocked" },
    "complete": { "kind": "terminal", "result": "complete" }
  }
}
