{
  "schema": "work/preset@1",
  "id": "starci-visual",
  "modes": {
    "default": {
      "when": "A selected visual concept is requested without product implementation.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "interface-plan",
              "op": "interface.plan",
              "scope": "selected-visual-direction"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "interface-draw",
              "op": "interface.draw",
              "scope": "selected-visual-artifact"
            }
          ]
        }
      ]
    }
  }
}
