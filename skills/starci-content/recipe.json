{
  "schema": "work/preset@1",
  "id": "starci-content",
  "modes": {
    "default": {
      "when": "Selected sourced content and a landing composition need delivery.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "content-generate",
              "op": "content.generate",
              "scope": "selected-content"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "landing-compose",
              "op": "landing.compose",
              "scope": "selected-landing"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "interface-audit",
              "op": "interface.audit",
              "scope": "selected-landing-audit"
            }
          ]
        }
      ]
    }
  }
}
