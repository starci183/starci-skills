{
  "schemaVersion": 7,
  "id": "starci-release-manage",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "select-intent"
        }
      ]
    },
    "select-intent": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "mission.intent": "deploy"
            }
          },
          "target": "intent"
        },
        {
          "when": {
            "inputEquals": {
              "mission.intent": "monitor"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "inputEquals": {
              "mission.intent": "recover"
            }
          },
          "target": "recover"
        },
        {
          "when": {
            "inputEquals": {
              "mission.intent": "rollback"
            }
          },
          "target": "rollback"
        }
      ]
    },
    "intent": {
      "kind": "operator",
      "ref": "deployment/intent-bind",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "rollout"
        }
      ]
    },
    "rollout": {
      "kind": "operator",
      "ref": "deployment/rollout",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "partial"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-error"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "monitor": {
      "kind": "operator",
      "ref": "deployment/monitor",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "progressing"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-error"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "steady"
            }
          },
          "target": "proof"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "recover"
            }
          },
          "target": "recover"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "rollback"
            }
          },
          "target": "rollback"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "recover": {
      "kind": "operator",
      "ref": "deployment/recover",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "retry"
            }
          },
          "target": "monitor"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "rollback"
            }
          },
          "target": "rollback"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "approval-required"
            }
          },
          "target": "blocked"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "rollback": {
      "kind": "operator",
      "ref": "deployment/rollback",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "rolled-back"
            }
          },
          "target": "proof"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "partial"
            }
          },
          "target": "rollback"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-error"
            }
          },
          "target": "rollback"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "proof": {
      "kind": "operator",
      "ref": "deployment/proof",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "complete"
            }
          },
          "target": "complete"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "rolled-back"
            }
          },
          "target": "complete"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-error"
            }
          },
          "target": "blocked"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
