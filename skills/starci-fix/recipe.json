{
  "schema": "work/preset@1",
  "id": "starci-fix",
  "modes": {
    "default": {
      "when": "An authorized repair needs reproduction, scoped fixes and regression checks.",
      "branches": {
        "min": 1,
        "allowed": [
          "backend",
          "frontend"
        ]
      },
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "api-verify-backend",
              "op": "api.verify",
              "scope": "selected-backend-defect",
              "branch": "backend"
            },
            {
              "slot": "interface-audit-frontend",
              "op": "interface.audit",
              "scope": "selected-frontend-defect",
              "branch": "frontend"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "backend-generate-backend",
              "op": "backend.generate",
              "scope": "selected-backend-defect",
              "branch": "backend"
            },
            {
              "slot": "interface-fix-frontend",
              "op": "interface.fix",
              "scope": "selected-frontend-defect",
              "branch": "frontend"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "quality-verify",
              "op": "quality.verify",
              "scope": "selected-fix-quality"
            }
          ]
        }
      ]
    }
  }
}
