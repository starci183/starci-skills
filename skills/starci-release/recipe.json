{
  "schema": "work/preset@1",
  "id": "starci-release",
  "modes": {
    "full": {
      "when": "Both publication and deployment of the exact selected release are authorized.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "quality-verify",
              "op": "quality.verify",
              "scope": "selected-release-quality"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "git-publish",
              "op": "git.publish",
              "scope": "selected-publication"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "release-deploy",
              "op": "release.deploy",
              "scope": "selected-deployment"
            }
          ]
        }
      ]
    },
    "publish-only": {
      "when": "Only publication is requested and current verified proof already exists.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "git-publish",
              "op": "git.publish",
              "scope": "selected-publication"
            }
          ]
        }
      ]
    }
  }
}
