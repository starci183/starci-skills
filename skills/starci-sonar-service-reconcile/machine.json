{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-sonar-service-reconcile",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "sonar",
          "label": "enter sonar"
        }
      ]
    },
    "sonar": {
      "kind": "operator",
      "ref": "platform/sonar-service-reconcile",
      "on": [
        {
          "when": {
            "decision": "proved"
          },
          "target": "complete",
          "label": "proved"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
