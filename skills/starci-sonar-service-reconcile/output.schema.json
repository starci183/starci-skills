{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/skills/starci-sonar-service-reconcile/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "skillId",
    "result",
    "finalState",
    "receiptRefs",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "skillId": {
      "const": "starci-sonar-service-reconcile"
    },
    "result": {
      "enum": [
        "complete",
        "rolled-back",
        "blocked",
        "handoff",
        "not-needed",
        "rejected"
      ]
    },
    "finalState": {
      "type": "string",
      "minLength": 1
    },
    "receiptRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
