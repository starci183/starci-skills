{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-content-generate/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","runId","project","selection","requestRef","artifactRefs","evidenceRefs","scope","options"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["analyzerVersion","skillId","confidence","interactionPolicy","activeInputRefs","passiveContextRefs"],
      "properties": {
        "analyzerVersion": { "const": 2 },
        "skillId": { "const": "starci-content-generate" },
        "confidence": { "enum": ["exact","clarified"] },
        "interactionPolicy": { "const": "ask-only-when-stuck" },
        "activeInputRefs": { "$ref": "#/$defs/nonEmptyRefs" },
        "passiveContextRefs": { "$ref": "#/$defs/refs" }
      }
    },
    "requestRef": { "$ref": "#/$defs/ref" },
    "artifactRefs": { "$ref": "#/$defs/refs" },
    "evidenceRefs": { "$ref": "#/$defs/refs" },
    "scope": { "$ref": "#/$defs/missionScope" },
    "options": {
      "type": "object", "additionalProperties": false,
      "required": ["intentMode","resumeTarget","audience","naturalLanguages","implementationLanguages","imageMode","codeMode","e2eMode","maxReviewRounds"],
      "properties": {
        "intentMode": { "enum": ["create","refactor","resume"] },
        "resumeTarget": { "oneOf": [{ "enum": ["brainstorm","write","image","code","e2e","review"] },{ "type": "null" }] },
        "audience": { "type": "string", "minLength": 1, "maxLength": 512 },
        "naturalLanguages": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" } },
        "implementationLanguages": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["typescript","java","csharp","go"] } },
        "imageMode": { "enum": ["required","optional","none"] },
        "codeMode": { "enum": ["required","optional","none"] },
        "e2eMode": { "enum": ["required","optional","none"] },
        "maxReviewRounds": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "missionScope": {
      "type": "object", "additionalProperties": false,
      "required": ["status","unit","targetRefs","inclusionRefs","exclusionRefs","writeRoots","externalMutation","approvalRef","completionProofRefs","dimensions","ambiguityRefs"],
      "properties": {
        "status": { "const": "frozen" },
        "unit": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "targetRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "inclusionRefs": { "$ref": "#/$defs/refs" },
        "exclusionRefs": { "$ref": "#/$defs/refs" },
        "writeRoots": { "$ref": "#/$defs/refs" },
        "externalMutation": { "type": "boolean" },
        "approvalRef": { "oneOf": [{ "$ref": "#/$defs/ref" },{ "type": "null" }] },
        "completionProofRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "dimensions": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["key","value","authorityRef"], "properties": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" }, "value": { "$ref": "#/$defs/ref" }, "authorityRef": { "$ref": "#/$defs/ref" } } } },
        "ambiguityRefs": { "type": "array", "maxItems": 0, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
