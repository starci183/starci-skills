{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-content-generate",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        { "when": { "inputEquals": { "options.intentMode": "create" } }, "target": "brainstorm", "label": "create from teacher brief" },
        { "when": { "inputEquals": { "options.intentMode": "refactor" } }, "target": "brainstorm", "label": "refactor from teacher brief" },
        { "when": { "inputEquals": { "options.resumeTarget": "brainstorm" } }, "target": "brainstorm", "label": "resume brainstorm" },
        { "when": { "inputEquals": { "options.resumeTarget": "write" } }, "target": "write", "label": "resume writing" },
        { "when": { "inputEquals": { "options.resumeTarget": "image" } }, "target": "image", "label": "resume image" },
        { "when": { "inputEquals": { "options.resumeTarget": "code" } }, "target": "code", "label": "resume code" },
        { "when": { "inputEquals": { "options.resumeTarget": "e2e" } }, "target": "e2e", "label": "resume e2e" },
        { "when": { "inputEquals": { "options.resumeTarget": "review" } }, "target": "review", "label": "resume review" }
      ]
    },
    "brainstorm": {
      "kind": "operator", "ref": "content/brainstorm",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "write" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "write": {
      "kind": "operator", "ref": "content/write",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "image" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "image": {
      "kind": "operator", "ref": "content/image",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "code" },
        { "when": { "outputEquals": { "outcome": "not-needed" } }, "target": "code" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "code": {
      "kind": "operator", "ref": "content/code",
      "on": [
        { "when": { "outputEquals": { "outcome": "ready" } }, "target": "e2e" },
        { "when": { "outputEquals": { "outcome": "not-needed" } }, "target": "e2e" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "e2e": {
      "kind": "operator", "ref": "content/e2e",
      "on": [
        { "when": { "outputEquals": { "outcome": "passed" } }, "target": "review" },
        { "when": { "outputEquals": { "outcome": "not-needed" } }, "target": "review" },
        { "when": { "outputEquals": { "outcome": "failed" } }, "target": "code" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "review": {
      "kind": "operator", "ref": "content/review",
      "on": [
        { "when": { "outputEquals": { "outcome": "approved" } }, "target": "complete" },
        { "when": { "outputEquals": { "outcome": "revise-brainstorm" } }, "target": "brainstorm" },
        { "when": { "outputEquals": { "outcome": "revise-write" } }, "target": "write" },
        { "when": { "outputEquals": { "outcome": "revise-image" } }, "target": "image" },
        { "when": { "outputEquals": { "outcome": "revise-code" } }, "target": "code" },
        { "when": { "outputEquals": { "outcome": "revise-e2e" } }, "target": "e2e" },
        { "when": { "outputEquals": { "outcome": "blocked" } }, "target": "blocked" }
      ]
    },
    "complete": { "kind": "terminal", "result": "complete" },
    "blocked": { "kind": "terminal", "result": "blocked" }
  }
}
