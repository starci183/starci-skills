{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "skillId",
    "result",
    "finalState",
    "handoffRef",
    "receiptRefs",
    "findings",
    "state",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "skillId": {
      "const": "starci-frontend-contract-plan"
    },
    "result": {
      "enum": [
        "complete",
        "blocked",
        "handoff",
        "rejected",
        "not-needed"
      ]
    },
    "finalState": {
      "enum": [
        "implementation-handoff",
        "gap-handoff",
        "blocked"
      ]
    },
    "handoffRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    },
    "receiptRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 512,
        "pattern": "^(?:receipt:sha256:[0-9a-f]{64}|session://tasks/[A-Za-z0-9._-]+/.+)$"
      },
      "maxItems": 64
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "retryable",
        "terminalState"
      ],
      "properties": {
        "status": {
          "enum": [
            "handoff",
            "blocked"
          ]
        },
        "code": {
          "enum": [
            "starci-frontend-contract-plan-implementation-handoff",
            "starci-frontend-contract-plan-gap-handoff",
            "starci-frontend-contract-plan-blocked"
          ]
        },
        "retryable": {
          "const": false
        },
        "terminalState": {
          "enum": [
            "implementation-handoff",
            "gap-handoff",
            "blocked"
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratchRefs",
        "retention",
        "purgeAt"
      ],
      "properties": {
        "scratchRefs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention": {
          "const": "until-skill-terminal"
        },
        "purgeAt": {
          "const": "skill-terminal"
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "result": {
              "const": "handoff"
            },
            "finalState": {
              "const": "implementation-handoff"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "handoff"
                },
                "code": {
                  "const": "starci-frontend-contract-plan-implementation-handoff"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "implementation-handoff"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        },
        {
          "properties": {
            "result": {
              "const": "handoff"
            },
            "finalState": {
              "const": "gap-handoff"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "handoff"
                },
                "code": {
                  "const": "starci-frontend-contract-plan-gap-handoff"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "gap-handoff"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        },
        {
          "properties": {
            "result": {
              "const": "blocked"
            },
            "finalState": {
              "const": "blocked"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "blocked"
                },
                "code": {
                  "const": "starci-frontend-contract-plan-blocked"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "blocked"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        }
      ]
    }
  ]
}
