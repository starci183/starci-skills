{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-contract-plan",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "plan"
        }
      ]
    },
    "plan": {
      "kind": "operator",
      "ref": "fe/contract-plan",
      "on": [
        {
          "when": {
            "decision": "contract-ready"
          },
          "target": "implementation-handoff"
        },
        {
          "when": {
            "decision": "grammar-gap"
          },
          "target": "gap-handoff"
        },
        {
          "when": {
            "decision": "backend-gap"
          },
          "target": "gap-handoff"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked"
        }
      ]
    },
    "implementation-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "gap-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
