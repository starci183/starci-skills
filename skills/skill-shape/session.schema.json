{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/skills/skill-shape/session.schema.json",
  "title": "Design session",
  "description": "The append-only record a design session keeps. Rounds are appended, never edited: an accepted round is evidence, and feedback opens the next round instead of rewriting the last.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "project", "surface", "phase", "rounds", "queue"],
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "project": {"$ref": "#/$defs/slug", "description": "Declared by the user and resolved through the workspace route, never inferred from a folder."},
    "surface": {"$ref": "#/$defs/slug", "description": "Session identity IS the surface. A reworded prompt is a new round, not a new session."},
    "phase": {"enum": ["layout", "block", "execute", "complete"]},
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/round"}
    },
    "queue": {
      "description": "Pending decisions. Durable, which is why it lives in `registries` and not in the disposable `sessions` root.",
      "type": "array",
      "items": {"$ref": "#/$defs/queued"}
    }
  },
  "$defs": {
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "phase", "prompt", "produced", "verdict"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "phase": {"enum": ["layout", "block"]},
        "prompt": {"type": "string", "minLength": 1, "description": "The exact request or feedback that opened this round."},
        "region": {"$ref": "#/$defs/slug", "description": "Present for block rounds."},
        "produced": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "hash"],
            "properties": {
              "id": {"$ref": "#/$defs/slug"},
              "hash": {"$ref": "#/$defs/hash", "description": "Of the canonical candidate or anatomy. Never of a rendered page."}
            }
          }
        },
        "refusal": {"type": "string", "minLength": 12, "description": "The product decision this round could not make."},
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["pending", "accepted", "feedback"]},
            "acceptedHash": {"$ref": "#/$defs/hash"},
            "rejected": {
              "description": "The actual proposal refused, its replacement, and the owner's reason in their words. Never reconstructed from memory.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hash", "reason"],
                "properties": {
                  "hash": {"$ref": "#/$defs/hash"},
                  "instead": {"$ref": "#/$defs/slug"},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "queued": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "phase", "state"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "phase": {"enum": ["layout", "block"]},
        "region": {"$ref": "#/$defs/slug"},
        "state": {"enum": ["queued", "accepted", "rejected"]}
      }
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?$"}
  }
}
