{
  "schema": "work/preset@1",
  "id": "starci-migrate",
  "modes": {
    "default": {
      "when": "One explicitly selected business pilot needs safe Work 3 adoption.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "workspace-migrate",
              "op": "workspace.migrate",
              "scope": "selected-pilot"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "business-decide",
              "op": "business.decide",
              "scope": "selected-pilot-business"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "workflow-verify",
              "op": "workflow.verify",
              "scope": "selected-pilot-review"
            }
          ]
        }
      ]
    }
  }
}
