{
  "schema": "work/preset@1",
  "id": "starci-data",
  "modes": {
    "seed": {
      "when": "Explicitly authorized scoped fixture seeding is requested.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "data-plan",
              "op": "data.plan",
              "scope": "selected-fixture"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "data-seed",
              "op": "data.seed",
              "scope": "selected-fixture"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "quality-verify",
              "op": "quality.verify",
              "scope": "selected-fixture-quality"
            }
          ]
        }
      ]
    },
    "migrate": {
      "when": "Explicitly authorized bounded data migration is requested.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "data-plan",
              "op": "data.plan",
              "scope": "selected-data-migration"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "migration-release",
              "op": "migration.release",
              "scope": "selected-data-migration"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "quality-verify",
              "op": "quality.verify",
              "scope": "selected-migration-quality"
            }
          ]
        }
      ]
    }
  }
}
