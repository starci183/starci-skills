{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-uat-verify",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "snapshot"
        }
      ]
    },
    "snapshot": {
      "kind": "operator",
      "ref": "test/uat-snapshot-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "freeze-cases"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "freeze-cases": {
      "kind": "operator",
      "ref": "test/uat-case-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "frozen"
            }
          },
          "target": "behavior"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "behavior": {
      "kind": "operator",
      "ref": "test/uat-behavior-proof",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ux"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "publish"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "ux": {
      "kind": "operator",
      "ref": "test/uat-ux-proof",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ui"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "publish"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "ui": {
      "kind": "operator",
      "ref": "test/uat-ui-proof",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "publish"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "publish"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "publish": {
      "kind": "operator",
      "ref": "test/uat-result-publish",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "complete"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "complete"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
