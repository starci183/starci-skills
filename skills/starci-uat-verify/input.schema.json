{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-uat-verify/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "selection",
    "feature",
    "flow",
    "authorityRefs",
    "runtimeEvidenceRefs",
    "returnReceipt",
    "progressHistory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "interactionPolicy",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 2
        },
        "skillId": {
          "const": "starci-uat-verify"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "interactionPolicy": {
          "const": "ask-only-when-stuck"
        },
        "activeInputRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        },
        "passiveContextRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        }
      }
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "flow": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "authorityRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "runtimeEvidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "returnReceipt": {
      "description": "Typed runtime RETURN receipt for executable resume.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "receiptId",
            "type",
            "missionId",
            "skillId",
            "operatorId",
            "parentId",
            "childId",
            "timestamp",
            "progressFingerprint",
            "trace"
          ],
          "properties": {
            "version": {
              "const": "7.0.0"
            },
            "receiptId": {
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "type": {
              "enum": [
                "CALL",
                "RETURN",
                "TRANSITION",
                "WAIT",
                "RESUME",
                "SKIP",
                "ERROR"
              ]
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": [
                "string",
                "null"
              ]
            },
            "operatorId": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "childId": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "progressFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "progressHistory": {
      "description": "Closed history used to reject no-progress cycles.",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  }
}
