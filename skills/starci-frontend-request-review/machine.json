{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-request-review",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "request-review",
          "label": "enter request-review"
        }
      ]
    },
    "request-review": {
      "kind": "operator",
      "ref": "fe/request-review",
      "on": [
        {
          "when": {
            "decision": "approved"
          },
          "target": "complete",
          "label": "approved"
        },
        {
          "when": {
            "decision": "rejected"
          },
          "target": "complete",
          "label": "rejected"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
