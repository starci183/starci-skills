{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/starci-feature-deliver/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "selection",
    "objective",
    "domainOrder",
    "resume",
    "returnReceipt",
    "progressHistory",
    "receiptType",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "interactionPolicy",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 2
        },
        "skillId": {
          "const": "starci-feature-deliver"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "interactionPolicy": {
          "const": "ask-only-when-stuck"
        },
        "activeInputRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        },
        "passiveContextRefs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          }
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "domainOrder": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "resume": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missionRef",
            "skillId",
            "receiptRef",
            "resumeState"
          ],
          "properties": {
            "missionRef": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": "string",
              "minLength": 1
            },
            "receiptRef": {
              "type": "string",
              "minLength": 1
            },
            "resumeState": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "returnReceipt": {
      "description": "Typed runtime RETURN receipt for executable resume.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "receiptId",
            "type",
            "missionId",
            "skillId",
            "operatorId",
            "parentId",
            "childId",
            "timestamp",
            "progressFingerprint",
            "trace"
          ],
          "properties": {
            "version": {
              "const": "7.6.0-beta.1"
            },
            "receiptId": {
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "type": {
              "enum": [
                "CALL",
                "RETURN",
                "TRANSITION",
                "WAIT",
                "RESUME",
                "SKIP",
                "ERROR"
              ]
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": [
                "string",
                "null"
              ]
            },
            "operatorId": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "childId": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "progressFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "type": "object"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "progressHistory": {
      "description": "Closed history used to reject no-progress cycles.",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "receiptType": {
      "enum": [
        "NONE",
        "RETURN",
        "RESUME"
      ]
    },
    "scope": {
      "$ref": "#/$defs/missionScope"
    }
  },
  "$defs": {
    "missionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "targetRefs",
        "inclusionRefs",
        "exclusionRefs",
        "writeRoots",
        "externalMutation",
        "approvalRef",
        "completionProofRefs",
        "dimensions",
        "ambiguityRefs"
      ],
      "properties": {
        "status": {
          "const": "frozen"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "inclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "exclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "writeRoots": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "externalMutation": {
          "type": "boolean"
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "completionProofRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "authorityRef"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "authorityRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "ambiguityRefs": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
