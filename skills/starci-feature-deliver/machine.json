{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-feature-deliver",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {
            "inputEquals": {
              "receiptType": "RETURN"
            }
          },
          "target": "consume-return"
        },
        {
          "when": {
            "inputEquals": {
              "receiptType": "NONE"
            }
          },
          "target": "plan"
        }
      ]
    },
    "consume-return": {
      "kind": "operator",
      "ref": "test/return-consume",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "consumed"
            }
          },
          "target": "guard"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "guard": {
      "kind": "operator",
      "ref": "fe/progress-guard",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "progress"
            }
          },
          "target": "plan"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "cycle"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "plan": {
      "kind": "operator",
      "ref": "test/domain-call-plan",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "call-business"
            }
          },
          "target": "handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "call-backend"
            }
          },
          "target": "handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "call-frontend"
            }
          },
          "target": "handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "call-quality"
            }
          },
          "target": "handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "call-uat"
            }
          },
          "target": "handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "join-proof"
            }
          },
          "target": "join"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "join": {
      "kind": "operator",
      "ref": "test/proof-join",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "joined"
            }
          },
          "target": "complete"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
