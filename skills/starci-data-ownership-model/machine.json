{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-data-ownership-model",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "ownership",
          "label": "enter ownership"
        }
      ]
    },
    "ownership": {
      "kind": "operator",
      "ref": "architecture/data-ownership",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "contradictions",
          "label": "ready"
        },
        {
          "when": {
            "decision": "revise"
          },
          "target": "ownership",
          "label": "revise"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "contradictions": {
      "kind": "operator",
      "ref": "architecture/contradiction-analysis",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "handoff",
          "label": "ready"
        },
        {
          "when": {
            "decision": "revise"
          },
          "target": "ownership",
          "label": "revise"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "handoff": {
      "kind": "terminal",
      "result": "handoff"
    }
  }
}
