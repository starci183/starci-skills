{
  "schema": "work/preset@1",
  "id": "starci-goal",
  "modes": {
    "default": {
      "when": "A new or explicitly revised purpose with selected repository binding and business scope.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "goal-setup",
              "op": "goal.setup",
              "scope": "selected-purpose"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "workspace-bind",
              "op": "workspace.bind",
              "scope": "selected-binding"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "business-decide",
              "op": "business.decide",
              "scope": "selected-business"
            }
          ]
        }
      ]
    }
  }
}
