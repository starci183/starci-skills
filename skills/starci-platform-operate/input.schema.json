{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "selection",
    "mission",
    "receipts",
    "scope"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "skillId": {
      "const": "starci-platform-operate"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionId",
        "project",
        "objectiveRef",
        "intent",
        "approvalRef",
        "sourceHeads"
      ],
      "properties": {
        "missionId": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "objectiveRef": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "enum": [
            "observability",
            "sonar",
            "tunnel-plan",
            "tunnel-apply"
          ]
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceHeads": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:git:|refs/).+"
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "receiptId",
          "type",
          "missionId",
          "skillId",
          "operatorId",
          "parentId",
          "childId",
          "timestamp",
          "progressFingerprint",
          "trace"
        ],
        "properties": {
          "version": {
            "const": "7.5.0-alpha.1"
          },
          "receiptId": {
            "type": "string",
            "pattern": "^receipt:[A-Za-z0-9._-]+$"
          },
          "type": {
            "enum": [
              "CALL",
              "RETURN",
              "TRANSITION",
              "WAIT",
              "RESUME",
              "SKIP",
              "ERROR"
            ]
          },
          "missionId": {
            "type": "string"
          },
          "skillId": {
            "type": [
              "string",
              "null"
            ]
          },
          "operatorId": {
            "type": [
              "string",
              "null"
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "childId": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "progressFingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "trace": {
            "type": "object"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "interactionPolicy",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 2
        },
        "skillId": {
          "const": "starci-platform-operate"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "interactionPolicy": {
          "const": "ask-only-when-stuck"
        },
        "activeInputRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "passiveContextRefs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "scope": {
      "$ref": "#/$defs/missionScope"
    }
  },
  "$defs": {
    "missionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unit",
        "targetRefs",
        "inclusionRefs",
        "exclusionRefs",
        "writeRoots",
        "externalMutation",
        "approvalRef",
        "completionProofRefs",
        "dimensions",
        "ambiguityRefs"
      ],
      "properties": {
        "status": {
          "const": "frozen"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "inclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "exclusionRefs": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "writeRoots": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "externalMutation": {
          "type": "boolean"
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "completionProofRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "authorityRef"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "authorityRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "ambiguityRefs": {
          "type": "array",
          "maxItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  }
}
