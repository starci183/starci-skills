{
  "schema": "work/preset@1",
  "id": "starci-redesign-fe",
  "modes": {
    "default": {
      "when": "Selected existing frontend needs authorized redesign and real visual audit.",
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "interface-plan",
              "op": "interface.plan",
              "scope": "selected-frontend-design"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "interface-generate",
              "op": "interface.generate",
              "scope": "selected-frontend"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "interface-audit",
              "op": "interface.audit",
              "scope": "selected-frontend-audit"
            }
          ]
        }
      ]
    }
  }
}
