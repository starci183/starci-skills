{
  "schema": "work/preset@1",
  "id": "starci-build",
  "modes": {
    "default": {
      "when": "One bounded delivery needs selected backend/frontend implementation.",
      "branches": {
        "min": 1,
        "allowed": [
          "backend",
          "frontend"
        ]
      },
      "waves": [
        {
          "id": "wave-1",
          "invocations": [
            {
              "slot": "backend-plan-backend",
              "op": "backend.plan",
              "scope": "selected-backend",
              "branch": "backend"
            },
            {
              "slot": "interface-plan-frontend",
              "op": "interface.plan",
              "scope": "selected-frontend",
              "branch": "frontend"
            }
          ]
        },
        {
          "id": "wave-2",
          "invocations": [
            {
              "slot": "backend-generate-backend",
              "op": "backend.generate",
              "scope": "selected-backend",
              "branch": "backend"
            },
            {
              "slot": "interface-generate-frontend",
              "op": "interface.generate",
              "scope": "selected-frontend",
              "branch": "frontend"
            }
          ]
        },
        {
          "id": "wave-3",
          "invocations": [
            {
              "slot": "quality-verify",
              "op": "quality.verify",
              "scope": "selected-delivery-quality"
            }
          ]
        }
      ]
    }
  }
}
