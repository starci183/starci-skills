{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-backend-repair",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "route",
          "label": "enter route"
        }
      ]
    },
    "route": {
      "kind": "operator",
      "ref": "workspace/route-verify",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-staleness",
          "label": "ready"
        },
        {
          "when": {
            "decision": "initialize-required"
          },
          "target": "blocked",
          "label": "initialize-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "business-staleness": {
      "kind": "operator",
      "ref": "business/staleness-check",
      "on": [
        {
          "when": {
            "decision": "fresh"
          },
          "target": "repair-prerequisites",
          "label": "fresh"
        },
        {
          "when": {
            "decision": "initialize-required"
          },
          "target": "business-evidence",
          "label": "initialize-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "repair-prerequisites": {
      "kind": "operator",
      "ref": "be/repair-prerequisite-check",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "coding-scope",
          "label": "ready"
        },
        {
          "when": {
            "decision": "route-required"
          },
          "target": "route",
          "label": "route-required"
        },
        {
          "when": {
            "decision": "business-refresh-required"
          },
          "target": "business-staleness",
          "label": "business-refresh-required"
        },
        {
          "when": {
            "decision": "replan-required"
          },
          "target": "replan-handoff",
          "label": "replan-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "business-evidence": {
      "kind": "operator",
      "ref": "business/evidence-normalize",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-model",
          "label": "ready"
        }
      ]
    },
    "coding-scope": {
      "kind": "operator",
      "ref": "be/coding-scope-freeze",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "implement",
          "label": "ready"
        },
        {
          "when": {
            "decision": "source-drift"
          },
          "target": "replan-handoff",
          "label": "source-drift"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "replan-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "business-model": {
      "kind": "operator",
      "ref": "business/model",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "business-approval",
          "label": "ready"
        }
      ]
    },
    "implement": {
      "kind": "operator",
      "ref": "be/implementation",
      "on": [
        {
          "when": {
            "decision": "ready"
          },
          "target": "format",
          "label": "ready"
        },
        {
          "when": {
            "decision": "source-drift"
          },
          "target": "replan-handoff",
          "label": "source-drift"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "business-approval": {
      "kind": "wait",
      "approval": {
        "prompt": "Approve regenerated business authority before resuming the backend repair.",
        "approve": "OK BUSINESS <hash>",
        "reject": "REJECT BUSINESS <hash>"
      },
      "on": [
        {
          "when": {
            "stage": "business.model.review",
            "status": "approved"
          },
          "target": "business-publish"
        },
        {
          "when": {
            "stage": "business.model.review",
            "status": "rejected"
          },
          "target": "business-evidence"
        }
      ]
    },
    "format": {
      "kind": "operator",
      "ref": "quality/format",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "lint",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "business-publish": {
      "kind": "operator",
      "ref": "business/publish",
      "on": [
        {
          "when": {
            "decision": "direct-plan"
          },
          "target": "business-staleness",
          "label": "direct-plan"
        },
        {
          "when": {
            "decision": "architecture-required"
          },
          "target": "business-staleness",
          "label": "architecture-required"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "lint": {
      "kind": "operator",
      "ref": "quality/lint",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "typecheck",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "typecheck": {
      "kind": "operator",
      "ref": "quality/typecheck",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "build",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "build": {
      "kind": "operator",
      "ref": "quality/build",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "unit",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "unit": {
      "kind": "operator",
      "ref": "quality/unit-coverage",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "integration",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "integration": {
      "kind": "operator",
      "ref": "quality/integration",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "e2e",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "e2e": {
      "kind": "operator",
      "ref": "quality/e2e",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "sonar",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "sonar": {
      "kind": "operator",
      "ref": "quality/sonar",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "post-quality",
          "label": "pass"
        },
        {
          "when": {
            "decision": "in-boundary"
          },
          "target": "implement",
          "label": "in-boundary"
        },
        {
          "when": {
            "decision": "boundary-drift"
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "post-quality": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "options.deploymentMode": "none"
            }
          },
          "target": "source-proof"
        },
        {
          "when": {
            "inputEquals": {
              "options.deploymentMode": "handoff"
            }
          },
          "target": "deployment-handoff"
        }
      ]
    },
    "source-proof": {
      "kind": "operator",
      "ref": "quality/delivery-proof",
      "on": [
        {
          "when": {
            "decision": "pass"
          },
          "target": "business-reconcile",
          "label": "pass"
        },
        {
          "when": {
            "decision": "blocked"
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "deployment-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "business-reconcile": {
      "kind": "operator",
      "ref": "business/reconcile",
      "on": [
        {
          "when": {
            "decision": "implemented"
          },
          "target": "complete",
          "label": "implemented"
        },
        {
          "when": {
            "decision": "discrepancy"
          },
          "target": "blocked",
          "label": "discrepancy"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
