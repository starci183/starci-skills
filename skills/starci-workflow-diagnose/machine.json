{
  "$schema": "../machine.schema.json",
  "schemaVersion": 7,
  "id": "starci-workflow-diagnose",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "select-intent",
          "label": "validate authority and runtime receipts"
        }
      ]
    },
    "select-intent": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "options.intentMode": "diagnose"
            }
          },
          "target": "bind-diagnose",
          "label": "bind diagnose prerequisites"
        },
        {
          "when": {
            "inputEquals": {
              "options.intentMode": "resume"
            }
          },
          "target": "resume-select",
          "label": "consume RETURN through RESUME"
        }
      ]
    },
    "resume-select": {
      "kind": "choice",
      "on": [
        {
          "when": {
            "inputEquals": {
              "options.resumeTarget": "diagnose"
            }
          },
          "target": "bind-diagnose",
          "label": "resume diagnose"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "bind-diagnose": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "diagnose",
          "label": "prerequisites bound"
        }
      ]
    },
    "diagnose": {
      "kind": "operator",
      "ref": "quality/workflow-diagnose",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "diagnosed"
            }
          },
          "target": "complete",
          "label": "diagnosed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "inconclusive"
            }
          },
          "target": "blocked",
          "label": "inconclusive"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-blocker"
            }
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    }
  }
}
