{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-workflow-diagnose",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "diagnose",
          "label": "enter diagnose"
        }
      ]
    },
    "diagnose": {
      "kind": "operator",
      "ref": "quality/workflow-diagnose",
      "on": [
        {
          "when": {
            "decision": "diagnosed"
          },
          "target": "complete",
          "label": "diagnosed"
        },
        {
          "when": {
            "decision": "inconclusive"
          },
          "target": "blocked",
          "label": "inconclusive"
        },
        {
          "when": {
            "decision": "external-blocker"
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
