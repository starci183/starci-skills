{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/skills/machine.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "start", "states"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 7 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "start": { "type": "string", "minLength": 1 },
    "states": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "condition": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stage": { "type": "string" }, "status": { "type": "string" }, "decision": { "type": "string" },
        "allFacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "noneFacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "inputEquals": { "type": "object", "additionalProperties": { "type": ["string", "boolean", "number"] } },
        "outputEquals": { "type": "object", "additionalProperties": { "type": ["string", "boolean", "number", "null"] } }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["when", "target"],
      "properties": { "when": { "$ref": "#/$defs/condition" }, "target": { "type": "string", "minLength": 1 }, "label": { "type": "string" } }
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["analysis", "operator", "choice", "wait", "terminal"] },
        "ref": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "on": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edge" } },
        "approval": { "type": "object", "additionalProperties": false, "required": ["prompt", "approve", "reject", "resumeTarget"],
          "properties": {
            "prompt": { "type": "string", "minLength": 1 },
            "approve": { "type": "string", "minLength": 1 },
            "reject": { "type": "string", "minLength": 1 },
            "resumeTarget": { "type": "string", "minLength": 1 }
          }
        },
        "result": { "enum": ["complete", "rolled-back", "blocked", "handoff", "not-needed", "rejected"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "operator" } }, "required": ["kind"] },
          "then": { "required": ["ref", "on"] }
        },
        {
          "if": { "properties": { "kind": { "enum": ["analysis", "choice"] } }, "required": ["kind"] },
          "then": { "required": ["on"] }
        },
        {
          "if": { "properties": { "kind": { "const": "wait" } }, "required": ["kind"] },
          "then": { "required": ["approval", "on"] }
        },
        {
          "if": { "properties": { "kind": { "const": "terminal" } }, "required": ["kind"] },
          "then": { "required": ["result"] }
        }
      ]
    }
  }
}
