{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-workflow-handoff",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "route",
          "label": "enter route"
        }
      ]
    },
    "route": {
      "kind": "operator",
      "ref": "workspace/route-verify",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "handoff",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "initialize-required"
            }
          },
          "target": "blocked",
          "label": "initialize-required"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "handoff": {
      "kind": "operator",
      "ref": "workspace/workflow-handoff",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "published"
            }
          },
          "target": "complete",
          "label": "published"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "resumed"
            }
          },
          "target": "complete",
          "label": "resumed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
