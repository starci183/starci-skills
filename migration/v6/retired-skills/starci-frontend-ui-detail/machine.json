{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-ui-detail",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "freeze"
        }
      ]
    },
    "freeze": {
      "kind": "operator",
      "ref": "fe/ui-detail-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "detail-frozen"
            }
          },
          "target": "review"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "review": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
