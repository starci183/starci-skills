{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-conversation-record",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "record",
          "label": "enter record"
        }
      ]
    },
    "record": {
      "kind": "operator",
      "ref": "source/conversation-record",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "recorded"
            }
          },
          "target": "complete",
          "label": "recorded"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "idempotent"
            }
          },
          "target": "complete",
          "label": "idempotent"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "conflict"
            }
          },
          "target": "blocked",
          "label": "conflict"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
