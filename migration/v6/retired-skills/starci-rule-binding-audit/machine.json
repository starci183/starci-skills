{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-rule-binding-audit",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "bindings",
          "label": "enter bindings"
        }
      ]
    },
    "bindings": {
      "kind": "operator",
      "ref": "quality/rule-binding-check",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "pass"
            }
          },
          "target": "complete",
          "label": "pass"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "fail"
            }
          },
          "target": "findings",
          "label": "fail"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "findings": {
      "kind": "terminal",
      "result": "complete"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
