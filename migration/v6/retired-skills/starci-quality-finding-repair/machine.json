{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-quality-finding-repair",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "repair-approval",
          "label": "enter repair-approval"
        }
      ]
    },
    "repair-approval": {
      "kind": "wait",
      "approval": {
        "prompt": "Approve one exact measured finding and repair boundary.",
        "approve": "OK REPAIR <finding>",
        "reject": "REJECT REPAIR <finding>",
        "bypassTarget": "repair"
      },
      "on": [
        {
          "when": {
            "stage": "quality.repair.review",
            "status": "approved"
          },
          "target": "repair"
        },
        {
          "when": {
            "stage": "quality.repair.review",
            "status": "rejected"
          },
          "target": "rejected"
        }
      ]
    },
    "repair": {
      "kind": "operator",
      "ref": "quality/finding-repair",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "repaired"
            }
          },
          "target": "finding-proof",
          "label": "repaired"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "stale-finding"
            }
          },
          "target": "finding-proof",
          "label": "stale-finding"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "boundary-drift"
            }
          },
          "target": "blocked",
          "label": "boundary-drift"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "external-blocker"
            }
          },
          "target": "blocked",
          "label": "external-blocker"
        }
      ]
    },
    "rejected": {
      "kind": "terminal",
      "result": "rejected"
    },
    "finding-proof": {
      "kind": "operator",
      "ref": "quality/readiness-inventory",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "green"
            }
          },
          "target": "complete",
          "label": "green"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "residual-findings",
          "label": "findings"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "residual-findings": {
      "kind": "terminal",
      "result": "handoff"
    }
  }
}
