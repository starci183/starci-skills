{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/skills/starci-quality-finding-repair/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "skillId",
    "result",
    "finalState",
    "state",
    "handoffRef",
    "receiptRefs",
    "findings",
    "cleanup"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "result": {
              "const": "rejected"
            },
            "finalState": {
              "const": "rejected"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "rejected"
                },
                "code": {
                  "const": "starci-quality-finding-repair-rejected"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "rejected"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        },
        {
          "properties": {
            "result": {
              "const": "blocked"
            },
            "finalState": {
              "const": "blocked"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "blocked"
                },
                "code": {
                  "const": "starci-quality-finding-repair-blocked"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "blocked"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        },
        {
          "properties": {
            "result": {
              "const": "complete"
            },
            "finalState": {
              "const": "complete"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "completed"
                },
                "code": {
                  "const": "starci-quality-finding-repair-complete"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "complete"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        },
        {
          "properties": {
            "result": {
              "const": "handoff"
            },
            "finalState": {
              "const": "residual-findings"
            },
            "state": {
              "properties": {
                "status": {
                  "const": "handoff"
                },
                "code": {
                  "const": "starci-quality-finding-repair-residual-findings"
                },
                "retryable": {
                  "const": false
                },
                "terminalState": {
                  "const": "residual-findings"
                }
              },
              "required": [
                "status",
                "code",
                "retryable",
                "terminalState"
              ]
            }
          },
          "required": [
            "result",
            "finalState",
            "state"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "skillId": {
      "const": "starci-quality-finding-repair"
    },
    "result": {
      "enum": [
        "rejected",
        "blocked",
        "complete",
        "handoff"
      ]
    },
    "finalState": {
      "enum": [
        "rejected",
        "blocked",
        "complete",
        "residual-findings"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "code",
        "retryable",
        "terminalState"
      ],
      "properties": {
        "status": {
          "enum": [
            "rejected",
            "blocked",
            "completed",
            "handoff"
          ]
        },
        "code": {
          "enum": [
            "starci-quality-finding-repair-rejected",
            "starci-quality-finding-repair-blocked",
            "starci-quality-finding-repair-complete",
            "starci-quality-finding-repair-residual-findings"
          ]
        },
        "retryable": {
          "const": false
        },
        "terminalState": {
          "enum": [
            "rejected",
            "blocked",
            "complete",
            "residual-findings"
          ]
        }
      }
    },
    "handoffRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    },
    "receiptRefs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 512,
        "pattern": "^(?:receipt:sha256:[0-9a-f]{64}|session://tasks/[A-Za-z0-9._-]+/.+)$"
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "evidenceRefs"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "maxLength": 120
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512,
              "pattern": "^(?:receipt:sha256:[0-9a-f]{64}|session://tasks/[A-Za-z0-9._-]+/.+)$"
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scratchRefs",
        "retention",
        "purgeAt"
      ],
      "properties": {
        "scratchRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^(?:receipt:sha256:[0-9a-f]{64}|session://tasks/[A-Za-z0-9._-]+/.+)$"
          }
        },
        "retention": {
          "const": "until-skill-terminal"
        },
        "purgeAt": {
          "const": "skill-terminal"
        }
      }
    }
  }
}
