{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-visual-fidelity",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "verify",
          "label": "enter verify"
        }
      ]
    },
    "verify": {
      "kind": "operator",
      "ref": "fe/visual-fidelity",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "complete",
          "label": "passed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "repair"
            }
          },
          "target": "repair-handoff",
          "label": "repair"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "repair-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
