{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-backend-contract-critique",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "critique",
          "label": "enter critique"
        }
      ]
    },
    "critique": {
      "kind": "operator",
      "ref": "be/contract-critique",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "complete",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "revise"
            }
          },
          "target": "revision-handoff",
          "label": "revise"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    },
    "revision-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
