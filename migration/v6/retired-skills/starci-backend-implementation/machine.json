{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-backend-implementation",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "scope",
          "label": "enter scope"
        }
      ]
    },
    "scope": {
      "kind": "operator",
      "ref": "be/coding-scope-freeze",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "preflight",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "source-drift"
            }
          },
          "target": "replan-handoff",
          "label": "source-drift"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "boundary-drift"
            }
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "preflight": {
      "kind": "operator",
      "ref": "quality/coding-preflight",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "implement",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "reference-gap"
            }
          },
          "target": "replan-handoff",
          "label": "reference-gap"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "replan-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "implement": {
      "kind": "operator",
      "ref": "be/implementation",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "conformance",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "source-drift"
            }
          },
          "target": "replan-handoff",
          "label": "source-drift"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "boundary-drift"
            }
          },
          "target": "replan-handoff",
          "label": "boundary-drift"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "conformance": {
      "kind": "operator",
      "ref": "be/implementation-conformance",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "complete",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "revise"
            }
          },
          "target": "scope",
          "label": "revise"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
