{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-architecture-discover",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "evidence",
          "label": "enter evidence"
        }
      ]
    },
    "evidence": {
      "kind": "operator",
      "ref": "architecture/evidence-discovery",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "model",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "revise"
            }
          },
          "target": "evidence",
          "label": "revise"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "model": {
      "kind": "operator",
      "ref": "architecture/system-model",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "handoff",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "revise"
            }
          },
          "target": "evidence",
          "label": "revise"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "handoff": {
      "kind": "terminal",
      "result": "handoff"
    }
  }
}
