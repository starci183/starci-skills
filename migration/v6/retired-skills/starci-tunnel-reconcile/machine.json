{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-tunnel-reconcile",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "tunnel-plan",
          "label": "enter tunnel-plan"
        }
      ]
    },
    "tunnel-plan": {
      "kind": "operator",
      "ref": "platform/tunnel-plan",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "tunnel-apply",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "tunnel-apply": {
      "kind": "operator",
      "ref": "platform/tunnel-apply",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "proved"
            }
          },
          "target": "complete",
          "label": "proved"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
