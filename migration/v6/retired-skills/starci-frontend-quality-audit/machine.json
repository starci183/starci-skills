{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-quality-audit",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "coverage",
          "label": "enter coverage"
        }
      ]
    },
    "coverage": {
      "kind": "operator",
      "ref": "test/flow-coverage-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "ready"
            }
          },
          "target": "behavior",
          "label": "ready"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "findings"
            }
          },
          "target": "findings",
          "label": "findings"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "require-user-action"
            }
          },
          "target": "user-action-required",
          "label": "require-user-action"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "behavior": {
      "kind": "operator",
      "ref": "test/behavior-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ux",
          "label": "passed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "findings",
          "label": "failed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "require-user-action"
            }
          },
          "target": "user-action-required",
          "label": "require-user-action"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "findings": {
      "kind": "terminal",
      "result": "complete"
    },
    "user-action-required": {
      "kind": "terminal",
      "result": "require-user-action"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    },
    "ux": {
      "kind": "operator",
      "ref": "test/ux-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "ui",
          "label": "passed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "findings",
          "label": "failed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "require-user-action"
            }
          },
          "target": "user-action-required",
          "label": "require-user-action"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "ui": {
      "kind": "operator",
      "ref": "test/ui-audit",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "passed"
            }
          },
          "target": "complete",
          "label": "passed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "failed"
            }
          },
          "target": "findings",
          "label": "failed"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "suspense"
            }
          },
          "target": "findings",
          "label": "suspense"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "require-user-action"
            }
          },
          "target": "user-action-required",
          "label": "require-user-action"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked",
          "label": "blocked"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
