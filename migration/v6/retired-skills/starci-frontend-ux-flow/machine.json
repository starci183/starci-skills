{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-frontend-ux-flow",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "model"
        }
      ]
    },
    "model": {
      "kind": "operator",
      "ref": "fe/ux-flow",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "modeled"
            }
          },
          "target": "containers"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "containers": {
      "kind": "operator",
      "ref": "fe/interaction-container-decision",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "containers-ready"
            }
          },
          "target": "review"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "review": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
