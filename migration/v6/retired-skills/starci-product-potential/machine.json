{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-product-potential",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {},
          "target": "assess"
        }
      ]
    },
    "assess": {
      "kind": "operator",
      "ref": "fe/product-potential",
      "on": [
        {
          "when": {
            "outputEquals": {
              "outcome": "assessed"
            }
          },
          "target": "route-handoff"
        },
        {
          "when": {
            "outputEquals": {
              "outcome": "blocked"
            }
          },
          "target": "blocked"
        }
      ]
    },
    "route-handoff": {
      "kind": "terminal",
      "result": "handoff"
    },
    "blocked": {
      "kind": "terminal",
      "result": "blocked"
    }
  }
}
