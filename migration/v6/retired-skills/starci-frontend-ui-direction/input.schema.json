{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/skills/starci-frontend-ui-direction/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "selection",
    "requestRef",
    "artifactRefs",
    "evidenceRefs",
    "scope",
    "options"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzerVersion",
        "skillId",
        "confidence",
        "activeInputRefs",
        "passiveContextRefs"
      ],
      "properties": {
        "analyzerVersion": {
          "const": 1
        },
        "skillId": {
          "const": "starci-frontend-ui-direction"
        },
        "confidence": {
          "enum": [
            "exact",
            "clarified"
          ]
        },
        "activeInputRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^(?![^:]+:(?:\\/\\/)?(?:entire-repository|whole-repository|all-history|all-source|\\*)$)[a-z][a-z0-9+.-]*:[^\\s]+$"
          },
          "maxItems": 8
        },
        "passiveContextRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 512,
            "pattern": "^(?![^:]+:(?:\\/\\/)?(?:entire-repository|whole-repository|all-history|all-source|\\*)$)[a-z][a-z0-9+.-]*:[^\\s]+$"
          },
          "maxItems": 8
        },
        "mode": {
          "enum": [
            "gated",
            "bypass"
          ]
        }
      }
    },
    "requestRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directionCount"
      ],
      "properties": {
        "directionCount": {
          "enum": [
            3,
            4
          ]
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRefs",
        "writeRoots",
        "externalMutation",
        "approvalRef"
      ],
      "properties": {
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writeRoots": {
          "type": "array",
          "maxItems": 0
        },
        "externalMutation": {
          "const": false
        },
        "approvalRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
