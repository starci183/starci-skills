{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.1/uat/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feature", "flow", "sourceRevision", "authorityRevision", "flowIdentity", "coverage", "cases", "resources", "runs", "findings", "feedback", "suspense", "userActions"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "feature": { "$ref": "#/$defs/id" },
    "flow": { "$ref": "#/$defs/id" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "flowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorEntry", "businessOutcomeTerminal", "semanticOwnerSideEffect", "recoveryTopology", "distinctBy"],
      "properties": {
        "actorEntry": { "$ref": "#/$defs/text" },
        "businessOutcomeTerminal": { "$ref": "#/$defs/text" },
        "semanticOwnerSideEffect": { "$ref": "#/$defs/text" },
        "recoveryTopology": { "$ref": "#/$defs/text" },
        "distinctBy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["actor-entry", "business-outcome-terminal", "semantic-owner-side-effect", "recovery-topology"] } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "selectedCaseCount", "delegatedPermutationCount", "uncoveredTransitionCount", "delegationRefs", "overflowReasons"],
      "properties": {
        "strategy": { "const": "product-decision-branches" },
        "selectedCaseCount": { "type": "integer", "minimum": 1 },
        "delegatedPermutationCount": { "type": "integer", "minimum": 0 },
        "uncoveredTransitionCount": { "type": "integer", "minimum": 0 },
        "delegationRefs": { "$ref": "#/$defs/refs" },
        "overflowReasons": { "$ref": "#/$defs/refs" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "type": "object", "properties": { "class": { "const": "happy" } }, "required": ["class"] },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "startState", "semanticOwner", "sideEffect", "recoveryAction", "terminalState", "faultScope", "resourceClass"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "class": { "enum": ["happy", "unhappy"] },
          "startState": { "$ref": "#/$defs/text" },
          "semanticOwner": { "$ref": "#/$defs/text" },
          "sideEffect": { "$ref": "#/$defs/text" },
          "recoveryAction": { "$ref": "#/$defs/text" },
          "terminalState": { "$ref": "#/$defs/text" },
          "faultScope": { "$ref": "#/$defs/text" },
          "resourceClass": { "enum": ["safe", "partitioned", "exclusive"] },
          "delegatedProofRefs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "runId", "executionOrder", "declaredBeforeExecute", "declarationReceiptRef", "constraintPreflightReceiptRef", "precondition", "expectedOutcome", "agent", "accountProvisioning", "account", "browserContext", "browserSessionRef", "browserLeaseRef", "browserProfileRefs", "origin", "fixtureNamespace", "artifactDirectory", "locks", "cleanupSelector"],
        "properties": {
          "caseId": { "$ref": "#/$defs/id" },
          "runId": { "$ref": "#/$defs/id" },
          "executionOrder": { "type": "integer", "minimum": 1 },
          "declaredBeforeExecute": { "const": true },
          "declarationReceiptRef": { "$ref": "#/$defs/text" },
          "constraintPreflightReceiptRef": { "$ref": "#/$defs/text" },
          "precondition": { "$ref": "#/$defs/text" },
          "expectedOutcome": { "$ref": "#/$defs/text" },
          "accountProvisioning": { "enum": ["fresh", "none"] },
          "account": { "$ref": "#/$defs/text" },
          "agent": { "$ref": "#/$defs/text" },
          "browserContext": { "$ref": "#/$defs/text" },
          "browserSessionRef": { "$ref": "#/$defs/text" },
          "browserLeaseRef": { "$ref": "#/$defs/text" },
          "browserProfileRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
          "origin": { "$ref": "#/$defs/text" },
          "mailQueryNamespace": { "$ref": "#/$defs/text" },
          "fixtureNamespace": { "$ref": "#/$defs/text" },
          "artifactDirectory": { "type": "string", "pattern": "^runs/[A-Za-z0-9._-]+/$" },
          "locks": { "$ref": "#/$defs/refs" },
          "cleanupSelector": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "runId", "isUat"],
            "properties": {
              "caseId": { "$ref": "#/$defs/id" },
              "runId": { "$ref": "#/$defs/id" },
              "isUat": { "const": true }
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "caseId", "behavior", "ux", "ui", "recoveryComplete", "terminalProved", "resultRef"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "caseId": { "$ref": "#/$defs/id" },
          "behavior": { "enum": ["PASS", "FAIL", "REQUIRE_USER_ACTION", "BLOCKED"] },
          "ux": { "enum": ["PASS", "FAIL", "REQUIRE_USER_ACTION", "BLOCKED"] },
          "ui": { "enum": ["PASS", "FAIL", "SUSPENSE", "REQUIRE_USER_ACTION", "BLOCKED"] },
          "recoveryComplete": { "type": "boolean" },
          "terminalProved": { "type": "boolean" },
          "resultRef": { "type": "string", "pattern": "^runs/[A-Za-z0-9._-]+/(?:result\\.json|events/[A-Za-z0-9._-]+\\.json)$" }
        }
      }
    },
    "findings": { "$ref": "#/$defs/refs" },
    "feedback": { "$ref": "#/$defs/refs" },
    "suspense": { "$ref": "#/$defs/refs" },
    "userActions": { "$ref": "#/$defs/refs" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
