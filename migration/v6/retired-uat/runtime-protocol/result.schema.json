{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.1/uat/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "caseId", "sourceRevision", "authorityRevision", "verdicts", "uiAuthority", "recoveryComplete", "terminalProved", "checkpoints", "resultVerification", "fixture", "resources", "findings", "feedbackRefs", "suspenseQuestions", "userActions", "overall"],
  "allOf": [
    {
      "if": { "properties": { "overall": { "const": "PASS" } }, "required": ["overall"] },
      "then": {
        "properties": {
          "verdicts": { "properties": { "behavior": { "const": "PASS" }, "ux": { "const": "PASS" }, "ui": { "const": "PASS" } }, "required": ["behavior", "ux", "ui"] },
          "recoveryComplete": { "const": true },
          "terminalProved": { "const": true },
          "suspenseQuestions": { "maxItems": 0 },
          "userActions": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "overall": { "const": "REQUIRE_USER_ACTION" } }, "required": ["overall"] },
      "then": { "properties": { "userActions": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "verdicts": { "properties": { "ui": { "const": "SUSPENSE" } }, "required": ["ui"] } }, "required": ["verdicts"] },
      "then": { "properties": { "suspenseQuestions": { "minItems": 1 } } }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "sourceRevision": { "$ref": "#/$defs/text" },
    "authorityRevision": { "$ref": "#/$defs/text" },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "ux", "ui"],
      "properties": {
        "behavior": { "enum": ["PASS", "FAIL", "REQUIRE_USER_ACTION", "BLOCKED"] },
        "ux": { "enum": ["PASS", "FAIL", "REQUIRE_USER_ACTION", "BLOCKED"] },
        "ui": { "enum": ["PASS", "FAIL", "SUSPENSE", "REQUIRE_USER_ACTION", "BLOCKED"] }
      }
    },
    "uiAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uiPrinciples", "grammar", "conflict", "evidenceRefs"],
      "properties": {
        "uiPrinciples": { "enum": ["PASS", "FAIL", "SUSPENSE", "BLOCKED"] },
        "grammar": { "enum": ["PASS", "FAIL", "SUSPENSE", "BLOCKED"] },
        "conflict": { "type": "boolean" },
        "evidenceRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "recoveryComplete": { "type": "boolean" },
    "terminalProved": { "type": "boolean" },
    "checkpoints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state", "viewport", "scaleMode", "scalePercent", "assertion", "fullScreenshotRef", "runtimeEvidenceRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["entry", "commit", "feedback", "recovery", "terminal", "before-refresh", "after-refresh", "before-resume", "after-resume"] },
          "state": { "$ref": "#/$defs/text" },
          "viewport": { "type": "string", "pattern": "^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$" },
          "scaleMode": { "enum": ["native", "viewport", "browser-zoom", "text-only"] },
          "scalePercent": { "type": "integer", "minimum": 25, "maximum": 500 },
          "assertion": { "$ref": "#/$defs/text" },
          "fullScreenshotRef": { "type": "string", "pattern": "^screenshots/.+\\.full\\.png$" },
          "regionRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^regions/.+\\.png$" } },
          "runtimeEvidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "resultVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "queryRefs", "mutationCount"],
      "properties": {
        "mode": { "const": "read-only" },
        "queryRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "mutationCount": { "const": 0 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseSelector", "isUat", "constraintPreflightReceiptRef", "prepareReceiptRef", "renderSeedRefs", "preparedBeforeExecute", "executeReceiptRef", "verifyReceiptRef", "cleanupReceiptRef", "outcomeMutationAfterExecute"],
      "properties": {
        "caseSelector": { "$ref": "#/$defs/id" },
        "isUat": { "const": true },
        "constraintPreflightReceiptRef": { "$ref": "#/$defs/text" },
        "prepareReceiptRef": { "$ref": "#/$defs/text" },
        "renderSeedRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "preparedBeforeExecute": { "const": true },
        "executeReceiptRef": { "$ref": "#/$defs/text" },
        "verifyReceiptRef": { "$ref": "#/$defs/text" },
        "cleanupReceiptRef": { "$ref": "#/$defs/text" },
        "outcomeMutationAfterExecute": { "const": false }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionOrder", "declaredBeforeExecute", "declarationReceiptRef", "precondition", "expectedOutcome", "accountProvisioning", "account", "accountProvisioningReceiptRef", "agent", "browserContext", "browserSessionRef", "browserLeaseReceiptRef", "origin", "mailQueryNamespace", "fixtureNamespace", "artifactDirectory", "locks"],
      "allOf": [
        {
          "if": { "properties": { "accountProvisioning": { "const": "fresh" } }, "required": ["accountProvisioning"] },
          "then": { "properties": { "account": { "not": { "const": "none" } }, "accountProvisioningReceiptRef": { "not": { "const": "not-applicable" } } } }
        },
        {
          "if": { "properties": { "accountProvisioning": { "const": "none" } }, "required": ["accountProvisioning"] },
          "then": { "properties": { "account": { "const": "none" }, "accountProvisioningReceiptRef": { "const": "not-applicable" } } }
        }
      ],
      "properties": {
        "executionOrder": { "type": "integer", "minimum": 1 },
        "declaredBeforeExecute": { "const": true },
        "declarationReceiptRef": { "$ref": "#/$defs/text" },
        "precondition": { "$ref": "#/$defs/text" },
        "expectedOutcome": { "$ref": "#/$defs/text" },
        "accountProvisioning": { "enum": ["fresh", "none"] },
        "account": { "$ref": "#/$defs/text" },
        "accountProvisioningReceiptRef": { "$ref": "#/$defs/text" },
        "agent": { "$ref": "#/$defs/text" },
        "browserContext": { "$ref": "#/$defs/text" },
        "browserSessionRef": { "$ref": "#/$defs/text" },
        "browserLeaseReceiptRef": { "$ref": "#/$defs/text" },
        "origin": { "$ref": "#/$defs/text" },
        "mailQueryNamespace": { "$ref": "#/$defs/text" },
        "fixtureNamespace": { "$ref": "#/$defs/text" },
        "artifactDirectory": { "$ref": "#/$defs/text" },
        "locks": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "findings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "feedbackRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "suspenseQuestions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "userActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "controlChannel", "controlRef", "exactAction", "completionEvidence", "resumeCommand"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "reason": { "$ref": "#/$defs/text" },
          "controlChannel": { "enum": ["browser", "device", "external-service"] },
          "controlRef": { "$ref": "#/$defs/text" },
          "exactAction": { "$ref": "#/$defs/text" },
          "completionEvidence": { "$ref": "#/$defs/text" },
          "resumeCommand": { "type": "string", "pattern": "^USER ACTION COMPLETE [A-Za-z0-9._-]+$" }
        }
      }
    },
    "overall": { "enum": ["PASS", "FAIL", "SUSPENSE", "REQUIRE_USER_ACTION", "BLOCKED"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "text": { "type": "string", "minLength": 1 }
  }
}
