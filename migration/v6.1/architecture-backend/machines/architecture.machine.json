{
  "schemaVersion": "6.1",
  "machineId": "architecture-v6.1",
  "initial": "discover-evidence",
  "contextPolicy": {
    "default": "references-only",
    "source": "observation-only",
    "cleanup": "purge-capability-scratch-at-handoff-and-all-terminal-states",
    "approvalBoundary": "architecture-option"
  },
  "states": {
    "discover-evidence": { "operator": "architecture.evidence-discovery", "on": { "ready": "model-tech-stack", "stale": "discover-evidence", "blocked": "blocked" } },
    "model-tech-stack": { "operator": "architecture.tech-stack-model", "on": { "ready": "model-system", "needs-input": "await-input", "blocked": "blocked" } },
    "model-system": { "operator": "architecture.system-model", "on": { "ready": "assign-data-ownership", "needs-evidence": "discover-evidence", "blocked": "blocked" } },
    "assign-data-ownership": { "operator": "architecture.data-ownership", "on": { "ready": "analyze-contradictions", "unknown": "await-input", "blocked": "blocked" } },
    "analyze-contradictions": { "operator": "architecture.contradiction-analysis", "on": { "clear": "generate-options", "authority-needed": "await-input", "target-proposed": "generate-options", "blocked": "blocked" } },
    "generate-options": { "operator": "architecture.options", "on": { "recommended": "await-architecture-approval", "revise-model": "model-system", "blocked": "blocked" } },
    "await-architecture-approval": { "type": "approval", "on": { "approved": "realize-design", "revise": "generate-options", "rejected": "rejected" } },
    "realize-design": { "operator": "architecture.design-realization", "on": { "ready": "decide-migration", "gap": "generate-options", "blocked": "blocked" } },
    "decide-migration": { "type": "choice", "when": "observedBinding != targetBinding or topology changed", "then": "design-migration", "else": "challenge" },
    "design-migration": { "operator": "architecture.migration-design", "on": { "ready": "challenge", "revise": "realize-design", "blocked": "blocked" } },
    "challenge": { "operator": "architecture.independent-critique", "freshContext": true, "on": { "accept": "conformance-handoff", "revise": "model-system", "reject": "rejected", "blocked": "blocked" } },
    "conformance-handoff": { "operator": "architecture.conformance", "deferredUntil": "implementation-evidence-available", "on": { "conformant": "complete", "non-conformant": "realize-design", "blocked": "blocked" } },
    "await-input": { "type": "pause", "on": { "resume": "discover-evidence", "cancel": "rejected" } },
    "complete": { "type": "final", "cleanup": true },
    "rejected": { "type": "final", "cleanup": true },
    "blocked": { "type": "final", "cleanup": true }
  }
}
