{
  "schemaVersion": "6.1",
  "machineId": "backend-v6.1",
  "initial": "design-solution",
  "contextPolicy": {
    "default": "references-only",
    "sourceBeforeApproval": "forbidden",
    "sourceAfterApproval": "exact-targets-only",
    "cleanup": "purge-capability-scratch-at-handoff-and-all-terminal-states",
    "approvalBoundary": "backend-contract-bundle"
  },
  "states": {
    "design-solution": { "operator": "backend.solution-design", "on": { "ready": "select-contracts", "architecture-gap": "return-to-architecture", "blocked": "blocked" } },
    "select-contracts": {
      "type": "fanout",
      "branches": [
        { "when": "external-api-required", "operator": "backend.api-contract" },
        { "when": "asynchronous-communication-required", "operator": "backend.event-contract" },
        { "when": "state-change-required", "operator": "backend.mutation-contract" },
        { "when": "read-required", "operator": "backend.query-contract" },
        { "when": "writes-or-effects-present", "operator": "backend.transaction-contract", "after": ["backend.mutation-contract", "backend.event-contract"] }
      ],
      "join": "assemble-contract-bundle",
      "onFailure": "design-solution"
    },
    "assemble-contract-bundle": { "type": "assemble", "schemaRef": "../schemas/backend-contract.schema.json", "on": { "valid": "challenge-contracts", "invalid": "select-contracts" } },
    "challenge-contracts": { "operator": "backend.contract-critique", "freshContext": true, "on": { "accept": "await-contract-approval", "revise": "design-solution", "reject": "rejected", "blocked": "blocked" } },
    "await-contract-approval": { "type": "approval", "on": { "approved": "implementation-handoff", "revise": "design-solution", "rejected": "rejected" } },
    "implementation-handoff": { "type": "handoff", "emits": "approved-contract-and-exact-source-scope", "on": { "implementation-ready": "semantic-conformance", "architecture-drift": "return-to-architecture", "blocked": "blocked" } },
    "semantic-conformance": { "operator": "backend.implementation-conformance", "on": { "conformant": "delivery-proof", "non-conformant": "implementation-handoff", "blocked": "blocked" } },
    "delivery-proof": { "operator": "backend.delivery-proof", "on": { "ready": "complete", "revise": "implementation-handoff", "blocked": "blocked" } },
    "return-to-architecture": { "type": "handoff", "targetMachine": "architecture-v6.1", "resumeAt": "design-solution" },
    "complete": { "type": "final", "cleanup": true },
    "rejected": { "type": "final", "cleanup": true },
    "blocked": { "type": "final", "cleanup": true }
  }
}
