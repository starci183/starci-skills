{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/architecture-options.schema.json",
  "title": "Architecture options and recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["optionsId", "problemRef", "options", "recommendation", "decisionState", "evidenceRefs"],
  "properties": {
    "optionsId": { "type": "string", "minLength": 1 },
    "problemRef": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "summary", "topologyChanges", "ownershipChanges", "failureModes", "migrationCost", "operatingCost", "tradeoffs"],
        "properties": {
          "optionId": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "topologyChanges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "ownershipChanges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "failureModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "migrationCost": { "type": "string", "minLength": 1 },
          "operatingCost": { "type": "string", "minLength": 1 },
          "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "decisionState": { "enum": ["proposed", "approved", "rejected", "revise"] },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
