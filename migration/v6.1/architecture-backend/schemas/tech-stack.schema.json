{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/tech-stack.schema.json",
  "title": "Project technology and operating model",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "claimState", "runtime", "services", "communication", "persistence", "infrastructure", "observability", "security", "development", "evidenceRefs"],
  "properties": {
    "modelId": { "type": "string", "minLength": 1 },
    "claimState": { "enum": ["observed", "authorized", "target", "migration", "contradicted"] },
    "runtime": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["componentRef", "language", "framework", "runtime", "versionConstraints", "packageManager", "evidenceRefs"],
        "properties": {
          "componentRef": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "framework": { "type": "string", "minLength": 1 },
          "runtime": { "type": "string", "minLength": 1 },
          "versionConstraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "packageManager": { "type": "string", "minLength": 1 },
          "buildArtifact": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "services": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedEvidence" } },
    "communication": { "type": "array", "items": { "$ref": "#/$defs/namedEvidence" } },
    "persistence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedEvidence" } },
    "infrastructure": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedEvidence" } },
    "observability": { "type": "array", "items": { "$ref": "#/$defs/namedEvidence" } },
    "security": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedEvidence" } },
    "development": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/namedEvidence" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "namedEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "claimState", "versionConstraints", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "claimState": { "enum": ["observed", "authorized", "target", "migration", "unknown", "contradicted"] },
        "versionConstraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
