{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/system-model.schema.json",
  "title": "Observed and target architecture system model",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "businessRevision", "sourceRevision", "deploymentRevision", "components", "stores", "edges", "evidenceRefs"],
  "properties": {
    "modelId": { "type": "string", "minLength": 1 },
    "businessRevision": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "deploymentRevision": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "stores": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/store" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "claimState": { "enum": ["observed", "authorized", "target", "migration", "unknown", "contradicted"] },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "deployableId", "responsibilities", "runtimeRef", "lifecycleOwner", "claimState", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["application", "service", "worker", "job", "cronjob", "gateway", "external-service", "library"] },
        "deployableId": { "type": ["string", "null"] },
        "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "runtimeRef": { "type": "string", "minLength": 1 },
        "replicaPolicy": { "type": "string", "minLength": 1 },
        "lifecycleOwner": { "type": "string", "minLength": 1 },
        "claimState": { "$ref": "#/$defs/claimState" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "store": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "technology", "physicalScope", "database", "namespace", "networkExposure", "restoreUnit", "claimState", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "technology": { "enum": ["postgresql", "mysql", "mongodb", "redis", "qdrant", "s3", "minio", "kafka", "filesystem", "vendor-managed", "other"] },
        "physicalScope": { "enum": ["central", "per-tenant", "per-instance", "per-expert", "per-environment", "external"] },
        "database": { "type": ["string", "null"] },
        "namespace": { "type": ["string", "null"] },
        "collection": { "type": ["string", "null"] },
        "bucket": { "type": ["string", "null"] },
        "queue": { "type": ["string", "null"] },
        "notApplicableReason": { "type": ["string", "null"] },
        "networkExposure": { "enum": ["process-local", "pod-local", "namespace-internal", "cluster-internal", "private-network", "public"] },
        "restoreUnit": { "type": "string", "minLength": 1 },
        "claimState": { "$ref": "#/$defs/claimState" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "protocol", "resourceRefs", "authRef", "failurePolicyRef", "claimState", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["request", "command", "event", "read", "write", "migrate", "admin", "presign", "backup", "restore"] },
        "protocol": { "type": "string", "minLength": 1 },
        "connectionToken": { "type": ["string", "null"] },
        "resourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "authRef": { "type": ["string", "null"] },
        "failurePolicyRef": { "type": ["string", "null"] },
        "claimState": { "$ref": "#/$defs/claimState" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
