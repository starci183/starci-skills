{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/operator-manifest.schema.json",
  "title": "Atomic v6.1 operator manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "purpose", "accepts", "loads", "emits", "decisions", "gates", "sourcePolicy", "sideEffects", "stopConditions"],
  "properties": {
    "schemaVersion": { "const": "6.1" },
    "id": { "type": "string", "pattern": "^(architecture|backend)\\.[a-z0-9-]+$" },
    "purpose": { "type": "string", "minLength": 1 },
    "accepts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "loads": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "emits": { "type": "string", "minLength": 1 },
    "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "gates": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "sourcePolicy": { "enum": ["observation-only", "contract-first", "approved-source-access", "no-source"] },
    "sideEffects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stopConditions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
