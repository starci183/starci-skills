{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/conformance.schema.json",
  "title": "Implementation conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportId", "subjectRef", "architectureRef", "ownershipRef", "contractRef", "accesses", "semanticChecks", "deterministicChecks", "decision", "evidenceRefs"],
  "properties": {
    "reportId": { "type": "string", "minLength": 1 },
    "subjectRef": { "type": "string", "minLength": 1 },
    "architectureRef": { "type": "string", "minLength": 1 },
    "ownershipRef": { "type": "string", "minLength": 1 },
    "contractRef": { "type": "string", "minLength": 1 },
    "accesses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentRef", "operation", "resourceRef", "storeRef", "qualifiedName", "connectionToken", "sourceRef"],
        "properties": {
          "componentRef": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["read", "write", "migrate", "publish", "consume"] },
          "resourceRef": { "type": "string", "minLength": 1 },
          "storeRef": { "type": "string", "minLength": 1 },
          "qualifiedName": { "type": "string", "minLength": 3 },
          "connectionToken": { "type": ["string", "null"] },
          "sourceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticChecks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
    "deterministicChecks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "decision": { "enum": ["conformant", "non-conformant", "blocked"] },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "evidenceRefs"],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "not-run", "not-applicable"] },
        "message": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
