{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/contradiction-ledger.schema.json",
  "title": "Architecture contradiction ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledgerId", "contradictions", "unresolvedBlockingCount", "evidenceRefs"],
  "properties": {
    "ledgerId": { "type": "string", "minLength": 1 },
    "contradictions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["contradictionId", "subject", "claims", "classification", "severity", "safeDefault", "resolutionOwner", "resolutionState", "affectedDecisionIds"],
        "properties": {
          "contradictionId": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "claims": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
          "classification": { "enum": ["authorized-not-realized", "implemented-not-authorized", "transitional", "ambiguous", "dead-code", "deployment-unverified", "schema-drift", "writer-conflict", "migration-conflict"] },
          "severity": { "enum": ["advisory", "material", "blocking"] },
          "safeDefault": { "enum": ["read-only", "no-new-writes", "use-observed", "use-authorized", "block"] },
          "resolutionOwner": { "type": "string", "minLength": 1 },
          "resolutionState": { "enum": ["open", "accepted-risk", "resolved"] },
          "resolutionRef": { "type": ["string", "null"] },
          "affectedDecisionIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "unresolvedBlockingCount": { "type": "integer", "minimum": 0 },
    "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
