{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/migration-plan.schema.json",
  "title": "Architecture and data migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "fromModelRef", "toModelRef", "compatibilityWindow", "steps", "rollback", "fleetPolicy", "evidenceRefs"],
  "properties": {
    "planId": { "type": "string", "minLength": 1 },
    "fromModelRef": { "type": "string", "minLength": 1 },
    "toModelRef": { "type": "string", "minLength": 1 },
    "compatibilityWindow": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stepId", "kind", "owner", "preconditions", "writes", "verification", "rollbackBoundary", "order"],
        "properties": {
          "stepId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["expand", "backfill", "dual-read", "dual-write", "shadow", "cutover", "contract", "retire"] },
          "owner": { "type": "string", "minLength": 1 },
          "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "writes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rollbackBoundary": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "rollback": { "type": "object", "additionalProperties": false, "required": ["supportedUntil", "procedureRef", "dataLossPolicy"], "properties": {
      "supportedUntil": { "type": "string", "minLength": 1 },
      "procedureRef": { "type": "string", "minLength": 1 },
      "dataLossPolicy": { "type": "string", "minLength": 1 }
    } },
    "fleetPolicy": { "type": "object", "additionalProperties": false, "required": ["versionCompatibility", "waveStrategy", "haltCondition"], "properties": {
      "versionCompatibility": { "type": "string", "minLength": 1 },
      "waveStrategy": { "type": "string", "minLength": 1 },
      "haltCondition": { "type": "string", "minLength": 1 }
    } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
