{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/evidence-claim-set.schema.json",
  "title": "Revision-pinned evidence claim set",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimSetId", "scopeRef", "claims", "unknowns"],
  "properties": {
    "claimSetId": { "type": "string", "minLength": 1 },
    "scopeRef": { "type": "string", "minLength": 1 },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "evidence-claim.schema.json" } },
    "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
