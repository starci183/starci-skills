{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/architecture-backend/evidence-claim.schema.json",
  "title": "Architecture evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimId", "subject", "value", "kind", "claimState", "revision", "evidenceRef"],
  "properties": {
    "claimId": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "value": {},
    "kind": {
      "enum": ["owner-intent", "business-authority", "source", "configuration", "deployment", "test", "runtime", "inference", "proposal"]
    },
    "claimState": { "enum": ["observed", "authorized", "target", "migration", "unknown", "contradicted"] },
    "revision": { "type": "string", "minLength": 1 },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
