{
  "schema": "starci/workflow@1",
  "id": "frontend",
  "matrix": "matrix.json",
  "transitions": "transitions.json",
  "contracts": "contracts.json",
  "handoffs": [
    {
      "from": "draw.outputs.draws",
      "to": "implement.inputs.draws"
    },
    {
      "from": "draw.artifacts",
      "to": "implement.inputs.drawArtifacts"
    },
    {
      "from": "implement.outputs.flows",
      "to": "uat.inputs.flows"
    },
    {
      "from": "implement.outputs.codeRefs",
      "to": "uat.inputs.codeRefs"
    },
    {
      "from": "implement.outputs.runtime",
      "to": "uat.inputs.runtime"
    },
    {
      "from": "implement.outputs.assets",
      "to": "uat.inputs.assets"
    }
  ],
  "criteria": {
    "draw": [
      "draws-reviewed",
      "business-covered",
      "knowledge-compliant"
    ],
    "implement": [
      "draws-covered",
      "knowledge-compliant",
      "code-checks-pass",
      "render-verified",
      "flows-ready",
      "lint-pass",
      "typecheck-pass",
      "tests-coverage-pass",
      "build-pass",
      "sonar-gate-pass",
      "commit-verified",
      "assets-accounted-for"
    ],
    "uat": [
      "flows-pass",
      "ux-pass",
      "recording-complete",
      "cleanup-complete"
    ]
  }
}
