{
  "schema": "starci/job-matrices@1",
  "limits": {
    "rows": 3,
    "columns": 3,
    "secondaryDefinitions": 3
  },
  "purpose": "Declarative complete-job workflows. Bind actual scope before execution; definitions alone do not run agents or certify results.",
  "bindingRules": [
    "Outputs are semantic handoffs produced in the op evidence bundle; the selected job request pins their exact JSON shape and artifact references before execution.",
    "A reference consumes the exact accepted producer output, never a regenerated approximation.",
    "Declared writeScopes are ownership keys that must resolve to actual exclusive paths, sessions and resource IDs. Shared physical targets or dependencies require sequential rows.",
    "A primary may call only its own declared secondary policy; support retains the same matrix cell and never bypasses its parent gate.",
    "Frontend workflow keeps its separately implemented strict request/response runtime; these matrices are validated templates, not an automatic executor."
  ],
  "workflows": [
    {
      "id": "source-to-work",
      "parameters": [
        "legacyScope",
        "intent"
      ],
      "matrix": [
        [
          {
            "id": "import",
            "op": "workspace.manage",
            "inputs": {
              "scope": {
                "parameter": "legacyScope"
              }
            },
            "outputs": [
              "workRef",
              "inventory",
              "sourceRefs",
              "unresolved"
            ],
            "criteria": [
              "source-preserved",
              "work-valid",
              "provenance-bound",
              "unapproved-import-visible"
            ],
            "writeScopes": [
              "canonical-work"
            ],
            "operation": "import"
          }
        ],
        [
          {
            "id": "business",
            "op": "business.decide",
            "inputs": {
              "work": {
                "cell": "import",
                "output": "workRef"
              },
              "observations": {
                "cell": "import",
                "output": "sourceRefs"
              },
              "intent": {
                "parameter": "intent"
              }
            },
            "outputs": [
              "businessSpec",
              "journeys"
            ],
            "criteria": [
              "intent-resolved",
              "coverage-pass",
              "work-valid"
            ],
            "writeScopes": [
              "canonical-work/business"
            ]
          }
        ],
        [
          {
            "id": "architecture",
            "op": "architecture.decide",
            "inputs": {
              "business": {
                "cell": "business",
                "output": "businessSpec"
              },
              "journeys": {
                "cell": "business",
                "output": "journeys"
              },
              "source": {
                "cell": "import",
                "output": "sourceRefs"
              }
            },
            "outputs": [
              "architectureSpec",
              "codeImpacts",
              "serviceCalls"
            ],
            "criteria": [
              "service-routing-resolved",
              "security-covered",
              "implementable",
              "work-valid"
            ],
            "writeScopes": [
              "canonical-work/architecture"
            ]
          }
        ]
      ],
      "transition": {
        "request": "exact-cell-op-mode-inputs-criteria",
        "response": "matching-request-digest-and-op-mode",
        "advance": "all-required-criteria-pass-and-output-evidence-verified",
        "missingOrFailed": "remain-in-cell",
        "repair": "same-cell-same-acceptance-bounded-retry",
        "evidence": "actual-artifacts-and-selected-work-completion-profile",
        "dispatch": "explicit-coordinator-only"
      }
    },
