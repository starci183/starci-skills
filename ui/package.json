{
  "name": "starci-status-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:i18n": "node ../scripts/hfs/sync-runtime.mjs",
    "predev": "npm run generate:i18n",
    "dev": "node start.mjs",
    "predev:ui": "npm run generate:i18n",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:api": "node server.mjs",
    "prebuild": "npm run generate:i18n",
    "build": "npm run lint && tsc --noEmit && vite build",
    "prelint": "npm run generate:i18n",
    "lint": "eslint src/app.tsx src/router.ts src/api src/i18n src/components src/pages",
    "serve": "node server.mjs --serve-static",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "0.468.0",
    "motion": "13.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.3.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
