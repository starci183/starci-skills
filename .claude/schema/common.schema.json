{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "revision": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "timestamp": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "mediaType": { "type": "string", "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$" },
    "relativePath": {
      "type": "string",
      "description": "A slash-separated file path relative to the work directory; no absolute path, dot segment, parent traversal, drive prefix or backslash.",
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "file": {
      "type": "object", "additionalProperties": false,
      "description": "A staged file relative to the work directory. The consumer verifies its actual bytes against sha256.",
      "required": ["path", "sha256", "mediaType"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "mediaType": { "$ref": "#/$defs/mediaType" }
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "description": "Recorded actor identity, not host-authenticated authority.",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["user", "agent", "tool", "system"] },
        "id": { "$ref": "#/$defs/text" }
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" } }
    },
    "criteria": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "excluded": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    }
  }
}
