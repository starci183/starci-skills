{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "preserve",
    "change"
  ],
  "properties": {
    "mode": {
      "enum": [
        "new",
        "extend",
        "revise"
      ]
    },
    "baselinePath": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "preserve": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    },
    "change": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "extend",
              "revise"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "baselinePath"
        ],
        "properties": {
          "preserve": {
            "minItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "baselinePath"
          ]
        }
      }
    }
  ]
}
