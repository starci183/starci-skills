{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "landing.compose response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [{ "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "properties": {
    "outputs": { "contains": { "properties": { "id": { "const": "landing-composition" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
    "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } }
  } } }],
  "description": "A done response contains the accepted landing composition. Knowledge conflict artifacts may accompany a blocked response, but a composition with unresolved ownership or evidence gaps is not done."
}
