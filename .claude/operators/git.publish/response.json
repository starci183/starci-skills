{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"git.publish response","$ref":"works:response",
  "description":"A done response binds the exact verified commit and a publication receipt containing approval, boundary, hooks, observed-before and read-back remote heads, publication mode and optional annotated tag.",
  "allOf":[{"if":{"properties":{"status":{"const":"done"}},"required":["status"]},"then":{"properties":{"outputs":{"allOf":[
    {"contains":{"properties":{"id":{"const":"published-commit"},"type":{"const":"commit"}},"required":["id","type","repository","sha"]}},
    {"contains":{"properties":{"id":{"const":"git-publication"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}}
  ]},"observations":{"not":{"contains":{"properties":{"result":{"const":"failed"}},"required":["result"]}}}}}}]
}
