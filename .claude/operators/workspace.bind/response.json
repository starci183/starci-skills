{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workspace.bind response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [{ "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "properties": {
    "outputs": { "allOf": [
      { "contains": { "properties": { "id": { "const": "workspace-route-binding" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "route" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } }
    ] }, "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } }
  } } }],
  "description": "A done response contains a head-bound checkout receipt and route record. It carries no runtime endpoint or secret."
}
