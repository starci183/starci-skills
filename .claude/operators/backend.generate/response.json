{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backend.generate response",
  "$ref": "works:response",
  "properties": {
    "outputs": {
      "items": { "properties": { "type": { "enum": ["text", "file", "commit"] } } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] },
      "then": {
        "properties": {
          "outputs": {
            "allOf": [
              { "contains": { "properties": { "id": { "const": "source-commit" }, "type": { "const": "commit" } }, "required": ["id", "type"] } },
              { "contains": { "properties": { "id": { "const": "mutation-report" }, "type": { "const": "file" } }, "required": ["id", "type", "file"] } },
              { "contains": { "properties": { "id": { "const": "proof-report" }, "type": { "const": "file" } }, "required": ["id", "type", "file"] } }
            ]
          },
          "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } }
        }
      }
    }
  ],
  "description": "A done response identifies one backend commit plus persisted mutation and proof reports. Non-done responses retain verified outputs and state the unresolved condition."
}
