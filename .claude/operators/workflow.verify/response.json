{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow.verify response",
  "$ref": "works:response",
  "description": "A done response contains one portfolio report whose peer set, exact goals, owned scopes, original goal evidence and delivered repository heads match the frozen snapshot.",
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "done"}}, "required": ["status"]},
      "then": {"properties": {
        "outputs": {"contains": {"properties": {"id": {"const": "workflow-verification-report"}, "type": {"const": "file"}, "file": {"properties": {"mediaType": {"const": "application/json"}}}}, "required": ["id", "type", "file"]}},
        "observations": {"not": {"contains": {"properties": {"result": {"const": "failed"}}, "required": ["result"]}}}
      }}
    }
  ]
}
