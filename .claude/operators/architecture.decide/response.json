{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "architecture.decide response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [{
    "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] },
    "then": { "properties": { "outputs": { "allOf": [
      { "contains": { "properties": { "id": { "const": "architecture-decision" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "current-state" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "stack-model" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "independent-critique" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } }
    ] }, "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } } } }
  }],
  "description": "A done response contains the observed current state, selected stack model, decision receipt and answered independent critique. A blocked response publishes no decision."
}
