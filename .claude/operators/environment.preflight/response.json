{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "environment.preflight response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [{ "if": { "properties": { "status": { "enum": ["done", "blocked", "mismatch"] } }, "required": ["status"] }, "then": { "properties": { "outputs": { "allOf": [
    { "contains": { "properties": { "id": { "const": "environment-readiness" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
    { "contains": { "properties": { "id": { "const": "readiness-report" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } }
  ] } } } }],
  "description": "Done requires no wall. Blocked and mismatch responses still contain the complete readiness report so the caller receives all owner actions at once."
}
