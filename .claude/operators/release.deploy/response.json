{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"release.deploy response","$ref":"works:response",
  "description":"A done response names the exact active digest, target revisions, authorization, branch taken and bounded observation series. A rollback result names the restored predecessor and is never described as a successful new deployment.",
  "allOf":[{"if":{"properties":{"status":{"const":"done"}},"required":["status"]},"then":{"properties":{"outputs":{"allOf":[
    {"contains":{"properties":{"id":{"const":"release-deployment"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}},
    {"contains":{"properties":{"id":{"const":"deployment-probes"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}}
  ]},"observations":{"not":{"contains":{"properties":{"result":{"const":"failed"}},"required":["result"]}}}}}}]
}
