{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.starci/bin/starci\" guard seat-tools" }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.starci/bin/starci\" guard command", "timeout": 30 }
        ]
      }
    ]
  }
}
