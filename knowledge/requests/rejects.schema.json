{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v1/requests/rejects.schema.json",
  "title": "Rejected frontend design source attempts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rejects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "rejects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requestId", "rejectedOn", "reason", "sourcePaths", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "requestId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "rejectedOn": {"type": "string", "format": "date"},
          "reason": {"type": "string", "minLength": 8},
          "sourcePaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
