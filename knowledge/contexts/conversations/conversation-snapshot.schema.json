{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v1/contexts/conversations/conversation-snapshot.schema.json",
  "title": "Conversation provenance snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "conversationId", "provider", "surface", "recordedAt", "messageCount", "transcript", "decisions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "conversationId": {"$ref": "#/$defs/slug"},
    "provider": {"enum": ["openai", "anthropic", "other"]},
    "surface": {"enum": ["chatgpt", "codex", "openai-api", "claude", "claude-code", "other"]},
    "externalThreadId": {"type": "string", "minLength": 1},
    "previousHash": {"$ref": "#/$defs/hash"},
    "recordedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "messageCount": {"type": "integer", "minimum": 0},
    "redactedSummary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "transcript": {"$ref": "#/$defs/transcript"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transcript": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "providerThreadId"],
          "properties": {
            "mode": {"const": "provider"},
            "providerThreadId": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ciphertextRef", "digest"],
          "properties": {
            "mode": {"const": "encrypted-external"},
            "ciphertextRef": {"type": "string", "pattern": "^(?:s3|r2)://[^?]+$"},
            "digest": {"$ref": "#/$defs/hash"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "digest"],
          "properties": {
            "mode": {"const": "cache-only"},
            "digest": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "identity", "artifactHash", "messageIds", "reason"],
      "properties": {
        "role": {"enum": ["fe", "be", "cross-role"]},
        "kind": {"enum": ["layout", "block", "capability", "operation", "contract", "applied"]},
        "identity": {"type": "string", "minLength": 1},
        "artifactHash": {"$ref": "#/$defs/hash"},
        "messageIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 12, "maxLength": 1000}
      }
    }
  }
}
