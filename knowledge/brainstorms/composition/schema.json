{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v5/knowledge/brainstorms/composition/schema.json",
  "title": "Design baseline four-lock record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "scope", "references", "owner", "invariant", "proof", "preserve", "allowedDeltas"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"$ref": "#/$defs/slug"},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["kind", "routes"],
      "properties": {"kind": {"enum": ["page", "flow"]}, "routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}},
    "owner": {"$ref": "#/$defs/owner"},
    "invariant": {"type": "object", "additionalProperties": false, "required": ["statement", "kind"], "properties": {"statement": {"type": "string", "minLength": 16}, "kind": {"enum": ["local", "page", "flow", "shared"]}}},
    "proof": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proof"}},
    "preserve": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "allowedDeltas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "rect": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "route", "state", "viewport"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "kind": {"enum": ["screenshot", "legacy", "current-source"]}, "route": {"type": "string", "minLength": 1}, "state": {"$ref": "#/$defs/slug"}, "viewport": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}}}
    },
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["id", "directChildren", "annotation", "childBounds"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "directChildren": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "annotation": {"$ref": "#/$defs/rect"},
        "childBounds": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/$defs/rect"}}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["referenceId", "fullViewport", "targetRegion"],
      "properties": {"referenceId": {"$ref": "#/$defs/slug"}, "fullViewport": {"const": true}, "targetRegion": {"const": true}}
    }
  }
}
