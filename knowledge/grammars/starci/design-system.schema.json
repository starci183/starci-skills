{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/schema/grammars/starci/design-system.schema.json",
  "title": "StarCi MASTER visual system",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grammar", "systemId", "axes", "roles", "spacingRungs", "componentLanguage", "antiPatterns", "legacyPolicy", "profileOverrides"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "grammar": {"const": "starci"},
    "systemId": {"const": "starci-master"},
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast", "density", "shape", "depth", "motion"],
      "properties": {
        "contrast": {"enum": ["soft", "balanced", "strong"]},
        "density": {"enum": ["compact", "balanced", "spacious"]},
        "shape": {"enum": ["square", "soft", "rounded"]},
        "depth": {"enum": ["flat", "layered", "floating"]},
        "motion": {"enum": ["still", "measured", "expressive"]}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ground", "surface", "content", "mutedContent", "separator", "display", "body", "label", "radius", "elevation", "duration", "easing"],
      "properties": {
        "ground": {"type": "string"}, "surface": {"type": "string"}, "content": {"type": "string"},
        "mutedContent": {"type": "string"}, "separator": {"type": "string"}, "display": {"type": "string"},
        "body": {"type": "string"}, "label": {"type": "string"}, "radius": {"type": "string"},
        "elevation": {"type": "string"}, "duration": {"type": "string"}, "easing": {"type": "string"}
      }
    },
    "spacingRungs": {"type": "array", "const": [1, 2, 3, 4, 6, 8]},
    "componentLanguage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
    "antiPatterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 12}},
    "legacyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precedence", "preserveOutsideTarget", "pageOverrideMode"],
      "properties": {
        "precedence": {"const": "legacy-baseline-before-master"},
        "preserveOutsideTarget": {"const": true},
        "pageOverrideMode": {"const": "deviations-only"}
      }
    },
    "profileOverrides": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accent", "deviations"],
        "properties": {
          "accent": {"type": "string", "pattern": "^--[a-z0-9-]+$"},
          "deviations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 12}}
        }
      }
    }
  }
}
