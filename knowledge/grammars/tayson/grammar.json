{
  "$schema": "./grammar.schema.json",
  "schemaVersion": 1,
  "grammar": "tayson",
  "grammarId": "tayson-ui",
  "version": 1,
  "factCatalog": "./facts.json",
  "evidenceCatalog": "./capsules.json",
  "rulingCatalog": "./rulings.json",
  "designSystem": "./design-system.json",
  "rules": [
    {
      "id": "tayson-product-uses-one-brand-theme",
      "slot": "product-visual-theme",
      "priority": 500,
      "when": {"all": ["surface-tayson-product"], "any": [], "none": []},
      "emit": {"outcome": "tayson-brand-theme", "obligations": ["tayson-green-accent", "warm-ivory-ground", "exact-shared-brand-tokens", "same-brand-public-and-crm", "no-starci-product-token-namespace"]},
      "capsuleRefs": ["tayson-brand-theme"]
    },
    {
      "id": "public-site-uses-editorial-shell",
      "slot": "surface-shell",
      "priority": 400,
      "when": {"all": ["surface-public-site"], "any": [], "none": ["surface-authenticated-crm"]},
      "emit": {"outcome": "public-site-shell", "obligations": ["public-identity-header", "responsive-public-navigation", "editorial-reading-ground", "public-site-footer", "no-authenticated-app-chrome"]},
      "capsuleRefs": ["public-site-shell"]
    },
    {
      "id": "published-information-uses-document-owner",
      "slot": "public-document-owner",
      "priority": 400,
      "when": {"all": ["surface-public-site", "surface-public-information", "content-published-document"], "any": [], "none": ["content-unpublished"]},
      "emit": {"outcome": "public-information-document", "obligations": ["editorial-masthead", "addressable-section-outline", "semantic-long-document", "loading-error-unavailable-states", "public-continuation"]},
      "capsuleRefs": ["public-information-document"]
    },
    {
      "id": "authenticated-crm-uses-operational-shell",
      "slot": "surface-shell",
      "priority": 450,
      "when": {"all": ["surface-authenticated-crm"], "any": [], "none": ["surface-public-site"]},
      "emit": {"outcome": "crm-operational-shell", "obligations": ["authenticated-global-chrome", "role-aware-navigation", "dense-sans-interface", "responsive-destination-replacement", "public-editorial-anatomy-absent"]},
      "capsuleRefs": ["crm-operational-shell"]
    },
    {
      "id": "crm-collection-is-permission-aware",
      "slot": "crm-content-owner",
      "priority": 400,
      "when": {"all": ["surface-authenticated-crm", "operation-collection"], "any": [], "none": ["operation-form"]},
      "emit": {"outcome": "crm-permission-collection", "obligations": ["loading-empty-ready-error", "permission-denied-state", "role-allowed-actions-only", "filterable-operational-density", "keyboard-operable-collection"]},
      "capsuleRefs": ["crm-permission-collection"]
    },
    {
      "id": "crm-form-is-permission-aware",
      "slot": "crm-content-owner",
      "priority": 400,
      "when": {"all": ["surface-authenticated-crm", "operation-form"], "any": [], "none": ["operation-collection"]},
      "emit": {"outcome": "crm-operational-form", "obligations": ["ready-disabled-submitting-success-error", "permission-aware-fields-actions", "validation-near-fields", "one-primary-save-action", "no-public-marketing-copy"]},
      "capsuleRefs": ["crm-operational-form"]
    }
  ]
}
