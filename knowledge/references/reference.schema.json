{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/knowledge/references/reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "role", "repository", "commit", "sourcePath", "immutableRef", "authority", "resolution"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 7 },
    "id": { "enum": ["starci-academy-fe", "starci-academy-be"] },
    "role": { "enum": ["fe", "be"] },
    "repository": { "type": "string", "pattern": "^https://github\\.com/" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourcePath": { "const": "src" },
    "immutableRef": { "type": "string", "pattern": "^git\\+https://github\\.com/.+@[0-9a-f]{40}:src$" },
    "authority": { "const": "precedent-only" },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "root", "required"],
      "properties": {
        "method": { "const": "default-search" },
        "root": { "const": "src" },
        "required": { "const": true }
      }
    }
  }
}
