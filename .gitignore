dist/
/.dist*/

# Local tools and scratch are not distributable skill sources.
/.venv/

# Runtime state: the installed product writes .starciwork/runtime.sqlite and
# ledger artifacts into the CONSUMER repo — consumers must ignore .starciwork/
# (the installer prints these lines). This repo ignores its own scratch too.
/.starciwork/
/.starci-wk-spec-*/

# Per-project config is seeded from config.example.yaml and stays untracked.
/config.yaml
/config.json

# Never accidentally track personal settings.
resources/settings.json
settings.local.json

# Dependencies and process-local generated state
node_modules/
__pycache__/
/scheduled_tasks.lock

# Generated build output under the examples and the packages tree: re-run, never committed.
examples/**/coverage/
packages/**/storybook-static/

# Generated roots (ruleParams.runtime.generated: scripts/hfs/sync-runtime.mjs writes the packages' runtime copies,
# scripts/i18n/generate-ui-catalog.mjs the ui catalog): never tracked, never edited; regenerated by pack, the packages'
# own tests, the repo's check and its specs.
packages/hfs/runtime/
packages/eslint/be/runtime/
packages/eslint/fe/runtime/
ui/src/i18n/generated/

# Scratch space for throwaway experiments: use it freely, it is never committed.
/ex-testing/
/.secrets/
/ui/fixtures/seed/
