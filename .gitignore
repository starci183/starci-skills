# Machine-local, never shared. This tree is read by several sources on several machines, so a value
# that is true on one of them does not belong in it — the WORKSPACE-6 failure, one level up.
launch.json
settings.local.json
settings.json

# Runtime state. A rules tree that stores the work also stores the mess, and a tree with session
# debris in it stops reading as authority — WORKTREE-3.
/worktrees/
/sessions/
/cache/
_canon_tmp/
scheduled_tasks.lock
**/__pycache__/
*.pyc

# Generated by the docs site
docs/node_modules/
docs/.next/
docs/out/
docs/content/

# Universal Vite design-review runtime dependencies and rebuildable bundle
publication/design-review-preview/app/node_modules/
publication/design-review-preview/app/dist/
