dist/
/.dist*/

# Local tools and scratch are not distributable skill sources.
/.venv/
/mcp/
/runtime/

# Actual local Git checkouts are not product completion storage.
worktrees/

# Runtime state: the installed product writes .starciwork/runtime.sqlite and
# ledger artifacts into the CONSUMER repo — consumers must ignore .starciwork/
# (the installer prints these lines). This repo ignores its own scratch too.
/.starciwork/
/.starci-wk-spec-*/

# Per-project config is seeded from config.example.yaml and stays untracked.
/config.yaml
/config.json

# Preserve this ignore after retirement: never accidentally track old personal settings.
resources/settings.json
settings.local.json

# Dependencies and process-local generated state
node_modules/
__pycache__/
/scheduled_tasks.lock

# ex-testing/ is deleted in the cut; keep the ignore so resurrected scratch
# never gets committed.
/ex-testing/
