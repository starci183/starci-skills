dist/
/.dist*/

# Local tools and scratch are not distributable skill sources.
/.venv/

# Operational state and disposable runtime specs stay untracked.
/.starciwork/
/.starci-wk-spec-*/

# Curated sample snapshots exclude process-local sidecars and materialized output.
/examples/.runtimes/*/runtime.sqlite-wal
/examples/.runtimes/*/runtime.sqlite-shm
/examples/.runtimes/*/runtime.sqlite-journal
/examples/.runtimes/*/artifacts-views/
/examples/.runtimes/*/cache/
/examples/.runtimes/*/views/
/examples/.runtimes/*/captures/
/examples/.runtimes/*/logs/
/examples/.runtimes/*/traces/

# Host-local preferences and credentials stay untracked.
/config.yaml
/config.json
/secret.env

# Never accidentally track personal settings.
resources/settings.json
settings.local.json

# Dependencies and process-local generated state
node_modules/
__pycache__/
/scheduled_tasks.lock

# Generated build output under the examples and the packages tree: re-run, never committed.
examples/**/coverage/
packages/**/storybook-static/

# Generated roots (ruleParams.runtime.generated: scripts/hfs/sync-runtime.mjs writes the packages' runtime copies,
# scripts/hfs/sync-runtime.mjs the ui catalog): never tracked, never edited; regenerated by pack, the packages'
# own tests, the repo's check and its specs.
packages/hfs/runtime/
packages/eslint/be/runtime/
packages/eslint/fe/runtime/
ui/src/i18n/generated/

# Scratch space for throwaway experiments: use it freely, it is never committed.
/ex-testing/
/.secrets/
/ui/fixtures/seed/
