{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v5/compilers/principles/cases.schema.json",
  "title": "Cross-principle owner cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "module", "owner", "directChildren", "invariant", "expectedSituation", "expectedClass", "rejects"],
      "properties": {
        "caseId": {"$ref": "#/$defs/slug"}, "module": {"$ref": "#/$defs/slug"}, "owner": {"$ref": "#/$defs/slug"},
        "directChildren": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "invariant": {"type": "string", "minLength": 16}, "expectedSituation": {"type": "string", "pattern": "^[A-Z-]+-[0-9]+$"},
        "expectedClass": {"type": "string", "minLength": 1}, "rejects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
        "maxStatusChips": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
