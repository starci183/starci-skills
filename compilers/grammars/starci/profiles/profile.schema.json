{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/schema/grammars/starci/profiles/profile.schema.json",
  "title": "StarCi product owner profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grammar", "profileId", "owners"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "grammar": { "const": "starci" },
    "profileId": { "$ref": "#/$defs/Id" },
    "owners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/Owner" }
    }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Concern": {
      "enum": [
        "alignment", "colour", "contrast", "density", "distribution", "divider", "elevation",
        "flow", "focus-order", "gap", "grid", "margin", "motion", "optical", "overflow",
        "padding", "position", "radius", "ratio", "responsive", "size", "state",
        "surface-in-surface", "target-size", "text-expansion", "typography"
      ]
    },
    "Owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "component", "primitive", "principleMode", "principleConcerns", "capsuleRefs"],
      "properties": {
        "decision": { "enum": ["reuse", "extend", "new-required", "not-applicable"] },
        "component": { "type": "string", "minLength": 2 },
        "primitive": { "type": "string", "minLength": 2 },
        "principleMode": { "enum": ["inherit", "delta", "none"] },
        "principleConcerns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Concern" } },
        "capsuleRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "reason": { "type": "string", "minLength": 12 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "reuse" } } },
          "then": {
            "properties": {
              "principleMode": { "const": "inherit" },
              "principleConcerns": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "enum": ["extend", "new-required"] } } },
          "then": {
            "properties": {
              "principleMode": { "const": "delta" },
              "principleConcerns": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "not-applicable" } } },
          "then": {
            "properties": {
              "principleMode": { "const": "none" },
              "principleConcerns": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
