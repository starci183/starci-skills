# Literals that look like codes to scripts/checks/failure-codes.mjs but are not: constants, env names, schema ids, event kinds, labels.
# One per line: <literal><TAB><why it is not a code>. Anything a checker or verb can emit as a reason belongs in modules/kernel/failure-codes.yaml instead.
APP_FILTER	NestJS framework token name the checker looks for, not a code
APP_GUARD	NestJS framework token name the checker looks for, not a code
ARTIFACT_ROOT_ENV	environment variable name
ASSET_PROMPT_ATTR	HTML attribute name constant
ASSET_SHA_ATTR	HTML attribute name constant
ASSET_SLOT_ATTR	HTML attribute name constant
BAND_TOKEN_NAMES	export name of a token table in the grammar knowledge
BASE_VIEW_ENV	environment variable name
BLOCK_FOLDED	YAML scalar type name, not an error code
BLOCK_LITERAL	YAML scalar type name, not an error code
CHILD_ENV	env var name STARCI_API_CHILD constant, not an emitted code
COMMON_GRAMMAR_COMPONENTS	name of a registry constant in the grammar package, not a code
COMPONENT_ATTR	attribute-name constant in draw-dna, not a code
ENGINE_SCHEMA	constant naming the engine protocol marker (starci/engine@1), not an emitted code
FALLBACK_SCRIPT	constant naming the package.json script lint:check used as a push-gate fallback
FAN_OUT_ORDER	constant naming a model order key (scaffold), not a code
GLOBAL_ANALYSIS_TOKEN	SonarQube token type label passed when minting a token, not a failure code
GRAMMAR_PACKAGE	constant holding the @starci/grammar package name for tsconfig paths
HOST_RESOURCES_ENV	env var name constant (STARCI_HOST_RESOURCES_JSON), not a code
IMAGEGEN_ASSERTION	assertion id label constant (imagegen-provenance), not an emitted code (its finding is DRAW_ASSET_NOT_TOKEN_RENDERED)
IO_DRIFT	only named in a comment in kinds.yaml; no emit site found in scripts/engine/modules
LEADER_NAME	constant naming the reconciler leader row, not a code
LEDGER_SCHEMA	schema id constant, not a code
LEDGER_VERSION	schema version constant, not a code
LOCAL_ROOT_ENV	constant naming the STARCI_LOCAL_ROOT env var
LOG_TRUNCATED	typed log row kind (log.truncated), not a failure code
MACHINE_SCHEMA	schema id constant, not a code
MACHINE_VERSION	schema version constant, not a code
PART_ATTR	name of the data-grammar-part HTML attribute constant
PROJECTS_ROOT_ENV	constant naming the STARCI_PROJECTS_ROOT env var
PROJECT_ANALYSIS_TOKEN	SonarQube token type label passed when minting a token
PROPOSAL_ATTR	name of the data-grammar-proposal HTML attribute constant
PUBLIC_CONTRACT_RULE_ID	JS constant name; the emitted rule id is BE_PUBLIC_CONTRACT_FORM
RATE_LIMITED_EVENT	event-kind constant that routes a re-read of quota pools, not a failure code
READONLY_BOUNDARY_RULE_ID	JS constant name; the emitted rule id is BE_READONLY_BOUNDARY
RECORDINGS_ROOT_ENV	constant naming the STARCI_UAT_RECORDINGS_ROOT env var
REDLINE_ATTR	name of the data-draw-redline HTML attribute constant
SKILL_ROOT	constant naming the runtime root directory (an array element [SKILL_ROOT], not a code)
SOURCE_LAYOUT_RULE_ID	constant naming a lint rule id in architecture coverage, not an emitted code
SOURCE_NAME_RULE_ID	constant naming a lint rule id in architecture coverage, not an emitted code
STACK_ROOT	constant, the .starcistacks directory name
STARCI_API_CHILD	env var name marking api child processes
STARCI_ENGINE_START_REASON	env var name
STARCI_HOST_RESOURCES_JSON	env var name (resource probe override)
STARCI_HOST_WAIT_MS	env var name (timing setting)
STARCI_KERNEL_DEATH_SETTLE_MS	env var name (timing setting)
STARCI_LOCAL_ROOT	env var name (overrides the whole %LOCALAPPDATA%/StarCi state base)
STARCI_PROJECTS_ROOT	env var name
STARCI_RELOADED_AT	env var name
STARCI_RELOAD_HANDOVER_FROM	env var name
STARCI_SCOPED_LINT_BASE_VIEW	env var name
STARCI_TEST_MACHINE_FILE	env var name for specs
STARCI_UAT_RECORDINGS_ROOT	env var name
START_REASON_ENV	JS constant naming an env var
STRICT_MODE	info label on a strict schema validation count line, not a failure
TEST_REGISTRY_ENV	JS constant naming an env var
UNPROVEN_FRAMEWORK	nhan hang so noi bo "(unproven framework identity)" cua bo kiem kien truc, khong phai ma phat ra
WHY_ATTR	ten thuoc tinh HTML data-why (hang so), khong phai ma loi
artifacts-indexed	ten su kien (event kind) ghi nhan da lap chi muc artifact, khong phai loi
ask-answered	ten su kien (event kind) chu so huu da tra loi cau hoi, khong phai loi
brief-gap	nhan nhom nguyen nhan (cause class) cua bai hoc Supervisor, khong phai ma phat ra
business-decision	ten mot loai cau hoi ask (ASK_KINDS), khong phai ma loi
canon-wire	nhan ly do (reason) khi tao job noi tiep, khong phai loi
checks-recorded	ten su kien (event kind) ghi nhan da luu ket qua check, khong phai loi
contract-churn	nhan nhom nguyen nhan (cause class) cua bai hoc Supervisor, khong phai ma phat ra
crash-loop	nhan lop thong bao khan (urgent class) cua notifier, khong phai ma refusal
deferred-settle	wait-kind label of a queued job, not a failure code
define-goal	workflow creation reason label, not a failure
directory-gone	GC item label (gc_items.reason) for a registry row whose worktree directory is already gone, not a failure
dispatch-reconciled	ledger event kind name, not a failure code
dispatch-rejected	ledger event kind name, not a failure code
draw-review	ask class label excluded from auto-accept, not a code
duplicate-session	supervisor terminal cleanup plan label, not a failure code
finished-early	draw-loop stop reason (benign), not a failure
first-run	schedule claim reason (benign due-state), not a failure
follow-up	peer message kind label, not a code
gate-defect	cause class label for supervisor lessons, not a code
goal-defined	ledger event kind name marking progress, not a failure
heads-up	peer message kind label
held-by-live-job	benign cleanup keep-reason label
impact-check	next-action kind label
incident-auto-resolved	ledger event kind, not a failure
incident-raised	ledger event kind
incident-resolved	ledger event kind
irreversible-confirmation	ask kind label
job-dropped	ledger event kind
job-enqueued	ledger event kind
land-scratch	worktree registry kind (machine.sqlite worktrees.kind, scripts/lib/worktrees.mjs WORKTREE_KINDS), not a code
layout-tree	foundation kind label
live-unbound-session	seat adoption plan label
live-worker-reconciled	ledger event kind
no-open-circuit	benign no-op recover label
no-quota-probe	benign probe skip label
no-starci-marker	benign terminal keep-reason label
not-a-file	benign archive skip label
not-starci	benign cleanup keep-reason label
nothing-open	benign doorbell no-op label
one-off	note class label
op-dispatched	ledger event kind
op-settled	ledger event kind
op-worker-nudged	ledger event kind
owner-restart	start reason label in PLANNED_START_REASONS, not a failure
phase-transition	ledger event kind for progress tracking, not a failure code
plan-derived	ledger event kind for progress tracking, not a failure code
planned-restart	start reason label in PLANNED_START_REASONS, not a failure
policy-shared	informational isolation-plan reason (brief opts out of worktree), not a failure
product-direction	note class label in draw-feedback, not a failure code
push-scratch	worktree registry kind (machine.sqlite worktrees.kind, scripts/lib/worktrees.mjs WORKTREE_KINDS), not a code
queued-ready	wait-kind metric label in supervisor op-metrics, not a failure code
rate-limited	doorbell ring-planning reason (skipped ring), not a failure
reload-handover	planned engine exit_reason label, not a failure
report-consumed	ledger event kind, not a failure code
report-filed	ledger event kind, not a failure code
retry-cap	wait-kind label (WAIT_KINDS), not a failure code
root-verify	next-action kind label
run-created	ledger event kind
runtime-flow	lesson cause-class label
runtime-repo	product-isolation skip reason (not a failure)
self-reload	planned-start reason label
sessions-db-owned	session archive skip reason (informational)
shared-system	owner ask class label
starci-agent-session	terminal dedupe reason (close decision), not a failure
supervisor-gate	next-action kind label
supervisor-staging	worktree registry kind (machine.sqlite worktrees.kind, scripts/lib/worktrees.mjs WORKTREE_KINDS), not a code
test-env-unrooted	session archive skip reason (informational)
time-budget	GC item label: a bounded worktree GC pass stopped at its time budget and resumes next pass, not a failure
typed-dependent	staleness relation label
work-owner-only	product-isolation skip reason (not a failure)
workflow-ended	incident close reason (success)
workflow-finished	phase-transition reason (success)
worktree-flag	product-isolation skip reason (operator flag)
