{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/product-proof/input.schema.json",
  "title": "FE Product Proof operator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "fe.product-proof.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "proof.run"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "$ref": "#/$defs/factList"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedFlowHash",
        "approvedLayoutHash",
        "exactSourceBoundary",
        "changeSetRef",
        "changeSetHash",
        "seedEvidenceRef",
        "seedEvidenceHash",
        "unitEvidenceRef",
        "unitEvidenceHash",
        "e2eEvidenceRef",
        "e2eEvidenceHash",
        "uiEvidenceRef",
        "uiEvidenceHash",
        "gates",
        "browserScenarios",
        "proofArtifactRoot"
      ],
      "properties": {
        "selectedFlowHash": {
          "type": "string",
          "minLength": 1
        },
        "approvedLayoutHash": {
          "type": "string",
          "minLength": 1
        },
        "exactSourceBoundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "changeSetRef": {
          "type": "string",
          "minLength": 1
        },
        "changeSetHash": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "unitEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "unitEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "e2eEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "e2eEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "uiEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "uiEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "browserScenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/browserScenario"
          }
        },
        "proofArtifactRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "factList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "commandRef",
        "required"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "commandRef": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        }
      }
    },
    "browserScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "journeyPageIds",
        "stateIds",
        "viewportRefs",
        "interactionRef",
        "assertionRefs"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "journeyPageIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "viewportRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "interactionRef": {
          "type": "string",
          "minLength": 1
        },
        "assertionRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "kind",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "checkId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "gate",
            "browser"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
