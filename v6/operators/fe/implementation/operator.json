{
  "schemaVersion": 6,
  "id": "fe/implementation",
  "domain": "fe",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "fe.implementation-boundaries"
  ],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "requests.review",
      "status": "ready",
      "noneFacts": [
        "create-required",
        "grammar-gap"
      ]
    },
    {
      "stage": "request.result",
      "status": "ready",
      "allFacts": [
        "create-required",
        "requests-emitted"
      ],
      "noneFacts": [
        "grammar-gap"
      ]
    },
    {
      "stage": "code.repair",
      "status": "repair",
      "allFacts": [
        "in-boundary-repair"
      ],
      "noneFacts": [
        "boundary-drift",
        "grammar-gap"
      ]
    }
  ],
  "emits": [
    {
      "when": "source writes and focused static checks succeed",
      "stage": "seed.materialize",
      "status": "ready",
      "factsAdd": [
        "source-written"
      ]
    },
    {
      "when": "an implementation stop condition is reached",
      "stage": "code.result",
      "status": "blocked",
      "factsAdd": [
        "implementation-blocked"
      ]
    }
  ],
  "sideEffects": [
    "write approved product source files",
    "run focused formatting, type and static checks"
  ],
  "stopConditions": [
    "Grammar gap",
    "approved layout hash or source boundary mismatch",
    "write outside exact source boundary",
    "undeclared lower-tier extension",
    "closed contract invariant change",
    "local reconstruction of package-owned Grammar capability",
    "non-color structural change in global.css",
    "failed static check",
    "boundary drift"
  ]
}
