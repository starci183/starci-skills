{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/state/input.schema.json",
  "title": "FE state operator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "stage": {
      "const": "state.generate"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "type": "array",
      "contains": {
        "const": "page-model-ready"
      },
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageModelRef",
        "pageModelHash",
        "businessEvidenceReceiptRef",
        "blockRefs"
      ],
      "properties": {
        "pageModelRef": {
          "$ref": "#/$defs/ref"
        },
        "pageModelHash": {
          "$ref": "#/$defs/hash"
        },
        "businessEvidenceReceiptRef": {
          "$ref": "#/$defs/ref"
        },
        "blockRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sensitivity": {
      "enum": [
        "money",
        "access",
        "entitlement",
        "data-loss",
        "legal",
        "terminal-outcome"
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "blockRef",
        "meaning",
        "trigger",
        "provenance",
        "evidenceRefs",
        "derivedFromRefs",
        "availableActions",
        "transitionTargets",
        "neutralPresentation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "blockRef": {
          "$ref": "#/$defs/ref"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "business",
            "derived-block"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "derivedFromRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "availableActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "transitionTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "neutralPresentation": {
          "enum": [
            "default",
            "informative",
            "affirmative",
            "caution",
            "critical",
            "pending",
            "disabled"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "business"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "derived-block"
              }
            }
          },
          "then": {
            "properties": {
              "derivedFromRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "blockRef",
        "question",
        "sensitivity",
        "blocking",
        "requiredEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "blockRef": {
          "$ref": "#/$defs/ref"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity": {
          "oneOf": [
            {
              "$ref": "#/$defs/sensitivity"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "requiredEvidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sensitivity": {
                "$ref": "#/$defs/sensitivity"
              }
            }
          },
          "then": {
            "properties": {
              "blocking": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
