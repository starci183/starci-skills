      "stage": "architecture.decision.frame",
      "status": "ready",
      "factsAdd": [
        "business-head-ready",
        "architecture-analysis-required"
      ],
      "factsRemove": []
    },
    {
      "stage": "architecture.source",
      "status": "ready",
      "factsAdd": [
        "business-head-ready"
      ],
      "factsRemove": []
    },
    {
      "stage": "business.blocked",
      "status": "blocked",
      "factsAdd": [
        "business-publication-blocked"
      ],
      "factsRemove": []
    }
  ],
  "sideEffects": [
    "write and commit only the routed business worktree"
  ],
  "stopConditions": [
    "required evidence is missing or stale",
    "the result would cross the declared boundary"
  ]
}
