{
  "schemaVersion": 6,
  "id": "business/publish",
  "domain": "business",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "business.authority-lifecycle"
  ],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "business.publish",
      "status": "ready",
      "allFacts": [
        "business-model-ready"
      ],
      "noneFacts": []
    }
  ],
  "emits": [
