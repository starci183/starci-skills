{
  "$schema": "./graph.schema.json",
  "schemaVersion": 6,
  "id": "fe-design-layout",
  "operationRoot": "../../operations",
  "nodes": {
    "preflight": "fe/preflight/operation.json",
    "customer-journey": "fe/customer-journey/operation.json",
    "page-model": "fe/page-model/operation.json",
    "state": "fe/state/operation.json",
    "layout": "fe/layout/operation.json",
    "grammar-convergence": "fe/grammar-convergence/operation.json",
    "source-fit": "fe/source-fit/operation.json",
    "principle-compile": "fe/principle-compile/operation.json",
    "request-emission": "fe/request-emission/operation.json",
    "implementation": "fe/implementation/operation.json",
    "product-seed": "fe/product-seed/operation.json",
    "unit-test": "test/unit/operation.json",
    "e2e-test": "test/e2e/operation.json",
    "ui-test": "test/ui/operation.json",
    "product-proof": "fe/product-proof/operation.json"
  },
  "routes": [
    { "when": { "stage": "request.received", "status": "ready" }, "target": { "kind": "operation", "ref": "preflight" } },
    { "when": { "stage": "flow.generate", "status": "ready", "allFacts": ["preflight-complete"] }, "target": { "kind": "operation", "ref": "customer-journey" } },
    { "when": { "stage": "flow.review", "status": "pending" }, "target": { "kind": "wait", "ref": "flow-approval" } },
    { "when": { "stage": "flow.review", "status": "approved", "allFacts": ["flow-approved"] }, "target": { "kind": "operation", "ref": "page-model" } },
    { "when": { "stage": "flow.review", "status": "rejected", "allFacts": ["flow-feedback-recorded"], "noneFacts": ["flow-approved"] }, "target": { "kind": "operation", "ref": "customer-journey" } },
    { "when": { "stage": "state.generate", "status": "ready", "allFacts": ["page-model-ready"] }, "target": { "kind": "operation", "ref": "state" } },
    { "when": { "stage": "state.result", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "layout.generate", "status": "ready", "allFacts": ["flow-approved", "page-model-ready", "state-model-ready"] }, "target": { "kind": "operation", "ref": "layout" } },
    { "when": { "stage": "layout.review", "status": "pending" }, "target": { "kind": "wait", "ref": "layout-approval" } },
    { "when": { "stage": "layout.review", "status": "approved", "allFacts": ["layout-approved", "grammar-lock-ready", "neutral-facts-ready"] }, "target": { "kind": "operation", "ref": "grammar-convergence" } },
    { "when": { "stage": "layout.review", "status": "rejected", "allFacts": ["layout-feedback-recorded"], "noneFacts": ["layout-approved"] }, "target": { "kind": "operation", "ref": "layout" } },
    { "when": { "stage": "source-fit.resolve", "status": "ready", "allFacts": ["grammar-converged", "source-context-ready"], "noneFacts": ["grammar-business-gate-failed"] }, "target": { "kind": "operation", "ref": "source-fit" } },
    { "when": { "stage": "source-fit.resolve", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "principles.compile", "status": "ready", "allFacts": ["source-fit-ready"] }, "target": { "kind": "operation", "ref": "principle-compile" } },
    { "when": { "stage": "requests.review", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "requests.review", "status": "ready", "allFacts": ["grammar-gap"] }, "target": { "kind": "operation", "ref": "request-emission" } },
    { "when": { "stage": "requests.review", "status": "ready", "allFacts": ["create-required"], "noneFacts": ["grammar-gap"] }, "target": { "kind": "operation", "ref": "request-emission" } },
    { "when": { "stage": "requests.review", "status": "ready", "noneFacts": ["create-required", "grammar-gap"] }, "target": { "kind": "operation", "ref": "implementation" } },
    { "when": { "stage": "request.result", "status": "blocked", "allFacts": ["grammar-gap"] }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "request.result", "status": "ready", "allFacts": ["create-required", "requests-emitted"], "noneFacts": ["grammar-gap"] }, "target": { "kind": "operation", "ref": "implementation" } },
    { "when": { "stage": "code.repair", "status": "repair", "allFacts": ["in-boundary-repair"], "noneFacts": ["boundary-drift", "grammar-gap"] }, "target": { "kind": "operation", "ref": "implementation" } },
    { "when": { "stage": "code.result", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "seed.materialize", "status": "ready", "allFacts": ["source-written"] }, "target": { "kind": "operation", "ref": "product-seed" } },
    { "when": { "stage": "seed.result", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "test.unit", "status": "ready", "allFacts": ["seed-evidence"] }, "target": { "kind": "operation", "ref": "unit-test" } },
    { "when": { "stage": "test.e2e", "status": "ready", "allFacts": ["unit-pass", "unit-evidence", "seed-evidence"] }, "target": { "kind": "operation", "ref": "e2e-test" } },
    { "when": { "stage": "test.ui", "status": "ready", "allFacts": ["unit-pass", "e2e-pass", "e2e-evidence", "seed-evidence"] }, "target": { "kind": "operation", "ref": "ui-test" } },
    { "when": { "stage": "test.review", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } },
    { "when": { "stage": "proof.run", "status": "ready", "allFacts": ["seed-evidence", "unit-pass", "unit-evidence", "e2e-pass", "e2e-evidence", "ui-pass", "ui-evidence"] }, "target": { "kind": "operation", "ref": "product-proof" } },
    { "when": { "stage": "proof.review", "status": "complete", "allFacts": ["proof-pass"] }, "target": { "kind": "terminal", "ref": "complete" } },
    { "when": { "stage": "proof.review", "status": "blocked" }, "target": { "kind": "terminal", "ref": "blocked" } }
  ]
}
