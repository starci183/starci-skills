{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/fe/implementation/output.schema.json",
  "title": "FE implementation operation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "fe.implementation.output"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "seed.materialize",
        "code.result"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "facts": {
      "$ref": "#/$defs/factList"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeSetRef",
        "changeSetHash",
        "changedFiles",
        "consumedContractRefs",
        "usedLowerTierExtensions",
        "staticChecks",
        "stopReasons"
      ],
      "properties": {
        "changeSetRef": {
          "type": "string",
          "minLength": 1
        },
        "changeSetHash": {
          "type": "string",
          "minLength": 1
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consumedContractRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "usedLowerTierExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lowerTierExtension"
          }
        },
        "staticChecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkReceipt"
          }
        },
        "stopReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "seed.materialize"
          },
          "payload": {
            "properties": {
              "changedFiles": {
                "minItems": 1
              },
              "stopReasons": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "code.result"
          },
          "payload": {
            "properties": {
              "stopReasons": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "factList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lowerTierExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "tier",
        "extensionAxis",
        "effectiveContractRef",
        "requestPath"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "composite",
            "branch",
            "leaf"
          ]
        },
        "extensionAxis": {
          "type": "string",
          "minLength": 1
        },
        "effectiveContractRef": {
          "type": "string",
          "minLength": 1
        },
        "requestPath": {
          "type": "string",
          "pattern": "^\\.claude/requests/[a-z0-9]+(?:-[a-z0-9]+)*\\.request\\.json$"
        }
      }
    },
    "checkReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commandRef",
        "status",
        "evidenceRef"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commandRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
