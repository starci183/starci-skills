{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/fe/implementation/input.schema.json",
  "title": "FE implementation operation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "fe.implementation.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "requests.review",
        "request.result",
        "code.repair"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "repair"
      ]
    },
    "facts": {
      "$ref": "#/$defs/factList"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedLayoutRef",
        "approvedLayoutHash",
        "exactSourceBoundary",
        "sourceFitRef",
        "implementationPlanRef",
        "effectiveContractRefs",
        "permittedLowerTierExtensions",
        "requestPaths",
        "repairEvidenceRefs"
      ],
      "properties": {
        "approvedLayoutRef": {
          "type": "string",
          "minLength": 1
        },
        "approvedLayoutHash": {
          "type": "string",
          "minLength": 1
        },
        "exactSourceBoundary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sourceFitRef": {
          "type": "string",
          "minLength": 1
        },
        "implementationPlanRef": {
          "type": "string",
          "minLength": 1
        },
        "effectiveContractRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "permittedLowerTierExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lowerTierExtension"
          }
        },
        "requestPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.claude/requests/[a-z0-9]+(?:-[a-z0-9]+)*\\.request\\.json$"
          },
          "uniqueItems": true
        },
        "repairEvidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "factList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "lowerTierExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "tier",
        "extensionAxis",
        "effectiveContractRef",
        "requestPath"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "enum": [
            "composite",
            "branch",
            "leaf"
          ]
        },
        "extensionAxis": {
          "type": "string",
          "minLength": 1
        },
        "effectiveContractRef": {
          "type": "string",
          "minLength": 1
        },
        "requestPath": {
          "type": "string",
          "pattern": "^\\.claude/requests/[a-z0-9]+(?:-[a-z0-9]+)*\\.request\\.json$"
        }
      }
    },
    "checkReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commandRef",
        "status",
        "evidenceRef"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "commandRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
