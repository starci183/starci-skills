{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/fe/product-seed/input.schema.json",
  "title": "FE Product Seed operation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "fe.product-seed.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "seed.materialize"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "$ref": "#/$defs/factList"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeSetRef",
        "changeSetHash",
        "businessStateContractRef",
        "requiredStates",
        "seedBoundaryRef",
        "environmentRef"
      ],
      "properties": {
        "changeSetRef": {
          "type": "string",
          "minLength": 1
        },
        "changeSetHash": {
          "type": "string",
          "minLength": 1
        },
        "businessStateContractRef": {
          "type": "string",
          "minLength": 1
        },
        "requiredStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requiredState"
          }
        },
        "seedBoundaryRef": {
          "type": "string",
          "minLength": 1
        },
        "environmentRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "factList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requiredState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "ownerRef",
        "provenance",
        "evidenceRef",
        "materializationIntent",
        "sensitivity"
      ],
      "properties": {
        "stateId": {
          "type": "string",
          "minLength": 1
        },
        "ownerRef": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "business",
            "derived-block"
          ]
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "materializationIntent": {
          "type": "string",
          "minLength": 1
        },
        "sensitivity": {
          "enum": [
            "none",
            "money",
            "access",
            "entitlement",
            "data-loss",
            "legal",
            "terminal-outcome"
          ]
        }
      }
    },
    "stateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateId",
        "ownerRef",
        "setupRef",
        "observableRef",
        "resetRef",
        "evidenceRef",
        "deterministic"
      ],
      "properties": {
        "stateId": {
          "type": "string",
          "minLength": 1
        },
        "ownerRef": {
          "type": "string",
          "minLength": 1
        },
        "setupRef": {
          "type": "string",
          "minLength": 1
        },
        "observableRef": {
          "type": "string",
          "minLength": 1
        },
        "resetRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "deterministic": {
          "const": true
        }
      }
    }
  }
}
