{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/fe/request-emission/input.schema.json",
  "title": "FE request emission operation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "fe.request-emission.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "requests.review"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "$ref": "#/$defs/factList"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestObligations",
        "sourceBoundaryRef",
        "approvedLayoutHash",
        "grammarGapIds"
      ],
      "properties": {
        "requestObligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requestObligation"
          }
        },
        "sourceBoundaryRef": {
          "type": "string",
          "minLength": 1
        },
        "approvedLayoutHash": {
          "type": "string",
          "minLength": 1
        },
        "grammarGapIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "factList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requestObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "kind",
        "targetTier",
        "ownerRef",
        "reason",
        "evidenceRefs",
        "decisionRef"
      ],
      "properties": {
        "stableId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "block-create",
            "lower-tier-extension",
            "grammar-gap"
          ]
        },
        "targetTier": {
          "enum": [
            "block",
            "composite",
            "branch",
            "leaf",
            "grammar"
          ]
        },
        "ownerRef": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "decisionRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requestReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "path",
        "contentHash"
      ],
      "properties": {
        "stableId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^\\.claude/requests/[a-z0-9]+(?:-[a-z0-9]+)*\\.request\\.json$"
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
