{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/fe/preflight/output.schema.json",
  "title": "FE preflight operation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "stage": {
      "const": "flow.generate"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "type": "array",
      "allOf": [
        {
          "contains": {
            "const": "preflight-complete"
          }
        },
        {
          "contains": {
            "const": "source-context-ready"
          }
        },
        {
          "contains": {
            "const": "grammar-lock-ready"
          }
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestReceipt",
        "businessEvidenceReceipt",
        "workspaceReceipt",
        "sourceContextReceipt",
        "grammarLockReceipt",
        "writeRoots",
        "approvalMode"
      ],
      "properties": {
        "requestReceipt": {
          "$ref": "#/$defs/receipt"
        },
        "businessEvidenceReceipt": {
          "$ref": "#/$defs/receipt"
        },
        "workspaceReceipt": {
          "$ref": "#/$defs/receipt"
        },
        "sourceContextReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactRef",
            "hash",
            "effectiveContractHash"
          ],
          "properties": {
            "artifactRef": {
              "$ref": "#/$defs/ref"
            },
            "hash": {
              "$ref": "#/$defs/hash"
            },
            "effectiveContractHash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "grammarLockReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactRef",
            "hash",
            "grammarId",
            "package"
          ],
          "properties": {
            "artifactRef": {
              "$ref": "#/$defs/ref"
            },
            "hash": {
              "$ref": "#/$defs/hash"
            },
            "grammarId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "package": {
              "type": "string",
              "pattern": "^@starci/grammar/[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "writeRoots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "approvalMode": {
          "enum": [
            "manual",
            "auto"
          ]
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRef",
        "hash"
      ],
      "properties": {
        "artifactRef": {
          "$ref": "#/$defs/ref"
        },
        "hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
