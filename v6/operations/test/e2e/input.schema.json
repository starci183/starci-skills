{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operations/test/e2e/input.schema.json",
  "title": "E2E Test operation input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "test.e2e.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "test.e2e"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "$ref": "#/$defs/strings"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRouteRefs",
        "sourceReferenceRefs",
        "manifestRefs",
        "selectedFlowRef",
        "selectedFlowHash",
        "seedEvidenceRef",
        "seedEvidenceHash",
        "scenarioRefs",
        "environmentRef",
        "credentialProviderRef",
        "evidenceRoot"
      ],
      "properties": {
        "workspaceRouteRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fe",
            "be"
          ],
          "properties": {
            "fe": {
              "type": "string",
              "minLength": 1
            },
            "be": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sourceReferenceRefs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "starci-academy-fe"
            },
            {
              "const": "starci-academy-be"
            }
          ],
          "items": false
        },
        "manifestRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 2
        },
        "selectedFlowRef": {
          "type": "string",
          "minLength": 1
        },
        "selectedFlowHash": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "scenarioRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        },
        "environmentRef": {
          "type": "string",
          "minLength": 1
        },
        "credentialProviderRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scenarioReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "setupRef",
        "actionRef",
        "observableRef",
        "resetRef",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "setupRef": {
          "type": "string",
          "minLength": 1
        },
        "actionRef": {
          "type": "string",
          "minLength": 1
        },
        "observableRef": {
          "type": "string",
          "minLength": 1
        },
        "resetRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "evidenceRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        }
      }
    }
  }
}
