{
  "$schema": "../machine.schema.json",
  "schemaVersion": 6,
  "id": "starci-conversation-provenance",
  "start": "analyze-input",
  "states": {
    "analyze-input": {
      "kind": "analysis",
      "on": [
        {
          "when": {
            "inputEquals": {
              "mode": "record"
            }
          },
          "target": "record",
          "label": "append immutable snapshot head"
        },
        {
          "when": {
            "inputEquals": {
              "mode": "query"
            }
          },
          "target": "query",
          "label": "read provenance index"
        }
      ]
    },
    "record": {
      "kind": "operator",
      "ref": "source/conversation-record",
      "on": [
        {
          "when": {
            "decision": "recorded"
          },
          "target": "complete",
          "label": "recorded"
        }
      ]
    },
    "query": {
      "kind": "operator",
      "ref": "source/conversation-query",
      "on": [
        {
          "when": {
            "decision": "found"
          },
          "target": "complete",
          "label": "found"
        },
        {
          "when": {
            "decision": "empty"
          },
          "target": "complete",
          "label": "empty"
        }
      ]
    },
    "complete": {
      "kind": "terminal",
      "result": "complete"
    }
  }
}
