{
  "schemaVersion": 8,
  "runtime": "openai",
  "provider": "openai",
  "note": "Execution profiles are roles, separate from model capability. Sol runs reasoning/review under sol-reviewer and execution under sol-fresh; each operator grants only its declared tools. Retired profiles resolve historical receipts and cannot be assigned to current operators or helpers.",
  "profiles": {
    "sol-fresh": {
      "model": "gpt-5.6-sol",
      "forkTurns": {
        "isolated": "none",
        "dispatch": 40
      },
      "count": 1,
      "role": "Execute the assigned implementation, content, repair or operation inside its frozen goal and write boundaries.",
      "capabilities": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": true,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": true,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "permits": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": true,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": true,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "roleClass": "working"
    },
    "astra": {
      "model": "gpt-6-astra",
      "forkTurns": {
        "isolated": "none",
        "dispatch": 40
      },
      "count": 1,
      "role": "Historical Astra profile retained only to resolve existing receipts. New operator/helper bindings use sol-reviewer.",
      "capabilities": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": true,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": true,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "permits": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": false,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": false,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "retired": true,
      "roleClass": "legacy"
    },
    "sol-reviewer": {
      "model": "gpt-5.6-sol",
      "forkTurns": {
        "isolated": "none",
        "dispatch": 40
      },
      "count": 1,
      "role": "Plan, analyze and judge from source and independently observed evidence. Write the decision, plan or verification artifacts the operator owns; never repair the product being judged.",
      "capabilities": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": true,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": true,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "permits": {
        "fileread": true,
        "sourcewrite": true,
        "git": true,
        "shell": true,
        "websearch": true,
        "imagegen": false,
        "visualize": true,
        "browsercontrol": true,
        "http": true,
        "registry": true,
        "container": true,
        "ci": true,
        "objectstorage": false,
        "secrets": true,
        "database": true,
        "host": true,
        "print": true
      },
      "roleClass": "reasoning"
    }
  }
}
