{
  "$id": "kind:knowledge-question", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "family", "sourceOperator", "surfaceRef", "rule", "case", "impact", "evidence", "applicabilityValidated"],
  "properties": {
    "schemaVersion": { "const": 10 },
    "family": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sourceOperator": { "enum": ["interface.plan", "interface.generate", "interface.fix", "interface.audit", "library.update"] },
    "surfaceRef": { "type": "string", "minLength": 1 },
    "rule": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-(?:[0-9]+|[A-Z][A-Z0-9-]*)$" },
    "case": { "type": ["string", "null"], "pattern": "^Case [1-9][0-9]*$" },
    "impact": { "type": "string", "minLength": 12 },
    "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "applicabilityValidated": { "const": true }
  }
}
