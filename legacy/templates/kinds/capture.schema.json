{
  "$id": "kind:capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrixId", "viewport", "scheme", "state", "nodes"],
  "properties": {
    "matrixId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "viewport": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 240 }
    },
    "scheme": { "enum": ["light", "dark"] },
    "state": { "type": "string", "minLength": 1 },
    "driver": {
      "description": "Present when the entry's screenshot was taken by scripts/browser-walk.mjs from a declarative walk (@tools/browsercontrol mode playwright): the walk, the result the runner wrote beside it, the capture step of that walk whose name is this matrixId, and the control that step followed, copied from the walk and never from the agent. The validator refuses a capture that names a walk with no result on disk, a step the walk does not carry, or a control the walk did not state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "walkRef", "resultRef", "stepId", "control"],
      "properties": {
        "mode": { "const": "playwright" },
        "walkRef": { "type": "string", "pattern": "^response/data/walks/[a-z0-9][a-z0-9-]*/walk\\.json$" },
        "resultRef": { "type": "string", "pattern": "^response/data/walks/[a-z0-9][a-z0-9-]*/walk-result\\.json$" },
        "stepId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "control": { "type": "string", "minLength": 1 },
        "measurementsRef": { "description": "The capture-measurements record the runner wrote at that step, as the walk-result names it; every measurable-lane verdict over this entry cites an element of it.", "type": "string", "pattern": "^response/artifacts/[a-z0-9][a-z0-9-]*\\.measurements\\.json$" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "claims", "measured"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owner": { "enum": ["app", "grammar"] },
          "claims": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-(?:[0-9]+|[A-Z][A-Z0-9-]*)$" } },
          "measured": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
