{
  "$id": "kind:restatement-delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedBy",
    "sourceRef",
    "statement",
    "scope",
    "coordinatorSession",
    "operators"
  ],
  "properties": {
    "selectedBy": {
      "const": "user"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "missionVersion",
        "scopeHash"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "missionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "scopeHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "coordinatorSession": {
      "type": "string",
      "minLength": 1
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
