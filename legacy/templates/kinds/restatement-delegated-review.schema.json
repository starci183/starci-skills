{
  "$id": "kind:restatement-delegated-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected",
    "selectedBy",
    "sourceRef",
    "requestHash",
    "restatementHash",
    "scopeHash",
    "goalVersion",
    "lines",
    "exclusions",
    "materialChanges"
  ],
  "properties": {
    "selected": {
      "const": "as-stated"
    },
    "selectedBy": {
      "enum": [
        "coordinator",
        "orchestrator"
      ]
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "delegationId": {
      "type": "string",
      "minLength": 1
    },
    "coordinatorSession": {
      "type": "string",
      "minLength": 1
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "restatementHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "goalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line",
          "statementHash",
          "clauses",
          "judgment"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "statementHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pointer",
                "hash"
              ],
              "properties": {
                "pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          },
          "judgment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "hash"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "materialChanges": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selectedBy": {
            "const": "coordinator"
          }
        }
      },
      "then": {
        "required": [
          "delegationId",
          "coordinatorSession"
        ]
      },
      "else": {
        "properties": {
          "delegationId": {
            "const": null
          },
          "coordinatorSession": {
            "const": null
          }
        }
      }
    }
  ]
}
