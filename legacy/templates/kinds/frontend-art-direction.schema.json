{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "route",
    "goalVersion",
    "brief",
    "source",
    "grammar",
    "candidates",
    "selected",
    "decisionId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "goalVersion": {
      "type": "integer",
      "minimum": 1
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "head"
      ],
      "properties": {
        "alias": {
          "const": "@workspaces/fe"
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "version",
        "manifestHash",
        "adoption"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifestHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "adoption": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "component",
              "authority",
              "limits"
            ],
            "properties": {
              "region": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "component": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "sha256"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              },
              "limits": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "concept",
          "title",
          "rationale",
          "limits",
          "prompt",
          "generation",
          "png",
          "regions",
          "assets",
          "anatomy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "concept": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "sourceRef",
              "inputHash"
            ],
            "properties": {
              "tool": {
                "const": "@tools/imagegen"
              },
              "sourceRef": {
                "type": "string",
                "minLength": 1
              },
              "inputHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "png": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256",
              "width",
              "height"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region",
                "realization",
                "grammarCompatibility"
              ],
              "properties": {
                "region": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "realization": {
                  "type": "string",
                  "minLength": 1
                },
                "grammarCompatibility": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "region",
                "subject",
                "prompt",
                "delivery",
                "provenance"
              ],
              "properties": {
                "region": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "subject": {
                  "type": "string",
                  "minLength": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "delivery": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "sha256"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    }
                  },
                  "minItems": 1
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              }
            },
            "minItems": 0
          },
          "anatomy": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "element",
                "bounds"
              ],
              "properties": {
                "element": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "bounds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "selected": {
      "type": [
        "string",
        "null"
      ]
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    }
  }
}
