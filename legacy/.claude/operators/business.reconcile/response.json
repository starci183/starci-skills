{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business.reconcile response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["done", "mismatch"] } }, "required": ["status"] }, "then": { "properties": { "outputs": { "allOf": [
      { "contains": { "properties": { "id": { "const": "business-reconciliation" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "claims" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } }
    ] } } } },
    { "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "properties": {
      "outputs": { "contains": { "properties": { "id": { "const": "model" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } },
      "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } }
    } } }
  ],
  "description": "A mismatch carries the complete reconciliation and delivered claims but no model. A done response adds the republished model after every matrix row is satisfied."
}
