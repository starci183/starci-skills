{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"api.verify response","$ref":"works:response",
  "description":"A done response retains the repository runner's raw output, every reported case, exactly three separately judged lane verdicts, API read-back and exact namespace cleanup proof. A run that reached cases remains append-only even when it failed.",
  "allOf":[{"if":{"properties":{"status":{"const":"done"}},"required":["status"]},"then":{"properties":{"outputs":{"allOf":[
    {"contains":{"properties":{"id":{"const":"api-verification"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}},
    {"contains":{"properties":{"id":{"const":"api-cases"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}},
    {"contains":{"properties":{"id":{"const":"api-verdicts"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"application/json"}}}},"required":["id","type","file"]}},
    {"contains":{"properties":{"id":{"const":"api-output"},"type":{"const":"file"},"file":{"properties":{"mediaType":{"const":"text/plain"}}}},"required":["id","type","file"]}}
  ]},"observations":{"not":{"contains":{"properties":{"result":{"const":"failed"}},"required":["result"]}}}}}}]
}
