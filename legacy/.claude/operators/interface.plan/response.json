{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "interface.plan response",
  "$ref": "works:response",
  "properties": { "outputs": { "items": { "properties": { "type": { "enum": ["text", "file"] } } } } },
  "allOf": [{ "if": { "properties": { "status": { "const": "done" } }, "required": ["status"] }, "then": { "properties": {
    "outputs": { "allOf": [
      { "contains": { "properties": { "id": { "const": "surface-map" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "text/markdown" } } } }, "required": ["id", "type", "file"] } },
      { "contains": { "properties": { "id": { "const": "units" }, "type": { "const": "file" }, "file": { "properties": { "mediaType": { "const": "application/json" } } } }, "required": ["id", "type", "file"] } }
    ] }, "observations": { "not": { "contains": { "properties": { "result": { "const": "failed" } }, "required": ["result"] } } }
  } } }],
  "description": "A done response contains the complete human surface map and matching units. Optional knowledge clarification artifacts may accompany a blocked response."
}
