{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": ".works/<workId>/requests/<id>.json: prompts and files to act on, with supporting context kept separate, against one work revision. This record alone grants no execution permission.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "workId", "workRevision", "operation", "expected", "inputs", "context", "requestedBy", "createdAt"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/version" },
    "kind": { "const": "request" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "workId": { "$ref": "common.schema.json#/$defs/id" },
    "workRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "operation": { "$ref": "common.schema.json#/$defs/text" },
    "expected": { "$ref": "common.schema.json#/$defs/criteria" },
    "inputs": { "$ref": "inputs.schema.json" },
    "context": { "$ref": "context.schema.json" },
    "requestedBy": { "$ref": "common.schema.json#/$defs/actor" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
