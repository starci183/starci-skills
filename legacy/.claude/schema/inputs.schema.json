{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request inputs",
  "description": "The prompts and files the request asks the skill to act on. At least one prompt or file is required.",
  "type": "object", "additionalProperties": false,
  "required": ["prompts", "files"],
  "properties": {
    "prompts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "files": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/file" } }
  },
  "anyOf": [
    { "properties": { "prompts": { "minItems": 1 } } },
    { "properties": { "files": { "minItems": 1 } } }
  ]
}
