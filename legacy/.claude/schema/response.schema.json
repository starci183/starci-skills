{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "description": ".works/<workId>/responses/<id>.json: typed outputs produced for one request. Optional verification observations describe their checks separately; delivering an output is not a claim that the work is proved complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "workId",
    "workRevision",
    "requestId",
    "status",
    "outputs",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "kind": {
      "const": "response"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "workId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "workRevision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "mismatch",
        "blocked",
        "waiting"
      ]
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "output.schema.json"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "result",
          "evidenceIds",
          "note"
        ],
        "properties": {
          "criterionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-checked"
            ]
          },
          "evidenceIds": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "note": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    },
    "feedbackRound": {
      "type": "integer",
      "minimum": 0,
      "description": "Completed feedback-and-repair rounds for this request. Initial candidate is round zero; the caller maintains truthful history."
    },
    "criteriaResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "result",
          "outputIds",
          "note"
        ],
        "properties": {
          "criterionId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-checked"
            ]
          },
          "outputIds": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "note": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "mismatch",
              "blocked",
              "waiting"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
