{
  "$id": "identity:provision-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "routeKey",
    "flow",
    "provider",
    "realm",
    "api",
    "container",
    "containerId",
    "imageId",
    "inventoryFingerprint",
    "credentials",
    "credentialFingerprints",
    "productContract",
    "clientId",
    "accounts",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "routeKey": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/(fe|be)$"
    },
    "flow": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "realm": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "containerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inventoryFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "password",
        "uat"
      ],
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "uat": {
          "type": "string",
          "pattern": "^\\.stacks/[a-z0-9-]+/secrets/[a-z0-9-]+\\.enc$"
        }
      }
    },
    "credentialFingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "username",
        "password",
        "uat"
      ],
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "password": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "uat": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "productContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "fingerprint"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "custodyEvidenceRef"
        ],
        "properties": {
          "capability": {
            "const": "identity:account-admin"
          },
          "custodyEvidenceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Every account this branch provisions, one entry per alias the flow names. One branch provisions a flow’s whole cast: a flow that is only true when two roles meet needs both, and splitting them across branches splits one flow’s identity across two plans that nothing joins. Usernames are distinct within the plan.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "username",
          "email",
          "firstName",
          "lastName",
          "usernameMaxLength"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The actor this account plays in the flow. It is the key the account record is published under, so the plan and the record join on it rather than on a name a reader has to compare by eye."
          },
          "username": {
            "type": "string",
            "pattern": "^uat-[A-Za-z0-9._-]+$"
          },
          "email": {
            "type": "string",
            "pattern": "^[^\\s@]+@[^\\s@]+$"
          },
          "firstName": {
            "type": "string",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "minLength": 1
          },
          "usernameMaxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          }
        },
        "description": "One account the branch provisions: a name, an address and a profile. The shared password is resolved by name at the moment it is used and is never a field here."
      }
    }
  }
}
