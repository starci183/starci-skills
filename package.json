{
  "name": "starci",
  "version": "1.0.0-alpha.3",
  "description": "StarCi: kernel-agent workflow runtime — one long-lived kernel agent per workflow, one ephemeral op agent per job, a sqlite ledger as the only state.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "starci": "bin/starci.mjs"
  },
  "files": [
    "bin/",
    "init/",
    "ext/",
    "skills/",
    "modules/",
    "engine/",
    "knowledge/",
    "docs/",
    "examples/",
    "tests/",
    "scripts/",
    "packages/",
    "!packages/**/node_modules/",
    "!packages/**/dist/",
    "!packages/**/storybook-static/",
    "!packages/**/reference-renders/",
    "!examples/**/node_modules/",
    "!examples/**/dist/",
    "!examples/**/coverage/",
    "*.md",
    "config.example.yaml",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starci183/starci-skills.git"
  },
  "homepage": "https://github.com/starci183/starci-skills#readme",
  "keywords": [
    "claude-code",
    "codex",
    "devin",
    "agent",
    "skills",
    "starci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node bin/starci.mjs check",
    "test": "node --import ./tests/setup/low-priority.mjs --import ./tests/setup/isolated-temp.mjs --import ./tests/setup/isolated-registry.mjs --test \"tests/**/*.spec.mjs\"",
    "starci": "node bin/starci.mjs",
    "release:check": "node scripts/gates/release-check.mjs",
    "release:publish": "node scripts/gates/release-publish.mjs"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@nestjs/common": "11.1.27",
    "@nestjs/core": "11.1.27",
    "@nestjs/testing": "11.1.27",
    "@types/jest": "29.5.14",
    "acorn": "8.16.0",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "next": "16.3.1",
    "prettier": "3.9.6",
    "swr": "2.5.1",
    "typescript": "5.9.3",
    "yaml": "^2.9.0"
  }
}
