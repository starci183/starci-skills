{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/schema/grammars/starci/capsules.schema.json",
  "title": "StarCi durable behavior capsules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grammar", "capsules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "grammar": { "const": "starci" },
    "capsules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Capsule" } }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assertion"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["accessibility", "computed-style", "dom", "interaction", "state", "typecheck"] },
        "assertion": { "type": "string", "minLength": 16 }
      }
    },
    "Capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "intent", "triggerFacts", "decisionQuestions", "variableAxes", "invariants",
        "interactionProof", "counterexampleCaseRefs", "templateRef", "templateHash", "rulings",
        "goldenCaseRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "intent": { "type": "string", "minLength": 24 },
        "triggerFacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "decisionQuestions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 16 } },
        "variableAxes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "invariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "interactionProof": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Proof" } },
        "counterexampleCaseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "templateRef": { "type": "string", "pattern": "^\\./templates/[a-z0-9]+(?:-[a-z0-9]+)*\\.template\\.tsx$" },
        "templateHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "rulings": {
          "description": "Founder rulings retained as durable product-family evidence, never source provenance.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^founder-(?:feedback|ruling):[a-zA-Z0-9:._-]+$" }
        },
        "goldenCaseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }
      }
    }
  }
}
