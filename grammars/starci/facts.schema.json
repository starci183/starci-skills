{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/schema/grammars/starci/facts.schema.json",
  "title": "StarCi product-family closed fact catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grammar", "facts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "grammar": { "const": "starci" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Fact" }
    }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "definition", "proofKinds"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "category": {
          "enum": ["asset", "collection", "content", "interaction", "navigation", "region", "route", "state", "surface"]
        },
        "definition": { "type": "string", "minLength": 16 },
        "proofKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["business-input", "contract", "founder-ruling", "runtime-observation"] }
        }
      }
    }
  }
}
