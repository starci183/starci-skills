{
  "$schema": "./profile.schema.json",
  "schemaVersion": 1,
  "grammar": "starci",
  "profileId": "starci-academy",
  "owners": {
    "starci-dashboard-theme": {
      "decision": "reuse",
      "component": "StarCiDashboardThemeBoundary",
      "primitive": "grammar-locked semantic theme tokens",
      "principleMode": "inherit",
      "principleConcerns": [],
      "capsuleRefs": ["dashboard-theme"],
      "visualContract": {
        "axes": { "contrast": "balanced", "density": "compact", "shape": "soft", "depth": "layered", "motion": "measured" },
        "roles": {
          "ground": "--starci-background",
          "surface": "--starci-surface",
          "content": "--starci-foreground",
          "mutedContent": "--starci-muted",
          "accent": "--starci-accent",
          "separator": "--starci-separator",
          "display": "--starci-font-sans",
          "body": "--starci-font-sans",
          "label": "--starci-font-sans",
          "radius": "--starci-radius-3xl",
          "elevation": "--starci-surface-shadow",
          "duration": "--starci-duration",
          "easing": "--starci-easing"
        },
        "tokens": {
          "--starci-background": "oklch(97.02% 0.0015 354.13)",
          "--starci-surface": "oklch(100% 0.0008 354.13)",
          "--starci-surface-secondary": "oklch(95.24% 0.0012 354.13)",
          "--starci-foreground": "oklch(21.03% 0.0015 354.13)",
          "--starci-muted": "oklch(55.17% 0.0030 354.13)",
          "--starci-accent": "oklch(70.03% 0.2092 354.13)",
          "--starci-accent-foreground": "oklch(100% 0 0)",
          "--starci-accent-soft": "color-mix(in oklab, var(--starci-accent) 15%, transparent)",
          "--starci-separator": "oklch(92% 0.0015 354.13)",
          "--starci-border": "oklch(90% 0.0015 354.13)",
          "--starci-success": "oklch(73.29% 0.1941 162.85)",
          "--starci-success-soft": "color-mix(in oklab, var(--starci-success) 15%, transparent)",
          "--starci-warning": "oklch(78.19% 0.1590 84.37)",
          "--starci-warning-soft": "color-mix(in oklab, var(--starci-warning) 18%, transparent)",
          "--starci-danger": "oklch(65.32% 0.2335 37.78)",
          "--starci-danger-soft": "color-mix(in oklab, var(--starci-danger) 15%, transparent)",
          "--starci-scrim": "oklch(21.03% 0.0015 354.13 / 48%)",
          "--starci-font-sans": "Open Sans, ui-sans-serif, system-ui, sans-serif",
          "--starci-radius-3xl": "1.5rem",
          "--starci-surface-shadow": "0 2px 4px 0 rgba(0, 0, 0, 0.04), 0 1px 2px 0 rgba(0, 0, 0, 0.06), 0 0 1px 0 rgba(0, 0, 0, 0.06)",
          "--starci-duration": "150ms",
          "--starci-easing": "cubic-bezier(0.4, 0, 0.2, 1)"
        }
      },
      "reason": "Dashboard and console surfaces reuse StarCi topology while this Academy profile alone owns the exact rose accent; another product must declare its own profile."
    },
    "continuation-highlight": { "decision": "new-required", "component": "ContinuationHighlightCard", "primitive": "SurfaceCard", "principleMode": "delta", "principleConcerns": ["colour", "gap", "state", "surface-in-surface"], "capsuleRefs": ["continuation-highlight"], "reason": "Academy continuation surfaces share one semantic highlight owner instead of rebuilding next-task emphasis per page." },
    "surface-list": { "decision": "reuse", "component": "SurfaceListCard", "primitive": "HeroUI Card", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["surface-list"] },
    "surface-accordion": { "decision": "reuse", "component": "SurfaceAccordionCard", "primitive": "HeroUI Accordion", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["hierarchical-disclosure"] },
    "selection-listbox": { "decision": "extend", "component": "SelectionList", "primitive": "HeroUI ListBox", "principleMode": "delta", "principleConcerns": ["state", "size"], "capsuleRefs": ["selection-listbox"], "reason": "Destination navigation extends the closed ListBox owner; focus order remains vendor-pattern law and target extent resolves through size." },
    "navigable-gated-destination": { "decision": "extend", "component": "SelectionList", "primitive": "HeroUI ListBox", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["navigation-fact-chip"], "reason": "A viewable gate differs from a hard-disabled destination only on the availability state axis." },
    "navigation-locked-chip": { "decision": "extend", "component": "SelectionList", "primitive": "Badge", "principleMode": "delta", "principleConcerns": ["colour", "state"], "capsuleRefs": ["navigation-fact-chip"], "reason": "Locked status uses the warning Badge owner without changing destination interaction." },
    "navigation-rank-chip": { "decision": "extend", "component": "SelectionList", "primitive": "Badge", "principleMode": "delta", "principleConcerns": ["colour"], "capsuleRefs": ["navigation-fact-chip"], "reason": "Viewer rank uses the accent Badge owner without changing row geometry." },
    "navigation-due-chip": { "decision": "reuse", "component": "SelectionList", "primitive": "Badge", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["navigation-fact-chip"] },
    "resizable-rail": { "decision": "reuse", "component": "RailDivider", "primitive": "ARIA separator", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["resizable-rail"] },
    "rail-content-spacing": { "decision": "reuse", "component": "content rail contracts", "primitive": "contract Tree", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["rail-planes"], "reason": "Resizable content rails own inline inset only and remain flush on the block axis." },
    "primary-content-spacing": { "decision": "reuse", "component": "primary content contracts", "primitive": "contract Tree", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["rail-planes"] },
    "collapsible-rail-transition": { "decision": "reuse", "component": "CollapsibleRail", "primitive": "Framer Motion plus contract Tree", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["collapsible-rail", "rail-planes"] },
    "circular-icon-destination": { "decision": "reuse", "component": "SelectionList", "primitive": "HeroUI ListBox", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["compact-navigation"] },
    "navigation-groups-scroll-viewport": { "decision": "reuse", "component": "ScrollViewport", "primitive": "HeroUI scroll-shadow utility", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["navigation-scroll"] },
    "focused-work-surface": { "decision": "reuse", "component": "LearnShellLayout", "primitive": "shared route predicate", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["focused-work-surface"] },
    "mobile-destination-bar": { "decision": "reuse", "component": "LearnShellLayout", "primitive": "bottom navigation contract", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["mobile-destination-bar"] },
    "omit-empty-mobile-destination": { "decision": "new-required", "component": "LearnShellLayout", "primitive": "controlled local view state", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["mobile-destination-bar"], "reason": "Optional destinations must derive from the content they can reveal." },
    "active-descendant-follow": { "decision": "new-required", "component": "OutlineRail", "primitive": "controlled state", "principleMode": "delta", "principleConcerns": ["overflow", "state"], "capsuleRefs": ["hierarchical-disclosure"] },
    "search-reveals-matches": { "decision": "new-required", "component": "OutlineRail", "primitive": "controlled state", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["hierarchical-disclosure"] },
    "adaptive-group-summary": { "decision": "new-required", "component": "OutlineRail", "primitive": "HeroUI Accordion", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["hierarchical-disclosure"] },
    "back-link": { "decision": "reuse", "component": "Breadcrumbs", "primitive": "HeroUI Link", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["adaptive-path-navigation"], "reason": "The Breadcrumbs leaf now resolves deep paths to one short Back link owned by the nearest legal ancestor." },
    "breadcrumb-trail": { "decision": "reuse", "component": "Breadcrumbs", "primitive": "HeroUI Breadcrumbs", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["adaptive-path-navigation"] },
    "responsive-tab-toolbar": { "decision": "extend", "component": "DualTabsToolbar", "primitive": "HeroUI Tabs", "principleMode": "delta", "principleConcerns": ["overflow", "responsive"], "capsuleRefs": ["responsive-tab-toolbar"], "reason": "Independent tab axes need explicit narrow stacking and per-axis overflow; text expansion is evidence for those two modules, not a phantom principle." },
    "tab-axis-horizontal-overflow": { "decision": "extend", "component": "ChoiceTabs", "primitive": "HeroUI Tabs", "principleMode": "delta", "principleConcerns": ["overflow", "responsive"], "capsuleRefs": ["responsive-tab-toolbar"], "reason": "Variable labels remain one line while overflow and responsive law own the narrow result." },
    "omit-inert-tab-axis": { "decision": "extend", "component": "DualTabsToolbar", "primitive": "controlled tab state", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["responsive-tab-toolbar"], "reason": "An axis with fewer than two enabled choices is information, not an interactive tablist." },
    "markdown-document": { "decision": "extend", "component": "Article", "primitive": "mdast plus house semantic owners", "principleMode": "delta", "principleConcerns": ["overflow", "responsive", "typography"], "capsuleRefs": ["markdown-document"], "reason": "Article preserves authored semantics; focus order remains a source/vendor pattern rather than a class-emitting principle." },
    "host-relative-document-headings": { "decision": "reuse", "component": "Heading", "primitive": "semantic heading leaf", "principleMode": "inherit", "principleConcerns": [], "capsuleRefs": ["markdown-document"] },
    "source-derived-document-outline": { "decision": "extend", "component": "CourseLearnContentPage and ContentOutlineRail", "primitive": "shared parsed heading model", "principleMode": "delta", "principleConcerns": ["state", "responsive"], "capsuleRefs": ["markdown-document"], "reason": "The rendered document and outline share heading identities; focus order is proved by interaction patterns." },
    "selectable-document-passages": { "decision": "extend", "component": "Article", "primitive": "bounded selection context", "principleMode": "delta", "principleConcerns": ["state"], "capsuleRefs": ["markdown-document"], "reason": "Passage selection state is visual; control order remains source-pattern and browser-proof law." },
    "heroicons-extension": { "decision": "extend", "component": "@starci/heroicons", "primitive": "Heroicons-compatible SVG", "principleMode": "delta", "principleConcerns": ["size"], "capsuleRefs": ["heroicons-extension"], "reason": "Stable missing meanings use the Icon pattern for optical review while size remains the class-emitting concern." }
  }
}
