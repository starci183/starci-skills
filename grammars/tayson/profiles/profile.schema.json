{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/schema/grammars/tayson/profiles/profile.schema.json",
  "title": "Tây Sơn product owner profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "grammar", "profileId", "owners"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "grammar": { "const": "tayson" },
    "profileId": { "$ref": "#/$defs/Id" },
    "owners": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/Owner" }
    }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Concern": {
      "enum": [
        "alignment", "colour", "distribution", "divider", "flow", "gap", "grid", "overflow",
        "padding", "radius", "responsive", "size", "state", "surface-in-surface", "typography"
      ]
    },
    "Owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "component", "primitive", "principleMode", "principleConcerns", "capsuleRefs"],
      "properties": {
        "decision": { "enum": ["reuse", "extend", "new-required", "not-applicable"] },
        "component": { "type": "string", "minLength": 2 },
        "primitive": { "type": "string", "minLength": 2 },
        "principleMode": { "enum": ["inherit", "delta", "none"] },
        "principleConcerns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Concern" } },
        "capsuleRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "visualContract": { "$ref": "#/$defs/VisualContract" },
        "reason": { "type": "string", "minLength": 12 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "reuse" } } },
          "then": {
            "properties": {
              "principleMode": { "const": "inherit" },
              "principleConcerns": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "enum": ["extend", "new-required"] } } },
          "then": {
            "properties": {
              "principleMode": { "const": "delta" },
              "principleConcerns": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "not-applicable" } } },
          "then": {
            "properties": {
              "principleMode": { "const": "none" },
              "principleConcerns": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "VisualContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "roles", "tokens"],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contrast", "density", "shape", "depth", "motion"],
          "properties": {
            "contrast": { "enum": ["soft", "balanced", "strong"] },
            "density": { "enum": ["compact", "balanced", "spacious"] },
            "shape": { "enum": ["square", "soft", "rounded"] },
            "depth": { "enum": ["flat", "layered", "floating"] },
            "motion": { "enum": ["still", "measured", "expressive"] }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ground", "surface", "content", "mutedContent", "accent", "separator", "display", "body", "label", "radius", "elevation", "duration", "easing"],
          "properties": {
            "ground": { "$ref": "#/$defs/Token" },
            "surface": { "$ref": "#/$defs/Token" },
            "content": { "$ref": "#/$defs/Token" },
            "mutedContent": { "$ref": "#/$defs/Token" },
            "accent": { "$ref": "#/$defs/Token" },
            "separator": { "$ref": "#/$defs/Token" },
            "display": { "$ref": "#/$defs/Token" },
            "body": { "$ref": "#/$defs/Token" },
            "label": { "$ref": "#/$defs/Token" },
            "radius": { "$ref": "#/$defs/Token" },
            "elevation": { "$ref": "#/$defs/Token" },
            "duration": { "$ref": "#/$defs/Token" },
            "easing": { "$ref": "#/$defs/Token" }
          }
        },
        "tokens": {
          "type": "object",
          "minProperties": 13,
          "propertyNames": { "$ref": "#/$defs/Token" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Token": { "type": "string", "pattern": "^--[A-Za-z_][A-Za-z0-9_-]*$" }
  }
}
