{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v1/contexts/conversations/conversation-registry.schema.json",
  "title": "Conversation provenance registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "hashAlgorithm", "canonicalization", "conversationHeads", "objects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"$ref": "#/$defs/slug"},
    "hashAlgorithm": {"const": "sha256"},
    "canonicalization": {"const": "RFC8785-JCS"},
    "conversationHeads": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {"$ref": "#/$defs/head"}
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "byHash"],
      "properties": {
        "immutable": {"const": true},
        "byHash": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/hash"},
          "additionalProperties": {"$ref": "#/$defs/objectRef"}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "provider", "surface", "head"],
      "properties": {
        "conversationId": {"$ref": "#/$defs/slug"},
        "provider": {"enum": ["openai", "anthropic", "other"]},
        "surface": {"enum": ["chatgpt", "codex", "openai-api", "claude", "claude-code", "other"]},
        "externalThreadId": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/hash"}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "path"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "pattern": "^conversations/objects/sha256/[0-9a-f]{64}\\.json$"}
      }
    }
  }
}
