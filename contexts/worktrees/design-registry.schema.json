{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v2/contexts/worktrees/design-registry.schema.json",
  "title": "Identity-centric design registry",
  "description": "Version 2 keeps stable layout and block identities separate from mutable review records. New accepted designs are immutable two-file revision bundles; legacy hash-addressed JSON objects remain readable during migration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "hashAlgorithm", "canonicalization", "layoutHeads", "blockHeads"],
  "anyOf": [
    {"required": ["revisions"]},
    {"required": ["objects"]}
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "project": {"$ref": "#/$defs/slug"},
    "hashAlgorithm": {"const": "sha256"},
    "canonicalization": {"const": "RFC8785-JCS"},
    "layoutHeads": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/slug"},
      "additionalProperties": {"$ref": "#/$defs/layoutHead"}
    },
    "blockHeads": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/scopedId"},
      "additionalProperties": {"$ref": "#/$defs/blockHead"}
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "byHash"],
      "properties": {
        "immutable": {"const": true},
        "byHash": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/hash"},
          "additionalProperties": {"$ref": "#/$defs/revisionRef"}
        }
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable", "byHash"],
      "properties": {
        "immutable": {"const": true},
        "byHash": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/hash"},
          "additionalProperties": {"$ref": "#/$defs/objectRef"}
        }
      }
    },
    "reviewHistory": {"$ref": "#/$defs/reviewHistory"}
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scopedId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "layoutHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "head", "regions"],
      "properties": {
        "layoutId": {"$ref": "#/$defs/slug"},
        "routePattern": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/hash"},
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    },
    "blockHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "blockId", "layoutHash", "head"],
      "properties": {
        "layoutId": {"$ref": "#/$defs/slug"},
        "blockId": {"$ref": "#/$defs/slug"},
        "layoutHash": {"$ref": "#/$defs/hash"},
        "head": {"$ref": "#/$defs/hash"}
      }
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "path"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{64}\\.json$"}
      }
    },
    "revisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "path"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "pattern": "^revisions/[0-9a-f]{64}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "round", "state", "produced"],
      "properties": {
        "phase": {"enum": ["layout", "block"]},
        "round": {"type": "integer", "minimum": 1},
        "state": {"enum": ["pending", "accepted", "feedback", "rejected"]},
        "prompt": {"type": "string"},
        "produced": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "hash"],
            "properties": {
              "id": {"$ref": "#/$defs/slug"},
              "hash": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "acceptedHash": {"$ref": "#/$defs/hash"},
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hash", "reason"],
            "properties": {
              "hash": {"$ref": "#/$defs/hash"},
              "instead": {"$ref": "#/$defs/slug"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "reviewHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layouts", "blocks"],
      "properties": {
        "layouts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/slug"},
          "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/review"}}
        },
        "blocks": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/scopedId"},
          "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/review"}}
        }
      }
    }
  }
}
