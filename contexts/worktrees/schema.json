{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/contexts/worktrees/schema.json",
  "title": "Project worktree roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "source", "roots"],
  "properties": {
    "schema": {"const": 1},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "source": {"type": "string", "minLength": 1},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registries", "businesses", "cache"],
      "properties": {
        "registries": {"$ref": "#/$defs/durableRoot"},
        "businesses": {"$ref": "#/$defs/durableRoot"},
        "cache": {"$ref": "#/$defs/rebuildableRoot"}
      }
    }
  },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "durability"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "durability": {"enum": ["durable", "rebuildable"]},
        "ignored": {"type": "boolean"},
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locked", "clean", "branch", "owningGit"],
          "properties": {
            "locked": {"type": "boolean"},
            "clean": {"type": "boolean"},
            "branch": {"type": "string", "minLength": 1},
            "owningGit": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "durableRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "durability", "ignored", "ownership"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "durability": {"const": "durable"},
        "ignored": {"const": false},
        "ownership": {"$ref": "#/$defs/root/properties/ownership"}
      }
    },
    "rebuildableRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "durability", "ignored"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "durability": {"const": "rebuildable"},
        "ignored": {"const": true}
      }
    }
  }
}
