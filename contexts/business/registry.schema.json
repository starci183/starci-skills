{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v4/contexts/business/registry.schema.json",
  "title": "Business registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "hashAlgorithm", "canonicalization", "featureHeads", "objects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hashAlgorithm": {"const": "sha256"},
    "canonicalization": {"const": "RFC8785-JCS"},
    "featureHeads": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["featureId", "head", "sources"],
        "properties": {
          "featureId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "head"], "properties": {"role": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}
        }
      }
    },
    "objects": {
      "type": "object", "additionalProperties": false,
      "required": ["immutable", "byHash"],
      "properties": {
        "immutable": {"const": true},
        "byHash": {"type": "object", "propertyNames": {"pattern": "^[0-9a-f]{64}$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["hash", "path"], "properties": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{64}\\.json$"}}}}
      }
    }
  }
}
