{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v4/contexts/business/schema.json",
  "title": "Evidence-backed business feature",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "featureId", "title", "summary", "sources", "scope", "actors", "flows", "rules", "states", "entities", "operations", "surfaces", "acceptance", "unknowns", "evidence"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "authority": {"$ref": "#/$defs/authority"},
    "project": {"$ref": "#/$defs/slug"},
    "featureId": {"$ref": "#/$defs/slug"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "scope": {"$ref": "#/$defs/scope"},
    "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "flows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/flow"}},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 2}}},
      "then": {"required": ["authority"]}
    }
  ],
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "repository", "head"],
      "properties": {
        "role": {"$ref": "#/$defs/slug"},
        "repository": {"type": "string", "minLength": 1},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "basis", "requiredRoles"],
      "properties": {
        "status": {"enum": ["pending", "in-progress", "implemented", "rejected"]},
        "basis": {"enum": ["owner-intent", "reconciled"]},
        "requiredRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "baseHead": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "previousHead": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "supersedes": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["includes", "excludes"],
      "properties": {
        "includes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excludes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "capabilities", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "flow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "trigger", "steps", "outcomes", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "actor", "action", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "actor": {"$ref": "#/$defs/id"},
        "action": {"type": "string", "minLength": 1}, "result": {"type": "string", "minLength": 1},
        "surfaceId": {"$ref": "#/$defs/id"}, "stateId": {"$ref": "#/$defs/id"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "strength", "evidenceIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^BR-[0-9]{2,}$"},
        "statement": {"type": "string", "minLength": 1},
        "strength": {"enum": ["confirmed", "partial"]},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind", "transitions", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["initial", "pending", "success", "error", "empty", "partial"]},
        "transitions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "fields", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "owner", "inputs", "outputs", "failures", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["query", "mutation", "command", "event", "redirect"]},
        "name": {"type": "string", "minLength": 1}, "owner": {"enum": ["frontend", "backend", "provider"]},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "failures": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "routePattern", "title", "eyebrow", "purpose", "navigation", "regions", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "routePattern": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "eyebrow": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "navigation": {"type": "array", "items": {"$ref": "#/$defs/navigation"}},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "navigation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "group", "availability"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "group": {"type": "string", "minLength": 1}, "availability": {"enum": ["active", "available", "unavailable"]}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "items", "actions", "states", "evidenceIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["form", "navigation", "summary", "flow", "content", "collection"]},
        "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["shortcut", "divider", "field", "choice", "link", "fact", "status", "step", "navigation", "text", "entity"]},
        "label": {"type": "string", "minLength": 1}, "value": {"type": "string"},
        "status": {"type": "string"}, "meta": {"type": "string"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["primary", "secondary", "link", "destructive"]}, "target": {"type": "string"}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "evidenceIds"],
      "properties": {"id": {"type": "string", "pattern": "^AC-[0-9]{2,}$"}, "statement": {"type": "string", "minLength": 1}, "evidenceIds": {"$ref": "#/$defs/evidenceIds"}}
    },
    "unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "question": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV-[0-9]{3,}$"}, "role": {"$ref": "#/$defs/slug"},
        "path": {"type": "string", "minLength": 1}, "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1}, "claim": {"type": "string", "minLength": 1},
        "kind": {"enum": ["route", "ui", "contract", "api", "schema", "test", "policy", "owner-decision"]},
        "authority": {"const": "owner"},
        "decisionId": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "owner-decision"}}, "required": ["kind"]},
          "then": {"required": ["authority", "decisionId"]},
          "else": {"required": ["role", "path", "startLine", "endLine"]}
        }
      ]
    },
    "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9]{3,}$"}}
  }
}
