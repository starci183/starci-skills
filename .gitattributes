# One line ending everywhere: the tree is hashed, diffed and fingerprinted as bytes.
* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary

# Append-only registries: two staged changes each append an entry; the land gate
# cherry-picks them one after the other, and union keeps both (scripts/supervisor/workers.mjs SHARED_APPEND_FILES).
modules/kernel/contract-changes.yaml merge=union
