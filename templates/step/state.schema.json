{
  "$id": "step:state",
  "description": "state.json at the session root; the orchestrator writes it, no agent does. Documented in resources/orchestrator.json#session.manifest. brief and budget are written at create and are required from the first transition on; mission is written at create from the request and is required by the gates for a session that writes routed source or touches a runtime (scripts/validate-request.mjs#missionGateErrors).",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "provenEntry": {
      "description": "The two spellings an entry of brief.proven opens with on a mission, and the whole of what may open one: `doneWhen:<n> ` for a done-when line of the mission, and `prerequisite:<N/M> ` for a branch whose goal was to enable another branch (request.json.goal.prerequisite) — a bind, a preflight, an audit a later walk needed. Both name a branch whose receipt is done and whose goalCheck the response gate accepted, which is the only thing that puts an entry here; the gate that resolves them reads this pattern rather than carrying a copy of it (scripts/validate-session.mjs#provenErrors)",
      "type": "string",
      "pattern": "^(?:doneWhen:(?<doneWhen>[0-9]+)|prerequisite:(?<prerequisite>[0-9]+/[0-9]+)) "
    }
  },
  "required": [
    "id",
    "project",
    "startedAt",
    "status",
    "chain",
    "steps",
    "requestHashes"
  ],
  "properties": {
    "contractVersion": { "const": "starci/v2.2", "description": "Marks a session created by the v2.2 runtime. A missing marker is legacy read compatibility only." },
    "hostBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "hostId", "worktree", "sourcePromptRef"],
      "properties": {
        "kind": { "enum": ["codex-task", "claude-session"] },
        "hostId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "worktree": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourcePromptRef": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "openedAt"],
      "properties": {
        "phase": { "enum": ["draft", "active", "blocked", "failed", "closing", "closed-success"] },
        "openedAt": { "type": "string", "minLength": 1 },
        "closedAt": { "type": "string", "minLength": 1 },
        "closeReason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "compactRef": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "attempts": {
      "description": "Immutable per-invocation history. A retry or repair uses another branch and points request.attempt.previous at the latest attempt id.",
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operatorId", "number", "kind", "expectedVersion", "expectedHash", "expected", "frozenInputs", "status", "requestRef", "startedAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "operatorId": { "type": "string", "pattern": "^[a-z]+(?:\\.[a-z]+)+$" },
          "number": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["initial", "repair", "retry", "resume"] },
          "previous": { "type": ["string", "null"] },
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "expectedHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "expected": { "type": "object" },
          "frozenInputs": { "type": "array" },
          "status": { "enum": ["running", "matched", "mismatched", "inconclusive", "blocked", "waiting"] },
          "requestRef": { "type": "string", "minLength": 1 },
          "responseRef": { "type": "string", "minLength": 1 },
          "startedAt": { "type": "string", "minLength": 1 },
          "endedAt": { "type": "string", "minLength": 1 },
          "comparison": { "type": "object" },
          "evidenceManifest": {
            "type": "object", "additionalProperties": false,
            "required": ["version", "responseHash", "fingerprint", "files"],
            "properties": {
              "version": { "const": 1 },
              "responseHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "files": {
                "type": "array", "minItems": 2,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["ref", "sha256"],
                  "properties": {
                    "ref": { "type": "string", "pattern": "^(?:request|response)/[A-Za-z0-9_./-]+$" },
                    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workerSlots": {
      "description": "The single session-wide scheduler ledger. Nested exchanges, repairs and retries acquire from these same three slots.",
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slot", "token", "attemptId", "workerId", "branch", "exclusive", "environment", "acquiredAt"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 3 },
          "token": { "type": "string", "minLength": 1 },
          "attemptId": { "type": "string", "minLength": 1 },
          "workerId": { "type": "string", "minLength": 1 },
          "branch": { "type": "string", "pattern": "^[0-9]+/[0-9]+(?:/[a-z][a-z-]*)?$" },
          "exclusive": { "type": "array", "items": { "type": "string" } },
          "environment": { "type": "object" },
          "acquiredAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "choices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selected",
          "selectedBy",
          "sourceRef"
        ],
        "properties": {
          "selected": {
            "type": "string",
            "minLength": 1
          },
          "selectedBy": {
            "type": "string",
            "description": "Checked against resources/interaction.json.selectionSource."
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "description": "Reference to the actual user message selecting this option."
          }
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "blocked",
        "done",
        "stopped"
      ]
    },
    "chain": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]+(?:\\.[a-z]+)+$"
      }
    },
    "current": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+/[0-9]+$"
    },
    "leases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "holds"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requestHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "planned": {
      "description": "branch \"N/M\" -> the requirements the plan fixed for it (scripts/plan-chain.mjs presets: a bind's role, a preflight's roles, a preset mode), written when the chain is drawn or redrawn and before the branch's request exists; the chain gate reads a bind's role from here until the request is written, and the request that dispatches the branch carries these values unchanged (scripts/validate-request.mjs#plannedRequirementErrors); inputs: the imported slot references the plan bound for the branch (scripts/plan-chain.mjs imports), read by the chain gate until the request is written and carried unchanged by the request that dispatches the branch",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "object"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "kind -> step-N/parallel-M/... reference into an imported slot of this session"
          }
        }
      }
    },
    "resumes": {
      "description": "branch \"N/M\" that re-enters a blocked branch: which one, and the stop it answered",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resumes",
          "stop"
        ],
        "properties": {
          "resumes": {
            "type": "string",
            "pattern": "^[0-9]+/[0-9]+$"
          },
          "stop": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        }
      }
    },
    "stoppedAt": {
      "description": "where the session ended: a terminating stop, a response that failed a validator (stop null), or a person",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "operator",
        "stop",
        "why"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^[0-9]+/[0-9]+$"
        },
        "operator": {
          "type": "string"
        },
        "stop": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "substitutions": {
      "description": "codes the orchestrator read as UNKNOWN_STOP: branch -> the code the agent wrote",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "branch",
          "event"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "branch": {
            "type": "string",
            "pattern": "^[0-9]+/[0-9]+(?:/[a-z][a-z-]*)?$"
          },
          "event": {
            "enum": [
              "dispatched",
              "waiting",
              "resumed",
              "done",
              "blocked",
              "invalid",
              "resolved",
              "abandoned",
              "replanned"
            ]
          },
          "note": {
            "type": "string"
          },
          "goalVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "the mission version the redrawn chain runs under; required when event is replanned: equal to mission.version when only the chain changed (a red gate routed back to an owner, a plan produced its units, a stop added an operator) and the goal did not, the next version when the goal was corrected and confirmed again"
          },
          "logged": {
            "const": true,
            "description": "the two-line transition log (resources/interaction.json#transitionLog) was printed to the root chat for this transition; required on every transition of a session that carries a mission (scripts/validate-session.mjs)"
          }
        },
        "if": {
          "required": [
            "event"
          ],
          "properties": {
            "event": {
              "const": "replanned"
            }
          }
        },
        "then": {
          "required": [
            "note",
            "goalVersion"
          ]
        }
      }
    },
    "brief": {
      "description": "the orchestrator's own memory of the mission, rewritten after every transition and read back after a context compaction: what is proven, what is blocked and on whom, what comes next, which peer session owns which head, and the last report the person received; the only orchestrator memory the tree recognises — a note file beside it is a second home",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proven",
        "blocked",
        "next",
        "peers",
        "report"
      ],
      "properties": {
        "proven": {
          "description": "what a receipt evidenced, one entry per proof. On a mission every entry opens with the coordinate that carries the evidence, in one of the two spellings $defs.provenEntry publishes, and scripts/validate-session.mjs#provenErrors resolves it against the goal ledger; off a mission the field is free prose and nothing resolves it",
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "blocked": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what",
              "owner",
              "since"
            ],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "who clears it: a domain of routing.json, a peer session id, a person, or an outside party"
              },
              "since": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "pattern": "^[0-9]+/[0-9]+$"
              }
            }
          }
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owns",
              "head"
            ],
            "properties": {
              "owns": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "wake": {
                "type": "string",
                "maxLength": 240,
                "description": "the condition on which this session resumes waiting on that peer"
              }
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "text",
            "at"
          ],
          "properties": {
            "shape": {
              "type": "string",
              "description": "one of resources/interaction.json reportShapes"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "description": "the last message the person received, in the person's language"
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "budget": {
      "description": "the caps the session runs under, written at create from resources/orchestrator.json#budget; a request past a cap is refused (BUDGET_EXHAUSTED) unless an extension recorded here points at a user choice of continue",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSteps",
        "maxSameOperator"
      ],
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "maxSameOperator": {
          "type": "integer",
          "minimum": 1
        },
        "units": {
          "type": "integer",
          "minimum": 0,
          "description": "how many units the latest plan produced; the orchestrator writes it when a units.json lands, and the step cap grows by orchestrator.json#budget.perUnit for each"
        },
        "extensions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decisionId",
              "maxSteps",
              "maxSameOperator"
            ],
            "properties": {
              "decisionId": {
                "type": "string",
                "pattern": "^budget:[a-z0-9-]+$"
              },
              "maxSteps": {
                "type": "integer",
                "minimum": 1
              },
              "maxSameOperator": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "mission": {
      "description": "the mission's goal as the person confirmed it: written at create from the request, printed to the person as one block of at most five lines — the last being the scope the plan filled into mission.scope — and confirmed through a goal-confirm choice at choices[\"goal:<sessionId>:v<version>\"]; a corrected reading is written as the next version and asked again; a replan is a replanned transition carrying the new version, never a silent rewrite",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "language",
        "goal",
        "includes",
        "excludes",
        "doneWhen",
        "sourceRef"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "the language tag the block is printed in: the display language of resources/settings.json#language (over settings.example.json, default vi) unless the person's own message is plainly in another, which is then recorded here"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "The product, source, runtime or artifact affected, shown in the v2.2 scope table."
        },
        "includes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "excludes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "doneWhen": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence",
              "producedBy"
            ],
            "properties": {
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "producedBy": {
                "type": "string",
                "pattern": "^[a-z]+(?:\\.[a-z]+)+$",
                "description": "the operator whose receipt is this evidence"
              }
            }
          }
        },
        "outputs": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "verification": {
          "type": "string", "minLength": 1, "maxLength": 500,
          "description": "Evidence reach and the limits of the conclusion, shown before confirmation."
        },
        "example": {
          "type": ["string", "null"], "maxLength": 500,
          "description": "An example only when one materially disambiguates the draft scope."
        },
        "confirmation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "decisionId", "sourceRef"],
          "properties": {
            "status": { "enum": ["draft", "confirmed", "corrected", "rejected"] },
            "decisionId": { "type": "string", "minLength": 1 },
            "sourceRef": { "type": ["string", "null"], "maxLength": 400 },
            "confirmedAt": { "type": "string", "minLength": 1 }
          }
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "description": "the person's message the block was read from"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journey",
            "deferred"
          ],
          "description": "how far the mission's verification reaches, counted off every units.json this session has landed and rewritten at each plan transition (scripts/validate-session.mjs#missionScopeErrors): journey units are the ones a lane is dispatched over, deferred ones are carried as unchecked under @worktrees/unchecked. A mission that plans surfaces and then plans flows has two plans and one coverage, so the counts are the sum: taking them off the newest plan alone lets its all-journey units erase an earlier plan's deferrals from the one line the person was shown. It is the scope line of the goal block, so the person sees the narrowing once, in the same confirmation, and is never asked about it again; before a plan has run there is no scope and the field is absent",
          "properties": {
            "journey": {
              "type": "integer",
              "minimum": 0
            },
            "deferred": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "bankRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "missionId",
            "approval"
          ],
          "description": "the banked entry this mission was opened from (@worktrees/banked/<product>/<missionId>), present only when it was. It is what makes the goal block print without waiting: the person approved the whole queue once and that answer is the goal-confirm of every mission the queue listed. scripts/validate-session.mjs#bankRefErrors refuses a bankRef whose entry is gone, whose goal is not the one the bank carries, or whose approval no longer covers the bank as it stands — so a corrected goal, a reordered queue or an edited mission puts the question back to the person",
          "properties": {
            "product": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "missionId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "approval": {
              "type": "string",
              "pattern": "^bank:[a-z0-9][a-z0-9-]*:v[1-9][0-9]*$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["contractVersion"] },
      "then": { "required": ["hostBinding", "lifecycle", "attempts", "workerSlots", "mission", "choices", "brief", "budget"] }
    }
  ]
}
