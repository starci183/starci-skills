{
  "$id": "step:response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "step",
    "parallel",
    "status",
    "fields",
    "fallbacks",
    "commits",
    "next"
  ],
  "properties": {
    "contractVersion": { "const": "starci/v2.2", "description": "Required for receipts produced by a v2.2 attempt." },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "expectedVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,159}$" },
        "number": { "type": "integer", "minimum": 1 },
        "expectedVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "observedAt", "observations"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "observedAt": { "type": "string", "minLength": 1 },
        "observations": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterionId", "observed", "evidence"],
            "properties": {
              "criterionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
              "observed": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$" } }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedVersion", "verdict", "criteria", "next"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "verdict": { "enum": ["matched", "mismatched", "inconclusive"] },
        "criteria": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterionId", "verdict", "evidence", "note"],
            "properties": {
              "criterionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
              "verdict": { "enum": ["matched", "mismatched", "inconclusive"] },
              "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$" } },
              "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        },
        "next": { "enum": ["advance", "repair", "retry", "blocked"] }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decisionId", "options"],
      "properties": {
        "kind": { "type": "string", "description": "Allowed question kinds come from resources/interaction.json." },
        "decisionId": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "tradeoff"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "tradeoff": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "schemaVersion": {
      "const": 9
    },
    "operatorId": {
      "type": "string",
      "pattern": "^[a-z]+(?:\\.[a-z]+)+$"
    },
    "step": {
      "type": "integer",
      "minimum": 1
    },
    "parallel": {
      "type": "integer",
      "minimum": 1
    },
    "exchange": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*$"
    },
    "status": {
      "enum": [
        "running",
        "done",
        "blocked",
        "waiting"
        ,"mismatch"
      ],
      "description": "running is the skeleton the orchestrator writes at dispatch and never routes; the agent replaces it with done, blocked or waiting, and an agent that exits leaving it in place is RECEIPT_MISSING"
    },
    "stop": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "awaiting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange",
        "kind"
      ],
      "properties": {
        "exchange": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?:[a-z][a-z-]*/)?response/(?:data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$"
            }
          }
        ]
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z]+(?:\\.[a-z]+)+|user|external)$"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "One paragraph for a person: why the branch blocked or waits, when the kind files could not be written"
    },
    "boundProfile": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*$",
      "description": "The active profile operator.json binds; every v2.2 receipt records it even when no stand-in ran"
    },
    "ranProfile": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*$",
      "description": "The profile that actually ran the branch"
    },
    "goalCheck": {
      "description": "The agent's own check against the branch goal (request.json.goal.doneWhen): whether the done-when line is now evidenced, and by which of this response's declared files. Required on a done response whose request carried goal.doneWhen; every evidence path is one the fields list and exists on disk; achieved true needs at least one (scripts/validate-response.mjs#goalCheckErrors). Only a validator-accepted goalCheck reaches state.json.brief.proven.",
      "type": "object",
      "additionalProperties": false,
      "required": ["achieved", "evidence"],
      "properties": {
        "achieved": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$"
          }
        }
      }
    },
    "outcome": {
      "description": "The reviewable result presented after a v2.2 done attempt is accepted. Every ref is one of this response's owned fields and is sealed with the attempt evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "primary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "primary": { "$ref": "#/definitions/outcomeItem" },
        "secondary": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/outcomeItem" }
        },
        "selectionReason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  },
  "definitions": {
    "outcomeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "ref"],
      "properties": {
        "kind": { "enum": ["image", "table", "code", "diagram", "document", "link"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ref": { "type": "string", "pattern": "^(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["contractVersion"] },
      "then": { "required": ["attempt", "boundProfile"] }
    },
    {
      "if": { "required": ["contractVersion"], "properties": { "status": { "enum": ["done", "blocked", "mismatch", "waiting"] } } },
      "then": { "required": ["ranProfile"] }
    },
    {
      "if": { "required": ["contractVersion"], "properties": { "status": { "enum": ["done", "blocked", "mismatch"] } } },
      "then": { "required": ["actual", "comparison"] }
    },
    {
      "if": { "required": ["contractVersion"], "properties": { "status": { "const": "done" } } },
      "then": { "required": ["outcome"] }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "stop"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting"
          }
        }
      },
      "then": {
        "required": [
          "awaiting"
        ]
      }
    }
  ]
}
