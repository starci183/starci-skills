{
  "$id": "step:request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "step", "parallel", "sessionId", "contexts", "requirements", "inputs", "resume"],
  "properties": {
    "contractVersion": { "const": "starci/v2.2", "description": "Required for every request created by the v2.2 session runtime. Absence is accepted only when reading a legacy v9 bundle." },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "kind", "previous"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,159}$" },
        "number": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["initial", "repair", "retry", "resume"] },
        "previous": { "type": ["string", "null"], "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,159}$" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "goalVersion", "sourceRef", "criteria"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "goalVersion": { "type": "integer", "minimum": 1 },
        "sourceRef": { "type": "string", "minLength": 1, "maxLength": 400 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "required", "expected", "verification"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
              "required": { "type": "boolean" },
              "expected": { "type": "string", "minLength": 1, "maxLength": 500 },
              "verification": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolationId", "mode", "workspace", "reads", "writes", "exclusive", "outputRoot"],
      "properties": {
        "isolationId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mode": { "enum": ["inline", "dispatch", "isolated"] },
        "workspace": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["alias", "worktree", "revision"],
              "properties": {
                "alias": { "type": "string", "pattern": "^@[a-z][a-z-]*(?:/[^\\s]+)*$" },
                "worktree": { "type": "string", "minLength": 1, "maxLength": 500 },
                "revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
              }
            }
          ]
        },
        "reads": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "writes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "exclusive": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "outputRoot": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "frozenInputs": {
      "description": "Request-side artifacts whose bytes are frozen before dispatch. The attempt gate verifies every digest both when opening and accepting the attempt.",
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": { "type": "string", "pattern": "^request/(?:[A-Za-z0-9_.-]+|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "decisionId": { "type": "string", "minLength": 1, "description": "Stable id of a recorded user tier/direction choice; paired with selectedOption." },
    "selectedOption": { "type": "string", "minLength": 1, "description": "Must equal state.json.choices[decisionId].selected; never an agent default." },
    "schemaVersion": { "const": 9 },
    "operatorId": { "type": "string", "pattern": "^[a-z]+(?:\\.[a-z]+)+$" },
    "step": { "type": "integer", "minimum": 1 },
    "parallel": { "type": "integer", "minimum": 1 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "exchange": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "head"],
        "properties": {
          "alias": { "type": "string", "pattern": "^@[a-z][a-z-]*(?:/[A-Za-z0-9_<>.@#:-]+)*$" },
          "head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "requirements": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null", "array", "object"] } },
    "inputs": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^step-\\d+/parallel-\\d+/(?:[a-z][a-z-]*/)?response/(?:(?:[a-z][a-z-]*/)*[A-Za-z0-9_.-]+\\.md|data/[A-Za-z0-9_./-]+\\.json|artifacts/[A-Za-z0-9_./-]+)$" }
    },
    "goal": {
      "description": "What this branch is for: doneWhen, the index of the one state.json.mission.doneWhen line whose evidence this branch produces (its producedBy is this operator), or prerequisite, the branch N/M this one enables. Required on every branch of a session that carries a mission (scripts/validate-request.mjs#branchGoalErrors); a branch that points at nothing does not run.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["doneWhen"] },
        { "required": ["prerequisite"] }
      ],
      "properties": {
        "doneWhen": { "type": "integer", "minimum": 0 },
        "prerequisite": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" }
      }
    },
    "unit": {
      "description": "The one unit this branch runs: an id of the units.json bound as inputs.units, which an earlier <domain>.plan branch produced (templates/kinds/units.schema.json). Required on a mission branch of an execute operator whose domain has a plan operator and whose done-when lines number more than one (scripts/validate-request.mjs#unitGateErrors); a blind agent takes one page, one modal, one flow.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "resume": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "parallel", "token"],
          "properties": { "step": { "type": "integer", "minimum": 1 }, "parallel": { "type": "integer", "minimum": 1 }, "token": { "type": "string", "minLength": 1 } }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["contractVersion"] },
      "then": { "required": ["attempt", "expected", "environment", "frozenInputs"] }
    }
  ]
}
