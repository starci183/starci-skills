{
  "$id": "kind:workflow-verification-report",
  "description": "The sole machine-readable shape of workflow.verify's read-only portfolio proof. Version 1 remains readable for a single-head peer. Version 2 separates complete original goal proof from exact delivered heads at each routed repository boundary.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshotHash", "peers"],
      "properties": {
        "version": { "const": 1 },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peerV1" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshotHash", "peers"],
      "properties": {
        "version": { "const": 2 },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peerV2" }
        },
        "coordination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assignment", "edges", "heads", "fingerprint", "combined"],
          "properties": {
            "assignment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "hash"],
              "properties": {
                "ref": { "type": "string", "pattern": "^runtime/history/assignments/[0-9a-f]{64}\\.json$" },
                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
              }
            },
            "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["dependencyId", "producerSessionId", "consumerSessionId", "producer", "incorporation", "regression"],
                "properties": {
                  "dependencyId": { "type": "string", "minLength": 1 },
                  "producerSessionId": { "type": "string", "minLength": 1 },
                  "consumerSessionId": { "type": "string", "minLength": 1 },
                  "producer": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fingerprint", "requestHash"],
                    "properties": {
                      "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "requestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                    }
                  },
                  "incorporation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["step", "parallel", "fingerprint", "requestHash", "sourceReceipts"],
                    "properties": {
                      "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "requestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "step": { "type": "integer", "minimum": 1 },
                      "parallel": { "type": "integer", "minimum": 1 },
                      "sourceReceipts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["alias", "intent", "receipt"],
                          "properties": {
                            "alias": { "type": "string", "pattern": "^@workspaces/(fe|be)$" },
                            "intent": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["ref", "hash"],
                              "properties": {
                                "ref": { "type": "string", "pattern": "^runtime/history/incorporations/[0-9a-f]{64}\\.json$" },
                                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                              }
                            },
                            "receipt": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["ref", "hash"],
                              "properties": {
                                "ref": { "type": "string", "pattern": "^runtime/history/incorporations/[0-9a-f]{64}\\.json$" },
                                "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "regression": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["step", "parallel", "fingerprint", "requestHash"],
                    "properties": {
                      "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "requestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "step": { "type": "integer", "minimum": 1 },
                      "parallel": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            },
            "heads": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sessionId", "alias", "head"],
                "properties": {
                  "sessionId": { "type": "string", "minLength": 1 },
                  "alias": { "type": "string", "minLength": 1 },
                  "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
                }
              }
            },
            "combined": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sessionId", "step", "parallel", "fingerprint", "requestHash", "heads", "runtime"],
              "properties": {
                "sessionId": { "type": "string", "minLength": 1 },
                "step": { "type": "integer", "minimum": 1 },
                "parallel": { "type": "integer", "minimum": 1 },
                "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "requestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "heads": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["repository", "head", "contributions", "alias"],
                    "properties": {
                      "repository": { "type": "string", "minLength": 1 },
                      "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                      "contributions": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["sessionId", "head"],
                          "properties": {
                            "sessionId": { "type": "string", "minLength": 1 },
                            "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
                          }
                        }
                      },
                      "alias": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "runtime": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["alias", "head", "repositoryHash", "endpoint", "fingerprint"],
                    "properties": {
                      "alias": { "enum": ["@workspaces/fe", "@workspaces/be"] },
                      "head": { "$ref": "#/$defs/head" },
                      "repositoryHash": { "$ref": "#/$defs/hash" },
                      "endpoint": { "type": "string", "pattern": "^https?://" },
                      "fingerprint": { "$ref": "#/$defs/hash" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "peerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sessionId", "goal", "owns", "head", "doneWhen", "stateHash", "evidence"],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "head": { "$ref": "#/$defs/head" },
        "doneWhen": { "$ref": "#/$defs/doneWhen" },
        "stateHash": { "$ref": "#/$defs/hash" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceV1" }
        }
      }
    },
    "peerV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sessionId", "goal", "owns", "heads", "doneWhen", "stateHash", "evidence"],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "heads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verifiedHead" }
        },
        "doneWhen": { "$ref": "#/$defs/doneWhen" },
        "stateHash": { "$ref": "#/$defs/hash" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceV2" }
        }
      }
    },
    "verifiedHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "head", "repositoryHash", "deliveryEvidence"],
      "properties": {
        "alias": { "$ref": "#/$defs/workspaceAlias" },
        "head": { "$ref": "#/$defs/head" },
        "repositoryHash": { "$ref": "#/$defs/hash" },
        "deliveryEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indexedEvidence" }
        }
      }
    },
    "evidenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "indexedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doneWhen", "ref", "fingerprint"],
      "properties": {
        "doneWhen": { "type": "integer", "minimum": 0 },
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "evidenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doneWhen", "ref", "fingerprint"],
      "properties": {
        "doneWhen": { "type": "integer", "minimum": 0 },
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "revision", "terminalHead", "relation"],
          "properties": {
            "alias": { "$ref": "#/$defs/workspaceAlias" },
            "revision": { "$ref": "#/$defs/head" },
            "terminalHead": { "$ref": "#/$defs/head" },
            "relation": { "enum": ["exact", "ancestor"] }
          }
        }
      }
    },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
    "sessionId": { "type": "string", "pattern": "^(?!central-runtime$)(?!.*\\.\\.)[a-z0-9][a-z0-9.-]{0,127}$" },
    "owns": { "type": "string", "minLength": 1, "maxLength": 240 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 240 },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workspaceAlias": { "type": "string", "pattern": "^@workspaces/[A-Za-z0-9_.@#:-]+$" },
    "doneWhen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "ref": { "type": "string", "pattern": "^step-[1-9][0-9]*/parallel-[1-9][0-9]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
