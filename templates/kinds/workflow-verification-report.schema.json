{
  "$id": "kind:workflow-verification-report",
  "description": "The sole machine-readable shape of workflow.verify's read-only portfolio proof. Version 1 remains readable for a single-head peer. Version 2 separates complete original goal proof from exact delivered heads at each routed repository boundary.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshotHash", "peers"],
      "properties": {
        "version": { "const": 1 },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peerV1" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "snapshotHash", "peers"],
      "properties": {
        "version": { "const": 2 },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peerV2" }
        }
      }
    }
  ],
  "$defs": {
    "peerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sessionId", "goal", "owns", "head", "doneWhen", "stateHash", "evidence"],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "head": { "$ref": "#/$defs/head" },
        "doneWhen": { "$ref": "#/$defs/doneWhen" },
        "stateHash": { "$ref": "#/$defs/hash" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceV1" }
        }
      }
    },
    "peerV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "sessionId", "goal", "owns", "heads", "doneWhen", "stateHash", "evidence"],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "heads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verifiedHead" }
        },
        "doneWhen": { "$ref": "#/$defs/doneWhen" },
        "stateHash": { "$ref": "#/$defs/hash" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceV2" }
        }
      }
    },
    "verifiedHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "head", "repositoryHash", "deliveryEvidence"],
      "properties": {
        "alias": { "$ref": "#/$defs/workspaceAlias" },
        "head": { "$ref": "#/$defs/head" },
        "repositoryHash": { "$ref": "#/$defs/hash" },
        "deliveryEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indexedEvidence" }
        }
      }
    },
    "evidenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "indexedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doneWhen", "ref", "fingerprint"],
      "properties": {
        "doneWhen": { "type": "integer", "minimum": 0 },
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "evidenceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doneWhen", "ref", "fingerprint"],
      "properties": {
        "doneWhen": { "type": "integer", "minimum": 0 },
        "ref": { "$ref": "#/$defs/ref" },
        "fingerprint": { "$ref": "#/$defs/hash" },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias", "revision", "terminalHead", "relation"],
          "properties": {
            "alias": { "$ref": "#/$defs/workspaceAlias" },
            "revision": { "$ref": "#/$defs/head" },
            "terminalHead": { "$ref": "#/$defs/head" },
            "relation": { "enum": ["exact", "ancestor"] }
          }
        }
      }
    },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" },
    "sessionId": { "type": "string", "pattern": "^(?!central-runtime$)(?!.*\\.\\.)[a-z0-9][a-z0-9.-]{0,127}$" },
    "owns": { "type": "string", "minLength": 1, "maxLength": 240 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 240 },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workspaceAlias": { "type": "string", "pattern": "^@workspaces/[A-Za-z0-9_.@#:-]+$" },
    "doneWhen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "ref": { "type": "string", "pattern": "^step-[1-9][0-9]*/parallel-[1-9][0-9]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
