{
  "$id": "kind:stack-model",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "selectedAlternativeId", "alternatives", "boundaries", "stores", "components", "operations"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "verified", "evidence"],
      "properties": {
        "axis": { "enum": ["runtime-version", "deployable-unit", "communication-failure", "datastore-ownership", "backup-restore"] },
        "verified": { "type": "boolean" },
        "evidence": { "type": "string" }
      }
    }
  },
  "properties": {
    "decisionId": { "$ref": "#/$defs/id" },
    "selectedAlternativeId": { "$ref": "#/$defs/id" },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alternativeId", "status", "scores", "rejectedBecause"],
        "properties": {
          "alternativeId": { "$ref": "#/$defs/id" },
          "status": { "enum": ["selected", "rejected"] },
          "scores": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 5 } },
          "rejectedBecause": { "type": ["string", "null"] }
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundaryId", "responsibility", "owner", "interfaces", "ownsData"],
        "properties": {
          "boundaryId": { "$ref": "#/$defs/id" },
          "responsibility": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "interfaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "ownsData": { "type": "boolean" }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["storeId", "owningBoundaryId", "writers", "readers", "migrators", "transactionScope", "backup", "restore", "sharedWriteJustification"],
        "properties": {
          "storeId": { "$ref": "#/$defs/id" },
          "owningBoundaryId": { "$ref": "#/$defs/id" },
          "writers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "readers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "migrators": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "transactionScope": { "type": "string", "minLength": 1 },
          "backup": { "type": "string", "minLength": 1 },
          "restore": { "type": "string", "minLength": 1 },
          "sharedWriteJustification": { "type": ["string", "null"] }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "description": "One row per write this decision commits to. The implementation restates these unchanged as the operations of its mutation record; it may not add one, and it may not choose its own writer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "name", "transport", "writerRef", "storeRefs", "transactionBoundary", "idempotencyKind", "migrationRefs", "authorityDimensionIds"],
        "properties": {
          "operationId": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "transport": { "enum": ["graphql-mutation", "graphql-query", "rest", "worker", "cron", "event-consumer"] },
          "writerRef": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "The one file path this operator names: the implementation may not choose its own writer." },
          "storeRefs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
          "transactionBoundary": { "enum": ["single-transaction", "per-item", "read-only", "none"] },
          "idempotencyKind": { "enum": ["none", "natural-key", "request-token", "event-id"] },
          "migrationRefs": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
          "authorityDimensionIds": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/id" }, "description": "The coverage-matrix dimensions of the bound business head this operation implements." }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "status", "justification", "evidence", "compatibility"],
        "properties": {
          "componentId": { "$ref": "#/$defs/id" },
          "status": { "enum": ["existing", "added", "replaced", "removed", "replaced-candidate"] },
          "justification": { "enum": ["measured-constraint", "observed-evidence", "requirement-fit", null] },
          "evidence": { "type": ["string", "null"] },
          "compatibility": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/verdict" } }
        }
      }
    }
  }
}
