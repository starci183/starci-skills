{
  "$id": "kind:goal-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "repositories",
    "impacts",
    "destinations",
    "unresolved",
    "lanes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "stage": {
      "enum": [
        "handoff",
        "implement",
        "publish",
        "deploy"
      ]
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "project",
          "repository",
          "routeRef",
          "head"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "routeRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "head": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "routes",
          "code",
          "behavior",
          "tags",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "feature",
                "business",
                "architecture",
                "backend",
                "data",
                "api",
                "interface",
                "browser",
                "runtime",
                "tooling",
                "documentation"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 1
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "kind",
          "target"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "enum": [
              "artifact",
              "branch",
              "environment"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "enum": [
              "planned",
              "not-applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
