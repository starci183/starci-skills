{
  "$id": "kind:workflow-peers",
  "description": "The sole machine-readable shape of request/peers.json. Version 1 retains the original single-head peer contract. Version 2 freezes one exact terminal head per routed repository boundary and records the original child done-when lines required at each head. The verifier derives every current obligation from accepted proof and refuses an omitted deliveryDoneWhen; only the coordinated topology's closed ancestralEvidenceOperators may remain on same-repository ancestry. Ordinary task messages may supply these values to the coordinator but are transport only; they are neither part of this contract nor evidence of an outcome.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "peers"],
      "properties": {
        "version": { "const": 1 },
        "peers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/taskId" },
          "additionalProperties": { "$ref": "#/$defs/peerV1" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "peers"],
      "properties": {
        "version": { "const": 2 },
        "peers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/taskId" },
          "additionalProperties": { "$ref": "#/$defs/peerV2" }
        }
      }
    }
  ],
  "$defs": {
    "peerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "goal", "owns", "head", "doneWhen"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "head": { "$ref": "#/$defs/head" },
        "doneWhen": { "$ref": "#/$defs/doneWhen" }
      }
    },
    "peerV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "goal", "owns", "heads", "doneWhen"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/sessionId" },
        "goal": { "$ref": "#/$defs/goal" },
        "owns": { "$ref": "#/$defs/owns" },
        "heads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/repositoryHead" }
        },
        "doneWhen": { "$ref": "#/$defs/doneWhen" }
      }
    },
    "repositoryHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "head", "deliveryDoneWhen"],
      "properties": {
        "alias": { "$ref": "#/$defs/workspaceAlias" },
        "head": { "$ref": "#/$defs/head" },
        "deliveryDoneWhen": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^(?!central-runtime$)(?!.*\\.\\.)[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "owns": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workspaceAlias": {
      "type": "string",
      "pattern": "^@workspaces/[A-Za-z0-9_.@#:-]+$"
    },
    "doneWhen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
