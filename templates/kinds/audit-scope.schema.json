{
  "$id": "kind:audit-scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "surfaces",
    "deferredStates",
    "coverageClaim"
  ],
  "properties": {
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "surfaces": {
      "$ref": "#/$defs/surfaces"
    },
    "deferredStates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deferrals": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "description": "One entry per deferredStates entry, giving the reason that state was not reached. A state deferred with no reason is a skip nobody can read, and scripts/record-unchecked.mjs copies this sentence into the ledger line so the ledger states no reason of its own.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "reason"
        ],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "coverageClaim": {
      "enum": [
        "selected-surfaces",
        "full-state-matrix",
        "incomplete"
      ]
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "primary-surfaces",
        "exhaustive"
      ],
      "default": "primary-surfaces"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "route",
          "matrixIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "matrixIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "type": {
            "enum": [
              "page",
              "layout",
              "modal",
              "drawer"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "primary",
              "deferred"
            ],
            "default": "primary"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "surfaces": {
          "$ref": "#/$defs/surfaces"
        }
      }
    },
    "deferredTasteRule": {
      "enum": [
        "TASTE-10"
      ]
    },
    "journeyStates": {
      "description": "The states a unit the mission's journey passes through is always measured in, and which therefore cannot be carried as unchecked. They are the conditions a person meets on the way through — waiting for the data, waiting with a placeholder, arriving at nothing, and arriving at a failure — the same four the taste lens scores a captured state on (TASTE-10 and the loading, empty and error cases of the taste topic). A deferral naming one of these under a journey unit is UNCHECKED_UNLAWFUL and goes back to the plan that tiered the unit, because the fix is a tier, not a smaller audit. This list is the one home of that set; the gate reads it from here.",
      "enum": [
        "loading",
        "skeleton",
        "empty",
        "error"
      ]
    }
  }
}
