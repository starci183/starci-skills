{
  "$id": "kind:probes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deadlineSeconds",
    "elapsedSeconds",
    "backoffSeconds",
    "observations",
    "finalCondition"
  ],
  "properties": {
    "deadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "elapsedSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "backoffSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observedAt",
          "condition",
          "activeReleaseIds",
          "activeDigest",
          "availableTargets",
          "probeResults"
        ],
        "properties": {
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "condition": {
            "enum": [
              "progressing",
              "failing",
              "steady"
            ]
          },
          "activeReleaseIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^release:[A-Za-z0-9._-]+$"
            }
          },
          "activeDigest": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availableTargets": {
            "type": "integer",
            "minimum": 0
          },
          "probeResults": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "probeId",
                "status",
                "observedStatus",
                "observedAt"
              ],
              "properties": {
                "probeId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "observedStatus": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "finalCondition": {
      "enum": [
        "progressing",
        "failing",
        "steady",
        "deadline-exceeded"
      ]
    }
  }
}
