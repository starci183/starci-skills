{
  "$id": "kinds:contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "title", "sections"],
  "properties": {
    "reentry": {
      "description": "A sealed nested review may select this typed same-owner return route; integrity re-review binds the same owner without crediting the questioned verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stop", "heading", "row", "value"],
      "properties": {
        "stop": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "heading": { "type": "string", "pattern": "^## .+" },
        "row": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "example": { "type": "string", "pattern": "^templates/[A-Za-z0-9_./-]+\\.md$" },
    "title": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading"],
        "properties": {
          "heading": { "type": "string", "pattern": "^\\^## " },
          "table": { "type": "string", "pattern": "^\\| .+ \\|$" },
          "minRows": { "type": "integer", "minimum": 0 },
          "maxRows": { "type": "integer", "minimum": 1 },
          "exactRows": { "type": "integer", "minimum": 0 },
          "rows": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "cell": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
