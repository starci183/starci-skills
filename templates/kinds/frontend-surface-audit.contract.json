        "Screenshot": "^`response/artifacts/[A-Za-z0-9_.-]+[.]png`$"
      }
    },
    {
      "heading": "^## Verdicts by owner$",
      "table": "| Matrix | Owner | Node | Rule | Measured | Verdict |",
