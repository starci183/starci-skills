        "Node": "^`[^`]+`$",
        "Rule": "^`[A-Z][A-Z0-9-]*-[0-9]+`$",
        "Verdict": "^(pass|fail)$",
        "Matrix": "^`[a-z0-9][a-z0-9-]*`$"
      }
    },
    {
      "heading": "^## Taste$",
      "table": "| Rule | Measured | Score | Verdict |",
