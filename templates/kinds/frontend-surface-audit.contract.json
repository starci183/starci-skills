        "Verdict": "^(pass|fail|ship|fix-first|blocked)$",
        "Route": "^(resolve|direction|seed|flow-owner|grammar-gap|none)$"
      }
    },
    {
      "heading": "^## Regressions$",
      "table": "| Matrix | Node | Rule | Measured | Routes to |",
