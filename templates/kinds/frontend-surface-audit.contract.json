      "cell": {
        "Rule": "^`TASTE-([1-9]|1[0-2])`$",
        "Measured": "\\S",
        "Score": "^[1-5]$",
        "Verdict": "^(pass|fail)$"
      }
    },
    {
      "heading": "^## Verdict$",
      "table": "| Topic | Verdict | Route |",
      "exactRows": 8,
      "rows": [
        "presentation",
        "composition",
        "responsive",
        "motion",
        "accessibility",
        "contrast",
        "render-truth",
        "taste"
