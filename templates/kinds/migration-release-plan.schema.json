{
  "$id": "kind:migration-release-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "env",
    "target",
    "sourceHead",
    "contractFingerprint",
    "runner",
    "configuration",
    "connectionRef",
    "connectionFingerprint",
    "migrations",
    "journal",
    "journalBefore",
    "journalExistsBefore",
    "journalFingerprintBefore",
    "environmentSha256"
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$",
      "maxLength": 1024
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "env": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "sourceHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contractFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "runner": {
      "$ref": "#/$defs/file"
    },
    "configuration": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "connectionRef": {
      "type": "string",
      "pattern": "^secret-ref://[A-Za-z0-9][A-Za-z0-9_./-]*$"
    },
    "connectionFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "table",
        "allowInitialization"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "allowInitialization": {
          "type": "boolean"
        }
      }
    },
    "journalBefore": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "journalExistsBefore": {
      "type": "boolean"
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "path": {
            "$ref": "#/$defs/relative"
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "journalFingerprintBefore": {
      "$ref": "#/$defs/hash"
    },
    "environmentSha256": {
      "$ref": "#/$defs/hash"
    }
  }
}
