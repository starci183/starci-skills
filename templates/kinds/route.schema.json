{
  "$id": "kind:route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "role",
    "portableRouteRef",
    "hydratedRouteRef",
    "routeFingerprint",
    "identityFingerprint",
    "sourceHead",
    "checkout",
    "gitPolicy",
    "mutationReadiness",
    "writeRoots",
    "authorityRoots",
    "runtime",
    "provenanceHeadRef"
  ],
  "properties": {
    "project": {
      "$ref": "#/$defs/slug"
    },
    "role": {
      "$ref": "#/$defs/slug"
    },
    "portableRouteRef": {
      "type": "string",
      "minLength": 1
    },
    "hydratedRouteRef": {
      "type": "string",
      "minLength": 1
    },
    "routeFingerprint": {
      "$ref": "#/$defs/fingerprint",
      "description": "sha256 over the bytes of the portable declaration followed by the bytes of the hydrated route, each exactly as stored on disk, with no normalisation."
    },
    "identityFingerprint": {
      "$ref": "#/$defs/fingerprint",
      "description": "sha256 over the bytes of .workspaces/device-state.json, exactly as stored on disk, with no normalisation."
    },
    "sourceHead": {
      "$ref": "#/$defs/gitHead"
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diskPath",
        "gitRoot",
        "gitRepository",
        "branch",
        "repositoryKind",
        "directory",
        "sourceHead"
      ],
      "properties": {
        "diskPath": {
          "type": "string",
          "minLength": 1
        },
        "gitRoot": {
          "type": "string",
          "minLength": 1
        },
        "gitRepository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "repositoryKind": {
          "enum": [
            "source",
            "sibling"
          ]
        },
        "directory": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceHead": {
          "$ref": "#/$defs/gitHead"
        }
      }
    },
    "gitPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktreeBranches",
        "mutationBranch"
      ],
      "properties": {
        "worktreeBranches": {
          "enum": [
            "forbidden",
            "session-only"
          ]
        },
        "mutationBranch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutationReadiness": {
      "enum": [
        "ready",
        "read-only"
      ]
    },
    "writeRoots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The write roots the request declared; empty for a read-only binding (declaredWriteRoots defaults to empty)."
    },
    "authorityRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businesses"
      ],
      "properties": {
        "businesses": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "\\.worktrees/businesses$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtimeConsumption"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenanceHeadRef": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "serviceKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "runtimeConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerTaskId",
        "registryEntryKey",
        "served",
        "generation",
        "status",
        "consumerRole",
        "endpointBinding",
        "endpoints",
        "identity"
      ],
      "properties": {
        "ownerTaskId": {
          "type": "string",
          "minLength": 1
        },
        "registryEntryKey": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "The registry entry this binding read, as `<project>/<role>`. The registry holds one entry per route, so a binding names the entry it consumed and a route can never be judged not ready because a sibling route's entry was the one that was read."
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "starting",
            "ready",
            "degraded",
            "stopped"
          ]
        },
        "consumerRole": {
          "const": "consumer"
        },
        "endpointBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "project",
            "application",
            "services",
            "authorityFingerprint"
          ],
          "properties": {
            "authority": {
              "const": "workspace-route-port-projection"
            },
            "project": {
              "$ref": "#/$defs/slug"
            },
            "application": {
              "$ref": "#/$defs/slug"
            },
            "services": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frontend",
                "api",
                "identity"
              ],
              "properties": {
                "frontend": {
                  "$ref": "#/$defs/serviceKey"
                },
                "api": {
                  "$ref": "#/$defs/serviceKey"
                },
                "identity": {
                  "$ref": "#/$defs/serviceKey"
                }
              }
            },
            "authorityFingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frontend",
            "api",
            "identity"
          ],
          "properties": {
            "frontend": {
              "type": "string",
              "minLength": 1
            },
            "api": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "identity": {
          "description": "The identity declaration the registry entry carries, copied unchanged. It says where an account for this route is created and the name of the sealed credential its password is set from. Null means the entry declares no provider, which is why a request to provision an account against this route is refused at the gate instead of guessed at.",
          "oneOf": [
            {
              "$ref": "#/$defs/identityDeclaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "served": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "head",
            "contains",
            "port",
            "leaseSessionId"
          ],
          "description": "What the entry is actually serving: the integration branch, the head the server runs, the commits that head is known to contain, the fixed port, and the session holding the lease if one is. A binding does not require the served head to equal the head it pinned — one server carries the work of several sessions — it requires its own head to be inside that served head, and `contains` is where it reads that.",
          "properties": {
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "head": {
              "$ref": "#/$defs/gitHead"
            },
            "contains": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gitHead"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "leaseSessionId": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "identityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "adminEndpoint",
        "realm",
        "tenant",
        "credentialName"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "adminEndpoint": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "realm": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tenant": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    }
  }
}
