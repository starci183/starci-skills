{
  "$id": "kind:uat-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "requestedBy",
    "feature",
    "flow",
    "env",
    "commit",
    "frozenAt",
    "flowRoot",
    "snapshotRef",
    "snapshotFingerprint",
    "lease",
    "admission",
    "accounts",
    "fixtureNamespace",
    "seed",
    "cases",
    "flowSource",
    "golden",
    "isolation"
  ],
  "properties": {
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "$ref": "#/$defs/slug"
    },
    "flow": {
      "$ref": "#/$defs/slug"
    },
    "env": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The environment this run drove. Accounts and the approved reference are both per environment, so a run that does not say which one it was in can be compared with the wrong baseline."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "flowRoot": {
      "type": "string",
      "minLength": 1
    },
    "snapshotRef": {
      "type": "string",
      "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/snapshot\\.json$"
    },
    "snapshotFingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "lease": {
      "description": "The exclusive lease on the flow directory. One run writes it at a time; the lease is granted by the orchestrator and is never asked of a person.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseRef",
        "exclusive",
        "expiresAt"
      ],
      "properties": {
        "leaseRef": {
          "type": "string",
          "pattern": "^uat-lease://[A-Za-z0-9._~/-]+$"
        },
        "exclusive": {
          "const": true
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "admission": {
      "description": "The two receipts that admit product UAT, each pinned at the commit this run verifies.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "commit"
        ],
        "properties": {
          "kind": {
            "enum": [
              "frontend-surface-audit",
              "quality-verification"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "accounts": {
      "description": "One frozen account per alias the flow names, each a dedicated username with the shared password resolved by name. Every field is a name or a reference, so a password has nowhere to live even by accident.",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "username",
          "role",
          "credentialName",
          "credentialRef",
          "custody",
          "isUat",
          "plaintextRecorded",
          "identity",
          "provisionedBy"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "username": {
            "type": "string",
            "pattern": "^uat-[A-Za-z0-9._-]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "credentialName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "credentialRef": {
            "type": "string",
            "pattern": "^\\.stacks/[a-z0-9][a-z0-9-]*/secrets/uat\\.enc$"
          },
          "custody": {
            "const": "sealed-shared-master-identity"
          },
          "isUat": {
            "const": true
          },
          "plaintextRecorded": {
            "const": false
          },
          "identity": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "The runtime registry entry this account exists in. An account that names none names no provider it could have been created at."
          },
          "provisionedBy": {
            "description": "The run that created the account, or null when it already existed. A flow whose account was absent is not a stop: the identity is provisioned and the run continues.",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "fixtureNamespace": {
      "$ref": "#/$defs/namespace"
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordsRef",
        "expectedRef",
        "fingerprint",
        "namespace",
        "isUat"
      ],
      "properties": {
        "recordsRef": {
          "type": "string",
          "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/seed/records\\.json$"
        },
        "expectedRef": {
          "type": "string",
          "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/seed/expected\\.json$"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "isUat": {
          "const": true
        }
      }
    },
    "flowSource": {
      "enum": [
        "committed",
        "drafted-from-template"
      ],
      "description": "Where the flow document and its seed came from. A flow folder that did not exist is created from the shipped template and the receipt says so: a drafted flow is honest, an absent flow would have been a stop, and a draft reported as committed is the one outcome neither is."
    },
    "golden": {
      "description": "The approved reference this run is compared against. A flow with no approved reference yet does not fail: this run becomes the candidate, and only a person's approval promotes it, so no run ever approves its own baseline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "ref",
        "approvedBy",
        "env"
      ],
      "properties": {
        "state": {
          "enum": [
            "approved",
            "candidate"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "The environment the approved reference was taken in. A golden from one environment is not authority for another."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "candidate"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "approvedBy": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "approvedBy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "order",
          "as",
          "assertions"
        ],
        "properties": {
          "caseId": {
            "$ref": "#/$defs/slug"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "as": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The alias this case acts as. It names one of the frozen accounts, so a case can never be run as an identity the flow never declared."
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "description": "What keeps this run apart from another run of the same product on the same machine. The runtime serves one integration branch on one port, so isolation is not a second server: it is this session driving its own browser profile, seeding only rows that carry its own prefix, and rolling back only what it seeded. Every field here is something another run could otherwise have written.",
      "required": [
        "sessionId",
        "browserProfileRef",
        "servedHead",
        "servedContainsCommit",
        "ancestryEvidenceRef",
        "seededIds",
        "rollbackIds"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "description": "The session this run belongs to. It is the session the request names, so a run folder written for somebody else is visible rather than merely possible."
        },
        "browserProfileRef": {
          "type": "string",
          "minLength": 1,
          "description": "This run's own browser profile. Two runs sharing one profile share a sign-in, and then each proves the other's session."
        },
        "servedHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The head the runtime was serving. It carries the work of every session that asked for it, so it is almost never equal to the commit this run verifies."
        },
        "servedContainsCommit": {
          "type": "boolean",
          "description": "Whether the served head contains the commit this run pinned. False is drift, and drift is a stop with nothing driven."
        },
        "ancestryEvidenceRef": {
          "type": "string",
          "minLength": 1,
          "description": "The record of the ancestry test, so the claim can be checked without rerunning it."
        },
        "seededIds": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Every identifier this run seeded. Each carries the run fixture namespace, which is what makes \"touched no shared row\" a fact rather than an intention."
        },
        "rollbackIds": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What cleanup removes: a subset of what this run seeded, and never one identifier more."
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^uat-[A-Za-z0-9._-]+$"
    }
  }
}
