{
  "$id": "kind:uat-verdicts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "commit",
    "resultRef",
    "latestRef",
    "historyRef",
    "lanes",
    "experience",
    "cleanup"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resultRef": {
      "type": "string",
      "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/runs/[A-Za-z0-9._-]+/result\\.json$"
    },
    "latestRef": {
      "description": "The pointer file that names the newest run. It is a file holding a run id, never a symlink: a symlink does not survive every checkout the tree is cloned into.",
      "type": "string",
      "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/latest\\.json$"
    },
    "historyRef": {
      "description": "The one-line-per-run history of this flow, appended to and never rewritten.",
      "type": "string",
      "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/history\\.md$"
    },
    "lanes": {
      "description": "Three independent lanes, judged apart on their own evidence. There is no fourth lane and no lane may be omitted.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "verdict",
          "evidenceRefs",
          "statement"
        ],
        "properties": {
          "lane": {
            "enum": [
              "behavior",
              "ux",
              "ui"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cleanup": {
      "description": "Cleanup deletes the run namespace and nothing else; a run record is history and is never deleted.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "isUat",
        "namespace",
        "runRecordsDeleted"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "isUat": {
          "const": true
        },
        "namespace": {
          "type": "string",
          "pattern": "^uat-[A-Za-z0-9._-]+$"
        },
        "runRecordsDeleted": {
          "const": false
        }
      }
    },
    "experience": {
      "description": "The UX-12 score set behind the `ux` lane: every criterion UX-1 to UX-11 with the run step or capture that measured it, and the verdict UX-12 computes over them. UX-12 is the arithmetic and is not itself scored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "mean",
        "verdict",
        "routeTo"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "measured",
              "score",
              "verdict",
              "routeTo"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^UX-([1-9]|1[01])$"
              },
              "measured": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "verdict": {
                "enum": [
                  "pass",
                  "fail",
                  "evidence-unavailable"
                ]
              },
              "routeTo": {
                "enum": [
                  "direction",
                  "flow-owner",
                  "none"
                ]
              }
            }
          }
        },
        "mean": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "verdict": {
          "enum": [
            "ship",
            "fix-first",
            "blocked"
          ]
        },
        "routeTo": {
          "enum": [
            "resolve",
            "direction",
            "flow-owner",
            "grammar-gap",
            "none"
          ]
        }
      }
    }
  }
}
