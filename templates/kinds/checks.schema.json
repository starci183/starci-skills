{
  "$id": "kind:checks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceRef",
    "serviceKind",
    "requiredCheckNames",
    "checks",
    "findings"
  ],
  "properties": {
    "serviceRef": {
      "type": "string",
      "minLength": 1
    },
    "serviceKind": {
      "enum": [
        "observability",
        "sonar",
        "tunnel",
        "runtime",
        "identity"
      ]
    },
    "requiredCheckNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/checkName"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "resourceRef",
          "status",
          "evidenceRef"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/checkName"
          },
          "resourceRef": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "resourceRef",
          "port",
          "holderRef",
          "statement"
        ],
        "properties": {
          "code": {
            "enum": [
              "SHARED_SERVICE_INVENTORIED",
              "PORT_COORDINATION_REQUIRED",
              "ALREADY_CONVERGED",
              "PARTIAL_MUTATION",
              "PRODUCT_DEPLOYMENT_DECLINED",
              "RUNTIME_ENTRY_ATTESTED",
              "IDENTITY_PROVISIONED",
              "RUNTIME_RUNG_CLIMBED",
              "RUNTIME_HEAD_SERVED",
              "RUNTIME_HEAD_REUSED",
              "RUNTIME_SERVER_RESTARTED",
              "RUNTIME_SERVER_RESET",
              "RUNTIME_SERVER_STOPPED",
              "RUNTIME_LEASE_BUSY",
              "INTEGRATION_MERGED"
            ]
          },
          "resourceRef": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "holderRef": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "checkName": {
      "enum": [
        "service-health",
        "target-boundary",
        "label-boundary",
        "remote-write-delivery",
        "sample-ordering",
        "retry-backoff",
        "sensitive-data-filter",
        "service-available",
        "project-exists",
        "source-revision",
        "profile-assigned",
        "gate-assigned",
        "enforcement-active",
        "dns-target",
        "tunnel-route",
        "tls",
        "public-https",
        "entry-declared",
        "endpoints-served",
        "head-observed",
        "generation-advanced",
        "provider-reachable",
        "credential-resolvable",
        "account-exists",
        "account-signs-in",
        "no-credential-recorded",
        "infra-ports-open",
        "cors-origin-admitted",
        "checkout-located",
        "integration-merged",
        "server-pid-owned",
        "lease-honoured"
      ]
    }
  }
}
