{
  "$id": "kind:uat-case-sheet",
  "description": "Machine-readable UAT execution sheet written by uat.plan before identity, seed or browser action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "feature", "env", "planVersion", "flows", "cases"],
  "properties": {
    "contractVersion": { "const": "starci/v2.2" },
    "feature": { "$ref": "#/$defs/slug" },
    "env": { "$ref": "#/$defs/slug" },
    "planVersion": { "type": "string", "pattern": "^uat-plan/[1-9][0-9]*$" },
    "flows": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["flowId", "state", "action", "entry", "actorAliases", "namespace"],
        "properties": {
          "flowId": { "$ref": "#/$defs/slug" },
          "state": { "enum": ["valid", "missing", "invalid"] },
          "action": { "enum": ["reuse", "create", "update"] },
          "entry": { "type": "string", "minLength": 1 },
          "actorAliases": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/alias" } },
          "namespace": { "type": "string", "pattern": "^uat-[A-Za-z0-9._-]+$" }
        },
        "allOf": [
          { "if": { "properties": { "state": { "const": "valid" } }, "required": ["state"] }, "then": { "properties": { "action": { "const": "reuse" } } } },
          { "if": { "properties": { "state": { "const": "missing" } }, "required": ["state"] }, "then": { "properties": { "action": { "const": "create" } } } },
          { "if": { "properties": { "state": { "const": "invalid" } }, "required": ["state"] }, "then": { "properties": { "action": { "const": "update" } } } }
        ]
      }
    },
    "cases": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "flowId", "order", "actor", "preconditions", "inputs", "actions", "assertions", "expected", "verification", "fixture", "cleanup"],
        "properties": {
          "caseId": { "$ref": "#/$defs/slug" },
          "flowId": { "$ref": "#/$defs/slug" },
          "order": { "type": "integer", "minimum": 1 },
          "actor": { "$ref": "#/$defs/alias" },
          "preconditions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "inputs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "actions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
          "assertions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/assertion" } },
          "expected": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "verification": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
          "fixture": {
            "type": "object", "additionalProperties": false,
            "required": ["jsonRef", "sqlRef", "createsAssertedOutcome"],
            "properties": {
              "jsonRef": { "type": "string", "pattern": "^\\.worktrees/uat/[a-z0-9-]+/[a-z0-9-]+/seed/[A-Za-z0-9._-]+\\.json$" },
              "sqlRef": { "oneOf": [{ "type": "string", "pattern": "^\\.worktrees/uat/[a-z0-9-]+/[a-z0-9-]+/seed/[A-Za-z0-9._-]+\\.sql$" }, { "type": "null" }] },
              "createsAssertedOutcome": { "const": false }
            }
          },
          "cleanup": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "alias": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "assertion": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
