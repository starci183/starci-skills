{
  "$id": "kind:ui-coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["directionId", "surfaceClass", "actions", "regions", "states", "responsive"],
  "properties": {
    "directionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "surfaceClass": {
      "description": "The one class this direction declares, from the vocabulary COVERAGE-1 Case 7 publishes. The name carries no numbers: every banded threshold lives in the proof topic that owns the measure, and this is how the topics agree which surface they are looking at. A later audit reads it here.",
      "enum": [
        "console",
        "form",
        "landing",
        "catalog",
        "reader"
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "pointerRoute", "keyboardRoute", "states"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "pointerRoute": { "type": "string", "minLength": 1 },
          "keyboardRoute": { "type": "string", "minLength": 1 },
          "states": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "pendingPaths": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "settlement"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "settlement": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "idiomRef", "compositionRef"],
        "properties": {
          "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "idiomRef": { "type": "string", "minLength": 1 },
          "compositionRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "states": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meaning", "carrier"],
        "properties": {
          "meaning": { "type": "string", "minLength": 1 },
          "carrier": { "type": "string", "minLength": 1 }
        }
      }
    },
    "responsive": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "owner"],
        "properties": {
          "branch": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
