            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "grammar": {
            "type": "string",
            "minLength": 1
          },
          "matrixId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element",
          "axis",
          "matrixId",
          "path",
          "rule",
          "capture",
          "measurement",
          "evidence",
          "verdict",
          "observation"
        ],
        "properties": {
          "element": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "axis": {
            "enum": [
