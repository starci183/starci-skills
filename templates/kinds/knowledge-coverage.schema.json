{
  "$id": "kind:knowledge-coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestFingerprint", "items"],
  "properties": {
    "schemaVersion": { "const": 10 },
    "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "applicability", "evidence"],
      "properties": {
        "key": { "type": "string", "pattern": "^(?:file|rule|case):\\S+$" },
        "applicability": { "enum": ["applicable", "n/a"] },
        "actual": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 12 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
