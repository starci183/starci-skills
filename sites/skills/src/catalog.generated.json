{
  "version": "7.6.0-beta.1",
  "skills": [
    {
      "id": "starci-feature-deliver",
      "capability": "feature.deliver",
      "description": "Coordinate one cross-domain product outcome through typed domain-skill calls, exact returns, joined proof, and resume; never implement or self-certify.",
      "domain": "feature"
    },
    {
      "id": "starci-business-process",
      "capability": "business.process",
      "description": "Process one evidence-backed business feature through modeling, challenge, publication, reconciliation, and durable backend-owned authority.",
      "domain": "business"
    },
    {
      "id": "starci-architecture-design",
      "capability": "architecture.design",
      "description": "Design and challenge one architecture with observed-state, tech-stack, data-ownership, realization, and proof boundaries.",
      "domain": "architecture"
    },
    {
      "id": "starci-backend-process",
      "capability": "backend.process",
      "description": "Process one backend outcome through prerequisite binding, contract and solution design, implementation, repair, and proof in a frozen source boundary.",
      "domain": "backend"
    },
    {
      "id": "starci-fe-process",
      "capability": "fe.process",
      "description": "Compile one UI-only frontend outcome, repair exact Grammar gaps, optionally render a reconstruct/new direction, apply it, prove each round by blind Sol review, then close through quality and UAT.",
      "domain": "fe"
    },
    {
      "id": "starci-quality-assure",
      "capability": "quality.assure",
      "description": "Assure one bounded delivery through measured readiness, executable rule binding, approved repairs or debt, and exact static quality proof.",
      "domain": "quality"
    },
    {
      "id": "starci-content-generate",
      "capability": "content.generate",
      "description": "Generate or refactor one educational content unit through a Sol teacher brief, Luna writing and implementation, visual generation, executable E2E, and independent final critique.",
      "domain": "content"
    },
    {
      "id": "starci-uat-verify",
      "capability": "uat.verify",
      "description": "Verify one product-decision flow from frozen inputs and independent Behavior, UX, and UI evidence, then publish its canonical UAT snapshot and result pair.",
      "domain": "uat"
    },
    {
      "id": "starci-release-manage",
      "capability": "release.manage",
      "description": "Manage one immutable release through deploy, monitor, recover, rollback, and public steady-state proof under exact authorization.",
      "domain": "release"
    },
    {
      "id": "starci-platform-operate",
      "capability": "platform.operate",
      "description": "Operate one bounded shared observability, Sonar, or tunnel service without taking product deployment ownership.",
      "domain": "platform"
    },
    {
      "id": "starci-workspace-manage",
      "capability": "workspace.manage",
      "description": "Manage one runtime workspace identity, routed source set, task session, provenance record, or portable checkpoint without becoming product authority.",
      "domain": "workspace"
    },
    {
      "id": "starci-git-publish",
      "capability": "git.publish",
      "description": "Publish one approved Git boundary or portable continuation checkpoint from exact mission-owned source heads without force semantics.",
      "domain": "git"
    },
    {
      "id": "starci-workflow-diagnose",
      "capability": "workflow.diagnose",
      "description": "Diagnose one failed workflow from immutable evidence and return a report without repairing source or mutating external state.",
      "domain": "workflow"
    }
  ],
