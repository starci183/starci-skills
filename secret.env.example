# Host-local plaintext credentials. Copy this example only when secret.env is missing.
# Supply values locally; never commit secret.env or paste its contents into chat.
# docs/host-secrets.md owns setup, selected-action requirements and native account auth.

# Supply an existing shared age identity locally. Initial identity publication has its own setup owner.
# Keep this commented when no identity has been supplied; an active blank intentionally disables it.
# SOPS_AGE_KEY=

# Sonar actions require the selected server and its user token.
SONAR_HOST_URL=
SONAR_TOKEN=
# Only a selected remotely managed tunnel uses this token.
# CLOUDFLARE_TUNNEL_TOKEN=
# Only an enabled Telegram connector uses this token.
# TELEGRAM_BOT_TOKEN=
