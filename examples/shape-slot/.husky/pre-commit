# Commit gate: the secrets guard, then types, lint and format of the staged files.
npx hfs work-hygiene
npm run typecheck
sources=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' '*.cjs' || true)
if [ -n "$sources" ]; then
  npx eslint --max-warnings=0 --no-warn-ignored $sources
fi
styles=$(git diff --cached --name-only --diff-filter=ACMR -- '*.css' || true)
if [ -n "$styles" ]; then
  npx stylelint $styles
fi
formatted=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$formatted" ]; then
  npx prettier --check --ignore-unknown $formatted
fi
