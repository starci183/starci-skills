{
  "name": "@shape-slot/repo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reference example: shape (state) + slot (per-API data status) across every FE tier.",
  "workspaces": [
    "apps/*"
  ],
  "prettier": "@starci/prettier-config",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@starci/eslint-canon-fe": "6.0.2",
    "@starci/hfs": "1.0.1",
    "@starci/prettier-config": "1.0.0",
    "@starci/tsconfig": "1.0.0",
    "@types/node": "22.20.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
