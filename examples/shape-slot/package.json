{
  "name": "shape-slot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "nest-commander": "3.21.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@starci/cli": "1.0.1",
    "@starci/eslint-canon-be": "3.0.10",
    "@starci/eslint-canon-fe": "8.0.10",
    "@starci/jest-preset": "2.2.5",
    "@starci/prettier-config": "1.0.3",
    "@starci/stylelint-canon": "2.0.5",
    "@starci/test-world": "1.2.1",
    "@starci/tsconfig": "2.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/core/src/main.ts",
    "dev:fe": "npm run codegen --silent && turbo run dev --filter=@shape-slot/shape-slot",
    "start:core": "node be/dist/apps/core/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:shape-slot": "npm run start -w @shape-slot/shape-slot",
    "docker:build": "npm run docker:build:core && npm run docker:build:cli && npm run docker:build:shape-slot",
    "docker:build:core": "docker build -f be/apps/core/Dockerfile -t shape-slot/core:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t shape-slot/cli:dev .",
    "docker:build:shape-slot": "docker build -f fe/apps/shape-slot/Dockerfile -t shape-slot/shape-slot:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "lint": "npm run codegen --silent && starci app lint",
    "lint:fix": "npm run codegen --silent && starci app lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:affected": "cd be && jest --selectProjects unit --passWithNoTests",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && cd be && jest --selectProjects e2e",
    "test:contract": "npm run typecheck:tests && cd be && jest --selectProjects contract",
    "test:stack": "starci app stack",
    "contract:emit": "starci app emit"
  }
}
