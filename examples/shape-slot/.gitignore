# >>> starci app sync (managed block; do not edit) >>>
# Build output and tool output the tools need in place.
node_modules/
dist/
coverage/
reports/
test-results/
*.tsbuildinfo
.scannerwork/
.turbo/
.tools/
# Generated code is rebuilt by prebuild / pretypecheck, never tracked.
__generated__/
# Plaintext secrets never enter the tree; the sealed form is .starcistacks/<env>/secrets/<slug>.enc.
.env
.env.*
!.env.example
.secrets/
*.pem
# Agent output lives in the scratchpad and the blob store, never in the repository.
report*.json
*.tmp.json
*-lint.json
lf.json
lt.json
%*%
nul
.artifacts/
.tmp-*
# Worktrees live outside the repository, never inside it.
.worktrees/
# StarCi runtime state of the repository (ledger), never tracked.
.starci/
# be: the schema Nest writes when it boots GraphQL
schema.gql
# fe: Next build output and its generated type file
.next/
next-env.d.ts
# .starcistacks custody at the app root: modules/schemas/stacks-layout.yaml custody.gitignoreRules, in order. Only the
# declaration, runbooks, key lists, seeds, the rendered environment, the infra definitions and sealed *.enc are tracked.
.starcistacks/**
!.starcistacks/**/
!.starcistacks/**/KEYS.md
!.starcistacks/**/.gitkeep
!.starcistacks/application-stacks.yaml
!.starcistacks/*/README.md
!.starcistacks/*/environment.json
!.starcistacks/*/seeds/**
!.starcistacks/*/infra/metadata.json
!.starcistacks/*/infra/compose/**
!.starcistacks/*/infra/k8s/**
!.starcistacks/*/infra/terraform/**
.starcistacks/*/infra/**/.env
.starcistacks/*/infra/**/.env.*
.starcistacks/*/infra/**/*.env
.starcistacks/*/infra/**/*.key
.starcistacks/*/infra/**/*.pem
.starcistacks/*/infra/**/*.tfvars
.starcistacks/*/infra/terraform/.terraform/
.starcistacks/*/infra/terraform/*.tfstate
.starcistacks/*/infra/terraform/*.tfstate.*
.starcistacks/*/infra/terraform/files/
.starcistacks/*/infra/terraform/*.tar.gz
!.starcistacks/**/*.enc
# <<< starci app sync <<<
