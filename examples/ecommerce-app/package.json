{
  "name": "ecommerce-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "Ecommerce app: one StarCi app with a NestJS back end in be/ (identity and order api apps) and two Next.js apps in fe/ (landing and app) over the workspace packages fe/packages/*.",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:be:identity": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/identity/src/main.ts",
    "dev:be:order": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/order/src/main.ts",
    "dev:fe:landing": "npm run codegen --silent && turbo run dev --filter=@ecommerce-app/landing",
    "dev:fe:app": "npm run codegen --silent && turbo run dev --filter=@ecommerce-app/app",
    "start:identity": "node be/dist/apps/identity/src/main.js",
    "start:order": "node be/dist/apps/order/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:landing": "npm run start -w @ecommerce-app/landing",
    "start:app": "npm run start -w @ecommerce-app/app",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "lint": "npm run codegen --silent && hfs lint",
    "lint:fix": "npm run codegen --silent && hfs lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:affected": "cd be && jest --selectProjects unit --passWithNoTests",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && cd be && jest --selectProjects e2e",
    "test:contract": "npm run typecheck:tests && cd be && jest --selectProjects contract",
    "test:stack": "cd be && starci-test-stack",
    "contract:emit": "hfs emit-contracts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "graphql": "16.14.2",
    "ioredis": "^5.4.1",
    "nest-commander": "3.21.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.0.7",
    "@starci/eslint-canon-fe": "8.0.7",
    "@starci/hfs": "4.0.7",
    "@starci/jest-preset": "2.2.2",
    "@starci/prettier-config": "1.0.0",
    "@starci/stylelint-canon": "2.0.2",
    "@starci/test-world": "1.0.5",
    "@starci/tsconfig": "2.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "tailwindcss": "^4",
    "ts-jest": "29.4.12",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "globals": "^17.12.0"
  }
}
