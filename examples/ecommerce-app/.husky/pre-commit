if [ -n "$fe" ]; then
  (cd fe && npx eslint --max-warnings=0 --no-warn-ignored $fe)
fi
styles=$(git diff --cached --name-only --diff-filter=ACMR --relative=fe -- '*.css' || true)
if [ -n "$styles" ]; then
  (cd fe && npx stylelint $styles)
fi
formatted=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$formatted" ]; then
  npx prettier --check --ignore-unknown $formatted
fi
specs=$(git diff --cached --name-only --diff-filter=ACMR --relative=be -- '*.ts' | grep -v -E '(^|/)src/tests/(world|integration|e2e|contract)/|\.(integration|e2e|contract)-spec\.ts$' || true)
if [ -n "$specs" ]; then
  npm run test:affected -- --findRelatedTests $specs
fi
