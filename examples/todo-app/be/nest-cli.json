{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/todo",
  "sourceRoot": "apps/todo/src",
  "projects": {
    "todo": {
      "type": "application",
      "root": "apps/todo",
      "entryFile": "main",
      "sourceRoot": "apps/todo/src"
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src"
    },
    "migrate": {
      "type": "application",
      "root": "apps/migrate",
      "entryFile": "main",
      "sourceRoot": "apps/migrate/src"
    }
  }
}
