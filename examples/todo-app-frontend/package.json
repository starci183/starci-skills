{
  "name": "todo-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @starci/todo-web --",
    "build": "npm run build --workspace @starci/todo-web --",
    "start": "npm run start --workspace @starci/todo-web --",
    "typecheck": "npm run typecheck --workspace @starci/todo-web --",
    "lint:check": "eslint . --max-warnings=0",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "uat:typecheck": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@starci/eslint-canon-fe": "file:../../packages/eslint/fe",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.2",
    "yaml": "^2.9.1"
  },
  "starci": {
    "codePatterns": {
      "next": {
        "schema": "starci/next-code-pattern-contract@1",
        "projects": [
          "apps/web/tsconfig.json"
        ],
        "owners": [
          {
            "root": "apps/web/src/components/blocks/share-invite",
            "name": "ShareInvite"
          },
          {
            "root": "apps/web/src/components/blocks/task-list",
            "name": "TaskList"
          },
          {
            "root": "apps/web/src/components/blocks/sign-in-form",
            "name": "SignInForm"
          }
        ],
        "closedVocabularies": [],
        "grammarGuards": {
          "schema": "starci/grammar-guard-contract@1",
          "package": "@starci/grammar",
          "entry": "./common",
          "source": {
            "kind": "installed"
          },
          "vectorProfile": "starci/grammar-guards-v1"
        },
        "errorState": {
          "schema": "starci/next-error-state@1",
          "sourceRoots": [
            "apps/web/src"
          ],
          "transports": [
            {
              "root": "apps/web/src/modules/api",
              "mode": "throwing"
            }
          ],
          "worldMappings": [
            {
              "id": "share-collaborators-read-refusal",
              "owner": {
                "path": "apps/web/src/components/blocks/share-invite/index.tsx",
                "export": "ShareInviteBlock"
              },
              "source": {
                "path": "apps/web/src/hooks/share/useCollaborators.ts",
                "export": "useCollaborators"
              },
              "failurePath": "collaboratorsQuery.error",
              "state": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "export": "ShareInviteState"
              },
              "failureState": "refused",
              "render": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "symbol": "ShareInviteView",
                "stateProp": "state"
              }
            },
            {
              "id": "share-invite-refusal",
              "owner": {
                "path": "apps/web/src/components/blocks/share-invite/index.tsx",
                "export": "ShareInviteBlock"
              },
              "source": {
                "path": "apps/web/src/hooks/share/useInviteCollaborator.ts",
                "export": "useInviteCollaborator"
              },
              "failurePath": "invite.error",
              "state": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "export": "ShareInviteState"
              },
              "failureState": "refused",
              "render": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "symbol": "ShareInviteView",
                "stateProp": "state"
              }
            },
            {
              "id": "share-revoke-refusal",
              "owner": {
                "path": "apps/web/src/components/blocks/share-invite/index.tsx",
                "export": "ShareInviteBlock"
              },
              "source": {
                "path": "apps/web/src/hooks/share/useRevokeCollaborator.ts",
                "export": "useRevokeCollaborator"
              },
              "failurePath": "revoke.error",
              "state": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "export": "ShareInviteState"
              },
              "failureState": "refused",
              "render": {
                "path": "apps/web/src/components/blocks/share-invite/component.tsx",
                "symbol": "ShareInviteView",
                "stateProp": "state"
              }
            },
            {
              "id": "task-list-read-refusal",
              "owner": {
                "path": "apps/web/src/components/blocks/task-list/index.tsx",
                "export": "TaskListBlock"
              },
              "source": {
                "path": "apps/web/src/hooks/task/useTasks.ts",
                "export": "useTasks"
              },
              "failurePath": "tasksQuery.error",
              "state": {
                "path": "apps/web/src/components/blocks/task-list/component.tsx",
                "export": "TaskListState"
              },
              "failureState": "refused",
              "render": {
                "path": "apps/web/src/components/blocks/task-list/component.tsx",
                "symbol": "TaskListView",
                "stateProp": "state"
              }
            },
            {
              "id": "sign-in-refusal",
              "owner": {
                "path": "apps/web/src/components/blocks/sign-in-form/index.tsx",
                "export": "SignInFormBlock"
              },
              "source": {
                "path": "apps/web/src/hooks/auth/useSignIn.ts",
                "export": "useSignIn"
              },
              "failurePath": "refusal",
              "state": {
                "path": "apps/web/src/components/blocks/sign-in-form/component.tsx",
                "export": "SignInFormState"
              },
              "failureState": "refused",
              "render": {
                "path": "apps/web/src/components/blocks/sign-in-form/component.tsx",
                "symbol": "SignInFormView",
                "stateProp": "state"
              }
            }
          ],
          "envelopes": [],
          "writes": [
            {
              "action": {
                "path": "apps/web/src/modules/api/share.ts",
                "export": "inviteCollaborator"
              },
              "feedback": {
                "path": "apps/web/src/modules/api/write-feedback.ts",
                "export": "runWrite"
              },
              "binding": "callback",
              "sites": [
                {
                  "path": "apps/web/src/modules/api/share.ts",
                  "export": "inviteCollaboratorAndNotify"
                }
              ]
            },
            {
              "action": {
                "path": "apps/web/src/modules/api/share.ts",
                "export": "revokeCollaborator"
              },
              "feedback": {
                "path": "apps/web/src/modules/api/write-feedback.ts",
                "export": "runWrite"
              },
              "binding": "callback",
              "sites": [
                {
                  "path": "apps/web/src/modules/api/share.ts",
                  "export": "revokeCollaboratorAndNotify"
                }
              ]
            },
            {
              "action": {
                "path": "apps/web/src/modules/api/tasks.ts",
                "export": "createTask"
              },
              "feedback": {
                "path": "apps/web/src/modules/api/write-feedback.ts",
                "export": "runWrite"
              },
              "binding": "callback",
              "sites": [
                {
                  "path": "apps/web/src/modules/api/tasks.ts",
                  "export": "createTaskAndNotify"
                }
              ]
            },
            {
              "action": {
                "path": "apps/web/src/modules/api/tasks.ts",
                "export": "setTaskComplete"
              },
              "feedback": {
                "path": "apps/web/src/modules/api/write-feedback.ts",
                "export": "runWrite"
              },
              "binding": "callback",
              "sites": [
                {
                  "path": "apps/web/src/modules/api/tasks.ts",
                  "export": "setTaskCompleteAndNotify"
                }
              ]
            },
            {
              "action": {
                "path": "apps/web/src/modules/api/tasks.ts",
                "export": "deleteTask"
              },
              "feedback": {
                "path": "apps/web/src/modules/api/write-feedback.ts",
                "export": "runWrite"
              },
              "binding": "callback",
              "sites": [
                {
                  "path": "apps/web/src/modules/api/tasks.ts",
                  "export": "deleteTaskAndNotify"
                }
              ]
            }
          ],
          "boundaries": [],
          "requiredValues": []
        },
        "dataLifecycle": {
          "schema": "starci/next-data-lifecycle@1",
          "swr": {
            "package": "swr",
            "major": 2
          },
          "hooks": [
            {
              "id": "share-collaborators-query",
              "path": "apps/web/src/hooks/share/useCollaborators.ts",
              "export": "useCollaborators",
              "kind": "query",
              "resultBinding": "collaboratorsQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-invite-mutation",
              "path": "apps/web/src/hooks/share/useInviteCollaborator.ts",
              "export": "useInviteCollaborator",
              "kind": "mutation",
              "resultBinding": "invite",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-revoke-mutation",
              "path": "apps/web/src/hooks/share/useRevokeCollaborator.ts",
              "export": "useRevokeCollaborator",
              "kind": "mutation",
              "resultBinding": "revoke",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-task-title-query",
              "path": "apps/web/src/hooks/share/useTaskTitle.ts",
              "export": "useTaskTitle",
              "kind": "query",
              "resultBinding": "taskTitleQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-list-query",
              "path": "apps/web/src/hooks/task/useTasks.ts",
              "export": "useTasks",
              "kind": "query",
              "resultBinding": "tasksQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-create-mutation",
              "path": "apps/web/src/hooks/task/useCreateTask.ts",
              "export": "useCreateTask",
              "kind": "mutation",
              "resultBinding": "createTask",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-complete-mutation",
              "path": "apps/web/src/hooks/task/useSetTaskComplete.ts",
              "export": "useSetTaskComplete",
              "kind": "mutation",
              "resultBinding": "setTaskComplete",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-delete-mutation",
              "path": "apps/web/src/hooks/task/useDeleteTask.ts",
              "export": "useDeleteTask",
              "kind": "mutation",
              "resultBinding": "deleteTask",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            }
          ]
        }
      }
    }
  }
}
