{
  "name": "todo-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:web": "npm run dev --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "codegen": "npm run codegen --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run codegen --silent && eslint . --fix --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\" --fix",
    "lint:check": "npm run codegen --silent && eslint . --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\"",
    "lint:report": "eslint . --format json --output-file reports/eslint.json",
    "lint:report:css": "stylelint \"{apps,packages}/*/src/**/*.css\" --formatter json --output-file reports/stylelint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hfs:check": "hfs check",
    "hfs:report": "hfs check --sonar reports/hfs.sonar.json"
  },
  "devDependencies": {
    "@starci/eslint-canon-fe": "7.0.0",
    "@starci/hfs": "2.0.0",
    "@starci/prettier-config": "1.0.0",
    "@starci/stylelint-canon": "2.0.0",
    "@starci/tsconfig": "2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "starci": {
    "codePatterns": {
      "next": {
        "schema": "starci/next-code-pattern-contract@1",
        "dataLifecycle": {
          "schema": "starci/next-data-lifecycle@1",
          "swr": {
            "package": "swr",
            "major": 2
          },
          "hooks": [
            {
              "id": "share-collaborators-query",
              "path": "apps/web/src/hooks/share/useCollaborators.ts",
              "export": "useCollaborators",
              "kind": "query",
              "resultBinding": "collaboratorsQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-invite-mutation",
              "path": "apps/web/src/hooks/share/useInviteCollaborator.ts",
              "export": "useInviteCollaborator",
              "kind": "mutation",
              "resultBinding": "invite",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-revoke-mutation",
              "path": "apps/web/src/hooks/share/useRevokeCollaborator.ts",
              "export": "useRevokeCollaborator",
              "kind": "mutation",
              "resultBinding": "revoke",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "share-task-title-query",
              "path": "apps/web/src/hooks/share/useTaskTitle.ts",
              "export": "useTaskTitle",
              "kind": "query",
              "resultBinding": "taskTitleQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                },
                {
                  "id": "task",
                  "binding": "taskId",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-list-query",
              "path": "apps/web/src/hooks/task/useTasks.ts",
              "export": "useTasks",
              "kind": "query",
              "resultBinding": "tasksQuery",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-create-mutation",
              "path": "apps/web/src/hooks/task/useCreateTask.ts",
              "export": "useCreateTask",
              "kind": "mutation",
              "resultBinding": "createTask",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-complete-mutation",
              "path": "apps/web/src/hooks/task/useSetTaskComplete.ts",
              "export": "useSetTaskComplete",
              "kind": "mutation",
              "resultBinding": "setTaskComplete",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            },
            {
              "id": "task-delete-mutation",
              "path": "apps/web/src/hooks/task/useDeleteTask.ts",
              "export": "useDeleteTask",
              "kind": "mutation",
              "resultBinding": "deleteTask",
              "identities": [
                {
                  "id": "viewer",
                  "binding": "token",
                  "gatesRequest": true,
                  "resource": true
                }
              ]
            }
          ]
        }
      }
    }
  }
}
