{
  "schema": "starci/architecture-config@1",
  "kinds": ["frontend"],
  "tsconfig": "tsconfig.json",
  "owners": [
    { "id": "feature.pages.sign-in", "root": "src/features/pages/sign-in", "entry": "src/features/pages/sign-in/index.tsx" },
    { "id": "feature.pages.tasks", "root": "src/features/pages/tasks", "entry": "src/features/pages/tasks/index.tsx" }
  ],
  "frontend": {
    "routes": "src/app",
    "features": "src/features",
    "components": "src/components",
    "hooks": "src/hooks",
    "modules": "src/modules",
    "transport": "src/modules/api",
    "grammar": {
      "package": "@todo-app/grammar",
      "entry": "@todo-app/grammar/index",
      "styleEntry": "@todo-app/grammar/styles.css",
      "styleSources": ["src/app/globals.css"],
      "consumerManifests": ["package.json"],
      "peers": ["react"]
    }
  }
}
