{
  "name": "ecommerce-app-be",
  "version": "1.0.0",
  "private": true,
  "description": "Ecommerce app backend: a NestJS monorepo with identity and order services. Runtime values come from the environment (.starcistacks/dev/runtime/env/KEYS.md).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:identity": "node dist/apps/identity/src/main.js",
    "start:order": "node dist/apps/order/src/main.js",
    "migrate": "node dist/apps/migrate/src/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p src/tests/e2e/tsconfig.json",
    "lint": "hfs lint",
    "lint:fix": "hfs lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit --coverage",
    "test:affected": "jest --selectProjects unit --passWithNoTests",
    "test:e2e": "npm run typecheck:e2e && jest --selectProjects e2e",
    "test:e2e:live": "npm run typecheck:e2e && jest --selectProjects e2e --testPathIgnorePatterns /node_modules/ --testPathPattern e2e.live",
    "contract:emit": "hfs emit-contracts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "graphql": "^16.14.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "1.8.1",
    "@starci/hfs": "1.0.1",
    "@starci/jest-preset": "2.0.0",
    "@starci/prettier-config": "1.0.0",
    "@starci/tsconfig": "1.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "^8.11.6",
    "axios": "^1.20.0",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "graphql": "^16.14.2",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
