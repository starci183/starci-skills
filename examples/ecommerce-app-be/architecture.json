{
  "schema": "starci/architecture-config@1",
  "kinds": ["backend"],
  "backend": {
    "apps": ["apps/identity", "apps/order"],
    "modules": ["src/modules"],
    "features": ["src/features"],
    "moduleRegistration": {
      "providerIdentity": "exported-class-token",
      "handlerDecorators": ["CommandHandler", "QueryHandler"]
    }
  },
  "owners": [
    { "id": "identity-service", "root": "apps/identity", "entry": "apps/identity/src/app.module.ts" },
    { "id": "order-service", "root": "apps/order", "entry": "apps/order/src/app.module.ts" },
    { "id": "feature-checkout", "root": "src/features/checkout", "entry": "src/features/checkout/index.ts" },
    { "id": "feature-identity", "root": "src/features/identity", "entry": "src/features/identity/index.ts" },
    { "id": "module-domain-account", "root": "src/modules/domain/account", "entry": "src/modules/domain/account/index.ts" },
    { "id": "module-domain-cart", "root": "src/modules/domain/cart", "entry": "src/modules/domain/cart/index.ts" },
    { "id": "module-domain-catalog", "root": "src/modules/domain/catalog", "entry": "src/modules/domain/catalog/index.ts" },
    { "id": "module-domain-order", "root": "src/modules/domain/order", "entry": "src/modules/domain/order/index.ts" },
    { "id": "module-domain-payment", "root": "src/modules/domain/payment", "entry": "src/modules/domain/payment/index.ts" },
    { "id": "module-domain-session", "root": "src/modules/domain/session", "entry": "src/modules/domain/session/index.ts" },
    { "id": "module-integrations-identity", "root": "src/modules/integrations/identity", "entry": "src/modules/integrations/identity/index.ts" },
    { "id": "module-integrations-order", "root": "src/modules/integrations/order", "entry": "src/modules/integrations/order/index.ts" },
    { "id": "module-platform-config-identity", "root": "src/modules/platform/config/identity", "entry": "src/modules/platform/config/identity/index.ts" },
    { "id": "module-platform-config-order", "root": "src/modules/platform/config/order", "entry": "src/modules/platform/config/order/index.ts" },
    { "id": "module-platform-db-identity", "root": "src/modules/platform/databases/postgresql/identity", "entry": "src/modules/platform/databases/postgresql/identity/index.ts" },
    { "id": "module-platform-db-order", "root": "src/modules/platform/databases/postgresql/order", "entry": "src/modules/platform/databases/postgresql/order/index.ts" },
    { "id": "module-platform-cache-redis", "root": "src/modules/platform/caches/redis/primary", "entry": "src/modules/platform/caches/redis/primary/index.ts" },
    { "id": "module-platform-exceptions", "root": "src/modules/platform/exceptions", "entry": "src/modules/platform/exceptions/index.ts" }
  ]
}
