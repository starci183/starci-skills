{
  "schema": "starci/architecture-config@1",
  "kinds": ["backend"],
  "backend": {
    "apps": ["apps/identity", "apps/order"],
    "modules": ["apps/identity/src/modules", "apps/order/src/modules"],
    "features": ["apps/identity/src/features", "apps/order/src/features"],
    "moduleRegistration": {
      "providerIdentity": "exported-class-token",
      "handlerDecorators": ["CommandHandler", "QueryHandler"]
    }
  },
  "owners": [
    { "id": "identity-service", "root": "apps/identity", "entry": "apps/identity/src/app.module.ts" },
    { "id": "order-service", "root": "apps/order", "entry": "apps/order/src/app.module.ts" }
  ]
}
