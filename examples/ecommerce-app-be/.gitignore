node_modules/
dist/
coverage/
test-results/
.scannerwork/
*.tsbuildinfo
*.log
nul
.artifacts/
.tmp-*
report*.json
*.tmp.json

# eslint -f json dumps (e.g. ec-lint.json) are review output, not source.
*-lint.json
lf.json
lt.json

# .starcistacks custody: the ordered modules/schemas/stacks-layout.yaml custody.gitignoreRules, plus the
# value-free members this kit tracks (the rendered environment.json and the resolved port projection
# infra/metadata.json). Decrypted materializations are never the tracked record.
.starcistacks/**
!.starcistacks/**/
!.starcistacks/**/KEYS.md
!.starcistacks/**/.gitkeep
!.starcistacks/application-stacks.yaml
!.starcistacks/*/README.md
!.starcistacks/*/environment.json
!.starcistacks/*/seeds/**
!.starcistacks/*/infra/metadata.json
!.starcistacks/*/infra/compose/**
!.starcistacks/*/infra/terraform/**
.starcistacks/*/infra/**/.env
.starcistacks/*/infra/**/.env.*
.starcistacks/*/infra/**/*.env
.starcistacks/*/infra/**/*.key
.starcistacks/*/infra/**/*.pem
.starcistacks/*/infra/**/*.tfvars
.starcistacks/*/infra/terraform/.terraform/
.starcistacks/*/infra/terraform/*.tfstate
.starcistacks/*/infra/terraform/*.tfstate.*
.starcistacks/*/infra/terraform/files/
.starcistacks/*/infra/terraform/*.tar.gz
!.starcistacks/**/*.enc

# Keep the cited evidence runs already tracked; ignore fresh replay output.
/.starciwork/features/**/uat/**/runs/
