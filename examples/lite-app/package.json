{
  "name": "lite-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "11.0.3",
    "@supabase/supabase-js": "2.117.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31",
    "nest-commander": "3.21.0"
  },
  "devDependencies": {
    "@starci/cli": "1.0.0",
    "@starci/eslint-canon-be": "3.0.9",
    "@starci/eslint-canon-fe": "8.0.9",
    "@starci/prettier-config": "1.0.2",
    "@starci/stylelint-canon": "2.0.4",
    "@starci/tsconfig": "2.0.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:fe": "turbo run dev --filter=@lite-app/web",
    "start:api": "node be/dist/apps/api/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:web": "npm run start -w @lite-app/web",
    "docker:build": "npm run docker:build:api && npm run docker:build:cli",
    "docker:build:api": "docker build -f be/apps/api/Dockerfile -t lite-app/api:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t lite-app/cli:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "typecheck": "tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "starci app lint",
    "lint:fix": "starci app lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "npm run contract:emit",
    "db:lint": "starci app check --fast",
    "contract:emit": "starci app emit"
  }
}
