{
  "name": "lite-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*"
  ],
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "@supabase/supabase-js": "2.117.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "jose": "6.2.12",
    "nest-commander": "3.21.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@nestjs/testing": "11.2.5",
    "@starci/cli": "1.7.18",
    "@starci/eslint-canon-be": "3.4.26",
    "@starci/eslint-canon-fe": "8.4.25",
    "@starci/jest-preset": "2.3.4",
    "@starci/prettier-config": "1.0.3",
    "@starci/stylelint-canon": "2.0.10",
    "@starci/tsconfig": "2.0.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:fe": "npm run codegen --silent && turbo run dev --filter=@lite-app/web",
    "start:api": "node be/dist/apps/api/src/main.js",
    "cli": "node be/dist/apps/cli/src/main.js",
    "migrate": "node be/dist/apps/cli/src/main.js migrate run",
    "start:web": "npm run start -w @lite-app/web",
    "docker:build": "npm run docker:build:api && npm run docker:build:cli && npm run docker:build:web",
    "docker:build:api": "docker build -f be/apps/api/Dockerfile -t lite-app/api:dev .",
    "docker:build:cli": "docker build -f be/apps/cli/Dockerfile -t lite-app/cli:dev .",
    "docker:build:web": "docker build -f fe/apps/web/Dockerfile -t lite-app/web:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "codegen:graphql": "node scripts/codegen.mjs --graphql",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run codegen --silent && starci app lint",
    "lint:fix": "npm run codegen --silent && starci app lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:affected": "cd be && jest --selectProjects unit --passWithNoTests",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "npm run contract:emit",
    "db:lint": "starci app check --fast",
    "contract:emit": "starci app emit"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "@xyflow/react": "12.11.6",
    "dayjs": "1.11.21",
    "zod": "4.4.3",
    "zustand": "5.0.12"
  }
}
