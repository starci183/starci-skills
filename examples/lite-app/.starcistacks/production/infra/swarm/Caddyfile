lite-app.example {
    reverse_proxy web:3000 {
        health_uri /health/live
        health_interval 10s
        health_timeout 3s
    }
}

api.lite-app.example {
    reverse_proxy api:8787 {
        health_uri /health/ready
        health_interval 10s
        health_timeout 3s
        # server-sent events (/booking-status/stream): flush every write at once; never add `encode` to this route
        flush_interval -1
    }
}
