{
  "hfs": 2,
  "kind": "app",
  "edition": "lite",
  "project": "lite-app",
  "supabase": {
    "enableSignup": false,
    "jwtExpiry": 3600,
    "siteUrl": "http://127.0.0.1:3000",
    "redirectUrls": ["http://127.0.0.1:3000/"]
  },
  "sides": {
    "be": {
      "apps": [
        {
          "name": "api",
          "kind": "api"
        },
        {
          "name": "cli",
          "kind": "cli"
        }
      ],
      "kinds": ["api", "cli", "jobs", "webhooks"],
      "connections": [
        {
          "name": "primary",
          "envPrefix": "PRIMARY_DB",
          "owner": "api",
          "isolation": "schema",
          "provider": "supabase"
        }
      ],
      "reads": ["supabase/types/"],
      "optionalSlots": ["be.contract.graphql"],
      "patterns": ["fenced-job", "queue", "webhooks"]
    },
    "fe": {
      "apps": [
        {
          "name": "web",
          "kind": "next"
        }
      ],
      "reads": ["be/contracts/", "supabase/types/"]
    }
  }
}
