    "@heroui/styles": "3.2.6",
    "@starci/grammar": "0.7.2",
    "next": "16.1.6",
    "next-intl": "4.13.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "22.20.4",
    "@types/react": "^19.0.0",
