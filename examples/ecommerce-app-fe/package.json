{
  "name": "@ecommerce/fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n landing,shop -c cyan,magenta \"npm:dev:landing\" \"npm:dev:shop\"",
    "dev:landing": "node scripts/serve.mjs landing dev --webpack",
    "dev:shop": "node scripts/serve.mjs shop dev --webpack",
    "build": "npm run build -w @ecommerce/landing && npm run build -w @ecommerce/shop",
    "build:shared": "node ../../packages/fe-kit/scripts/link-peers.mjs ecommerce-app-fe && npm run build -w @ecommerce/shared",
    "prebuild": "npm run build:shared",
    "predev": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "pretest:unit": "npm run build:shared",
    "start": "concurrently -n landing,shop -c cyan,magenta \"npm:start:landing\" \"npm:start:shop\"",
    "start:landing": "node scripts/serve.mjs landing start",
    "start:shop": "node scripts/serve.mjs shop start",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "test:ci": "vitest run --coverage",
    "test:affected": "vitest run --changed origin/main --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@starci/eslint-canon-fe": "file:.starci/packages/eslint-canon-fe",
    "@starci/hfs": "file:.starci/packages/hfs",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "^9.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.2.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.7",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  }
}
