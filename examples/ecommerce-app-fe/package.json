{
  "name": "@ecommerce/fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n landing,shop -c cyan,magenta \"npm:dev:landing\" \"npm:dev:shop\"",
    "dev:landing": "node scripts/serve.mjs landing dev --webpack",
    "dev:shop": "node scripts/serve.mjs shop dev --webpack",
    "build": "npm run build -w @ecommerce/landing && npm run build -w @ecommerce/shop",
    "build:shared": "node ../../packages/fe-kit/scripts/link-peers.mjs ecommerce-app-fe && npm run build -w @ecommerce/shared",
    "prebuild": "npm run build:shared",
    "predev": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "start": "concurrently -n landing,shop -c cyan,magenta \"npm:start:landing\" \"npm:start:shop\"",
    "start:landing": "node scripts/serve.mjs landing start",
    "start:shop": "node scripts/serve.mjs shop start",
    "lint": "hfs lint",
    "lint:fix": "hfs lint --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@starci/eslint-canon-fe": "6.0.2",
    "@starci/hfs": "1.0.1",
    "@types/node": "22.20.4",
    "concurrently": "^9.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  }
}
