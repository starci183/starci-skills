{
  "name": "@ecommerce/fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:landing": "npm run dev --workspace apps/landing",
    "start:landing": "npm run start --workspace apps/landing",
    "dev:shop": "npm run dev --workspace apps/shop",
    "start:shop": "npm run start --workspace apps/shop",
    "codegen": "npm run codegen --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run codegen --silent && eslint . --fix --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\" --fix",
    "lint:check": "npm run codegen --silent && eslint . --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\"",
    "lint:report": "eslint . --format json --output-file reports/eslint.json",
    "lint:report:css": "stylelint \"{apps,packages}/*/src/**/*.css\" --formatter json --output-file reports/stylelint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hfs:check": "hfs check",
    "hfs:report": "hfs check --sonar reports/hfs.sonar.json"
  },
  "devDependencies": {
    "@starci/eslint-canon-fe": "7.0.0",
    "@starci/hfs": "2.0.0",
    "@starci/prettier-config": "1.0.0",
    "@starci/stylelint-canon": "2.0.1",
    "@starci/tsconfig": "2.0.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
