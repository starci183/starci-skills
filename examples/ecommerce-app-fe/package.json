{
  "name": "@ecommerce/fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n landing,shop -c cyan,magenta \"npm:dev:landing\" \"npm:dev:shop\"",
    "dev:landing": "node scripts/serve.mjs landing dev",
    "dev:shop": "node scripts/serve.mjs shop dev",
    "build": "npm run build -w @ecommerce/landing && npm run build -w @ecommerce/shop",
    "build:shared": "node ../../packages/fe-kit/scripts/link-peers.mjs ecommerce-app-fe && npm run build -w @ecommerce/shared",
    "prebuild": "npm run build:shared",
    "predev": "npm run build:shared",
    "pretypecheck": "npm run build:shared",
    "pretest:unit": "npm run build:shared",
    "start": "concurrently -n landing,shop -c cyan,magenta \"npm:start:landing\" \"npm:start:shop\"",
    "start:landing": "node scripts/serve.mjs landing start",
    "start:shop": "node scripts/serve.mjs shop start",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@starci/eslint-canon-fe": "file:../../packages/eslint/fe",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.2",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.2",
    "yaml": "^2.9.1"
  }
}
