{
  "name": "todo-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Todo app backend: NestJS example with domain, platform and integrations modules, and Todo GraphQL and HTTP transport under src/features/todo/transport.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node -r tsconfig-paths/register dist/apps/todo/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register apps/todo/src/main.ts",
    "migrate": "node -r tsconfig-paths/register dist/apps/migrate/src/main.js",
    "migrate:dev": "ts-node-dev --transpile-only -r tsconfig-paths/register apps/migrate/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "jest --selectProjects unit",
    "test:unit": "jest --selectProjects unit",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:e2e": "jest --selectProjects e2e --runInBand --verbose",
    "lint": "eslint \"src/**/*.ts\" \"apps/**/*.ts\" --ignore-pattern \"src/tests/e2e/**\"",
    "lint:e2e": "eslint \"src/tests/e2e/**/*.ts\"",
    "lint:check": "eslint \"src/**/*.ts\" \"apps/**/*.ts\" --ignore-pattern \"src/tests/e2e/**\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"apps/**/*.ts\" --ignore-pattern \"src/tests/e2e/**\" --fix",
    "test:ci": "jest --selectProjects unit --coverage --ci",
    "test:affected": "jest --selectProjects unit --passWithNoTests --changedSince=origin/main"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@apollo/client": "^4.3.1",
    "@nestjs/testing": "11.2.5",
    "@starci-examples/e2e-kit": "file:../../packages/e2e-kit",
    "@starci/eslint-canon-be": "1.7.0",
    "@starci/jest-preset": "1.1.0",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "axios": "^1.20.0",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "graphql": "^16.14.2",
    "jest": "29.7.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
