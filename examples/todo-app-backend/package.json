{
  "name": "todo-app-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Todo app backend: NestJS example with domain, platform and integrations modules, and Todo GraphQL and HTTP transport under src/features/todo/transport.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:todo": "node dist/apps/todo/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "migrate": "node dist/apps/migrate/src/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p src/tests/tsconfig.json",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "lint:report": "eslint . --format json --output-file reports/eslint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit --coverage",
    "test:affected": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "npm run typecheck:tests && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && jest --selectProjects e2e",
    "test:contract": "npm run typecheck:tests && jest --selectProjects contract",
    "contract:emit": "hfs emit-contracts",
    "hfs:check": "hfs check",
    "hfs:report": "hfs check --sonar reports/hfs.sonar.json"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "1.8.1",
    "@starci/hfs": "1.0.1",
    "@starci/jest-preset": "2.0.0",
    "@starci/prettier-config": "1.0.0",
    "@starci/tsconfig": "1.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "axios": "^1.20.0",
    "eslint": "9.39.5",
    "globals": "^17.12.0",
    "graphql": "^16.14.2",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "supertest": "7.3.0",
    "ts-jest": "29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
