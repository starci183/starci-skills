node_modules/
dist/
*.tsbuildinfo

# Decrypted, DEMO-ONLY secret materializations - never the tracked record.
.starcistacks/*/runtime/env/*.env
!.starcistacks/*/runtime/env/*.env.enc
.starcistacks/*/runtime/files/*.key
!.starcistacks/*/runtime/files/*.key.enc
.starcistacks/*/runtime/config/*.yaml
!.starcistacks/*/runtime/config/*.yaml.enc
.starcistacks/*/secrets/*
!.starcistacks/*/secrets/*.enc

# UAT run videos are real bytes, not canonical Work: the run's manifest.yaml already carries their
# sha256 as the tracked reference, and a CI job uploads the actual .webm as a build artifact instead of
# committing it. Screens (PNG) stay tracked, same as every other frontend capture in this tree.
.starciwork/**/runs/**/videos/*
