{
  "schema": "starci/fe-handoff@1",
  "flows": [
    {
      "id": "uat.task.create",
      "title": "Create a task, and fail to delete somebody else's",
      "entry": "/tasks",
      "actor": "owner",
      "preconditions": [
        "frontend dev or production server reachable at its /tasks route",
        "backend GraphQL endpoint reachable (todo-app.session-token in localStorage identifies the session)",
        "seed fixture applied so owner and stranger identities exist"
      ],
      "steps": [
        {
          "id": "sign-in-owner",
          "order": 1,
          "actor": "owner",
          "action": "Sign in as the owner.",
          "expected": "the task list loads: shell shows Todo app, destinations, the Alex account presence; the task block renders the list section",
          "uxChecks": ["loading", "completion"],
          "sourcePaths": [
            "src/features/pages/tasks/index.tsx",
            "src/components/blocks/task-list/index.tsx",
            "src/hooks/task/useTasks.ts"
          ]
        },
        {
          "id": "create-task",
          "order": 2,
          "actor": "owner",
          "action": "Create a task with a title.",
          "expected": "the task is created and appears in the list",
          "uxChecks": ["completion", "validation"],
          "sourcePaths": [
            "src/components/blocks/task-list/component.tsx",
            "src/components/blocks/task-list/index.tsx",
            "src/modules/api/tasks.ts"
          ]
        },
        {
          "id": "read-list",
          "order": 3,
          "actor": "owner",
          "action": "Read the list.",
          "expected": "exactly that one task is shown",
          "uxChecks": [],
          "sourcePaths": [
            "src/components/blocks/task-list/component.tsx"
          ]
        },
        {
          "id": "stranger-delete-refused",
          "order": 4,
          "actor": "stranger",
          "action": "Sign in as the stranger and attempt to delete it.",
          "expected": "the delete is refused; the inline confirmation never offers a stranger's row and the server refuses the mutation",
          "uxChecks": ["errorFeedback"],
          "sourcePaths": [
            "src/components/blocks/task-list/component.tsx",
            "src/components/blocks/task-list/index.tsx",
            "src/modules/api/tasks.ts"
          ]
        },
        {
          "id": "re-read-owner-list",
          "order": 5,
          "actor": "owner",
          "action": "Read the owner's list again.",
          "expected": "the task is still present, unchanged",
          "uxChecks": [],
          "sourcePaths": [
            "src/components/blocks/task-list/component.tsx"
          ]
        }
      ],
      "cleanup": ["delete the run-owned task row by its recorded id"]
    }
  ],
  "codeRefs": {
    "route": ["src/app/tasks/page.tsx"],
    "feature": ["src/features/pages/tasks/index.tsx", "src/features/pages/tasks/classNames.ts"],
    "block": [
      "src/components/blocks/task-list/index.tsx",
      "src/components/blocks/task-list/component.tsx",
      "src/components/blocks/task-list/classNames.ts",
      "src/components/blocks/task-list/component.spec.tsx"
    ],
    "data": ["src/hooks/task/useTasks.ts", "src/modules/api/tasks.ts", "src/modules/api/graphql.ts", "src/modules/session/index.ts"],
    "commit": "see the implementation record's revision field once the delivery commit lands"
  },
  "runtime": {
    "servedBuild": "next start (production build of this worktree's todo-app-frontend)",
    "observedRoute": "/tasks",
    "captureDriver": "playwright chromium, deviceScaleFactor 2, --disable-lcd-text",
    "captureTransport": "GraphQL POST stubbed in-browser; no shared API/Postgres writes",
    "viewports": ["desktop-1280 (1280x960 css px)", "mobile-390 (390x1150 css px)"]
  },
  "assets": [
    {"id": "list-empty-desktop-1280", "path": "assets/list-empty-desktop-1280.png", "markup": "assets/list-empty-desktop-1280.html", "screen": "list", "state": "empty", "viewport": "desktop-1280"},
    {"id": "list-empty-mobile-390", "path": "assets/list-empty-mobile-390.png", "markup": "assets/list-empty-mobile-390.html", "screen": "list", "state": "empty", "viewport": "mobile-390"},
    {"id": "list-one-task-desktop-1280", "path": "assets/list-one-task-desktop-1280.png", "markup": "assets/list-one-task-desktop-1280.html", "screen": "list", "state": "one-task", "viewport": "desktop-1280"},
    {"id": "list-one-task-mobile-390", "path": "assets/list-one-task-mobile-390.png", "markup": "assets/list-one-task-mobile-390.html", "screen": "list", "state": "one-task", "viewport": "mobile-390"},
    {"id": "list-many-tasks-desktop-1280", "path": "assets/list-many-tasks-desktop-1280.png", "markup": "assets/list-many-tasks-desktop-1280.html", "screen": "list", "state": "many-tasks", "viewport": "desktop-1280"},
    {"id": "list-many-tasks-mobile-390", "path": "assets/list-many-tasks-mobile-390.png", "markup": "assets/list-many-tasks-mobile-390.html", "screen": "list", "state": "many-tasks", "viewport": "mobile-390"},
    {"id": "list-refused-desktop-1280", "path": "assets/list-refused-desktop-1280.png", "markup": "assets/list-refused-desktop-1280.html", "screen": "list", "state": "refused", "viewport": "desktop-1280"},
    {"id": "list-refused-mobile-390", "path": "assets/list-refused-mobile-390.png", "markup": "assets/list-refused-mobile-390.html", "screen": "list", "state": "refused", "viewport": "mobile-390"}
  ]
}
