{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://starci.dev/schemas/skill-facade-v1.schema.json",
  "title": "StarCi semantic skill facade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "facadeId",
    "kind",
    "executable",
    "description",
    "modes",
    "permissions",
    "dispatch",
    "output",
    "stops"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "facadeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "const": "semantic-skill-facade" },
    "executable": { "const": false },
    "description": { "type": "string", "minLength": 20 },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "targetSkill", "selectionFacts", "excludes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "intent": { "type": "string", "minLength": 10 },
          "targetSkill": { "type": "string", "pattern": "^starci-[a-z0-9-]+$" },
          "selectionFacts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "excludes": {
            "type": "array",
            "items": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "preDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "requiredArgs", "optionalArgs", "successExitCode", "stopExitCodes", "resultFields"],
      "properties": {
        "kind": { "const": "read-only-evidence" },
        "command": { "type": "string", "minLength": 1 },
        "requiredArgs": { "type": "array", "items": { "type": "string" } },
        "optionalArgs": { "type": "array", "items": { "type": "string" } },
        "successExitCode": { "const": 0 },
        "stopExitCodes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "resultFields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionOnly", "writes", "externalMutations", "approvalTransfer"],
      "properties": {
        "selectionOnly": { "const": true },
        "writes": { "type": "array", "maxItems": 0 },
        "externalMutations": { "const": false },
        "approvalTransfer": { "const": false }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadsTargetSkill", "startsTargetSeparately", "targetOwnsApprovalAndProof", "requiresOwnOrchestrationProfile"],
      "properties": {
        "loadsTargetSkill": { "const": false },
        "startsTargetSeparately": { "const": true },
        "targetOwnsApprovalAndProof": { "const": true },
        "requiresOwnOrchestrationProfile": { "const": false }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    }
  }
}
