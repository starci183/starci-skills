{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schemaVersion",
    "requiredCoreFields",
    "frozenStatus",
    "unclearAction",
    "sourceInspectionWhileAmbiguous",
    "registeredDimensions"
  ],
  "properties": {
    "version": { "const": "7.5.0-alpha.1" },
    "schemaVersion": { "const": 1 },
    "requiredCoreFields": {
      "type": "array",
      "minItems": 11,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "frozenStatus": { "const": "frozen" },
    "unclearAction": { "const": "ask-before-skill-selection" },
    "sourceInspectionWhileAmbiguous": { "const": "forbidden" },
    "registeredDimensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
