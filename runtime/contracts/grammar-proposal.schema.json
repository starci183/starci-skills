{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/grammar/7.4/proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "proposalId", "patternName", "scope", "anatomy", "consumerRefs", "platformInvariantRefs", "alternativeRefs", "migrationRefs", "status", "patternFingerprint", "approval"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "7.4.0" },
    "proposalId": { "type": "string", "minLength": 1 },
    "patternName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "scope": { "const": "grammar" },
    "anatomy": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "consumerRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "platformInvariantRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "alternativeRefs": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "migrationRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["proposal", "approved", "rejected"] },
    "patternFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "approval": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorityRef", "decision", "patternFingerprint"],
          "properties": {
            "authorityRef": { "type": "string", "pattern": "^(request|user|approval):" },
            "decision": { "enum": ["approve", "reject"] },
            "patternFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
