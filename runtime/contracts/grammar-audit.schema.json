{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.4/runtime/contracts/grammar-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetRef", "grammarManifestRef", "iconographyManifestRef", "status", "checks", "violations", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetRef": { "type": "string", "minLength": 1 },
    "grammarManifestRef": { "type": "string", "pattern": "^grammar://" },
    "iconographyManifestRef": { "type": "string", "pattern": "^iconography://" },
    "status": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array", "minItems": 3, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ownerRef", "state", "boundaryOwnerRefs", "insetOwnerRefs", "minimumInlineClearancePx", "inlineStartPx", "inlineEndPx", "dividerCount", "iconFamilyRefs", "evidenceRefs"],
        "properties": {
          "ownerRef": { "type": "string", "pattern": "^owner://" },
          "state": { "enum": ["wide", "intermediate", "compact", "breakpoint-before", "breakpoint-after", "expanded", "collapsed", "drawer"] },
          "boundaryOwnerRefs": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^owner://" } },
          "insetOwnerRefs": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^owner://" } },
          "minimumInlineClearancePx": { "type": "number", "minimum": 0 },
          "inlineStartPx": { "type": "number", "minimum": 0 },
          "inlineEndPx": { "type": "number", "minimum": 0 },
          "dividerCount": { "type": "integer", "minimum": 0, "maximum": 2 },
          "iconFamilyRefs": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-family://" } },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "violations": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "ownerRef", "state", "evidenceRefs"],
        "properties": {
          "kind": { "enum": ["duplicate-boundary-owner", "duplicate-inset-owner", "unsafe-inline-clearance", "duplicate-divider", "mixed-icon-family", "unbound-icon", "overflow", "other"] },
          "ownerRef": { "type": "string", "pattern": "^owner://" },
          "state": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
