{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6.1/runtime/tech-stack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "observed", "target", "claims", "contradictions", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "observed": { "$ref": "#/$defs/stackModel" },
    "target": { "$ref": "#/$defs/stackModel" },
    "claims": { "type": "array", "items": { "$ref": "protocol.schema.json#/$defs/claim" } },
    "contradictions": { "type": "array", "items": { "$ref": "protocol.schema.json#/$defs/contradiction" } },
    "status": { "enum": ["draft", "challenged", "approved", "blocked"] }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "runtime", "deployableUnit", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "kind": { "enum": ["frontend", "api", "service", "worker", "scheduler", "gateway", "vendor"] },
        "runtime": { "type": "string", "minLength": 1 },
        "deployableUnit": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "communication": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "mode", "protocol", "failurePolicyRef"],
      "properties": {
        "from": { "$ref": "#/$defs/identity" }, "to": { "$ref": "#/$defs/identity" },
        "mode": { "enum": ["sync", "async", "batch"] }, "protocol": { "type": "string", "minLength": 1 },
        "failurePolicyRef": { "type": "string", "minLength": 1 }
      }
    },
    "store": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "engine", "physicalInstance", "database", "namespace", "owner", "migrationOwner", "authority", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" }, "engine": { "type": "string", "minLength": 1 },
        "physicalInstance": { "type": "string", "minLength": 1 }, "database": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }, "owner": { "$ref": "#/$defs/identity" },
        "migrationOwner": { "$ref": "#/$defs/identity" }, "authority": { "enum": ["authoritative", "replica", "cache", "index"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["deploymentStrategy", "scalingModel", "healthChecks", "observability", "secretBoundary", "backupRestoreUnit"],
      "properties": {
        "deploymentStrategy": { "type": "string", "minLength": 1 }, "scalingModel": { "type": "string", "minLength": 1 },
        "healthChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "observability": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "secretBoundary": { "type": "string", "minLength": 1 }, "backupRestoreUnit": { "type": "string", "minLength": 1 }
      }
    },
    "stackModel": {
      "type": "object", "additionalProperties": false,
      "required": ["languages", "frameworks", "packageManagers", "components", "communications", "stores", "operations", "versionConstraints"],
      "properties": {
        "languages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "packageManagers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "communications": { "type": "array", "items": { "$ref": "#/$defs/communication" } },
        "stores": { "type": "array", "items": { "$ref": "#/$defs/store" } },
        "operations": { "$ref": "#/$defs/operation" },
        "versionConstraints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["package", "range", "evidenceRef"], "properties": { "package": { "type": "string", "minLength": 1 }, "range": { "type": "string", "minLength": 1 }, "evidenceRef": { "type": "string", "minLength": 1 } } } }
      }
    }
  }
}
