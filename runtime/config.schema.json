{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "grammarContractVersion",
    "debug",
    "aiBrainstormModel",
    "aiBrainstormCount",
    "aiBrainstormIsolation",
    "aiBrainstormForkTurns",
    "visualReviewModel",
    "visualReviewCount",
    "visualReviewIsolation",
    "visualReviewForkTurns",
    "visualReviewNoProgressLimit",
    "localRuntimeOwnership",
    "localRuntimeControlPlane",
    "localFrontendUrl",
    "localApiUrl",
    "localIdentityUrl",
    "featureTaskRuntimeMutation",
    "localRuntimeRegistry",
    "localUatBrowserOwnership",
    "localUatBrowserControlPlane",
    "localUatBrowserLeaseRegistry",
    "localUatBrowserDelivery",
    "crossTaskBrowserHandleAssumption",
    "featureTaskCredentialHandling"
  ],
  "properties": {
    "version": { "const": "7.6.0-beta.1" },
    "grammarContractVersion": { "const": "7.4.0" },
    "debug": { "type": "boolean" },
    "aiBrainstormModel": { "const": "gpt-5.6-sol" },
    "aiBrainstormCount": { "const": 1 },
    "aiBrainstormIsolation": { "const": "fresh" },
    "aiBrainstormForkTurns": { "const": "none" },
    "visualReviewModel": { "const": "gpt-5.6-sol" },
    "visualReviewCount": { "const": 1 },
    "visualReviewIsolation": { "const": "fresh" },
    "visualReviewForkTurns": { "const": "none" },
    "visualReviewNoProgressLimit": {
      "description": "Block only after this many consecutive identical progress fingerprints, never after an absolute round count.",
      "const": 3
    },
    "localRuntimeOwnership": { "const": "centralized-task" },
    "localRuntimeControlPlane": { "const": "control-panel" },
    "localFrontendUrl": { "const": "http://localhost:3000" },
    "localApiUrl": { "const": "http://localhost:3001" },
    "localIdentityUrl": { "const": "http://localhost:8080" },
    "featureTaskRuntimeMutation": { "const": "forbidden" },
    "localRuntimeRegistry": { "const": ".worktrees/sessions/central-runtime/owner.json" },
    "localUatBrowserOwnership": { "const": "centralized-lease" },
    "localUatBrowserControlPlane": { "const": "control-panel" },
    "localUatBrowserLeaseRegistry": { "const": ".worktrees/sessions/central-uat-browser/leases" },
    "localUatBrowserDelivery": { "const": "materialize-or-broker-execute" },
    "crossTaskBrowserHandleAssumption": { "const": "forbidden" },
    "featureTaskCredentialHandling": { "const": "forbidden" }
  }
}
