{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "role", "sourceRevision", "planHash", "objective", "files", "patternBindings", "tests", "excluded", "proof"],
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "role": { "const": "be" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{12,64}$" },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "objective": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "holds", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "holds": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "patternBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "situations", "paths", "evidence"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "situations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]+$" } },
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "proof": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
