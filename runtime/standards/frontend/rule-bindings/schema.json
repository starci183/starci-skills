{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "role", "patternRouter", "gateRouter", "publishedPackage", "policy"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "role": { "const": "fe" },
    "patternRouter": { "type": "string", "minLength": 1 },
    "gateRouter": { "type": "string", "minLength": 1 },
    "publishedPackage": { "const": "@starci/eslint-canon-fe" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknownMachineRule", "missingGateBinding", "missingMachineTest", "machineOnlyIdentityMustBeExplicit"],
      "properties": {
        "unknownMachineRule": { "const": "fail" },
        "missingGateBinding": { "const": "fail" },
        "missingMachineTest": { "const": "external" },
        "machineOnlyIdentityMustBeExplicit": { "const": true }
      }
    }
  }
}
