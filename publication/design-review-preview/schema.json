{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/publication/design-review-preview/schema.json",
  "title": "Session-local authored design review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "sessionId", "systemId", "baselineAt", "phase", "mode", "entryRoute", "layouts", "evidence"],
  "properties": {
    "schemaVersion": {"const": 3},
    "project": {"$ref": "#/$defs/slug"},
    "sessionId": {"type": "string", "minLength": 1},
    "systemId": {"const": "starci-master"},
    "baselineAt": {"$ref": "#/$defs/hash"},
    "phase": {"enum": ["layout", "block"]},
    "mode": {"enum": ["generate", "audit", "brainstorm"]},
    "entryRoute": {"type": "string", "pattern": "^previews/[a-z0-9-]+--[a-z0-9-]+\\.html$"},
    "layouts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutReview"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "previewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "html", "viewport"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "html": {"type": "string", "minLength": 1},
        "viewport": {"$ref": "#/$defs/viewport"}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "states"],
      "properties": {
        "html": {"type": "string", "minLength": 1},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/previewState"}}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entry", "assembler", "mount", "whyMatch"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "pageId": {"$ref": "#/$defs/slug"},
        "change": {"enum": ["existing", "proposed", "new"]},
        "entry": {"type": "object"},
        "assembler": {"type": "string", "minLength": 1},
        "mount": {"type": "string", "minLength": 1},
        "whyMatch": {"type": "string", "minLength": 1},
        "geometry": {"type": "object"},
        "brief": {"type": "object"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash", "status", "reason", "axes", "regions", "preview"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "hash": {"$ref": "#/$defs/hash"},
        "status": {"const": "proposed"},
        "reason": {"type": "string", "minLength": 1},
        "axes": {"type": "object", "additionalProperties": {"type": "string"}},
        "direction": {"type": "object"},
        "states": {"type": "array", "items": {"type": "string"}},
        "parts": {"type": "array", "items": {"type": "object"}},
        "pages": {"type": "array", "items": {"$ref": "#/$defs/page"}},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
        "preview": {"$ref": "#/$defs/preview"}
      }
    },
    "layoutReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "recommendedId", "theme", "candidates"],
      "properties": {
        "layoutId": {"$ref": "#/$defs/slug"},
        "recommendedId": {"$ref": "#/$defs/slug"},
        "scope": {"type": "object"},
        "theme": {"type": "object"},
        "candidates": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/candidate"}}
      }
    }
  }
}
