{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v1/publication/design-review-preview/schema.json",
  "title": "Universal design review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "project", "identity", "artifact", "theme", "candidates", "shell", "content", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"enum": ["layout", "block"]},
    "project": {"$ref": "#/$defs/slug"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId"],
      "properties": {
        "layoutId": {"$ref": "#/$defs/slug"},
        "blockId": {"$ref": "#/$defs/slug"},
        "parentLayoutHash": {"$ref": "#/$defs/hash"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "recommendedId"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "currentHead": {"$ref": "#/$defs/hash"},
        "recommendedId": {"$ref": "#/$defs/slug"}
      }
    },
    "theme": {"type": "object", "additionalProperties": {"$ref": "#/$defs/themeRole"}},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "visualDirections": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "visualDirectionRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "reason": {"type": "string", "minLength": 1}}
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "navigation"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "activeItem": {"type": "string"},
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "primaryAction", "rows"],
      "properties": {
        "eyebrow": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "primaryAction": {"type": "string", "minLength": 1},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {"title": {"type": "string"}, "description": {"type": "string"}, "meta": {"type": "string"}}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {"label": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "themeRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {"enum": ["reuse", "new", "none"]},
        "token": {"type": "string"},
        "value": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "hash", "status", "reason", "axes"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "hash": {"$ref": "#/$defs/hash"},
        "status": {"enum": ["accepted", "proposed", "superseded"]},
        "reason": {"type": "string"},
        "axes": {"type": "object", "additionalProperties": {"type": "string"}},
        "regions": {"type": "array", "items": {"type": "object"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "parts": {"type": "array", "items": {"type": "object"}},
        "restingCount": {"type": "integer", "minimum": 1}
      }
    }
  }
}
