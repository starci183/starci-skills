{
  "name": "@starci/tsconfig",
  "version": "2.0.0",
  "description": "The StarCi TypeScript configs: base, be (back end), build (back-end emit overlay), next (front-end app) and e2e. Strict, including noImplicitAny.",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    "./base.json": "./base.json",
    "./be.json": "./be.json",
    "./build.json": "./build.json",
    "./next.json": "./next.json",
    "./e2e.json": "./e2e.json"
  },
  "files": [
    "*.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
