{
  "name": "@starci/jest-preset",
  "version": "2.2.0",
  "description": "The StarCi jest config for Nest repositories (unit, integration, e2e and contract projects, ts-jest with diagnostics off, per-file 100 coverage of *.service.ts only) and the one shared unit-test double kit: typed mock<T>(), mockEntityManager(), fakeTransaction(), fakeCache(), fakeLock(), recordingOutbox(), FakeClock, fakeIds(), builder() and the Outcome matchers toBeRefused/toSucceedWith.",
  "license": "UNLICENSED",
  "private": false,
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./mock": {
      "types": "./mock.d.ts",
      "default": "./mock.cjs"
    },
    "./clock": {
      "types": "./clock.d.ts",
      "default": "./clock.cjs"
    },
    "./entity-manager": {
      "types": "./entity-manager.d.ts",
      "default": "./entity-manager.cjs"
    },
    "./ids": {
      "types": "./ids.d.ts",
      "default": "./ids.cjs"
    },
    "./matchers": {
      "types": "./matchers.d.ts",
      "default": "./matchers.cjs"
    },
    "./cache": {
      "types": "./cache.d.ts",
      "default": "./cache.cjs"
    },
    "./lock": {
      "types": "./lock.d.ts",
      "default": "./lock.cjs"
    },
    "./outbox": {
      "types": "./outbox.d.ts",
      "default": "./outbox.cjs"
    },
    "./builders": {
      "types": "./builders.d.ts",
      "default": "./builders.cjs"
    }
  },
  "files": [
    "*.cjs",
    "*.d.ts",
    "!*.test.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@types/jest": ">=29",
    "jest": ">=29",
    "ts-jest": ">=29",
    "typeorm": ">=0.3"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  },
  "peerDependenciesMeta": {
    "typeorm": {
      "optional": true
    }
  }
}
