{
  "name": "@starci/cli",
  "version": "1.0.1",
  "description": "The single catalog-driven command line for StarCi apps and runtimes.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "starci": "./bin/starci.mjs"
  },
  "exports": {
    ".": "./src/main.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@starci/hfs": "4.0.10"
  },
  "scripts": {
    "test": "node --test src/*.spec.mjs"
  },
  "files": [
    "LICENSE",
    "bin/",
    "src/",
    "!src/**/*.spec.mjs",
    "completions/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
