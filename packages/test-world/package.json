{
  "name": "@starci/test-world",
  "version": "1.0.5",
  "description": "The shared e2e library of every StarCi back end: one warm docker stack shared by all repos (postgres, redis, minio, qdrant, kafka, keycloak behind toxiproxy, k3d with a local registry), a framework for network-edge fakes (smtp, openai-compatible, vnpay, momo, payos, sepay), the Nest boot and the typed useTestWorld handle, and the starci-test-stack cli.",
  "license": "UNLICENSED",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "starci-test-stack": "bin/starci-test-stack.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./global-setup": {
      "types": "./dist/jest/global-setup.d.ts",
      "default": "./dist/jest/global-setup.js"
    },
    "./global-teardown": {
      "types": "./dist/jest/global-teardown.d.ts",
      "default": "./dist/jest/global-teardown.js"
    },
    "./fakes": {
      "types": "./dist/fakes/index.d.ts",
      "default": "./dist/fakes/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@nestjs/cqrs": ">=10",
    "@types/jest": ">=29",
    "jest": ">=29",
    "pg": ">=8",
    "tsconfig-paths": ">=4",
    "typeorm": ">=0.3"
  },
  "peerDependenciesMeta": {
    "@nestjs/cqrs": {
      "optional": true
    },
    "tsconfig-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/platform-express": "11.2.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.27",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepack": "npm run build"
  }
}
