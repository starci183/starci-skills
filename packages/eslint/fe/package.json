{
  "name": "@starci/eslint-canon-fe",
  "version": "5.1.1",
  "description": "The StarCi front-end lint canon: every rule its laws publish, gathered as one flat-config plugin and attached by one factory.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": "./index.mjs"
  },
  "main": "./index.mjs",
  "files": [
    "*.mjs",
    "lib/*.mjs",
    "docs/*.md",
    "*.ts",
    "!*.test.mjs",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "eslint-plugin-react-hooks": ">=7"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "canon"
  ]
}
