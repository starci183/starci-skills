{
  "name": "@starci/eslint-canon-be",
  "version": "2.1.2",
  "description": "The StarCi back-end lint canon: every rule its laws publish, gathered as one flat-config plugin.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": "./index.mjs"
  },
  "main": "./index.mjs",
  "files": [
    "*.mjs",
    "lib/*.mjs",
    "runtime/**",
    "!*.test.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "starci",
    "canon"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0"
  }
}
