{
  "name": "@starci-examples/fe-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared theme provider, display controls and next-intl plumbing for the StarCi example frontends. Consumers compile its source through declared package exports or the older @fe-kit/* alias.",
  "exports": {
    "./package.json": "./package.json",
    "./i18n/config": "./src/i18n/config.ts",
    "./i18n/i18n-context": "./src/i18n/i18n-context.tsx",
    "./i18n/navigation": "./src/i18n/navigation.ts",
    "./i18n/request": "./src/i18n/request.ts",
    "./i18n/routing": "./src/i18n/routing.ts",
    "./theme/theme-context": "./src/theme/theme-context.tsx",
    "./theme/leaves/DisplayControls": "./src/theme/leaves/DisplayControls/index.tsx",
    "./*": "./src/*"
  },
  "peerDependencies": {
    "@starci/grammar": ">=0.4.0",
    "next-intl": ">=4",
    "react": ">=19"
  },
  "scripts": {
    "link-peers": "node scripts/link-peers.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
