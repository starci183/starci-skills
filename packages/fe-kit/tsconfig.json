{
  // Standalone check for the kit sources: the StarCi front-end preset, strict and not relaxed. Peer imports
  // (react, next-intl, @starci/grammar) resolve through the junctions that `npm run link-peers` creates in
  // ./node_modules - the kit is consumed as source via the consumers' @fe-kit/* path alias, so those peers
  // always end up being the CONSUMER's own copies in the app build.
  "extends": "../tsconfig/next.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
