{
  "name": "@starci/prettier-config",
  "version": "1.0.3",
  "description": "The one StarCi Prettier config: 120 columns, 4 spaces, no semicolons, double quotes, trailing commas everywhere.",
  "license": "MIT",
  "private": false,
  "main": "index.cjs",
  "types": "index.d.cts",
  "exports": {
    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    }
  },
  "files": [
    "LICENSE",
    "index.cjs",
    "index.d.cts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "scripts": {
    "test": "node --test \"*.spec.mjs\""
  }
}
