{
  "name": "starci-eslint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The machines behind the StarCi lint canon: one flat-config plugin per side, each rule paired with the test that proves it fires. Lives in the .claude trust tree; published as @starci/eslint-canon-{be,fe}.",
  "workspaces": [
    "eslint/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:fe": "npm test --workspace @starci/eslint-canon-fe",
    "test:be": "npm test --workspace @starci/eslint-canon-be",
    "test:stylelint": "node --test stylelint/*.spec.mjs",
    "test:presets": "node --test tsconfig/*.spec.mjs prettier-config/*.spec.mjs jest-preset/*.spec.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "typescript": "^6.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "29.7.0"
  }
}
