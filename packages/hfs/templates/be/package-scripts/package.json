{
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    {{appScripts}}
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p src/tests/tsconfig.json",
    "lint": "hfs lint",
    "lint:fix": "hfs lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit --coverage",
    "test:affected": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "npm run typecheck:tests && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && jest --selectProjects e2e",
    "test:contract": "npm run typecheck:tests && jest --selectProjects contract",
    "test:stack": "starci-test-stack",
    "contract:emit": "hfs emit-contracts"
  }
}
