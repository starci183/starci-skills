{
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    {{appScripts}}
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --selectProjects unit",
    "test:e2e": "npm run typecheck:e2e && jest --selectProjects e2e",
    "test:e2e:live": "npm run typecheck:e2e && jest --selectProjects e2e --testPathIgnorePatterns /node_modules/ --testPathPattern e2e.live",
    "hfs:check": "hfs check"
  }
}
