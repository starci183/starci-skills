# Push gate: a release gate check, never a test run. Nothing but the release cut pushes main or a release tag, and the coordinator
# backs work up under refs/backup/*. Git hands this hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
#   refs/backup/*                  allowed: the coordinator backup namespace
#   refs/heads/main, refs/tags/v*  allowed only when HEAD carries an annotated tag v[0-9]* and the release cut recorded the
#                                  full suite of HEAD: <git common dir>/starci-release/<HEAD sha>.l4.json names that head and tag
#   any other ref, a delete        refused
common=$(git rev-parse --git-common-dir)
case "$common" in /* | [A-Za-z]:*) ;; *) common="$(pwd)/$common" ;; esac
head=$(git rev-parse HEAD)
record="$common/starci-release/$head.l4.json"
status=0
gate=""
refuse() {
  echo "RIGHTS_PUSH_NOT_RELEASE: $1 - the allowed path is the release cut (main and v* tags) or refs/backup/* (backups)" >&2
  status=1
}
# gate: the verdict of the release gate for HEAD, computed once: "ok" or the reason it is closed.
release_gate() {
  if [ -n "$gate" ]; then return 0; fi
  gate="no annotated tag v[0-9]* on HEAD $head"
  for tag in $(git tag --points-at HEAD --list 'v[0-9]*' 2>/dev/null || true); do
    if [ "$(git cat-file -t "refs/tags/$tag" 2>/dev/null || true)" != "tag" ]; then continue; fi
    if [ ! -f "$record" ]; then gate="no L4 record $record"; continue; fi
    flat=$(tr -d ' \t\r\n' < "$record")
    case "$flat" in
      *'"head":"'"$head"'"'*'"tag":"'"$tag"'"'* | *'"tag":"'"$tag"'"'*'"head":"'"$head"'"'*) gate="ok"; return 0 ;;
    esac
    gate="the L4 record $record does not name head $head and tag $tag"
  done
  return 0
}
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/backup/*) ;;
    refs/heads/main | refs/tags/v*)
      case "$local_sha" in
        *[!0]*) ;;
        *) refuse "refusing to delete $remote_ref"; continue ;;
      esac
      release_gate
      if [ "$gate" != "ok" ]; then refuse "$remote_ref is closed: $gate"; fi ;;
    *) refuse "refusing to push $remote_ref" ;;
  esac
done
exit "$status"
