{{header}}
# Commit gate: the secrets guard and work hygiene of the staged files, types, lint and format of the staged files of each side,
# stylelint over the staged CSS of fe, the unit specs of be the staged files touch. Never integration, e2e or contract.
{{> app/hooks/pre-commit-core}}
specs=$(git diff --cached --name-only --diff-filter=ACMR --relative=be -- '*.ts' | grep -v -E '(^|/)src/tests/(world|integration|e2e|contract)/|\.(integration|e2e|contract)-spec\.ts$' || true)
if [ -n "$specs" ]; then
  npm run test:affected -- --findRelatedTests $specs
fi
