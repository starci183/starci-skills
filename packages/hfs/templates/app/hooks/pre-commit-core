npx {{appBinary}} work-hygiene
npm run typecheck
be=$(git diff --cached --name-only --diff-filter=ACMR --relative=be -- '*.ts' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs' || true)
if [ -n "$be" ]; then
  (cd be && npx eslint $be)
fi
fe=$(git diff --cached --name-only --diff-filter=ACMR --relative=fe -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' '*.cjs' || true)
if [ -n "$fe" ]; then
  (cd fe && npx eslint --max-warnings=0 --no-warn-ignored $fe)
fi
styles=$(git diff --cached --name-only --diff-filter=ACMR --relative=fe -- '*.css' || true)
if [ -n "$styles" ]; then
  (cd fe && npx stylelint $styles)
fi
formatted=$(git diff --cached --name-only --diff-filter=ACMR || true)
if [ -n "$formatted" ]; then
  npx prettier --check --ignore-unknown $formatted
fi
