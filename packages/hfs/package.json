{
  "name": "@starci/hfs",
  "version": "4.0.9",
  "description": "The StarCi app command implementation for scaffolding, linting, checking and synchronizing one product repository.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "exports": {
    ".": "./src/main.mjs",
    "./package.json": "./package.json",
    "./runtime/*": "./runtime/*"
  },
  "dependencies": {
    "libpg-query": "18.1.5",
    "smol-toml": "1.9.0"
  },
  "files": [
    "src/main.mjs",
    "emit/**",
    "lint/**",
    "scaffold/**",
    "report/**",
    "runtime/**",
    "sync/**",
    "upgrade/**",
    "templates/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node ../../scripts/hfs/sync-runtime.mjs",
    "sync:check": "node ../../scripts/hfs/sync-runtime.mjs --check",
    "prepack": "node prep-runtime.mjs",
    "pretest": "node prep-runtime.mjs",
    "test": "node --test \"src/*.spec.mjs\""
  }
}
