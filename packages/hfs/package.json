{
  "name": "@starci/hfs",
  "version": "1.0.0",
  "description": "The HFS v2 command line of a StarCi product repository: hfs check, init, explain, sync and work-hygiene. Self-contained; installed by starci link, never from a registry.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "bin": {
    "hfs": "./bin/hfs.mjs"
  },
  "files": [
    "bin/hfs.mjs",
    "runtime/**",
    "sync/**",
    "templates/**",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync-runtime.mjs",
    "sync:check": "node scripts/sync-runtime.mjs --check"
  }
}
