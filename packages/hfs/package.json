{
  "name": "@starci/hfs",
  "version": "2.0.1",
  "description": "The HFS command line of a StarCi product repository: hfs check, init, explain, sync and work-hygiene. Self-contained: it carries the runtime files it reads.",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "bin": {
    "hfs": "./bin/hfs.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./runtime/*": "./runtime/*"
  },
  "files": [
    "bin/hfs.mjs",
    "emit/**",
    "scaffold/**",
    "report/**",
    "runtime/**",
    "sync/**",
    "templates/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync-runtime.mjs",
    "sync:check": "node scripts/sync-runtime.mjs --check"
  }
}
