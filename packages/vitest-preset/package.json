{
  "name": "@starci/vitest-preset",
  "version": "1.0.0",
  "description": "The StarCi vitest configs for Next front ends: one workspace lane per app or package (jsdom, HeroUI and React deduped) and one root config that runs every lane.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "scripts": {
    "test": "node --test \"*.test.mjs\""
  }
}
