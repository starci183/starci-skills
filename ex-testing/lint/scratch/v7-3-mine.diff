@@ -12,3 +12,9 @@ custody:
   provider: keycloak
-  realm: todo-app
+  # v7-3 (2026-09-19): the realm is the code's, not the project's. The imported realm file declares
+  # "realm": "todo" (.starcistacks/dev/infra/compose/realm-todo.json, mounted with --import-realm),
+  # app-config.service.ts defaults the token URL to /realms/todo/..., and integration.login.keycloak
+  # names /realms/todo/... too. "todo-app" is this workspace's project name (workspace.yaml project),
+  # which the record ids below also carry - an id segment is not a realm claim. A realm target that
