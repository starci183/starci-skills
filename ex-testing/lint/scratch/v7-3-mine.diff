index 0d85030b..842d53da 100644
--- a/examples/todo-app-backend/.starciwork/_resources/environments/dev/resource.yaml
+++ b/examples/todo-app-backend/.starciwork/_resources/environments/dev/resource.yaml
@@ -11,3 +11,6 @@ revision: application-stacks.yaml@2026-09-18
 target:
-  compose: infra/compose/compose.yaml
+  # v7-3 (2026-09-19): the compose file lives under the stack directory, not at a bare
+  # infra/compose/compose.yaml - that path resolved to nothing in this repository. The real file is
+  # the one whose services this environment's ports and origins come from.
+  compose: .starcistacks/dev/infra/compose/compose.yaml
   origins:
@@ -39,3 +42,10 @@ probes:
     method: http-get
-    target: http://localhost:8089/realms/todo-app
+    # v7-3 (2026-09-19): the realm this probe reads is the one the stack imports. realm-todo.json
+    # declares "realm": "todo" and keycloak.yaml boots it with --import-realm, so the old
+    # /realms/todo-app target could never go green on a healthy stack - Keycloak answers 404 for a
+    # realm that does not exist. The silent hazard is the near miss: expect 200 verifies only that
+    # *some* realm answers, so the moment a realm is named by two authorities (project name here,
+    # import file there) a probe that keeps passing proves readiness for the wrong one. The name now
+    # comes from the import file, and custody.realm on identity.todo-app.demo says the same thing.
+    target: http://localhost:8089/realms/todo
     expect: 200
@@ -43,3 +53,4 @@ allowedEffects:
   - seed prerequisite SQL rows under owner=uat-*
-  - create/delete disposable Keycloak users under the todo-app realm
+  # v7-3: same correction as custody.realm on identity.todo-app.demo.
+  - create/delete disposable Keycloak users under the todo realm
   - delete run-owned rows by exact recorded id
diff --git a/examples/todo-app-backend/.starciwork/_resources/identities/todo-app-demo/resource.yaml b/examples/todo-app-backend/.starciwork/_resources/identities/todo-app-demo/resource.yaml
