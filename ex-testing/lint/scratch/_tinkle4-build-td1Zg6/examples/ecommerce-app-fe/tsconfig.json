{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@shared/*": ["./packages/shared/src/*"],
      "@fe-kit/*": ["../../packages/fe-kit/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "vitest.setup.ts",
    "packages/shared/src/**/*.d.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/next-env.d.ts"
  ],
  "exclude": ["node_modules", "apps/*/node_modules", "apps/*/.next"]
}
