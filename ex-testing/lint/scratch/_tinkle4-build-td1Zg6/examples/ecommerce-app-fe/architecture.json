{
  "schema": "starci/architecture-config@1",
  "kinds": ["frontend"],
  "tsconfig": "tsconfig.json",
  "roots": ["apps/*"],
  "portProjection": {
    "comment": "The one runtime projection for the whole product, resolved by the BE lane. Every port this file used to restate is read from it - by scripts/serve.mjs for the listeners and by each app's src/modules/config for the service base URLs.",
    "file": "../ecommerce-app-be/metadata.json",
    "env": "ECOMMERCE_APP_BE_METADATA"
  },
  "apps": [
    {
      "id": "landing",
      "package": "@ecommerce/landing",
      "root": "apps/landing",
      "routes": "apps/landing/src/app",
      "devPort": {"projectionKey": "ports.landing"},
      "public": true,
      "summary": "Marketing site and catalogue teaser; links into the authenticated shop app."
    },
    {
      "id": "shop",
      "package": "@ecommerce/shop",
      "root": "apps/shop",
      "routes": "apps/shop/src/app",
      "devPort": {"projectionKey": "ports.shop"},
      "public": false,
      "summary": "Authenticated product app: browse, cart, checkout and account.",
      "consumes": [
        {
          "service": "order",
          "env": "NEXT_PUBLIC_ORDER_API_URL",
          "localhostFallback": {"projectionKey": "ports.orderApi"}
        },
        {
          "service": "identity",
          "env": "NEXT_PUBLIC_IDENTITY_API_URL",
          "localhostFallback": {"projectionKey": "ports.identityApi"}
        }
      ]
    }
  ],
  "frontend": {
    "routes": "apps/*/src/app",
    "components": "apps/*/src/components",
    "modules": "apps/*/src/modules",
    "transport": "apps/shop/src/modules/api"
  }
}
