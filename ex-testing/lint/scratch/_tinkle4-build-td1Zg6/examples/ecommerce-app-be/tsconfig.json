{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@e2e-kit/*": [
        "../../packages/e2e-kit/src/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@tests/*": [
        "./src/tests/*"
      ]
    }
  },
  "include": [
    "apps",
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}