sonar.projectKey=starci-todo-app-backend
sonar.projectName=StarCi Todo App Backend
sonar.host.url=https://sonar.starci.org
sonar.sourceEncoding=UTF-8

sonar.sources=src
sonar.tests=src
sonar.exclusions=**/*.spec.ts,**/*.int-spec.ts,**/*.e2e-spec.ts,**/*.harness-spec.ts,**/dist/**,**/coverage/**
sonar.test.inclusions=**/*.spec.ts,**/*.int-spec.ts,**/*.harness-spec.ts
sonar.test.exclusions=**/*.e2e-spec.*

sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.typescript.tsconfigPaths=tsconfig.json

# The JS/TS analyzer runs in a bridge Node process whose default heap is sized for a
# small project. Keep the heap explicit for the application source.
sonar.javascript.node.maxspace=8192
