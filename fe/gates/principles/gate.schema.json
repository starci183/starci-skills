{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://starci.academy/schema/fe/gates/principles/gate.schema.json",
  "title": "Gate 3 - linear principles executor", "type": "object", "additionalProperties": false, "required": ["input", "output"],
  "properties": {
    "input": { "$ref": "https://starci.academy/schema/fe/gates/blocks/gate.schema.json#/$defs/SelectedDesignBundle" },
    "output": { "oneOf": [{ "$ref": "#/$defs/PrinciplesResult" }, { "$ref": "https://starci.academy/schema/fe/gates/session.schema.json#/$defs/ReturnToOwner" }] }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "PrinciplesResult": { "type": "object", "additionalProperties": false, "required": ["inputHash", "nodes", "states", "visualRules", "findings", "outputHash"], "properties": { "inputHash": { "$ref": "#/$defs/Hash" }, "nodes": { "type": "array", "items": { "type": "object" } }, "states": { "type": "array", "items": { "type": "object" } }, "visualRules": { "type": "array", "items": { "type": "string" } }, "findings": { "type": "array", "items": { "type": "string" } }, "outputHash": { "$ref": "#/$defs/Hash" } } }
  }
}
