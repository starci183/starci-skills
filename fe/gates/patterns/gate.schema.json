{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://starci.academy/schema/fe/gates/patterns/gate.schema.json",
  "title": "Gate 4 - linear source materializer", "type": "object", "additionalProperties": false, "required": ["input", "output"],
  "properties": {
    "input": { "$ref": "#/$defs/PrinciplesReceipt" },
    "output": { "oneOf": [{ "$ref": "#/$defs/PatternResult" }, { "$ref": "https://starci.academy/schema/fe/gates/session.schema.json#/$defs/ReturnToOwner" }] }
  },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "PrinciplesReceipt": { "type": "object", "additionalProperties": false, "required": ["principlesHash", "whitelistHashes"], "properties": { "principlesHash": { "$ref": "#/$defs/Hash" }, "whitelistHashes": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/Hash" } } } },
    "PatternResult": { "type": "object", "additionalProperties": false, "required": ["inputHash", "files", "contracts", "componentSplit", "outputHash"], "properties": { "inputHash": { "$ref": "#/$defs/Hash" }, "files": { "type": "array", "items": { "type": "object" } }, "contracts": { "type": "array", "items": { "type": "string" } }, "componentSplit": { "type": "array", "items": { "type": "object" } }, "outputHash": { "$ref": "#/$defs/Hash" } } }
  }
}
