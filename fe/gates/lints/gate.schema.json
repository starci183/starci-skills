{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://starci.academy/schema/fe/gates/lints/gate.schema.json",
  "title": "Gate 5 - final exact-input verdict", "type": "object", "additionalProperties": false, "required": ["input", "output"],
  "properties": { "input": { "$ref": "#/$defs/LintInput" }, "output": { "$ref": "#/$defs/LintVerdict" } },
  "$defs": {
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "LintInput": {
      "type": "object", "additionalProperties": false, "required": ["sourcePlanHash", "auditResults"],
      "properties": {
        "sourcePlanHash": { "$ref": "#/$defs/Hash" },
        "auditResults": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["rule", "status", "evidence"],
            "properties": { "rule": { "type": "string" }, "status": { "enum": ["pass", "fail", "not-applicable"] }, "evidence": { "type": "string" } }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["rule", "status"],
                "properties": {
                  "rule": { "const": "principle-receipt-coverage" },
                  "status": { "const": "pass" }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["rule", "status"],
                "properties": {
                  "rule": { "const": "principle-recipe-exact" },
                  "status": { "const": "pass" }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "LintVerdict": { "type": "object", "additionalProperties": false, "required": ["inputHash", "verdict", "proofHash"], "properties": { "inputHash": { "$ref": "#/$defs/Hash" }, "verdict": { "enum": ["pass", "fail"] }, "blocking": { "type": "array", "items": { "type": "string" } }, "proofHash": { "$ref": "#/$defs/Hash" } }, "allOf": [{ "if": { "properties": { "verdict": { "const": "fail" } } }, "then": { "required": ["blocking"], "properties": { "blocking": { "minItems": 1 } } } }] }
  }
}
