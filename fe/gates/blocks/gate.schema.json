{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.academy/schema/fe/gates/blocks/gate.schema.json",
  "title": "Gate 2 - independent block proposals",
  "type": "object", "additionalProperties": false, "required": ["input", "output"],
  "properties": { "input": { "$ref": "#/$defs/BlockInput" }, "output": { "$ref": "#/$defs/BlockRoundBatch" } },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "BlockInput": {
      "type": "object", "additionalProperties": false, "required": ["acceptedLayout", "blockIds", "promptHash"],
      "properties": {
        "acceptedLayout": { "$ref": "https://starci.academy/schema/fe/gates/layouts/gate.schema.json#/$defs/SelectedLayoutBundle" },
        "blockIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "promptHash": { "$ref": "#/$defs/Hash" }, "basedOnHash": { "$ref": "#/$defs/Hash" }
      }
    },
    "BlockCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "blockId", "sourceLayoutHash", "role", "render", "collection", "fields", "data", "states", "actions", "copySlots", "responsive", "contract", "ownership"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/Id" }, "blockId": { "$ref": "#/$defs/Id" }, "sourceLayoutHash": { "$ref": "#/$defs/Hash" },
        "role": { "type": "string", "minLength": 12 },
        "render": { "type": "object", "required": ["type", "title", "description", "readingOrder"], "properties": { "type": { "type": "string" }, "title": { "type": ["string", "null"] }, "description": { "type": ["string", "null"] }, "readingOrder": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
        "collection": { "type": "object", "required": ["kind", "itemGrammar"], "properties": { "kind": { "enum": ["none", "list", "grid", "table", "carousel"] }, "itemGrammar": { "type": "string" } } },
        "fields": { "type": "array", "items": { "type": "object", "required": ["name", "order", "source"], "properties": { "name": { "type": "string" }, "order": { "type": "integer", "minimum": 0 }, "source": { "type": "string" } } } },
        "data": { "type": "array", "items": { "type": "string" } }, "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } }, "copySlots": { "type": "array", "items": { "type": "string" } },
        "responsive": { "type": "string", "minLength": 8 },
        "contract": { "type": "object", "required": ["decision", "key"], "properties": { "decision": { "enum": ["reuse", "extend", "new-required", "not-applicable"] }, "key": { "type": ["string", "null"] } } },
        "ownership": { "type": "object", "required": ["owner", "split"], "properties": { "owner": { "type": "string" }, "split": { "enum": ["pure", "connected", "pure-plus-connected"] } } }
      }
    },
    "BlockCandidateSet": {
      "type": "object", "additionalProperties": false, "required": ["blockId", "roundId", "candidates"],
      "properties": { "blockId": { "$ref": "#/$defs/Id" }, "roundId": { "$ref": "#/$defs/Id" }, "candidates": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/BlockCandidate" } } }
    },
    "BlockRoundBatch": {
      "type": "object", "additionalProperties": false, "required": ["sets", "responseHash"],
      "properties": { "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/BlockCandidateSet" } }, "responseHash": { "$ref": "#/$defs/Hash" } }
    },
    "SelectedBlock": {
      "type": "object", "additionalProperties": false, "required": ["blockId", "candidateHash", "decisionHash"],
      "properties": { "blockId": { "$ref": "#/$defs/Id" }, "candidateHash": { "$ref": "#/$defs/Hash" }, "decisionHash": { "$ref": "#/$defs/Hash" } }
    },
    "SelectedDesignBundle": {
      "type": "object", "additionalProperties": false, "required": ["layout", "blocks"],
      "properties": { "layout": { "$ref": "https://starci.academy/schema/fe/gates/layouts/gate.schema.json#/$defs/SelectedLayoutBundle" }, "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SelectedBlock" } } }
    }
  }
}
