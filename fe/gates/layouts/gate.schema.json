{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.academy/schema/fe/gates/layouts/gate.schema.json",
  "title": "Gate 1 - iterative surface layouts",
  "type": "object", "additionalProperties": false, "required": ["input", "output"],
  "properties": { "input": { "$ref": "#/$defs/LayoutInput" }, "output": { "$ref": "#/$defs/LayoutRoundBatch" } },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "GrammarReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["grammar", "grammarId", "version", "profileId", "grammarHash", "profileHash", "factCatalogHash"],
      "properties": {
        "grammar": { "$ref": "#/$defs/Id" }, "grammarId": { "$ref": "#/$defs/Id" }, "version": { "type": "integer", "minimum": 1 },
        "profileId": { "$ref": "#/$defs/Id" }, "grammarHash": { "$ref": "#/$defs/Hash" }, "profileHash": { "$ref": "#/$defs/Hash" },
        "factCatalogHash": { "$ref": "#/$defs/Hash" }
      }
    },
    "GrammarDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["slot", "ruleId", "outcome", "obligations", "ownerDecision", "owner", "principleMode", "principleConcerns"],
      "properties": {
        "slot": { "$ref": "#/$defs/Id" }, "ruleId": { "$ref": "#/$defs/Id" }, "outcome": { "$ref": "#/$defs/Id" },
        "obligations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "ownerDecision": { "enum": ["reuse", "extend", "new-required", "not-applicable"] },
        "owner": { "type": "string", "minLength": 2 }, "primitive": { "type": ["string", "null"] },
        "principleMode": { "enum": ["inherit", "delta", "none"] },
        "principleConcerns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }
      }
    },
    "SurfaceKind": { "enum": ["page", "layout", "modal", "drawer", "overlay"] },
    "TargetSurface": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaceId", "kind", "business", "requestedOutcome", "contracts", "intent", "grammarFacts"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/Id" }, "kind": { "$ref": "#/$defs/SurfaceKind" },
        "business": { "type": "object" }, "requestedOutcome": { "type": "string", "minLength": 8 },
        "contracts": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "intent": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "grammarFacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "origin": { "enum": ["root", "discovered"] }
      }
    },
    "LayoutInput": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "targets", "promptHash", "grammarReceipt"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/Id" }, "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TargetSurface" } },
        "promptHash": { "$ref": "#/$defs/Hash" }, "basedOnHash": { "$ref": "#/$defs/Hash" },
        "grammarReceipt": { "$ref": "#/$defs/GrammarReceipt" }
      }
    },
    "StateBrief": {
      "type": "object", "additionalProperties": false, "required": ["name", "renders", "source"],
      "properties": { "name": { "$ref": "#/$defs/Id" }, "renders": { "type": "string", "minLength": 8 }, "source": { "enum": ["business", "contract", "proposal"] } }
    },
    "BlockBrief": {
      "type": "object", "additionalProperties": false,
      "required": ["blockId", "title", "status", "usage", "businessPurpose", "renderBrief", "data", "states", "placement", "contractDecision", "grammarDecisionIds"],
      "properties": {
        "blockId": { "$ref": "#/$defs/Id" }, "title": { "type": "string", "minLength": 2 },
        "status": { "enum": ["existing", "new", "modify"] }, "usage": { "enum": ["used", "not-used", "conditional", "repeated", "on-demand"] },
        "activationOrReason": { "type": "string", "minLength": 8 }, "businessPurpose": { "type": "string", "minLength": 12 },
        "renderBrief": { "type": "string", "minLength": 20 }, "data": { "type": "array", "items": { "type": "string" } },
        "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/StateBrief" } },
        "placement": { "type": "object", "required": ["region", "order", "width", "responsive"], "properties": { "region": { "$ref": "#/$defs/Id" }, "order": { "type": "integer", "minimum": 0 }, "width": { "type": "string" }, "responsive": { "type": "string" } } },
        "contractDecision": { "enum": ["reuse", "extend", "new-required", "not-applicable"] }, "contract": { "type": ["string", "null"] },
        "brief": { "type": "string", "minLength": 12 },
        "grammarDecisionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }
      }
    },
    "MainLayout": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaceId", "kind", "purpose", "distribution", "css", "responsive", "blocks"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/Id" }, "kind": { "$ref": "#/$defs/SurfaceKind" }, "purpose": { "type": "string", "minLength": 12 },
        "distribution": { "type": "string", "minLength": 16 }, "css": { "type": "string", "minLength": 8 }, "responsive": { "type": "string", "minLength": 8 },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/BlockBrief" } }
      }
    },
    "ExtendEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaceId", "kind", "owner", "trigger", "mount", "renderBrief", "designStatus"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/Id" }, "kind": { "$ref": "#/$defs/SurfaceKind" }, "owner": { "$ref": "#/$defs/Id" },
        "trigger": { "type": "string", "minLength": 4 }, "mount": { "type": "string", "minLength": 4 }, "renderBrief": { "type": "string", "minLength": 12 },
        "designStatus": { "enum": ["queued", "approved", "rejected"] }
      }
    },
    "LayoutPlan": {
      "type": "object", "additionalProperties": false, "required": ["business", "main", "extends", "grammarDecisions"],
      "properties": {
        "business": { "type": "object" }, "main": { "$ref": "#/$defs/MainLayout" },
        "extends": { "type": "array", "items": { "$ref": "#/$defs/ExtendEdge" } },
        "grammarDecisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/GrammarDecision" } }
      }
    },
    "LayoutCandidate": {
      "type": "object", "additionalProperties": false, "required": ["candidateId", "name", "thesis", "tradeoffs", "plan"],
      "properties": { "candidateId": { "$ref": "#/$defs/Id" }, "name": { "type": "string", "minLength": 2 }, "thesis": { "type": "string", "minLength": 12 }, "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "plan": { "$ref": "#/$defs/LayoutPlan" } }
    },
    "LayoutCandidateSet": {
      "type": "object", "additionalProperties": false, "required": ["surfaceId", "roundId", "candidates"],
      "properties": { "surfaceId": { "$ref": "#/$defs/Id" }, "roundId": { "$ref": "#/$defs/Id" }, "candidates": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/LayoutCandidate" } } }
    },
    "LayoutRoundBatch": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "sets", "responseHash"],
      "properties": { "sessionId": { "$ref": "#/$defs/Id" }, "sets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/LayoutCandidateSet" } }, "responseHash": { "$ref": "#/$defs/Hash" } }
    },
    "SelectedLayoutBundle": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "surfaceId", "layoutHash", "decisionHash", "plan"],
      "properties": { "sessionId": { "$ref": "#/$defs/Id" }, "surfaceId": { "$ref": "#/$defs/Id" }, "layoutHash": { "$ref": "#/$defs/Hash" }, "decisionHash": { "$ref": "#/$defs/Hash" }, "plan": { "$ref": "#/$defs/LayoutPlan" } }
    }
  }
}
