{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.academy/schema/fe/intent/intent.schema.json",
  "title": "StarCi FE intent context",
  "type": "object", "additionalProperties": false,
  "required": ["audienceState", "desiredAction", "valueFrame", "evidence", "friction", "ethicalConstraints", "appliedModules", "forbiddenTactics"],
  "properties": {
    "audienceState": { "type": "string", "minLength": 8 }, "desiredAction": { "type": "string", "minLength": 4 },
    "valueFrame": { "type": "string", "minLength": 8 }, "evidence": { "type": "array", "items": { "type": "string" } },
    "friction": { "type": "array", "items": { "type": "string" } }, "ethicalConstraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "appliedModules": { "type": "array", "uniqueItems": true, "items": { "enum": ["call-to-action", "value-framing", "choice-architecture", "trust-and-proof", "urgency-and-scarcity", "commitment-and-friction"] } },
    "forbiddenTactics": { "type": "array", "uniqueItems": true, "items": { "enum": ["fake-scarcity", "fake-proof", "buried-cost", "ambiguous-cta", "confirmshaming", "forced-consent", "obstructed-cancellation"] } }
  }
}
