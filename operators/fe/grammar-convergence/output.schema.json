{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/grammar-convergence/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/grammar-convergence" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Whether a packaged Grammar Core plus visual DNA binding was compiled before source mutation.", "enum": ["converged", "refused"] },
        "result": {
          "description": "The pre-source packaged Grammar and product-family binding, or null when refused.",
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["summary", "artifactRefs", "layoutCompilationRef", "uiLawBindingRef", "uiDetailBindingRef", "grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyEvidence", "applicationStage"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "artifactRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "layoutCompilationRef": { "type": "string", "pattern": "^layout-compile://" },
                "uiLawBindingRef": { "type": "string", "pattern": "^ui-law-binding://" },
                "uiDetailBindingRef": { "type": "string", "pattern": "^ui-detail-binding://" },
                "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
                "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
                "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
                "productFamilyEvidence": {
                  "type": "object", "additionalProperties": false,
                  "required": ["productFamilyRef", "benchmarkRasterRefs"],
                  "properties": {
                    "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
                    "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
                  }
                },
                "applicationStage": { "const": "before-source-mutation" }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Finite Grammar package, DNA, or family-evidence gaps that prevent convergence.", "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact evidence supporting the Grammar convergence outcome.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
