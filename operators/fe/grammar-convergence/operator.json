  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "layout.review",
      "status": "approved",
      "allFacts": [
        "layout-approved",
        "grammar-pair-ready",
        "neutral-facts-ready"
      ],
      "noneFacts": []
    }
  ],
  "emits": [
    {
      "when": {
        "gate": "pass"
      },
      "stage": "source-fit.resolve",
      "status": "ready",
      "factsAdd": [
        "grammar-converged"
      ],
      "factsRemove": []
    },
    {
      "when": {
        "gate": "refused"
      },
      "stage": "source-fit.resolve",
      "status": "blocked",
      "factsAdd": [
        "grammar-business-gate-failed"
      ],
      "factsRemove": []
    }
  ],
  "sideEffects": [
    "keep input, output, loaded context, worker observations, drafts, evidence, and receipts in task-session storage only",
    "purge every intermediate session object at every parent-skill terminal state"
  ],
  "stopConditions": [
    "invalid-input",
    "non-neutral-fact",
    "non-neutral-state",
    "copy-semantic-branch",
    "ambiguous-rule",
    "unlocked-package",
    "undeclared-package-dependency",
    "usage-guide-stale",
    "invented-or-non-public-export",
    "undeclared-contract-extension-axis",
    "Refuse on business-specific Grammar content, an unlocked package, a missing neutral owner, or an undeclared package dependency.",
    "runtime binding revision or session ownership is invalid",
    "the operation would broaden its approved authority, source, or external boundary"
  ]
}
