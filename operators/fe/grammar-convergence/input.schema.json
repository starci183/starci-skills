{
  "$id": "https://starci.dev/v6/operators/fe/grammar-convergence/input.schema.json",
  "title": "fe/grammar-convergence operator input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "layout.review"
            },
            "status": {
              "const": "approved"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "layout.review"
      ]
    },
    "status": {
      "enum": [
        "approved"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided",
        "loads",
        "session"
      ],
      "properties": {
        "provided": {
          "type": "object",
          "description": "References supplied by the previous state; workers cannot replace or broaden them.",
          "additionalProperties": false,
          "required": [
            "priorStateRef",
            "grammarId",
            "authorityRefs",
            "approvalRef",
            "baselineRef"
          ],
          "properties": {
            "priorStateRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "grammarId": {
              "enum": [
                "core",
                "offset-pop"
              ]
            },
            "authorityRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sessionRef"
              }
            },
            "approvalRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sessionRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "baselineRef": {
              "type": "string",
              "pattern": "^(git:[0-9a-f]{7,64}|sha256:[0-9a-f]{64}|session://tasks/[A-Za-z0-9._-]+/.+)$"
            }
          }
        },
        "loads": {
          "type": "object",
          "description": "Runtime-resolved bindings. They identify exact values to load and never carry broad copied context.",
          "additionalProperties": false,
          "required": [
            "upstream",
            "knowledge",
            "frontendSource",
            "orchestration"
          ],
          "properties": {
            "upstream": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "role",
                  "ref",
                  "revision"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ref": {
                    "$ref": "#/$defs/sessionRef"
                  },
                  "revision": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "knowledge": {
              "type": "array",
              "minItems": 4,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "generation",
                  "contentSha256",
                  "loadMode"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "fe.grammar-common-overview",
                      "fe.grammar-common-contracts",
                      "fe.grammar-common-states-accessibility",
                      "fe.grammar-common-extension",
                      "fe.grammar-common-case-surface-inside-surface",
                      "fe.grammar-common-case-collection-cardinality",
                      "fe.grammar-common-case-sticky-scroll-owner",
                      "fe.grammar-common-case-responsive-flattening",
                      "fe.grammar-core-overview",
                      "fe.grammar-core-object-actions",
                      "fe.grammar-core-object-fields",
                      "fe.grammar-core-object-surface-card",
                      "fe.grammar-core-object-collections",
                      "fe.grammar-core-object-navigation",
                      "fe.grammar-core-object-tabs",
                      "fe.grammar-core-object-tables",
                      "fe.grammar-core-object-overlays-feedback",
                      "fe.grammar-core-case-primary-secondary-grid",
                      "fe.grammar-core-case-trust-list-in-card",
                      "fe.grammar-core-case-multi-step-form",
                      "fe.grammar-core-case-sticky-summary",
                      "fe.grammar-offset-pop-overview",
                      "fe.grammar-offset-pop-object-actions",
                      "fe.grammar-offset-pop-object-fields",
                      "fe.grammar-offset-pop-object-surface-card",
                      "fe.grammar-offset-pop-object-collections",
                      "fe.grammar-offset-pop-object-navigation",
                      "fe.grammar-offset-pop-object-tabs",
                      "fe.grammar-offset-pop-object-tables",
                      "fe.grammar-offset-pop-object-overlays-feedback",
                      "fe.grammar-offset-pop-case-hero-collage",
                      "fe.grammar-offset-pop-case-list-in-offset-card",
                      "fe.grammar-offset-pop-case-dense-screen-simplification",
                      "fe.grammar-offset-pop-case-mobile-accent-reduction"
                    ]
                  },
                  "generation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contentSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "loadMode": {
                    "const": "qdrant-exact"
                  }
                }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profileRef",
                "providerRef"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "economical",
                    "balanced",
                    "parallel"
                  ]
                },
                "profileRef": {
                  "enum": [
                    "orchestration/modes/economical.json",
                    "orchestration/modes/balanced.json",
                    "orchestration/modes/parallel.json"
                  ]
                },
                "providerRef": {
                  "type": "string",
                  "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$"
                }
              }
            },
            "frontendSource": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "snapshotPath",
                "snapshotSha256",
                "generatorSha256",
                "generation",
                "queryIds",
                "loadMode",
                "indexStatus",
                "rawRepositoryContext"
              ],
              "properties": {
                "snapshotPath": {
                  "type": "string",
                  "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]*/coding-context/frontend(?:/|$)"
                },
                "snapshotSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "generatorSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "generation": {
                  "type": "string",
                  "minLength": 1
                },
                "queryIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "loadMode": {
                  "const": "hash-pinned-json-generation"
                },
                "indexStatus": {
                  "enum": [
                    "reused",
                    "upserted"
                  ]
                },
                "rawRepositoryContext": {
                  "const": false
                }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "description": "Ephemeral task-local storage, never a persistence path.",
          "additionalProperties": false,
          "required": [
            "taskId",
            "inputRef",
            "outputRef",
            "scratchPrefix",
            "retention"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "inputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "outputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "scratchPrefix": {
              "$ref": "#/$defs/sessionRef"
            },
            "retention": {
              "const": "until-skill-terminal"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    }
  }
}
