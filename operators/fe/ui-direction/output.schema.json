{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/ui-direction/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/ui-direction"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "description": "Legacy semantic result consumed only by the Skill machine.",
          "enum": [
            "directions-ready",
            "blocked"
          ]
        },
        "result": {
          "description": "The atomic job result, or null when blocked.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "comparisonArtifactRef",
                "directions"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "comparisonArtifactRef": {
                  "description": "Inspectable HTML comparison rendered through visualize before direction choice.",
                  "type": "string",
                  "pattern": "\\.html$"
                },
                "directions": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id","visualPanelRef","wideStateRef","compactStateRef","materialStateRef","tradeoff"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                      "visualPanelRef": { "type": "string", "minLength": 1 },
                      "wideStateRef": { "type": "string", "minLength": 1 },
                      "compactStateRef": { "type": "string", "minLength": 1 },
                      "materialStateRef": { "type": "string", "minLength": 1 },
                      "tradeoff": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact missing authority or evidence; empty when complete.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used to produce the result.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  }
}
