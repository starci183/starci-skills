{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/mutation-boundary-freeze"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifiedFrontendRoute",
        "approvedContractFingerprint"
      ],
      "properties": {
        "verifiedFrontendRoute": {
          "description": "Verified FE route.",
          "type": "string",
          "minLength": 1
        },
        "approvedContractFingerprint": {
          "description": "Approved contract fingerprint.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "uxUiChangeLevel",
        "layoutOwnerCeilingMode",
        "layoutOwnerCeiling",
        "mutationAuthorizationRef",
        "files",
        "dominance"
      ],
      "properties": {
        "intent": {
          "description": "Mission intent.",
          "enum": [
            "create",
            "audit",
            "repair",
            "redesign",
            "debug",
            "reconcile"
          ]
        },
        "uxUiChangeLevel": {
          "description": "Projection of the frozen frontend.ux-ui.change-level scope dimension enforced by the file boundary.",
          "enum": [
            "refine",
            "reconstruct",
            "new"
          ]
        },
        "layoutOwnerCeiling": {
          "description": "Exact mutable owner set and immutable ancestor ceiling projected from frozen frontend scope.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetOwnerRef",
            "directInteractionOwnerRefs",
            "mutableNestedLayoutRefs",
            "mutableAncestorLayoutRefs",
            "immutableAncestorLayoutRefs"
          ],
          "properties": {
            "targetOwnerRef": { "type": "string", "minLength": 1 },
            "directInteractionOwnerRefs": {
              "description": "Feature-owned or directly nested page/modal/drawer owners; shared branches and ancestors remain outside this set.",
              "type": "array",
              "uniqueItems": true,
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1 }
            },
            "mutableNestedLayoutRefs": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
            "mutableAncestorLayoutRefs": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
            "immutableAncestorLayoutRefs": { "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "layoutOwnerCeilingMode": {
          "description": "Projection of the frozen frontend.layout.owner-ceiling scope dimension.",
          "enum": [
            "surface-only",
            "surface-and-nested-layouts",
            "ancestor-layouts-authorized"
          ]
        },
        "mutationAuthorizationRef": {
          "description": "Explicit mutation authorization, nullable only for non-mutating outcomes.",
          "type": [
            "string",
            "null"
          ]
        },
        "files": {
          "description": "Exact files and before hashes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "beforeSha256",
              "ownerRef"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "beforeSha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "ownerRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dominance": {
          "description": "Whether authority proves one uniquely dominant mutation.",
          "enum": [
            "unique",
            "none"
          ]
        }
      }
    }
  }
}
