{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/session-continuity/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/session-continuity" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionRef", "runtimeGeneration", "origin"],
      "properties": {
        "missionRef": { "description": "Canonical frontend mission identity.", "type": "string", "minLength": 1 },
        "runtimeGeneration": { "description": "Central runtime generation expected by the lease.", "type": "integer", "minimum": 1 },
        "origin": { "description": "Canonical local frontend origin.", "const": "http://localhost:3000" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseRef", "accountRef", "browserContextRef", "principalFingerprint", "continuityFailure"],
      "properties": {
        "leaseRef": { "description": "Opaque failed or stale Browser lease identity.", "type": "string", "pattern": "^browser-lease://" },
        "accountRef": { "description": "Fresh mission-scoped logical UAT account reference.", "type": "string", "pattern": "^account://fresh" },
        "browserContextRef": { "description": "Isolated Browser context bound to the lease.", "type": "string", "minLength": 1 },
        "principalFingerprint": { "description": "Opaque authenticated principal identity.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "continuityFailure": { "description": "Observed reason the existing lease cannot be trusted or cannot execute in the consumer.", "enum": ["expired", "contaminated", "browser-disconnected", "runtime-generation-changed", "identity-mismatch", "handoff-not-materialized"] }
      }
    }
  }
}
