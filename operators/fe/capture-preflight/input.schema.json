{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.6.0-beta.1/operators/fe/capture-preflight/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/capture-preflight" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRefs", "evidenceRefs", "uiKnowledgeId", "runtimeReadinessKnowledgeId", "resumeState", "debug"],
      "properties": {
        "authorityRefs": { "description": "Exact frozen frontend authority references.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact deterministic runtime evidence references.", "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "uiKnowledgeId": { "description": "Exact StarCi UI knowledge binding.", "const": "fe.ui" },
        "runtimeReadinessKnowledgeId": { "description": "Exact deterministic runtime/capture readiness authority.", "const": "fe.runtime-capture-readiness" },
        "resumeState": { "description": "Exact FE preflight state restored after a backend handoff.", "enum": ["capture-preflight", "recapture-preflight"] },
        "debug": { "description": "Preflight state and decisions must be visible in terminal debug.", "const": true }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "compiledRequestRef", "compiledRequestFingerprint", "sourceApplyReturnReceiptRef", "aggregateAfterFingerprint", "grammarBinding", "iconographyManifest", "mediaManifest", "productFamilyEvidence", "round", "matrix", "partitions", "readinessChecks"],
      "properties": {
        "targetRef": { "description": "One closed frontend target.", "type": "string", "minLength": 1 },
        "compiledRequestRef": { "description": "Exact author-once compiled request that froze the proof matrix.", "type": "string", "pattern": "^compiled-request://" },
        "compiledRequestFingerprint": { "description": "Exact fingerprint of the author-once compiled request; it is inherited, never recomputed from capture inputs.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceApplyReturnReceiptRef": { "description": "Exact runtime-issued source-apply RETURN bound to the latest mutation.", "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
        "aggregateAfterFingerprint": { "description": "Aggregate fingerprint of exact mutation effect paths and after hashes.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "grammarBinding": { "description": "Exact compile-owned Grammar decision and audit binding inherited through source apply.", "$ref": "#/$defs/grammarBinding" },
        "iconographyManifest": { "description": "Exact compile-owned iconography provenance manifest.", "$ref": "#/$defs/iconographyManifest" },
        "mediaManifest": { "description": "Exact compile-owned media provenance manifest.", "$ref": "#/$defs/mediaManifest" },
        "productFamilyEvidence": { "description": "Exact product-family identity and benchmark rasters.", "$ref": "#/$defs/productFamilyEvidence" },
        "round": {
          "description": "Visual round and its fixed purpose; later regression-attack rounds remain legal while progress continues.",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "purpose"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "purpose": { "enum": ["discovery", "verification", "regression"] }
          }
        },
        "matrix": {
          "description": "Immutable render-state, viewport, and adversarial-probe matrix.",
          "type": "object",
          "additionalProperties": false,
          "required": ["matrixRef", "matrixFingerprint", "states", "viewports", "probeRefs", "populatedHeroStateRef", "coreTaskRef", "cells"],
          "properties": {
            "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
            "matrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "states": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["stateRef", "lifecycle", "populated", "coreTaskVisible"],
                "properties": {
                  "stateRef": { "type": "string", "minLength": 1 },
                  "lifecycle": { "enum": ["happy-case", "loading", "empty", "error", "recovery", "result"] },
                  "populated": { "type": "boolean" },
                  "coreTaskVisible": { "type": "boolean" }
                }
              }
            },
            "viewports": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["wide", "intermediate", "compact"] } },
            "probeRefs": { "type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" } },
            "populatedHeroStateRef": { "type": "string", "minLength": 1 },
            "coreTaskRef": { "type": "string", "minLength": 1 },
            "cells": {
              "type": "array", "minItems": 3, "maxItems": 96,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["cellRef", "stateRef", "viewport"],
                "properties": {
                  "cellRef": { "type": "string", "pattern": "^proof-cell-[0-9]{3}$" },
                  "stateRef": { "type": "string", "minLength": 1 },
                  "viewport": { "enum": ["wide", "intermediate", "compact"] }
                }
              }
            }
          }
        },
        "partitions": {
          "description": "Owner partitions that define fresh capture, reuse, and shared sentinels.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partitionRef", "ownerRef", "stateRefs", "probeRefs", "disposition", "dependencyProofRefs"],
            "properties": {
              "partitionRef": { "type": "string", "pattern": "^partition://[a-z0-9][a-z0-9._/-]*$" },
              "ownerRef": { "type": "string", "minLength": 1 },
              "stateRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "probeRefs": { "type": "array", "maxItems": 96, "uniqueItems": true, "items": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" } },
              "disposition": { "enum": ["capture", "reuse", "shared-sentinel"] },
              "dependencyProofRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "readinessChecks": {
          "description": "Exact ordered deterministic checks that must pass before Sol review.",
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "verdict", "evidenceRef", "observation"],
            "properties": {
              "check": { "enum": ["runtime-origin-valid", "dependency-graph-ready", "repository-reproducibility-recorded", "viewport-controls-effective", "data-ready", "steady-not-skeleton", "state-content-valid", "controls-effective", "page-scroll-restored", "bounded-scroll-restored", "zoom-restored", "probe-complete", "raster-unique", "handoff-host-valid"] },
              "verdict": { "enum": ["passed", "failed", "not-applicable"] },
              "evidenceRef": { "type": "string", "minLength": 1 },
              "observation": { "type": "string", "minLength": 12 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "compositionOwners": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["ownerRef", "ownerLayer", "authorityRef", "patternRef"], "properties": { "ownerRef": { "type": "string", "pattern": "^owner://" }, "ownerLayer": { "enum": ["grammar", "application-block", "application-composite"] }, "authorityRef": { "type": "string", "pattern": "^(grammar|application)://" }, "patternRef": { "type": "string", "pattern": "^(pattern|block|composite)://" } } } },
    "grammarBinding": { "type": "object", "additionalProperties": false, "required": ["bindingRef", "packageRef", "manifestRef", "exportRefs", "contentSha256", "authorityRevision", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint", "compositionOwners"], "properties": { "bindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "packageRef": { "type": "string", "pattern": "^grammar-package://" }, "manifestRef": { "type": "string", "pattern": "^grammar://" }, "exportRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar://" } }, "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "authorityRevision": { "type": "string", "minLength": 1 }, "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" }, "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "compositionOwners": { "$ref": "#/$defs/compositionOwners" } } },
    "iconographyManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef", "decisions"], "properties": { "manifestRef": { "type": "string", "pattern": "^iconography://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "resolved"] }, "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] }, "decisions": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["roleRef", "meaningAuthorityRef", "source", "glyphRef", "catalogSearchRefs", "customReason"], "properties": { "roleRef": { "type": "string", "pattern": "^semantic-icon://" }, "meaningAuthorityRef": { "type": "string", "pattern": "^(business|ui-law|grammar)://" }, "source": { "enum": ["heroicons", "custom-svg"] }, "glyphRef": { "type": "string", "minLength": 1 }, "catalogSearchRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-catalog://" } }, "customReason": { "type": ["string", "null"], "minLength": 1 } } } } } },
    "mediaManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef", "artifactRefs", "provenanceRefs", "responsiveTreatmentRef", "altIntentRef", "fallbackRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^media-manifest://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "reuse", "generate"] }, "assetRef": { "type": ["string", "null"], "minLength": 1 }, "artifactRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "provenanceRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "responsiveTreatmentRef": { "type": ["string", "null"], "minLength": 1 }, "altIntentRef": { "type": ["string", "null"], "minLength": 1 }, "fallbackRef": { "type": ["string", "null"], "minLength": 1 } } },
    "productFamilyEvidence": { "type": "object", "additionalProperties": false, "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"], "properties": { "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" }, "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } }, "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" }, "productFamilyRef": { "type": "string", "pattern": "^product-family://" }, "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^benchmark://sha256-[0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } } } }
  }
}
