{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5.0-alpha.1/operators/fe/capture-preflight/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/capture-preflight" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRefs", "evidenceRefs", "uiKnowledgeId", "sourceFingerprint", "debug"],
      "properties": {
        "authorityRefs": { "description": "Exact frozen frontend authority references.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact deterministic runtime evidence references.", "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "uiKnowledgeId": { "description": "Exact StarCi UI knowledge binding.", "const": "fe.ui" },
        "sourceFingerprint": { "description": "Latest source fingerprint to freeze before capture.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "debug": { "description": "Preflight state and decisions must be visible in terminal debug.", "const": true }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "round", "matrix", "partitions", "readinessChecks"],
      "properties": {
        "targetRef": { "description": "One closed frontend target.", "type": "string", "minLength": 1 },
        "round": {
          "description": "Visual round and its fixed purpose; later regression-attack rounds remain legal while progress continues.",
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "purpose"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "purpose": { "enum": ["discovery", "verification", "regression"] }
          }
        },
        "matrix": {
          "description": "Immutable render-state, viewport, and adversarial-probe matrix.",
          "type": "object",
          "additionalProperties": false,
          "required": ["matrixRef", "matrixFingerprint", "renderStates", "viewports", "probeRefs"],
          "properties": {
            "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
            "matrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "renderStates": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "viewports": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["wide", "intermediate", "compact"] } },
            "probeRefs": { "type": "array", "minItems": 10, "maxItems": 96, "uniqueItems": true, "items": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" } }
          }
        },
        "partitions": {
          "description": "Owner partitions that define fresh capture, reuse, and shared sentinels.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["partitionRef", "ownerRef", "stateRefs", "probeRefs", "disposition", "dependencyProofRefs"],
            "properties": {
              "partitionRef": { "type": "string", "pattern": "^partition://[a-z0-9][a-z0-9._/-]*$" },
              "ownerRef": { "type": "string", "minLength": 1 },
              "stateRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "probeRefs": { "type": "array", "maxItems": 96, "uniqueItems": true, "items": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" } },
              "disposition": { "enum": ["capture", "reuse", "shared-sentinel"] },
              "dependencyProofRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "readinessChecks": {
          "description": "Exact ordered deterministic checks that must pass before Sol review.",
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "verdict", "evidenceRef", "observation"],
            "properties": {
              "check": { "enum": ["data-ready", "steady-not-skeleton", "state-content-valid", "controls-effective", "page-scroll-restored", "bounded-scroll-restored", "zoom-restored", "probe-complete", "raster-unique", "handoff-host-valid"] },
              "verdict": { "enum": ["passed", "failed"] },
              "evidenceRef": { "type": "string", "minLength": 1 },
              "observation": { "type": "string", "minLength": 12 }
            }
          }
        }
      }
    }
  }
}
