{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/request-review/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["fe.request.review.result", "fe.request.review.blocked"] },
    "status": { "enum": ["complete", "blocked"] },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["approved", "rejected", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "code", "retryable", "emits"],
          "properties": {
            "status": { "enum": ["completed", "blocked"] },
            "code": { "enum": ["fe-request-review-approved", "fe-request-review-rejected", "fe-request-review-blocked"] },
            "retryable": { "type": "boolean" },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status", "factsAdd", "factsRemove"],
              "properties": {
                "stage": { "enum": ["fe.request.review.result", "fe.request.review.blocked"] },
                "status": { "enum": ["complete", "blocked"] },
                "factsAdd": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "factsRemove": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactRefs", "mutations", "externalEffects"],
          "properties": {
            "artifactRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
            "mutations": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "operation", "contentSha256", "reviewDecision", "priority", "targetOwners"],
                "properties": {
                  "path": { "type": "string", "pattern": "^\\.claude/requests/[a-z0-9][a-z0-9._-]*\\.request\\.json$" },
                  "operation": { "const": "upsert" },
                  "contentSha256": { "$ref": "#/$defs/sha256" },
                  "reviewDecision": { "enum": ["approved", "rejected"] },
                  "priority": { "enum": ["normal", "urgent"] },
                  "targetOwners": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["starci-runtime", "grammar", "local-only"] } }
                }
              }
            },
            "externalEffects": { "type": "array", "maxItems": 0, "items": { "type": "object", "additionalProperties": false } }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "revision"],
                "properties": {
                  "ref": { "$ref": "#/$defs/sessionRef" },
                  "revision": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retention", "purgeAt", "scratchRefs"],
          "properties": {
            "retention": { "const": "until-skill-terminal" },
            "purgeAt": { "const": "skill-terminal" },
            "scratchRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }
          }
        },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
