{
  "schemaVersion": 6,
  "id": "fe/source-fit",
  "domain": "fe",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "fe.source-fit"
  ],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "source-fit.resolve",
      "status": "ready",
      "allFacts": [
        "grammar-converged",
        "frontend-contract-generation-ready"
      ],
      "noneFacts": [
        "grammar-business-gate-failed"
      ]
    }
  ],
  "emits": [
    {
      "when": {
        "hasGrammarGap": false,
        "hasCreate": false
      },
      "stage": "principles.compile",
      "status": "ready",
      "factsAdd": [
        "source-fit-ready"
      ],
      "factsRemove": []
    },
    {
      "when": {
        "hasGrammarGap": false,
        "hasCreate": true
      },
      "stage": "principles.compile",
      "status": "ready",
      "factsAdd": [
        "source-fit-ready",
        "create-required"
      ],
      "factsRemove": []
    },
    {
      "when": {
        "hasGrammarGap": true
      },
      "stage": "principles.compile",
      "status": "ready",
      "factsAdd": [
        "source-fit-ready",
        "grammar-gap"
      ],
      "factsRemove": []
    }
  ],
  "sideEffects": [
    "keep input, output, loaded context, worker observations, drafts, evidence, and receipts in task-session storage only",
    "purge every intermediate session object at every parent-skill terminal state"
  ],
  "stopConditions": [
    "invalid-input",
    "stale-contract-generation",
    "unresolved-effective-contract",
    "ambiguous-verdict",
    "ai-merged-contract",
    "closed-invariant-mutation",
    "implicit-package-substitute",
    "Stop on stale generation, ambiguous verdict, unresolved effective contract, closed invariant mutation, or implicit package substitution.",
    "runtime binding revision or session ownership is invalid",
    "the operation would broaden its approved authority, source, or external boundary"
  ]
}
