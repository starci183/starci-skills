{
  "$id": "https://starci.dev/v6/operators/fe/source-fit/output.schema.json",
  "title": "fe/source-fit operator output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "principles.compile"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "principles.compile"
      ]
    },
    "status": {
      "enum": [
        "ready"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "state",
        "produced",
        "context",
        "cleanup",
        "evidenceRefs",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "reuse-only",
            "create-required",
            "grammar-gap"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "status",
            "code",
            "retryable",
            "emits"
          ],
          "properties": {
            "operator": {
              "const": "fe/source-fit"
            },
            "status": {
              "enum": [
                "completed"
              ]
            },
            "code": {
              "enum": [
                "fe-source-fit-reuse-only",
                "fe-source-fit-create-required",
                "fe-source-fit-grammar-gap"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "status",
                "factsAdd",
                "factsRemove"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "principles.compile"
                  ]
                },
                "status": {
                  "enum": [
                    "ready"
                  ]
                },
                "factsAdd": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "factsRemove": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifactRefs",
            "mutations",
            "externalEffects"
          ],
          "properties": {
            "artifactRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sessionRef"
              }
            },
            "mutations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "beforeSha256",
                  "afterSha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "beforeSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "afterSha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "externalEffects": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "beforeRevision",
                  "afterRevision",
                  "evidenceRef"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "beforeRevision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "afterRevision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceRef": {
                    "$ref": "#/$defs/sessionRef"
                  }
                }
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used"
          ],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "ref",
                  "revision"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "worktree-business",
                      "session-upstream",
                      "qdrant-knowledge",
                      "fe-contract-generation",
                      "exact-source"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratchRefs",
            "retention",
            "purgeAt"
          ],
          "properties": {
            "scratchRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sessionRef"
              }
            },
            "retention": {
              "const": "until-skill-terminal"
            },
            "purgeAt": {
              "const": "skill-terminal"
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sessionRef"
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    }
  }
}
