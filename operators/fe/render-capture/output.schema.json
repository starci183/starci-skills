{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/render-capture/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/render-capture"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "captured",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "preflightRef",
                "compiledRequestRef",
                "compiledRequestFingerprint",
                "sourceApplyReturnReceiptRef",
                "aggregateAfterFingerprint",
                "grammarBinding",
                "iconographyManifest",
                "mediaManifest",
                "matrixRef",
                "matrixFingerprint",
                "partitionFingerprint",
                "visualRound",
                "capturePartitionRefs",
                "reusedPartitionRefs",
                "productFamilyEvidence",
                "sourceFingerprint",
                "latestMutationFingerprint",
                "latestMutationAt",
                "capturedAt",
                "blindReviewPacketRef",
                "blindReviewPacketFingerprint",
                "blindReviewPacket",
                "renderMatrix",
                "adversarialProbeMatrix",
                "handoffHostArtifact"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 192,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "preflightRef": { "type": "string", "pattern": "^preflight://[0-9a-f]{64}$" },
                "compiledRequestRef": { "type": "string", "pattern": "^compiled-request://" },
                "compiledRequestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "sourceApplyReturnReceiptRef": { "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
                "aggregateAfterFingerprint": { "description": "Registered source-apply aggregate after-state inherited through preflight.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "grammarBinding": { "$ref": "#/$defs/grammarBinding" },
                "iconographyManifest": { "$ref": "#/$defs/iconographyManifest" },
                "mediaManifest": { "$ref": "#/$defs/mediaManifest" },
                "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
                "matrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "partitionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "visualRound": {
                  "type": "object", "additionalProperties": false, "required": ["number", "purpose"],
                  "properties": { "number": { "type": "integer", "minimum": 1 }, "purpose": { "enum": ["discovery", "verification", "regression"] } }
                },
                "capturePartitionRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } },
                "reusedPartitionRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } },
                "productFamilyEvidence": {
                  "description": "Exact opaque Grammar identity and benchmark raster evidence copied into the blind packet.",
                  "type": "object", "additionalProperties": false,
                  "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"],
                  "properties": {
                    "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                    "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
                    "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
                    "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
                    "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
                    "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
                  }
                },
                "sourceFingerprint": {
                  "description": "Derived alias of aggregateAfterFingerprint for the source revision rendered by every matrix cell.",
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "latestMutationFingerprint": {
                  "description": "Derived alias of aggregateAfterFingerprint for the registered source mutation this capture follows.",
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "latestMutationAt": { "type": "string", "format": "date-time" },
                "capturedAt": { "type": "string", "format": "date-time" },
                "blindReviewPacketRef": {
                  "description": "Frozen raster-only packet. It excludes source, DOM, tests, authority, producer rationale, prior verdicts, suspected defects, and intended answers.",
                  "type": "string",
                  "minLength": 1
                },
                "blindReviewPacketFingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "blindReviewPacket": {
                  "description": "Exact immutable raster-only manifest issued by capture. Visual review may add only its receipt binding and this manifest fingerprint.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["packetRef", "preflightRef", "matrixRef", "matrixFingerprint", "partitionFingerprint", "visualRound", "capturePartitionRefs", "reusedPartitionRefs", "grammarBinding", "iconographyManifest", "mediaManifest", "productFamilyEvidence", "latestMutationFingerprint", "capturedSourceFingerprint", "latestMutationAt", "capturedAt", "rasterCells", "probeCells", "lastScreenshotRef"],
                  "properties": {
                    "packetRef": { "type": "string", "pattern": "^packet://[0-9a-f]{64}$" },
                    "preflightRef": { "type": "string", "pattern": "^preflight://[0-9a-f]{64}$" },
                    "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
                    "matrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "partitionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "visualRound": { "type": "object", "additionalProperties": false, "required": ["number", "purpose"], "properties": { "number": { "type": "integer", "minimum": 1 }, "purpose": { "enum": ["discovery", "verification", "regression"] } } },
                    "capturePartitionRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } },
                    "reusedPartitionRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } },
                    "grammarBinding": { "description": "Opaque Grammar decision and audit identity; no owner rationale.", "$ref": "#/$defs/blindGrammarBinding" },
                    "iconographyManifest": { "description": "Opaque icon family and manifest identity; no semantic-role rationale.", "$ref": "#/$defs/blindIconographyManifest" },
                    "mediaManifest": { "description": "Opaque media mode, asset, and manifest identity; no producer rationale.", "$ref": "#/$defs/blindMediaManifest" },
                    "productFamilyEvidence": {
                      "description": "Reviewer-visible benchmark rasters and opaque Grammar identity; no producer rationale or source details.",
                      "type": "object", "additionalProperties": false,
                      "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"],
                      "properties": {
                        "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                        "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
                        "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
                        "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
                        "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
                        "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
                      }
                    },
                    "latestMutationFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "capturedSourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "latestMutationAt": { "type": "string", "format": "date-time" },
                    "capturedAt": { "type": "string", "format": "date-time" },
                    "rasterCells": {
                      "type": "array", "minItems": 3, "maxItems": 96,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["cellRef", "imageRef", "viewKind", "viewport", "lastScreenshot"],
                        "properties": {
                          "cellRef": { "type": "string", "pattern": "^cell-[0-9]{3}$" },
                          "imageRef": { "type": "string", "pattern": "\\.(png|jpg|jpeg|webp)$" },
                          "viewKind": { "enum": ["host-context", "viewport", "surface-focus", "scroll-start", "scroll-middle", "scroll-terminal", "lifecycle", "overlay"] },
                          "viewport": { "enum": ["host", "wide", "intermediate", "compact"] },
                          "lastScreenshot": { "type": "boolean" }
                        }
                      }
                    },
                    "probeCells": {
                      "type": "array", "minItems": 10, "maxItems": 96,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["probeId", "category", "phase", "applicable", "imageRef", "reason"],
                        "properties": {
                          "probeId": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" },
                          "category": { "enum": ["viewport", "zoom", "page-scroll", "bounded-scroll", "content-stress", "state-transition", "sticky-fixed-overlay", "drag", "keyboard-focus", "composition-neighbors"] },
                          "phase": { "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"] },
                          "applicable": { "type": "boolean" },
                          "imageRef": { "type": ["string", "null"], "pattern": "\\.(png|jpg|jpeg|webp)$" },
                          "reason": { "enum": [null, "not-owned-by-target", "interaction-not-present", "container-not-present", "overlay-not-present", "lifecycle-not-present", "tool-capability-unavailable"] }
                        }
                      }
                    },
                    "lastScreenshotRef": { "type": "string", "pattern": "\\.(png|jpg|jpeg|webp)$" }
                  }
                },
                "renderMatrix": {
                  "description": "Actual full-viewport image artifact for every frozen state and viewport cell.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "stateRef",
                      "viewport",
                      "imageRef",
                      "handoffState"
                    ],
                    "properties": {
                      "stateRef": {
                        "type": "string",
                        "minLength": 1
                      },
                      "viewport": {
                        "enum": [
                          "wide",
                          "intermediate",
                          "compact"
                        ]
                      },
                      "imageRef": {
                        "description": "A real raster screenshot reference; CSS, DOM, geometry, lint, or source reports are invalid here.",
                        "type": "string",
                        "pattern": "\\.(png|jpg|jpeg|webp)$"
                      },
                      "handoffState": {
                        "type": "boolean"
                      }
                    }
                  },
                  "contains": {
                    "type": "object",
                    "required": [
                      "handoffState"
                    ],
                    "properties": {
                      "handoffState": {
                        "const": true
                      }
                    }
                  },
                  "minContains": 1
                },
                "adversarialProbeMatrix": {
                  "description": "Observed result of every frozen adversarial probe on latest-source pixels.",
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["probeId", "category", "phase", "stateRef", "attempt", "expectedFailure", "outcome", "imageRef", "reason"],
                    "properties": {
                      "probeId": { "type": "string", "minLength": 1 },
                      "category": {
                        "enum": ["viewport", "zoom", "page-scroll", "bounded-scroll", "content-stress", "state-transition", "sticky-fixed-overlay", "drag", "keyboard-focus", "composition-neighbors"]
                      },
                      "phase": { "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"] },
                      "stateRef": { "type": "string", "minLength": 1 },
                      "attempt": { "type": "string", "minLength": 1 },
                      "expectedFailure": { "type": "string", "minLength": 1 },
                      "outcome": { "enum": ["survived", "contradiction", "not-applicable"] },
                      "imageRef": { "type": ["string", "null"], "pattern": "\\.(png|jpg|jpeg|webp)$" },
                      "reason": { "type": ["string", "null"] }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "outcome": { "enum": ["survived", "contradiction"] } } },
                        "then": { "properties": { "imageRef": { "type": "string" }, "reason": { "type": "null" } } }
                      },
                      {
                        "if": { "properties": { "outcome": { "const": "not-applicable" } } },
                        "then": { "properties": { "imageRef": { "type": "null" }, "reason": { "type": "string", "minLength": 1 } } }
                      }
                    ]
                  }
                },
                "handoffHostArtifact": {
                  "description": "Uncropped raster of the delivered host browser surface at its actual content viewport without emulation.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["surfaceRef", "widthPx", "heightPx", "viewportOverride", "imageRef"],
                  "properties": {
                    "surfaceRef": { "type": "string", "minLength": 1 },
                    "widthPx": { "type": "integer", "minimum": 1 },
                    "heightPx": { "type": "integer", "minimum": 1 },
                    "viewportOverride": { "const": false },
                    "imageRef": { "type": "string", "pattern": "\\.(png|jpg|jpeg|webp)$" }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Always null; raster capture never owns routing or cross-domain continuation.",
          "type": "null"
        }
      }
    }
  },
  "$defs": {
    "compositionOwners": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["ownerRef", "ownerLayer", "authorityRef", "patternRef"], "properties": { "ownerRef": { "type": "string", "pattern": "^owner://" }, "ownerLayer": { "enum": ["grammar", "application-block", "application-composite"] }, "authorityRef": { "type": "string", "pattern": "^(grammar|application)://" }, "patternRef": { "type": "string", "pattern": "^(pattern|block|composite)://" } } } },
    "grammarBinding": { "type": "object", "additionalProperties": false, "required": ["bindingRef", "packageRef", "manifestRef", "exportRefs", "contentSha256", "authorityRevision", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint", "compositionOwners"], "properties": { "bindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "packageRef": { "type": "string", "pattern": "^grammar-package://" }, "manifestRef": { "type": "string", "pattern": "^grammar://" }, "exportRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar://" } }, "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "authorityRevision": { "type": "string", "minLength": 1 }, "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" }, "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "compositionOwners": { "$ref": "#/$defs/compositionOwners" } } },
    "iconographyManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef", "decisions"], "properties": { "manifestRef": { "type": "string", "pattern": "^iconography://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "resolved"] }, "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] }, "decisions": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["roleRef", "meaningAuthorityRef", "source", "glyphRef", "catalogSearchRefs", "customReason"], "properties": { "roleRef": { "type": "string", "pattern": "^semantic-icon://" }, "meaningAuthorityRef": { "type": "string", "pattern": "^(business|ui-law|grammar)://" }, "source": { "enum": ["heroicons", "custom-svg"] }, "glyphRef": { "type": "string", "minLength": 1 }, "catalogSearchRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-catalog://" } }, "customReason": { "type": ["string", "null"], "minLength": 1 } } } } } },
    "mediaManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef", "artifactRefs", "provenanceRefs", "responsiveTreatmentRef", "altIntentRef", "fallbackRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^media-manifest://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "reuse", "generate"] }, "assetRef": { "type": ["string", "null"], "minLength": 1 }, "artifactRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "provenanceRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "responsiveTreatmentRef": { "type": ["string", "null"], "minLength": 1 }, "altIntentRef": { "type": ["string", "null"], "minLength": 1 }, "fallbackRef": { "type": ["string", "null"], "minLength": 1 } } },
    "blindGrammarBinding": { "type": "object", "additionalProperties": false, "required": ["bindingRef", "manifestRef", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint"], "properties": { "bindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "manifestRef": { "type": "string", "pattern": "^grammar://" }, "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" }, "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "blindIconographyManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^iconography://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "resolved"] }, "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] } } },
    "blindMediaManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^media-manifest://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "reuse", "generate"] }, "assetRef": { "type": ["string", "null"], "minLength": 1 } } }
  }
}
