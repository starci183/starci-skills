{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/render-capture/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/render-capture"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "adversarialProbes",
        "renderStates",
        "viewports",
        "handoffStateRef",
        "handoffViewport",
        "preflight",
        "grammarBinding",
        "iconographyManifest",
        "mediaManifest",
        "productFamilyEvidence"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adversarialProbes": {
          "description": "Frozen attacks that try to falsify the UI before any visual verdict.",
          "type": "array",
          "minItems": 10,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probeId", "category", "phase", "stateRef", "attempt", "expectedFailure"],
            "properties": {
              "probeId": { "type": "string", "minLength": 1 },
              "category": {
                "enum": [
                  "viewport",
                  "zoom",
                  "page-scroll",
                  "bounded-scroll",
                  "content-stress",
                  "state-transition",
                  "sticky-fixed-overlay",
                  "drag",
                  "keyboard-focus",
                  "composition-neighbors"
                ]
              },
              "phase": { "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"] },
              "stateRef": { "type": "string", "minLength": 1 },
              "attempt": { "type": "string", "minLength": 1 },
              "expectedFailure": { "type": "string", "minLength": 1 }
            }
          },
          "allOf": [
            { "contains": { "properties": { "category": { "const": "viewport" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "zoom" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "page-scroll" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "bounded-scroll" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "content-stress" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "state-transition" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "sticky-fixed-overlay" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "drag" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "keyboard-focus" } }, "required": ["category"] } },
            { "contains": { "properties": { "category": { "const": "composition-neighbors" } }, "required": ["category"] } }
          ]
        },
        "renderStates": {
          "description": "Frozen in-scope entry, task, pending, recovery, result, exit, and other visible states to capture.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "viewports": {
          "description": "The mandatory responsive viewport set.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "wide",
              "intermediate",
              "compact"
            ]
          }
        },
        "handoffStateRef": {
          "description": "Exact visible state that will be handed to the user after completion.",
          "type": "string",
          "minLength": 1
        },
        "handoffViewport": {
          "description": "Exact host browser surface and content viewport visible to the user at handoff; viewport emulation is forbidden for this proof.",
          "type": "object",
          "additionalProperties": false,
          "required": ["surfaceRef", "widthPx", "heightPx", "viewportOverride"],
          "properties": {
            "surfaceRef": { "type": "string", "minLength": 1 },
            "widthPx": { "type": "integer", "minimum": 1 },
            "heightPx": { "type": "integer", "minimum": 1 },
            "viewportOverride": { "const": false }
          }
        },
        "grammarBinding": { "description": "Exact compile-owned Grammar decision and audit binding inherited through preflight.", "$ref": "#/$defs/grammarBinding" },
        "iconographyManifest": { "description": "Exact compile-owned iconography provenance manifest inherited through preflight.", "$ref": "#/$defs/iconographyManifest" },
        "mediaManifest": { "description": "Exact compile-owned media provenance manifest inherited through preflight.", "$ref": "#/$defs/mediaManifest" },
        "productFamilyEvidence": {
          "description": "Opaque Grammar identity plus content-addressed benchmark rasters allowed in the otherwise blind pixel packet.",
          "type": "object", "additionalProperties": false,
          "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"],
          "properties": {
            "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
            "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
            "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
            "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
            "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
            "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
          }
        },
        "preflight": {
          "description": "Exact validated preflight that froze the matrix, round, and owner partitions before capture.",
          "type": "object",
          "additionalProperties": false,
          "required": ["preflightRef", "compiledRequestRef", "compiledRequestFingerprint", "sourceApplyReturnReceiptRef", "aggregateAfterFingerprint", "matrixRef", "matrixFingerprint", "partitionFingerprint", "round", "capturePartitionRefs", "reusedPartitionRefs"],
          "properties": {
            "preflightRef": { "type": "string", "pattern": "^preflight://[0-9a-f]{64}$" },
            "compiledRequestRef": { "description": "Exact author-once compiled request inherited through preflight.", "type": "string", "pattern": "^compiled-request://" },
            "compiledRequestFingerprint": { "description": "Exact inherited compiled request fingerprint.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sourceApplyReturnReceiptRef": { "description": "Exact registered source-apply RETURN inherited through preflight.", "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
            "aggregateAfterFingerprint": { "description": "Exact aggregate after-state registered for the source-apply RETURN.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
            "matrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "partitionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "round": {
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "purpose"],
              "properties": { "number": { "type": "integer", "minimum": 1 }, "purpose": { "enum": ["discovery", "verification", "regression"] } }
            },
            "capturePartitionRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } },
            "reusedPartitionRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^partition://" } }
          }
        }
      }
    }
  },
  "$defs": {
    "compositionOwners": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["ownerRef", "ownerLayer", "authorityRef", "patternRef"], "properties": { "ownerRef": { "type": "string", "pattern": "^owner://" }, "ownerLayer": { "enum": ["grammar", "application-block", "application-composite"] }, "authorityRef": { "type": "string", "pattern": "^(grammar|application)://" }, "patternRef": { "type": "string", "pattern": "^(pattern|block|composite)://" } } } },
    "grammarBinding": { "type": "object", "additionalProperties": false, "required": ["bindingRef", "packageRef", "manifestRef", "exportRefs", "contentSha256", "authorityRevision", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint", "compositionOwners"], "properties": { "bindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "packageRef": { "type": "string", "pattern": "^grammar-package://" }, "manifestRef": { "type": "string", "pattern": "^grammar://" }, "exportRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar://" } }, "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "authorityRevision": { "type": "string", "minLength": 1 }, "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" }, "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "compositionOwners": { "$ref": "#/$defs/compositionOwners" } } },
    "iconographyManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef", "decisions"], "properties": { "manifestRef": { "type": "string", "pattern": "^iconography://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "resolved"] }, "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] }, "decisions": { "type": "array", "maxItems": 64, "items": { "type": "object", "additionalProperties": false, "required": ["roleRef", "meaningAuthorityRef", "source", "glyphRef", "catalogSearchRefs", "customReason"], "properties": { "roleRef": { "type": "string", "pattern": "^semantic-icon://" }, "meaningAuthorityRef": { "type": "string", "pattern": "^(business|ui-law|grammar)://" }, "source": { "enum": ["heroicons", "custom-svg"] }, "glyphRef": { "type": "string", "minLength": 1 }, "catalogSearchRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-catalog://" } }, "customReason": { "type": ["string", "null"], "minLength": 1 } } } } } },
    "mediaManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef", "artifactRefs", "provenanceRefs", "responsiveTreatmentRef", "altIntentRef", "fallbackRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^media-manifest://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "reuse", "generate"] }, "assetRef": { "type": ["string", "null"], "minLength": 1 }, "artifactRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "provenanceRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "responsiveTreatmentRef": { "type": ["string", "null"], "minLength": 1 }, "altIntentRef": { "type": ["string", "null"], "minLength": 1 }, "fallbackRef": { "type": ["string", "null"], "minLength": 1 } } }
  }
}
