{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/finding-classify/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/finding-classify"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "reviewStage",
        "findingSetRef",
        "visualRound",
        "findingRefs"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewStage": {
          "description": "The visual gate that produced the finding set.",
          "enum": ["visual-fidelity", "independent-review"]
        },
        "findingSetRef": {
          "description": "Exact validated visual or independent finding product to classify.",
          "type": "string",
          "minLength": 1
        },
        "visualRound": {
          "description": "Visual round that produced this complete finding set.",
          "type": "object", "additionalProperties": false, "required": ["number", "purpose"],
          "properties": { "number": { "type": "integer", "minimum": 1, "maximum": 3 }, "purpose": { "enum": ["discovery", "verification", "regression"] } }
        },
        "findingRefs": {
          "description": "The complete visual finding batch; classification may not stop after the first finding.",
          "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
