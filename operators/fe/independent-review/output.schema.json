{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/independent-review/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/independent-review"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "aiExecution",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "aiExecution": {
          "description": "Runtime-attested single fresh Sol execution provenance.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "isolation", "forkTurns", "executionRef"],
          "properties": {
            "model": { "const": "gpt-5.6-sol" },
            "count": { "const": 1 },
            "isolation": { "const": "fresh" },
            "forkTurns": { "const": "none" },
            "executionRef": { "type": "string", "pattern": "^execution://[0-9a-f]{64}$" }
          }
        },
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "passed",
            "findings",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "reviewerExecutionRef",
                "inspectionRefs",
                "inspectionVerdicts",
                "probeVerdicts"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reviewerExecutionRef": {
                  "description": "Identity that independently authored this verdict.",
                  "type": "string",
                  "minLength": 1
                },
                "inspectionRefs": {
                  "description": "Per-image visual inspection records consumed by this verdict.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "inspectionVerdicts": {
                  "description": "Independent verdict for every supplied visual inspection record.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["inspectionRef", "verdict", "observation"],
                    "properties": {
                      "inspectionRef": { "type": "string", "minLength": 1 },
                      "verdict": { "enum": ["passed", "finding"] },
                      "observation": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "probeVerdicts": {
                  "description": "Independent falsification verdict for all required probe categories.",
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["probeId", "category", "phase", "verdict", "observation"],
                    "properties": {
                      "probeId": { "type": "string", "minLength": 1 },
                      "category": {
                        "enum": ["viewport", "zoom", "page-scroll", "bounded-scroll", "content-stress", "state-transition", "sticky-fixed-overlay", "drag", "keyboard-focus", "composition-neighbors"]
                      },
                      "phase": { "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"] },
                      "verdict": { "enum": ["survived", "contradiction", "not-applicable"] },
                      "observation": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
