{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/independent-review/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/independent-review"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozenAuthority",
        "frozenEvidence",
        "uiKnowledgeId",
        "implementerExecutionRef",
        "reviewerExecutionRef",
        "implementerPrincipalFingerprint",
        "reviewerPrincipalFingerprint",
        "reviewerModel",
        "reviewerCount",
        "contextIsolation",
        "forkTurns",
        "reviewMode"
      ],
      "properties": {
        "frozenAuthority": {
          "description": "Frozen authority visible to the independent reviewer.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "frozenEvidence": {
          "description": "Frozen render and source evidence visible to the independent reviewer.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        },
        "implementerExecutionRef": {
          "description": "Execution identity that authored the implementation under review.",
          "type": "string",
          "pattern": "^execution://[0-9a-f]{64}$"
        },
        "reviewerExecutionRef": {
          "description": "Distinct execution identity that owns the independent verdict.",
          "type": "string",
          "pattern": "^execution://[0-9a-f]{64}$"
        },
        "implementerPrincipalFingerprint": { "description": "Runtime-attested implementer principal.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewerPrincipalFingerprint": { "description": "Runtime-attested reviewer principal, distinct from the implementer.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewerModel": { "description": "Single allowed reviewer model.", "const": "gpt-5.6-sol" },
        "reviewerCount": { "description": "Exactly one reviewer execution.", "const": 1 },
        "contextIsolation": { "description": "Fresh isolated reviewer context.", "const": "fresh" },
        "forkTurns": { "description": "No producer turns are inherited.", "const": "none" },
        "reviewMode": {
          "description": "Visual verdict mode that withholds implementation evidence while judging pixels.",
          "const": "blind-pixel"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewTarget",
        "reviewLenses",
        "rasterRefs",
        "probeSequence",
        "adversarialProbeRecordsRef",
        "handoffHostArtifactRef"
      ],
      "properties": {
        "reviewTarget": {
          "description": "The one target under independent review.",
          "type": "string",
          "minLength": 1
        },
        "reviewLenses": {
          "description": "Closed review lenses.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rasterRefs": {
          "description": "Exact ordered content-addressed raster references independently reviewed one-to-one.",
          "type": "array",
          "minItems": 3,
          "maxItems": 96,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$"
          }
        },
        "probeSequence": {
          "description": "Exact ordered probe identity supplied to the independent reviewer.",
          "type": "array",
          "minItems": 10,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["probeId", "category", "phase"],
            "properties": {
              "probeId": { "type": "string", "minLength": 1 },
              "category": {
                "enum": ["viewport", "zoom", "page-scroll", "bounded-scroll", "content-stress", "state-transition", "sticky-fixed-overlay", "drag", "keyboard-focus", "composition-neighbors"]
              },
              "phase": {
                "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"]
              }
            }
          }
        },
        "adversarialProbeRecordsRef": {
          "description": "Frozen visual-fidelity probe records that the independent reviewer must recheck instead of trusting the implementer aggregate.",
          "type": "string",
          "minLength": 1
        },
        "handoffHostArtifactRef": {
          "description": "Uncropped exact-host handoff raster that the reviewer must inspect separately from detached viewport captures.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
