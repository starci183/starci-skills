{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/source-repair/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/source-repair"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "behaviorContractRef",
        "behaviorContractFingerprint",
        "failedEvidenceRefs",
        "repairBatchRef",
        "affectedPartitionRefs"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "behaviorContractRef": {
          "description": "Exact frozen behavior-preservation contract that remains binding during repair.",
          "type": "string",
          "minLength": 1
        },
        "behaviorContractFingerprint": {
          "description": "Immutable fingerprint of the frozen behavior-preservation contract.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "failedEvidenceRefs": {
          "description": "Exact latest-source inspection or probe contradictions repaired by this invocation.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "repairBatchRef": {
          "description": "One complete classified finding batch repaired atomically before recapture.",
          "type": "string",
          "pattern": "^batch://[0-9a-f]{64}$"
        },
        "affectedPartitionRefs": {
          "description": "Owner partitions invalidated by this repair; shared sentinels are added again by preflight.",
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^partition://" }
        }
      }
    }
  }
}
