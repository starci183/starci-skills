{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/direction-generate/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/direction-generate"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "aiExecution",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "aiExecution": {
          "description": "Runtime-attested single fresh Sol execution provenance.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "isolation", "forkTurns", "executionRef"],
          "properties": {
            "model": { "const": "gpt-5.6-sol" },
            "count": { "const": 1 },
            "isolation": { "const": "fresh" },
            "forkTurns": { "const": "none" },
            "executionRef": { "type": "string", "pattern": "^execution://[0-9a-f]{64}$" }
          }
        },
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "generated",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "comparisonArtifactRef",
                "directionCount",
                "directions",
                "grammarFilterRecords",
                "materialDifferences"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "comparisonArtifactRef": {
                  "description": "Inspectable HTML comparison rendered through visualize before choice.",
                  "type": "string",
                  "pattern": "\\.html$"
                },
                "directionCount": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 4
                },
                "directions": {
                  "description": "Three or four materially distinct directions, each visibly addressable inside the comparison.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "title",
                      "visualPanelRef",
                      "wideStateRef",
                      "compactStateRef",
                      "materialStateRef",
                      "grammarDecisionManifestRef",
                      "tradeoff"
                    ],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                      "title": { "type": "string", "minLength": 1 },
                      "visualPanelRef": { "type": "string", "minLength": 1 },
                      "wideStateRef": { "type": "string", "minLength": 1 },
                      "compactStateRef": { "type": "string", "minLength": 1 },
                      "materialStateRef": { "type": "string", "minLength": 1 },
                      "grammarDecisionManifestRef": { "type": "string", "pattern": "^grammar://" },
                      "tradeoff": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "grammarFilterRecords": {
                  "description": "Every brainstorm candidate is accepted or rejected before rendering and ranking.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["candidateRef", "decision", "manifestRef", "reasonRefs"],
                    "properties": {
                      "candidateRef": { "type": "string", "minLength": 1 },
                      "decision": { "enum": ["accepted", "rejected"] },
                      "manifestRef": { "anyOf": [{ "type": "string", "pattern": "^grammar://" }, { "type": "null" }] },
                      "reasonRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                    }
                  }
                },
                "materialDifferences": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
