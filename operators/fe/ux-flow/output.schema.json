{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/ux-flow/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/ux-flow"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "uxFlowGraph",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "modeled",
            "blocked"
          ],
          "description": "Whether one complete graph was synthesized; only the Skill machine routes this value."
        },
        "uxFlowGraph": {
          "description": "The one synthesized flow graph when modeled; otherwise null.",
          "anyOf": [
            {
              "$ref": "#/$defs/graph"
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          },
          "description": "Exact missing authority that prevents a complete graph; empty when modeled."
        },
        "evidenceRefs": {
          "$ref": "#/$defs/texts",
          "description": "Business, journey, and law evidence used by synthesis."
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flowId",
        "primaryTask",
        "nodes",
        "transitions",
        "recoveryPaths",
        "continuityCoverage"
      ],
      "properties": {
        "flowId": {
          "$ref": "#/$defs/id"
        },
        "primaryTask": {
          "$ref": "#/$defs/text"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "userGoal",
              "surfaceRef",
              "observableState"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "kind": {
                "enum": [
                  "entry",
                  "work",
                  "review",
                  "commit",
                  "feedback",
                  "recovery",
                  "result",
                  "safe-terminal"
                ]
              },
              "userGoal": {
                "$ref": "#/$defs/text"
              },
              "surfaceRef": {
                "$ref": "#/$defs/text"
              },
              "observableState": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "event",
              "to",
              "userFeedback",
              "sideEffect"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "event": {
                "$ref": "#/$defs/text"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "userFeedback": {
                "$ref": "#/$defs/text"
              },
              "sideEffect": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "recoveryPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "failureNode",
              "recoveryAction",
              "resumeNode",
              "terminalNode"
            ],
            "properties": {
              "failureNode": {
                "$ref": "#/$defs/id"
              },
              "recoveryAction": {
                "$ref": "#/$defs/text"
              },
              "resumeNode": {
                "$ref": "#/$defs/id"
              },
              "terminalNode": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "continuityCoverage": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "validation",
              "failure",
              "recovery",
              "refresh",
              "resume",
              "async"
            ]
          }
        }
      }
    }
  }
}
