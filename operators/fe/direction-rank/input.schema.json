{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/direction-rank/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/direction-rank"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "directionSetRef",
        "visualArtifactRefs",
        "constraints"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "directionSetRef": {
          "description": "Exact generated direction-set reference being ranked.",
          "type": "string",
          "minLength": 1
        },
        "visualArtifactRefs": {
          "description": "Inspectable visualize HTML comparison artifacts that render every ranked direction.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 4,
          "items": { "type": "string", "pattern": "\\.html$" }
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
