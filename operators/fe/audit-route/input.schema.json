{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/audit-route/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/audit-route" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFingerprint", "evidenceFingerprint", "findingBatchFingerprint"],
      "properties": {
        "sourceFingerprint": { "description": "Latest reviewed source identity.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evidenceFingerprint": { "description": "Latest reviewed raster packet identity.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "findingBatchFingerprint": { "description": "Complete latest finding batch identity.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typedVerdict", "score", "changeLevel", "comparisonRequested", "structuralFindingRefs", "findingOwnerClasses"],
      "properties": {
        "typedVerdict": { "description": "Canonical failed visual verdict being routed.", "const": "FAIL" },
        "score": { "description": "Noncanonical evidence-backed progress score.", "type": "integer", "minimum": 0, "maximum": 8 },
        "changeLevel": { "description": "Frozen UX/UI mutation depth.", "enum": ["refine", "reconstruct", "new"] },
        "comparisonRequested": { "description": "Whether the user explicitly requested alternatives.", "type": "boolean" },
        "structuralFindingRefs": { "description": "Direct-owner findings proving composition failure.", "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
        "findingOwnerClasses": { "description": "Smallest owner classes present in the complete batch.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["direct-implementation", "shared-owner", "business", "backend", "runtime-auth"] } }
      }
    }
  }
}
