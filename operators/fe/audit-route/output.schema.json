{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/audit-route/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/audit-route" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Typed route consumed only by the parent Skill machine.", "enum": ["repair", "reconstruct", "shared-authority-required", "business-required", "backend-required", "session-recovery", "authorization-required", "blocked"] },
        "result": {
          "description": "Exact selected route, or null when authority/evidence is unavailable.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "route", "directionMode", "reason"],
              "properties": {
                "score": { "description": "Routed review score.", "type": "integer", "minimum": 0, "maximum": 8 },
                "route": { "description": "Selected next owner/action family.", "enum": ["repair", "reconstruct", "shared-authority", "business", "backend", "session-recovery"] },
                "directionMode": { "description": "Whether direction generation is needed and in which mode.", "enum": ["none", "dominant", "comparison"] },
                "reason": { "description": "Evidence-backed reason for this route.", "type": "string", "minLength": 20 }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Exact unresolved authority or evidence gaps.", "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact review and ownership evidence consumed.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
