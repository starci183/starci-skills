{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.4/operators/fe/iconography-resolve/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/iconography-resolve" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRefs", "authorityRevision"],
      "properties": {
        "evidenceRefs": { "description": "Exact evidence available to this atomic decision.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authorityRevision": { "description": "Exact approved authority revision binding this invocation.", "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "uiLawBindingRef", "semanticRoles", "approvedCatalogRefs", "constraints"],
      "properties": {
        "targetRef": { "description": "One closed frontend target.", "type": "string", "minLength": 1 },
        "uiLawBindingRef": { "description": "Mandatory UI-law binding governing these roles.", "type": "string", "pattern": "^ui-law-binding://" },
        "semanticRoles": {
          "description": "Authority-backed meanings requiring glyph decisions.",
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["roleRef", "meaning", "authorityRef", "visualLayer"],
            "properties": {
              "roleRef": { "type": "string", "pattern": "^semantic-icon://" },
              "meaning": { "type": "string", "minLength": 1 },
              "authorityRef": { "type": "string", "pattern": "^(business|ui-law|grammar)://" },
              "visualLayer": { "type": "string", "minLength": 1 }
            }
          }
        },
        "approvedCatalogRefs": { "description": "Approved icon catalogs searched before custom drawing.", "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-catalog://" } },
        "constraints": { "description": "Closed visual and platform constraints.", "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
