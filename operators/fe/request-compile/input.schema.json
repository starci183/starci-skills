{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/request-compile/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/request-compile"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId",
        "scopeKnowledgeId",
        "directionKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        },
        "scopeKnowledgeId": {
          "description": "Exact UX/UI change-level scope knowledge binding.",
          "const": "fe.ux-ui-change-levels"
        },
        "directionKnowledgeId": {
          "description": "Exact direction visualization and unfamiliar-domain research knowledge binding.",
          "const": "direction.visualization"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "uxUiChangeLevel",
        "directionMode",
        "directionEvidence",
        "constraints"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "uxUiChangeLevel": {
          "description": "Projection of the frozen frontend.ux-ui.change-level scope dimension.",
          "enum": [
            "refine",
            "reconstruct",
            "new"
          ]
        },
        "directionMode": {
          "description": "Executable projection of direction work: none for refine or an already approved reconstruct/new direction, otherwise dominant or alternatives for generation.",
          "enum": ["none", "dominant", "alternatives"]
        },
        "directionEvidence": {
          "description": "Exact classification that justifies directionMode and change level. Approved reconstruct/new evidence carries a typed direction identity, content fingerprint, and direction-specific approval authority.",
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "approvedDirectionAuthority", "evidenceRefs"],
          "properties": {
            "classification": { "enum": ["not-applicable", "approved", "dominant", "ambiguous", "comparison-requested"] },
            "approvedDirectionAuthority": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["directionRef", "directionFingerprint", "approvalRef"],
                  "properties": {
                    "directionRef": { "type": "string", "pattern": "^direction://[A-Za-z0-9][A-Za-z0-9._/-]*$" },
                    "directionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "approvalRef": { "type": "string", "pattern": "^direction-approval://[A-Za-z0-9][A-Za-z0-9._/-]*$" }
                  }
                },
                { "type": "null" }
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
