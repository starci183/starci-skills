{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/request-compile/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/request-compile"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId",
        "scopeKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        },
        "scopeKnowledgeId": {
          "description": "Exact UX/UI change-level scope knowledge binding.",
          "const": "fe.ux-ui-change-levels"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "uxUiChangeLevel",
        "directionMode",
        "directionEvidence",
        "constraints"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "uxUiChangeLevel": {
          "description": "Projection of the frozen frontend.ux-ui.change-level scope dimension.",
          "enum": [
            "refine",
            "reconstruct",
            "new"
          ]
        },
        "directionMode": {
          "description": "Executable projection of observed direction need.",
          "enum": ["none", "dominant", "alternatives"]
        },
        "directionEvidence": {
          "description": "Observed dominance, material ambiguity, or explicit comparison authority that justifies directionMode.",
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "evidenceRefs"],
          "properties": {
            "classification": { "enum": ["not-applicable", "dominant", "ambiguous", "comparison-requested"] },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
