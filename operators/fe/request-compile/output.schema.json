{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/request-compile/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/request-compile"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff",
        "repair"
      ],
      "properties": {
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "compiled",
            "grammar-required",
            "business-required",
            "backend-required",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "compiledRequestRef",
                "compiledRequestFingerprint",
                "objective",
                "targetRef",
                "uxUiChangeLevel",
                "directionMode",
                "directionEvidence",
                "behaviorContractRef",
                "behaviorContractFingerprint",
                "grammarBinding",
                "iconographyManifest",
                "mediaManifest",
                "productFamilyEvidence",
                "proofMatrix",
                "proofMatrixFingerprint",
                "constraints",
                "negativeBoundary",
                "acceptanceCriteria",
                "sourceBoundary",
                "sourceBoundaryFingerprint",
                "artifactRefs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "compiledRequestRef": { "type": "string", "pattern": "^compiled-request://" },
                "compiledRequestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "objective": {
                  "type": "string",
                  "minLength": 1
                },
                "targetRef": {
                  "type": "string",
                  "minLength": 1
                },
                "uxUiChangeLevel": {
                  "enum": ["refine", "reconstruct", "new"]
                },
                "directionMode": {
                  "enum": ["none", "dominant", "alternatives"]
                },
                "directionEvidence": {
                  "description": "Exact classification matching the compiled change level and direction mode. Approved reconstruct/new evidence carries a typed direction identity, content fingerprint, and direction-specific approval authority.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["classification", "approvedDirectionAuthority", "evidenceRefs"],
                  "properties": {
                    "classification": { "enum": ["not-applicable", "approved", "dominant", "ambiguous", "comparison-requested"] },
                    "approvedDirectionAuthority": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["directionRef", "directionFingerprint", "approvalRef"],
                          "properties": {
                            "directionRef": { "type": "string", "pattern": "^direction://[A-Za-z0-9][A-Za-z0-9._/-]*$" },
                            "directionFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                            "approvalRef": { "type": "string", "pattern": "^direction-approval://[A-Za-z0-9][A-Za-z0-9._/-]*$" }
                          }
                        },
                        { "type": "null" }
                      ]
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "uniqueItems": true,
                      "minItems": 1,
                      "maxItems": 32,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "behaviorContractRef": { "type": "string", "minLength": 1 },
                "behaviorContractFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "grammarBinding": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["bindingRef", "packageRef", "manifestRef", "exportRefs", "contentSha256", "authorityRevision", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint", "compositionOwners"],
                  "properties": {
                    "bindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                    "packageRef": { "type": "string", "pattern": "^grammar-package://" },
                    "manifestRef": { "type": "string", "pattern": "^grammar://" },
                    "exportRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar://" } },
                    "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "authorityRevision": { "type": "string", "minLength": 1 },
                    "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" },
                    "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "compositionOwners": {
                      "type": "array", "minItems": 1, "maxItems": 64,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["ownerRef", "ownerLayer", "authorityRef", "patternRef"],
                        "properties": {
                          "ownerRef": { "type": "string", "pattern": "^owner://" },
                          "ownerLayer": { "enum": ["grammar", "application-block", "application-composite"] },
                          "authorityRef": { "type": "string", "pattern": "^(grammar|application)://" },
                          "patternRef": { "type": "string", "pattern": "^(pattern|block|composite)://" }
                        }
                      }
                    }
                  }
                },
                "iconographyManifest": {
                  "type": "object", "additionalProperties": false,
                  "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef", "decisions"],
                  "properties": {
                    "manifestRef": { "type": "string", "pattern": "^iconography://" },
                    "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "mode": { "enum": ["none", "resolved"] },
                    "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] },
                    "decisions": {
                      "type": "array", "maxItems": 64,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["roleRef", "meaningAuthorityRef", "source", "glyphRef", "catalogSearchRefs", "customReason"],
                        "properties": {
                          "roleRef": { "type": "string", "pattern": "^semantic-icon://" },
                          "meaningAuthorityRef": { "type": "string", "pattern": "^(business|ui-law|grammar)://" },
                          "source": { "enum": ["heroicons", "custom-svg"] },
                          "glyphRef": { "type": "string", "minLength": 1 },
                          "catalogSearchRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^icon-catalog://" } },
                          "customReason": { "type": ["string", "null"], "minLength": 1 }
                        }
                      }
                    }
                  }
                },
                "mediaManifest": {
                  "type": "object", "additionalProperties": false,
                  "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef", "artifactRefs", "provenanceRefs", "responsiveTreatmentRef", "altIntentRef", "fallbackRef"],
                  "properties": {
                    "manifestRef": { "type": "string", "pattern": "^media-manifest://" },
                    "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "mode": { "enum": ["none", "reuse", "generate"] },
                    "assetRef": { "type": ["string", "null"], "minLength": 1 },
                    "artifactRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "provenanceRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                    "responsiveTreatmentRef": { "type": ["string", "null"], "minLength": 1 },
                    "altIntentRef": { "type": ["string", "null"], "minLength": 1 },
                    "fallbackRef": { "type": ["string", "null"], "minLength": 1 }
                  }
                },
                "productFamilyEvidence": {
                  "type": "object", "additionalProperties": false,
                  "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"],
                  "properties": {
                    "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                    "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
                    "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
                    "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
                    "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
                    "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^benchmark://sha256-[0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
                  }
                },
                "proofMatrix": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["matrixRef", "states", "viewports", "probeRefs", "populatedHeroStateRef", "coreTaskRef", "cells"],
                  "properties": {
                    "matrixRef": { "type": "string", "pattern": "^matrix://[a-z0-9][a-z0-9._/-]*$" },
                    "states": {
                      "type": "array", "minItems": 1, "maxItems": 32,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["stateRef", "lifecycle", "populated", "coreTaskVisible"],
                        "properties": {
                          "stateRef": { "type": "string", "minLength": 1 },
                          "lifecycle": { "enum": ["happy-case", "loading", "empty", "error", "recovery", "result"] },
                          "populated": { "type": "boolean" },
                          "coreTaskVisible": { "type": "boolean" }
                        }
                      }
                    },
                    "viewports": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["wide", "intermediate", "compact"] } },
                    "probeRefs": { "type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": { "type": "string", "pattern": "^probe-[a-z0-9-]+$" } },
                    "populatedHeroStateRef": { "type": "string", "minLength": 1 },
                    "coreTaskRef": { "type": "string", "minLength": 1 },
                    "cells": {
                      "type": "array", "minItems": 3, "maxItems": 96,
                      "items": {
                        "type": "object", "additionalProperties": false,
                        "required": ["cellRef", "stateRef", "viewport"],
                        "properties": {
                          "cellRef": { "type": "string", "pattern": "^proof-cell-[0-9]{3}$" },
                          "stateRef": { "type": "string", "minLength": 1 },
                          "viewport": { "enum": ["wide", "intermediate", "compact"] }
                        }
                      }
                    }
                  }
                },
                "proofMatrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "constraints": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "type": "string", "minLength": 1 }
                },
                "negativeBoundary": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "type": "string", "minLength": 1 }
                },
                "acceptanceCriteria": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "type": "string", "minLength": 1 }
                },
                "sourceBoundary": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "beforeSha256", "ownerRef"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "beforeSha256": {
                        "anyOf": [
                          { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                          { "type": "null" }
                        ]
                      },
                      "ownerRef": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "sourceBoundaryFingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "repair": {
          "description": "Exact local Grammar-owner repair metadata, only for grammar-required.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownerRef", "gapRef", "resumeState", "inputRef"],
              "properties": {
                "ownerRef": { "type": "string", "pattern": "^grammar://" },
                "gapRef": { "type": "string", "minLength": 1 },
                "resumeState": { "const": "request-compile" },
                "inputRef": { "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
