{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/context-sync/output.schema.json",
  "title": "fe/context-sync operator output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [{ "oneOf": [
    { "properties": { "stage": { "const": "source-fit.resolve" }, "status": { "const": "ready" }, "payload": { "properties": { "decision": { "enum": ["reused", "updated"] } } } }, "required": ["stage", "status", "payload"] },
    { "properties": { "stage": { "const": "source-fit.resolve" }, "status": { "const": "blocked" }, "payload": { "properties": { "decision": { "const": "blocked" } } } }, "required": ["stage", "status", "payload"] }
  ] }],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "source-fit.resolve" },
    "status": { "enum": ["ready", "blocked"] },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["reused", "updated", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "status", "code", "retryable", "emits"],
          "properties": {
            "operator": { "const": "fe/context-sync" },
            "status": { "enum": ["completed", "blocked"] },
            "code": { "enum": ["fe-context-sync-reused", "fe-context-sync-updated", "fe-context-sync-blocked"] },
            "retryable": { "type": "boolean" },
            "emits": { "type": "object", "additionalProperties": false, "required": ["stage", "status", "factsAdd"], "properties": { "stage": { "const": "source-fit.resolve" }, "status": { "enum": ["ready", "blocked"] }, "factsAdd": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codingContextManifestPath", "codingContextGenerationRef", "snapshotSha256", "indexGenerationRef", "indexAction", "durableWrites"],
          "properties": {
            "codingContextManifestPath": { "type": "string", "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]*/coding-context/frontend/current\\.json$" },
            "codingContextGenerationRef": { "type": ["string", "null"], "minLength": 1 },
            "snapshotSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "indexGenerationRef": { "type": ["string", "null"], "minLength": 1 },
            "indexAction": { "enum": ["reused", "upserted", "replaced", "none"] },
            "durableWrites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "context": { "type": "object", "additionalProperties": false, "required": ["used"], "properties": { "used": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "revision"], "properties": { "kind": { "enum": ["source-metadata", "coding-context-metadata", "knowledge-index-metadata", "changed-generated-json", "changed-knowledge-document"] }, "ref": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } } } } },
        "cleanup": { "type": "object", "additionalProperties": false, "required": ["scratchRefs", "retention", "purgeAt"], "properties": { "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "retention": { "const": "until-skill-terminal" }, "purgeAt": { "const": "skill-terminal" } } },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
