{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/ui-detail-freeze/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "ui.detail.freeze" },
    "status": { "const": "ready" },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectiveRef",
            "approvedDirectionRef",
            "approvedFlowRef",
            "interactionContainerPlanRef",
            "pageRefs",
            "grammarPackage"
          ],
          "properties": {
            "objectiveRef": { "$ref": "#/$defs/ref" },
            "approvedDirectionRef": { "$ref": "#/$defs/ref" },
            "approvedFlowRef": { "$ref": "#/$defs/ref" },
            "interactionContainerPlanRef": { "$ref": "#/$defs/ref" },
            "pageRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/ref" }
            },
            "grammarPackage": {
              "enum": ["@starci/grammar/core", "@starci/grammar/offset-pop"]
            }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frontendContextRevision", "knowledge", "orchestration"],
          "properties": {
            "frontendContextRevision": { "$ref": "#/$defs/hash" },
            "knowledge": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/binding" }
            },
            "orchestration": { "$ref": "#/$defs/orchestration" }
          }
        },
        "session": { "$ref": "#/$defs/session" }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation", "contentSha256"],
      "properties": {
        "id": {
          "enum": [
            "fe.layout-composition",
            "fe.grammar-common-contracts",
            "fe.grammar-common-states-accessibility",
            "fe.interaction-container-selection"
          ]
        },
        "generation": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["economical", "balanced", "parallel", "deep"] }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "inputRef",
        "outputRef",
        "scratchPrefix",
        "retention"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/ref" },
        "inputRef": { "$ref": "#/$defs/ref" },
        "outputRef": { "$ref": "#/$defs/ref" },
        "scratchPrefix": { "$ref": "#/$defs/ref" },
        "retention": { "const": "until-skill-terminal" }
      }
    }
  }
}
