{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/preflight/input.schema.json",
  "title": "fe/preflight operator input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "business.freshness" },
    "status": { "const": "ready" },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "requestRef", "routeReceiptRef", "businessFreshnessReceiptRef", "targetRefs", "writeRoots"],
          "properties": {
            "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "requestRef": { "$ref": "#/$defs/sessionRef" },
            "routeReceiptRef": { "$ref": "#/$defs/sessionRef" },
            "businessFreshnessReceiptRef": { "$ref": "#/$defs/sessionRef" },
            "targetRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "writeRoots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipts", "orchestration"],
          "properties": {
            "receipts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "ref", "revision", "loadMode"],
                "properties": {
                  "role": { "enum": ["request", "workspace-route", "business-freshness"] },
                  "ref": { "$ref": "#/$defs/sessionRef" },
                  "revision": { "$ref": "#/$defs/sha256" },
                  "loadMode": { "const": "receipt-metadata-only" }
                }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "profileRef", "providerRef"],
              "properties": {
                "mode": { "enum": ["economical", "balanced", "parallel"] },
                "profileRef": { "enum": ["orchestration/modes/economical.json", "orchestration/modes/balanced.json", "orchestration/modes/parallel.json"] },
                "providerRef": { "type": "string", "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$" }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "inputRef", "outputRef", "scratchPrefix", "retention"],
          "properties": {
            "taskId": { "type": "string", "minLength": 1 },
            "inputRef": { "$ref": "#/$defs/sessionRef" },
            "outputRef": { "$ref": "#/$defs/sessionRef" },
            "scratchPrefix": { "$ref": "#/$defs/sessionRef" },
            "retention": { "const": "until-skill-terminal" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
