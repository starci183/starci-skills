{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/dominant-direction-generate/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/dominant-direction-generate" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRefs", "evidenceRefs", "uiKnowledgeId"],
      "properties": {
        "authorityRefs": { "description": "Frozen business, scope, family, and Grammar authority.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Latest structural visual findings and runtime observations.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 } },
        "uiKnowledgeId": { "description": "StarCi UI knowledge binding.", "const": "fe.ui" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "findingBatchRef", "ownerCeilingRef", "familySignatureRefs"],
      "properties": {
        "targetRef": { "description": "One direct feature target being reconstructed.", "type": "string", "minLength": 1 },
        "findingBatchRef": { "description": "Structurally rejected visual finding batch.", "type": "string", "minLength": 1 },
        "ownerCeilingRef": { "description": "Frozen writable owner boundary.", "type": "string", "minLength": 1 },
        "familySignatureRefs": { "description": "Nearest sibling product-family signatures to reconcile.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
