{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/dominant-direction-generate/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/dominant-direction-generate" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "aiExecution", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Typed result consumed only by the parent Skill machine.", "enum": ["generated", "blocked"] },
        "aiExecution": {
          "description": "Runtime-attested single fresh Sol brainstorm provenance.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "isolation", "forkTurns", "executionRef"],
          "properties": {
            "model": { "const": "gpt-5.6-sol" },
            "count": { "const": 1 },
            "isolation": { "const": "fresh" },
            "forkTurns": { "const": "none" },
            "executionRef": { "type": "string", "pattern": "^execution://[0-9a-f]{64}$" }
          }
        },
        "result": {
          "description": "One visible dominant direction and construction contract, or null when blocked.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["summary", "artifactRefs", "directionCount", "directionRef", "visualizeArtifactRef", "wideStateRef", "compactStateRef", "materialStateRef", "familySignatureManifestRef", "grammarDecisionManifestRef", "constructionContractRef"],
              "properties": {
                "summary": { "description": "Concise direction rationale.", "type": "string", "minLength": 20 },
                "artifactRefs": { "description": "Inspectable direction and contract artifacts.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
                "directionCount": { "description": "Exactly one dominant direction.", "const": 1 },
                "directionRef": { "description": "Stable direction identity.", "type": "string", "pattern": "^direction://" },
                "visualizeArtifactRef": { "description": "Inspectable HTML render of the direction.", "type": "string", "pattern": "\\.html$" },
                "wideStateRef": { "description": "Rendered wide composition reference.", "type": "string", "minLength": 1 },
                "compactStateRef": { "description": "Rendered compact composition reference.", "type": "string", "minLength": 1 },
                "materialStateRef": { "description": "Rendered consequential interaction or recovery state.", "type": "string", "minLength": 1 },
                "familySignatureManifestRef": { "description": "Product-family reconciliation manifest.", "type": "string", "minLength": 1 },
                "grammarDecisionManifestRef": { "description": "Validated Grammar decision manifest.", "type": "string", "pattern": "^grammar://" },
                "constructionContractRef": { "description": "Frozen contract consumed by implementation.", "type": "string", "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Exact authority or evidence gaps.", "type": "array", "uniqueItems": true, "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact evidence used to generate the direction.", "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
