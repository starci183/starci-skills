{
  "schemaVersion": 6,
  "id": "fe/product-uat",
  "domain": "fe",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": ["fe.product-proof", "fe.customer-journey"],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "product.uat",
      "status": "ready",
      "allFacts": ["frontend-fidelity-passed"],
      "noneFacts": []
    }
  ],
  "emits": [
    {
      "stage": "product.uat.result",
      "status": "passed",
      "factsAdd": ["product-uat-passed"],
      "factsRemove": []
    },
    {
      "stage": "product.uat.result",
      "status": "ux-ui-repair",
      "factsAdd": ["product-uat-failed", "ux-ui-repair-required"],
      "factsRemove": []
    },
    {
      "stage": "product.uat.result",
      "status": "repair",
      "factsAdd": ["product-uat-failed"],
      "factsRemove": []
    },
    {
      "stage": "product.uat.result",
      "status": "blocked",
      "factsAdd": [],
      "factsRemove": []
    }
  ],
  "sideEffects": ["write UAT evidence only to task-session storage"],
  "stopConditions": [
    "fidelity not passed",
    "journey step untested",
    "exact Grammar object identity or owned anatomy unproven",
    "visible state marker does not correspond to its declared state",
    "UX/UI failure is emitted as generic repair instead of UX/UI repair",
    "semantic content or prerequisite-control assertion untested",
    "required entitlement variant untested",
    "business outcome unproven"
  ]
}
