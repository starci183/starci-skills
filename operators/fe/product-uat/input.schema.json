{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/product-uat/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "product.uat" },
    "status": { "const": "ready" },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objectiveRef",
            "approvedFlowRef",
            "approvedInteractionContainerPlanRef",
            "fidelityReceiptRef",
            "businessOutcomeRef",
            "resolution"
          ],
          "properties": {
            "objectiveRef": { "$ref": "#/$defs/ref" },
            "approvedFlowRef": { "$ref": "#/$defs/ref" },
            "approvedInteractionContainerPlanRef": { "$ref": "#/$defs/ref" },
            "fidelityReceiptRef": { "$ref": "#/$defs/ref" },
            "businessOutcomeRef": { "$ref": "#/$defs/ref" },
            "resolution": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["priorResolutionRef", "requestRefs", "repairReceiptRefs"],
                  "properties": {
                    "priorResolutionRef": { "$ref": "#/$defs/ref" },
                    "requestRefs": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/requestPath" } },
                    "repairReceiptRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
                  }
                }
              ]
            }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runningAppRef",
            "testIdentityRef",
            "knowledge",
            "orchestration"
          ],
          "properties": {
            "runningAppRef": { "$ref": "#/$defs/ref" },
            "testIdentityRef": { "$ref": "#/$defs/ref" },
            "knowledge": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/binding" }
            },
            "orchestration": { "$ref": "#/$defs/orchestration" }
          }
        },
        "session": { "$ref": "#/$defs/session" }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 1 },
    "requestPath": { "type": "string", "pattern": "^\\.claude/requests/[a-z0-9][a-z0-9._-]*\\.request\\.json$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generation", "contentSha256"],
      "properties": {
        "id": { "enum": ["fe.product-proof", "fe.customer-journey"] },
        "generation": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profileRef", "providerRef"],
      "properties": {
        "mode": { "enum": ["economical", "balanced", "parallel"] },
        "profileRef": {
          "enum": [
            "orchestration/modes/economical.json",
            "orchestration/modes/balanced.json",
            "orchestration/modes/parallel.json"
          ]
        },
        "providerRef": {
          "type": "string",
          "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "inputRef",
        "outputRef",
        "scratchPrefix",
        "retention"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/ref" },
        "inputRef": { "$ref": "#/$defs/ref" },
        "outputRef": { "$ref": "#/$defs/ref" },
        "scratchPrefix": { "$ref": "#/$defs/ref" },
        "retention": { "const": "until-skill-terminal" }
      }
    }
  }
}
