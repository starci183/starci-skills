{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.5-alpha/operators/fe/baseline-visual-review/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/baseline-visual-review" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerExecutionRef", "reviewerPrincipalFingerprint", "reviewerContextFingerprint", "reviewerModel", "reviewerCount", "contextIsolation", "forkTurns", "debug", "knowledgeRefs"],
      "properties": {
        "reviewerExecutionRef": { "description": "Fresh blind reviewer execution identity.", "type": "string", "pattern": "^execution://[0-9a-f]{64}$" },
        "reviewerPrincipalFingerprint": { "description": "Reviewer principal identity without secrets.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewerContextFingerprint": { "description": "Fingerprint of the isolated reviewer context.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewerModel": { "description": "Required blind visual reviewer model.", "const": "gpt-5.6-sol" },
        "reviewerCount": { "description": "Exactly one reviewer prevents consensus inflation.", "const": 1 },
        "contextIsolation": { "description": "Reviewer must receive a fresh isolated context.", "const": "fresh" },
        "forkTurns": { "description": "No prior turns may bias the reviewer.", "const": "none" },
        "debug": { "description": "Expose concrete raster observations in runtime logs.", "const": true },
        "knowledgeRefs": {
          "description": "Exact audit-loop and visual-review knowledge contracts bound to this invocation.",
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["fe.audit-loop-v75-alpha", "fe.ui-render-review"] },
          "allOf": [
            { "contains": { "const": "fe.audit-loop-v75-alpha" } },
            { "contains": { "const": "fe.ui-render-review" } }
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRef", "auditTargetScore", "packet"],
      "properties": {
        "targetRef": { "description": "Direct frontend owner being audited.", "type": "string", "minLength": 1 },
        "auditTargetScore": { "description": "Optional noncanonical progress target; nine is the highest routable target.", "type": ["integer", "null"], "minimum": 1, "maximum": 9 },
        "packet": {
          "description": "Small representative current-source raster packet used only for initial routing.",
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "packetRef", "packetFingerprint", "sourceFingerprint", "runtimeGeneration", "leaseRef", "executionMode", "cells"],
          "properties": {
            "profile": { "const": "rapid-baseline" },
            "packetRef": { "type": "string", "minLength": 1 },
            "packetFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "runtimeGeneration": { "type": "integer", "minimum": 1 },
            "leaseRef": { "type": "string", "pattern": "^browser-lease://" },
            "executionMode": { "enum": ["consumer-materialized", "broker-executed"] },
            "cells": {
              "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["cellRef", "imageRef", "artifactSha256", "viewport", "stateRole"],
                "properties": {
                  "cellRef": { "type": "string", "pattern": "^cell-[0-9]{3}$" },
                  "imageRef": { "type": "string", "minLength": 1 },
                  "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "viewport": { "enum": ["wide", "intermediate", "compact"] },
                  "stateRole": { "enum": ["core-task", "recovery", "constrained", "sibling"] }
                }
              },
              "allOf": [
                { "contains": { "properties": { "viewport": { "const": "wide" } }, "required": ["viewport"] } },
                { "contains": { "properties": { "viewport": { "const": "compact" } }, "required": ["viewport"] } },
                { "contains": { "properties": { "stateRole": { "const": "core-task" } }, "required": ["stateRole"] } },
                { "contains": { "properties": { "stateRole": { "enum": ["recovery", "constrained"] } }, "required": ["stateRole"] } }
              ]
            }
          }
        }
      }
    }
  }
}
