{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.4/operators/fe/media-produce/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/media-produce" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Typed result routed only by the parent Skill.", "enum": ["ready", "blocked"] },
        "result": {
          "description": "Fulfilled media manifest, or null when blocked.",
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["summary", "mode", "mediaManifestRef", "assetRef", "artifactRefs", "provenanceRefs", "responsiveTreatmentRef", "altIntentRef", "fallbackRef"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "mode": { "enum": ["none", "reuse", "generate"] },
                "mediaManifestRef": { "type": "string", "pattern": "^media-manifest://" },
                "assetRef": { "type": ["string", "null"], "minLength": 1 },
                "artifactRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "provenanceRefs": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "responsiveTreatmentRef": { "type": ["string", "null"], "minLength": 1 },
                "altIntentRef": { "type": ["string", "null"], "minLength": 1 },
                "fallbackRef": { "type": ["string", "null"], "minLength": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Exact production blockers.", "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact evidence used during media fulfillment.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
