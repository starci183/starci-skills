{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/product-potential/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/product-potential"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "description": "Legacy semantic result consumed only by the Skill machine.",
          "enum": [
            "assessed",
            "blocked"
          ]
        },
        "result": {
          "description": "The atomic job result, or null when blocked.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "capabilityDecisions",
                "flowRelations"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "capabilityDecisions": {
                  "description": "Exhaustive decisions for observed and missing capabilities.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "capabilityRef",
                      "decision",
                      "userOutcomeRef",
                      "owner",
                      "rationale",
                      "evidenceRefs"
                    ],
                    "properties": {
                      "capabilityRef": { "type": "string", "minLength": 1 },
                      "decision": { "enum": ["ADD", "CHANGE", "REMOVE", "KEEP"] },
                      "userOutcomeRef": { "type": "string", "minLength": 1 },
                      "owner": { "enum": ["frontend", "business", "backend", "cross-domain"] },
                      "rationale": { "type": "string", "minLength": 1 },
                      "evidenceRefs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                },
                "flowRelations": {
                  "description": "Required nodes and transitions, including missing or contradictory links.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fromRef",
                      "toRef",
                      "status",
                      "owner",
                      "userOutcomeRef",
                      "evidenceRefs"
                    ],
                    "properties": {
                      "fromRef": { "type": "string", "minLength": 1 },
                      "toRef": { "type": "string", "minLength": 1 },
                      "status": { "enum": ["present", "missing", "contradictory", "redundant"] },
                      "owner": { "enum": ["frontend", "business", "backend", "cross-domain"] },
                      "userOutcomeRef": { "type": "string", "minLength": 1 },
                      "evidenceRefs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact missing authority or evidence; empty when complete.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used to produce the result.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  }
}
