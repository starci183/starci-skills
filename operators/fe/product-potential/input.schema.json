{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/product-potential/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/product-potential"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs",
        "authorityRevision"
      ],
      "properties": {
        "evidenceRefs": {
          "description": "Exact canonical evidence references available to this atomic job.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "authorityRevision": {
          "description": "Exact approved authority revision binding this invocation.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "requiredOutcomeRefs",
        "observedCapabilityRefs"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this atomic invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints that bound this job without routing it.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredOutcomeRefs": {
          "description": "Authority-backed user outcomes that the target must complete.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observedCapabilityRefs": {
          "description": "Complete runtime-observed capability and interaction inventory for the target.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
