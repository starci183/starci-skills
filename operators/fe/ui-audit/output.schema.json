{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/ui-audit/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/ui-audit"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "passed",
            "findings",
            "authority-gap"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "checks"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["checkRef", "subjectRef", "verdict", "observation", "authorityRef", "evidenceRef"],
                    "properties": {
                      "checkRef": { "type": "string", "minLength": 1 },
                      "subjectRef": { "type": "string", "minLength": 1 },
                      "verdict": { "enum": ["passed", "finding", "authority-gap"] },
                      "observation": { "type": "string", "minLength": 1 },
                      "authorityRef": { "type": "string", "minLength": 1 },
                      "evidenceRef": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
