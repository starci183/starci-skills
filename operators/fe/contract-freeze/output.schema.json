{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/contract-freeze/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/contract-freeze"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "frozen",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "mediaDecision",
                "behaviorContract"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mediaDecision": {
                  "description": "Frozen decision for whether this contract needs no media, reuses an approved asset, or produces one purpose-built bitmap.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "purpose",
                    "placementRef",
                    "responsiveTreatment",
                    "assetBriefRef",
                    "altIntent"
                  ],
                  "properties": {
                    "mode": {
                      "enum": [
                        "none",
                        "reuse",
                        "generate"
                      ]
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    },
                    "placementRef": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "responsiveTreatment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assetBriefRef": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    },
                    "altIntent": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "mode": {
                            "const": "none"
                          }
                        },
                        "required": [
                          "mode"
                        ]
                      },
                      "then": {
                        "properties": {
                          "placementRef": {
                            "type": "null"
                          },
                          "assetBriefRef": {
                            "type": "null"
                          },
                          "altIntent": {
                            "type": "null"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "mode": {
                            "enum": [
                              "reuse",
                              "generate"
                            ]
                          }
                        },
                        "required": [
                          "mode"
                        ]
                      },
                      "then": {
                        "properties": {
                          "placementRef": {
                            "type": "string",
                            "minLength": 1
                          },
                          "assetBriefRef": {
                            "type": "string",
                            "minLength": 1
                          },
                          "altIntent": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                },
                "behaviorContract": {
                  "description": "Executable preservation contract carried into mutation and proof.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["observedInteractionRefs", "interactionDecisions", "surfaceOwnerRefs", "grammarBindingRefs", "responsiveStates"],
                  "properties": {
                    "observedInteractionRefs": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 128,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "interactionDecisions": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["interactionRef", "decision", "authorityRef", "rationale", "replacementRef"],
                        "properties": {
                          "interactionRef": { "type": "string", "minLength": 1 },
                          "decision": { "enum": ["preserve", "remove", "replace"] },
                          "authorityRef": { "type": ["string", "null"], "minLength": 1 },
                          "rationale": { "type": ["string", "null"], "minLength": 1 },
                          "replacementRef": { "type": ["string", "null"], "minLength": 1 }
                        }
                      }
                    },
                    "surfaceOwnerRefs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 128,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "grammarBindingRefs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 128,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "responsiveStates": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["viewport", "stateRef"],
                        "properties": {
                          "viewport": { "enum": ["wide", "intermediate", "compact"] },
                          "stateRef": { "type": "string", "minLength": 1 }
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
