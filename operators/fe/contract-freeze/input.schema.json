{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/contract-freeze/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/contract-freeze"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityRefs",
        "evidenceRefs",
        "uiKnowledgeId"
      ],
      "properties": {
        "authorityRefs": {
          "description": "Exact frozen authority references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "description": "Exact evidence references for this job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uiKnowledgeId": {
          "description": "Exact StarCi-native frontend UI knowledge binding.",
          "const": "fe.ui"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "uxUiChangeLevel",
        "constraints",
        "preservationContract"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this invocation.",
          "type": "string",
          "minLength": 1
        },
        "uxUiChangeLevel": {
          "description": "Projection of the frozen frontend.ux-ui.change-level scope dimension carried into the executable contract.",
          "enum": [
            "refine",
            "reconstruct",
            "new"
          ]
        },
        "constraints": {
          "description": "Closed constraints for this atomic job.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preservationContract": {
          "description": "Closed reconciliation of observed interactions, visible owners, Grammar bindings, and responsive states.",
          "type": "object",
          "additionalProperties": false,
          "required": ["observedInteractionRefs", "interactionDecisions", "surfaceOwnerRefs", "grammarBindingRefs", "responsiveStates"],
          "properties": {
            "observedInteractionRefs": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 128,
              "items": { "type": "string", "minLength": 1 }
            },
            "interactionDecisions": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["interactionRef", "decision", "authorityRef", "rationale", "replacementRef"],
                "properties": {
                  "interactionRef": { "type": "string", "minLength": 1 },
                  "decision": { "enum": ["preserve", "remove", "replace"] },
                  "authorityRef": { "type": ["string", "null"], "minLength": 1 },
                  "rationale": { "type": ["string", "null"], "minLength": 1 },
                  "replacementRef": { "type": ["string", "null"], "minLength": 1 }
                }
              }
            },
            "surfaceOwnerRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "grammarBindingRefs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "responsiveStates": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["viewport", "stateRef"],
                "properties": {
                  "viewport": { "enum": ["wide", "intermediate", "compact"] },
                  "stateRef": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
