{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/layout/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "fe/layout" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Whether responsive layout geometry compiled or a named gap blocked it.", "enum": ["compiled", "blocked"] },
        "result": {
          "description": "The evidence-bound layout compilation, or null when blocked.",
          "anyOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["summary", "artifactRefs", "directionRef", "uiLawBindingRef", "uiDetailBindingRef", "layoutCompilationRef", "responsiveStates"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "artifactRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "directionRef": { "type": "string", "minLength": 1 },
                "uiLawBindingRef": { "type": "string", "pattern": "^ui-law-binding://" },
                "uiDetailBindingRef": { "type": "string", "pattern": "^ui-detail-binding://" },
                "layoutCompilationRef": { "type": "string", "pattern": "^layout-compile://" },
                "responsiveStates": {
                  "type": "array", "minItems": 3, "maxItems": 3,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["viewport", "stateRef"],
                    "properties": {
                      "viewport": { "enum": ["wide", "intermediate", "compact"] },
                      "stateRef": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Finite geometry or responsive-state gaps that prevent compilation.", "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact evidence supporting the layout-compilation outcome.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
