{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/visual-fidelity/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/visual-fidelity"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "description": "Typed blind visual-review result consumed only by the parent Skill machine.",
          "enum": [
            "passed",
            "repair",
            "insufficient-evidence",
            "blocked"
          ]
        },
        "result": {
          "description": "The atomic job result, or null when blocked or when the raster packet cannot support a verdict.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "reviewMode",
                "grammarBinding",
                "iconographyManifest",
                "mediaManifest",
                "productFamilyEvidence",
                "grammarAudit",
                "packetFingerprint",
                "matrixFingerprint",
                "partitionFingerprint",
                "visualRound",
                "packetRasterRefs",
                "reviewerExecutionRef",
                "reviewerModel",
                "reviewerCount",
                "contextIsolation",
                "forkTurns",
                "lastScreenshotRef",
                "lastScreenshotVerdict",
                "uncertainty",
                "auditScore",
                "inspectionRecords",
                "probeRecords"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "maxItems": 96,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reviewMode": {
                  "description": "The AI must attack the raster before consulting implementation or authority.",
                  "const": "ai-adversarial-pixel"
                },
                "grammarBinding": { "$ref": "#/$defs/blindGrammarBinding" },
                "iconographyManifest": { "$ref": "#/$defs/blindIconographyManifest" },
                "mediaManifest": { "$ref": "#/$defs/blindMediaManifest" },
                "productFamilyEvidence": {
                  "description": "Exact product-family comparison identity copied from the blind packet.",
                  "type": "object", "additionalProperties": false,
                  "required": ["grammarBindingRef", "grammarCoreRef", "packagedContractRefs", "visualDnaRef", "productFamilyRef", "benchmarkRasterRefs"],
                  "properties": {
                    "grammarBindingRef": { "type": "string", "pattern": "^grammar-binding://" },
                    "grammarCoreRef": { "type": "string", "pattern": "^grammar-core://" },
                    "packagedContractRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^grammar-package://" } },
                    "visualDnaRef": { "type": "string", "pattern": "^visual-dna://" },
                    "productFamilyRef": { "type": "string", "pattern": "^product-family://" },
                    "benchmarkRasterRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "sha256[-/][0-9a-f]{64}\\.(png|jpg|jpeg|webp)$" } }
                  }
                },
                "grammarAudit": {
                  "description": "Exact separately validated Grammar audit record bound to this packet and proof matrix.",
                  "type": "object", "additionalProperties": false,
                  "required": ["auditRef", "auditFingerprint", "status", "grammarManifestRef", "grammarManifestFingerprint", "iconographyManifestRef", "iconographyManifestFingerprint", "mediaManifestRef", "mediaManifestFingerprint", "proofMatrixFingerprint", "evidenceRefs"],
                  "properties": {
                    "auditRef": { "type": "string", "pattern": "^grammar-audit://" },
                    "auditFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "status": { "enum": ["passed", "failed"] },
                    "grammarManifestRef": { "type": "string", "pattern": "^grammar://" },
                    "grammarManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "iconographyManifestRef": { "type": "string", "pattern": "^iconography://" },
                    "iconographyManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "mediaManifestRef": { "type": "string", "pattern": "^media-manifest://" },
                    "mediaManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "proofMatrixFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                  }
                },
                "packetFingerprint": {
                  "description": "Exact raster-only packet reviewed by the fresh Sol execution.",
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "matrixFingerprint": { "description": "Immutable matrix fingerprint inherited from preflight and capture.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "partitionFingerprint": { "description": "Immutable owner-partition fingerprint inherited from preflight and capture.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                "visualRound": {
                  "description": "Discovery, verification, or later regression-attack round.",
                  "type": "object", "additionalProperties": false, "required": ["number", "purpose"],
                  "properties": { "number": { "type": "integer", "minimum": 1 }, "purpose": { "enum": ["discovery", "verification", "regression"] } }
                },
                "packetRasterRefs": {
                  "description": "Exact raster set supplied by the blind packet; every item requires one inspection record.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 96,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "\\.(png|jpg|jpeg|webp)$" }
                },
                "reviewerExecutionRef": { "type": "string", "pattern": "^execution://[0-9a-f]{64}$" },
                "reviewerModel": { "const": "gpt-5.6-sol" },
                "reviewerCount": { "const": 1 },
                "contextIsolation": { "const": "fresh" },
                "forkTurns": { "const": "none" },
                "lastScreenshotRef": {
                  "description": "The single post-mutation raster whose inspection controls visual closure.",
                  "type": "string",
                  "pattern": "\\.(png|jpg|jpeg|webp)$"
                },
                "lastScreenshotVerdict": { "enum": ["passed", "repair"] },
                "uncertainty": {
                  "description": "True means the reviewer could not safely close and aggregate PASS is forbidden.",
                  "type": "boolean"
                },
                "auditScore": {
                  "description": "Evidence-backed noncanonical progress score. It reports movement between rounds but never replaces the typed verdict.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "target", "status", "canonical", "previousValue", "delta", "axes"],
                  "properties": {
                    "value": { "type": "integer", "minimum": 0, "maximum": 10 },
                    "target": { "type": ["integer", "null"], "minimum": 1, "maximum": 9 },
                    "status": { "enum": ["below-target", "met-target", "not-requested"] },
                    "canonical": { "const": false },
                    "previousValue": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
                    "delta": { "type": ["integer", "null"], "minimum": -10, "maximum": 10 },
                    "axes": {
                      "type": "array",
                      "minItems": 5,
                      "maxItems": 5,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["axis", "value", "observation"],
                        "properties": {
                          "axis": { "enum": ["business-task-closure", "ux-flow-state-clarity", "visual-hierarchy-composition", "responsive-interaction-resilience", "consistency-accessibility-cues"] },
                          "value": { "type": "integer", "minimum": 0, "maximum": 2 },
                          "observation": { "type": "string", "minLength": 20 }
                        }
                      }
                    }
                  }
                },
                "inspectionRecords": {
                  "description": "One pixel-observation record for every inspected screenshot cell.",
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 96,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "imageRef",
                      "pageInset",
                      "surfaceOpacity",
                      "contentPadding",
                      "alignment",
                      "verticalRhythm",
                      "hierarchy",
                      "visualOwnership",
                      "pinnedBoundaryClearance",
                      "wrapping",
                      "clipping",
                      "occlusion",
                      "semanticUtility",
                      "contentCoherence",
                      "affordance",
                      "responsiveComposition",
                      "visualConsistency",
                      "emptySpaceBalance",
                      "lensVerdicts",
                      "challengeRecords",
                      "verdict"
                    ],
                    "properties": {
                      "imageRef": { "type": "string", "pattern": "\\.(png|jpg|jpeg|webp)$" },
                      "pageInset": { "type": "string", "minLength": 1 },
                      "surfaceOpacity": { "type": "string", "minLength": 1 },
                      "contentPadding": { "type": "string", "minLength": 1 },
                      "alignment": { "type": "string", "minLength": 1 },
                      "verticalRhythm": { "type": "string", "minLength": 1 },
                      "hierarchy": { "type": "string", "minLength": 1 },
                      "visualOwnership": { "type": "string", "minLength": 1 },
                      "pinnedBoundaryClearance": { "type": "string", "minLength": 1 },
                      "wrapping": { "type": "string", "minLength": 1 },
                      "clipping": { "type": "string", "minLength": 1 },
                      "occlusion": { "type": "string", "minLength": 1 },
                      "semanticUtility": { "type": "string", "minLength": 1 },
                      "contentCoherence": { "type": "string", "minLength": 1 },
                      "affordance": { "type": "string", "minLength": 1 },
                      "responsiveComposition": { "type": "string", "minLength": 1 },
                      "visualConsistency": { "type": "string", "minLength": 1 },
                      "emptySpaceBalance": { "type": "string", "minLength": 1 },
                      "lensVerdicts": {
                        "description": "A separate falsification verdict for every required visual lens; one problem forces this image to repair.",
                        "type": "array",
                        "minItems": 20,
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["lens", "verdict", "observation"],
                          "properties": {
                            "lens": {
                              "enum": [
                                "page-inset",
                                "surface-opacity",
                                "content-padding",
                                "alignment",
                                "vertical-rhythm",
                                "hierarchy",
                                "aesthetic-finish",
                                "visual-ownership",
                                "pinned-boundary-clearance",
                                "wrapping",
                                "clipping",
                                "occlusion",
                                "semantic-utility",
                                "content-coherence",
                                "affordance",
                                "responsive-composition",
                                "visual-consistency",
                                "empty-space-balance",
                                "task-scanability",
                                "product-family-quality"
                              ]
                            },
                            "verdict": { "enum": ["passed", "problem"] },
                            "observation": { "type": "string", "minLength": 20 }
                          }
                        }
                      },
                      "challengeRecords": {
                        "description": "Potential problems the AI deliberately tried to expose in this raster, including rejected candidates.",
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 24,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["challengeRef", "family", "suspectedProblem", "pixelObservation", "disposition"],
                          "properties": {
                            "challengeRef": { "type": "string", "minLength": 1 },
                            "family": { "enum": ["purpose-content", "composition-spacing", "interaction-responsive"] },
                            "suspectedProblem": { "type": "string", "minLength": 12 },
                            "pixelObservation": { "type": "string", "minLength": 20 },
                            "disposition": { "enum": ["confirmed", "not-observed"] }
                          }
                        }
                      },
                      "verdict": { "enum": ["passed", "repair"] }
                    }
                  }
                },
                "probeRecords": {
                  "description": "One adversarial verdict for every supplied probe; no applicable attack may disappear during aggregation.",
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 96,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["probeId", "category", "phase", "imageRef", "verdict", "observation"],
                    "properties": {
                      "probeId": { "type": "string", "minLength": 1 },
                      "category": {
                        "enum": ["viewport", "zoom", "page-scroll", "bounded-scroll", "content-stress", "state-transition", "sticky-fixed-overlay", "drag", "keyboard-focus", "composition-neighbors"]
                      },
                      "phase": { "enum": ["baseline", "start", "middle", "end", "terminal", "zoom-in", "zoom-out", "restored", "skeleton", "loading", "steady", "expanded", "collapsed", "focus", "drag-limit", "overlay-open", "content-long", "content-short", "breakpoint-edge"] },
                      "imageRef": { "type": ["string", "null"], "pattern": "\\.(png|jpg|jpeg|webp)$" },
                      "verdict": { "enum": ["survived", "contradiction", "not-applicable"] },
                      "observation": { "type": "string", "minLength": 1 }
                    },
                    "allOf": [
                      {
                        "if": { "properties": { "verdict": { "const": "not-applicable" } }, "required": ["verdict"] },
                        "then": { "properties": { "imageRef": { "type": "null" } } }
                      },
                      {
                        "if": { "properties": { "verdict": { "enum": ["survived", "contradiction"] } }, "required": ["verdict"] },
                        "then": { "properties": { "imageRef": { "type": "string" } } }
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact missing authority or evidence; empty when complete.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used to produce the result.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "insufficient-evidence" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "result": { "type": "null" },
              "gaps": { "minItems": 1 }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "blindGrammarBinding": { "type": "object", "additionalProperties": false, "required": ["bindingRef", "manifestRef", "decisionManifestFingerprint", "auditPlanRef", "auditPlanFingerprint"], "properties": { "bindingRef": { "type": "string", "pattern": "^grammar-binding://" }, "manifestRef": { "type": "string", "pattern": "^grammar://" }, "decisionManifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "auditPlanRef": { "type": "string", "pattern": "^grammar-audit://" }, "auditPlanFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "blindIconographyManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "visualFamilyRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^iconography://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "resolved"] }, "visualFamilyRef": { "anyOf": [{ "type": "string", "pattern": "^icon-family://" }, { "type": "null" }] } } },
    "blindMediaManifest": { "type": "object", "additionalProperties": false, "required": ["manifestRef", "manifestFingerprint", "mode", "assetRef"], "properties": { "manifestRef": { "type": "string", "pattern": "^media-manifest://" }, "manifestFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "mode": { "enum": ["none", "reuse", "generate"] }, "assetRef": { "type": ["string", "null"], "minLength": 1 } } }
  }
}
