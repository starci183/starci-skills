{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/authority-reconcile/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/authority-reconcile"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "description": "Typed Grammar repair result consumed only by the parent Skill machine.",
          "enum": [
            "reconciled",
            "blocked"
          ]
        },
        "result": {
          "description": "The atomic job result, or null when blocked.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "owner",
                "gapRef",
                "authorityRef",
                "beforeAuthorityRevision",
                "afterAuthorityRevision",
                "authorityBoundary",
                "authorityBoundaryFingerprint",
                "effectRecords",
                "publishedGrammar",
                "changedGrammarRefs",
                "consumerImpactRefs",
                "resumeState"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "owner": {
                  "const": "grammar"
                },
                "gapRef": {
                  "type": "string",
                  "minLength": 1
                },
                "authorityRef": {
                  "type": "string",
                  "pattern": "^grammar://"
                },
                "beforeAuthorityRevision": {
                  "type": "string",
                  "minLength": 1
                },
                "afterAuthorityRevision": {
                  "type": "string",
                  "minLength": 1
                },
                "authorityBoundary": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "beforeSha256", "ownerRef"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "beforeSha256": {
                        "anyOf": [
                          { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                          { "type": "null" }
                        ]
                      },
                      "ownerRef": { "type": "string", "pattern": "^grammar://" }
                    }
                  }
                },
                "authorityBoundaryFingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "effectRecords": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "beforeSha256", "afterSha256", "effect"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "beforeSha256": {
                        "anyOf": [
                          { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                          { "type": "null" }
                        ]
                      },
                      "afterSha256": {
                        "anyOf": [
                          { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                          { "type": "null" }
                        ]
                      },
                      "effect": { "enum": ["created", "updated", "deleted"] }
                    }
                  }
                },
                "publishedGrammar": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["packageRef", "exportRef", "artifactRef", "contentSha256"],
                  "properties": {
                    "packageRef": { "type": "string", "pattern": "^grammar-package://" },
                    "exportRef": { "type": "string", "pattern": "^grammar://" },
                    "artifactRef": { "type": "string", "minLength": 1 },
                    "contentSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                },
                "changedGrammarRefs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^grammar://" }
                },
                "consumerImpactRefs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "resumeState": {
                  "const": "request-compile"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact missing authority or evidence; empty when complete.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used to produce the result.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  }
}
