{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/fe/authority-reconcile/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/authority-reconcile"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "description": "Legacy semantic result consumed only by the Skill machine.",
          "enum": [
            "reconciled",
            "blocked"
          ]
        },
        "result": {
          "description": "The atomic job result, or null when blocked.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact missing authority or evidence; empty when complete.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used to produce the result.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    }
  }
}
