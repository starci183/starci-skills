{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/authority-reconcile/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/authority-reconcile"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs",
        "authorityRevision"
      ],
      "properties": {
        "evidenceRefs": {
          "description": "Exact canonical evidence references available to this atomic job.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "authorityRevision": {
          "description": "Exact approved authority revision binding this invocation.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "gapRef",
        "owner",
        "authorityRef",
        "authorityBoundary",
        "authorityBoundaryFingerprint"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this atomic invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints that bound this job without routing it.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gapRef": {
          "description": "Exact compile-time Grammar gap being repaired.",
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "description": "The proven reusable frontend authority owner.",
          "const": "grammar"
        },
        "authorityRef": {
          "description": "Exact routed Grammar owner allowed to change.",
          "type": "string",
          "pattern": "^grammar://"
        },
        "authorityBoundary": {
          "description": "Exact Grammar files, owner refs, and before hashes authorized for this repair.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "beforeSha256", "ownerRef"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "beforeSha256": {
                "anyOf": [
                  { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                  { "type": "null" }
                ]
              },
              "ownerRef": { "type": "string", "pattern": "^grammar://" }
            }
          }
        },
        "authorityBoundaryFingerprint": {
          "description": "Immutable fingerprint of the ordered Grammar authority boundary.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
