{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/fe/authority-reconcile/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/authority-reconcile"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs",
        "authorityRevision"
      ],
      "properties": {
        "evidenceRefs": {
          "description": "Exact canonical evidence references available to this atomic job.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "authorityRevision": {
          "description": "Exact approved authority revision binding this invocation.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "constraints",
        "findingRef",
        "owner",
        "authorityRef"
      ],
      "properties": {
        "targetRef": {
          "description": "The one target owned by this atomic invocation.",
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "description": "Closed constraints that bound this job without routing it.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findingRef": {
          "description": "Exact classified visual finding whose reusable authority owner is being reconciled.",
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "description": "The proven reusable frontend authority owner.",
          "enum": ["grammar", "ui-knowledge"]
        },
        "authorityRef": {
          "description": "Exact routed Grammar or shared UI-knowledge record allowed to change.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
