{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/fe/customer-journey/input.schema.json",
  "title": "FE customer journey operator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
    },
    "stage": {
      "enum": [
        "flow.generate",
        "flow.review"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "rejected"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestReceiptRef",
        "businessEvidenceReceiptRef",
        "actor",
        "goal",
        "scope",
        "knownConditions"
      ],
      "properties": {
        "requestReceiptRef": {
          "$ref": "#/$defs/ref"
        },
        "businessEvidenceReceiptRef": {
          "$ref": "#/$defs/ref"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "knownConditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "success",
            "failure"
          ],
          "properties": {
            "entry": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "success": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "failure": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "flow.generate"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "ready"
          },
          "facts": {
            "contains": {
              "const": "preflight-complete"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "flow.review"
          }
        }
      },
      "then": {
        "required": [
          "payload"
        ],
        "properties": {
          "status": {
            "const": "rejected"
          },
          "facts": {
            "contains": {
              "const": "flow-feedback-recorded"
            }
          },
          "payload": {
            "required": [
              "feedback"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "pageIntent",
        "userCommitment",
        "systemResponse",
        "recovery"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "pageIntent": {
          "type": "string",
          "minLength": 1
        },
        "userCommitment": {
          "type": "string",
          "minLength": 1
        },
        "systemResponse": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "thesis",
        "actorGoal",
        "entryCondition",
        "terminalSuccess",
        "materialAxis",
        "journeyProgress",
        "steps",
        "benefits",
        "costs",
        "risks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "actorGoal": {
          "type": "string",
          "minLength": 1
        },
        "entryCondition": {
          "type": "string",
          "minLength": 1
        },
        "terminalSuccess": {
          "type": "string",
          "minLength": 1
        },
        "materialAxis": {
          "type": "string",
          "minLength": 1
        },
        "journeyProgress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "ownerScope"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "ownerScope": {
              "enum": [
                "none",
                "global"
              ]
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/journeyStep"
          }
        },
        "benefits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "costs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
