{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/fe/runtime-observe/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "fe/runtime-observe"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result",
        "gaps",
        "evidenceRefs",
        "handoff"
      ],
      "properties": {
        "outcome": {
          "description": "Typed result routed only by the parent Skill machine.",
          "enum": [
            "observed",
            "backend-required",
            "blocked"
          ]
        },
        "result": {
          "description": "This operator atomic product, or null when incomplete.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "artifactRefs",
                "runtimeReadiness",
                "surfaceInventory",
                "interactionInventory",
                "responsiveStateInventory"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "artifactRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "runtimeReadiness": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "worktreeRef",
                    "workingDirectoryRef",
                    "dependencyMode",
                    "dependencyRootRef",
                    "dependencyContained",
                    "manifestLockStatus",
                    "manifestLockEvidenceRef",
                    "runtimeBuildStatus",
                    "runtimeLoadStatus",
                    "runtimeOriginRef",
                    "targetLoadEvidenceRef"
                  ],
                  "properties": {
                    "worktreeRef": { "type": "string", "minLength": 1 },
                    "workingDirectoryRef": { "type": "string", "minLength": 1 },
                    "dependencyMode": { "enum": ["worktree-local-install", "toolchain-supported-local"] },
                    "dependencyRootRef": { "type": "string", "minLength": 1 },
                    "dependencyContained": { "const": true },
                    "manifestLockStatus": { "enum": ["reproducible", "drift-recorded", "not-applicable"] },
                    "manifestLockEvidenceRef": { "type": "string", "minLength": 1 },
                    "runtimeBuildStatus": { "enum": ["passed", "not-required"] },
                    "runtimeLoadStatus": { "const": "passed" },
                    "runtimeOriginRef": { "type": "string", "minLength": 1 },
                    "targetLoadEvidenceRef": { "type": "string", "minLength": 1 }
                  }
                },
                "surfaceInventory": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["surfaceRef", "ownerRef", "purpose", "evidenceRef"],
                    "properties": {
                      "surfaceRef": { "type": "string", "minLength": 1 },
                      "ownerRef": { "type": "string", "minLength": 1 },
                      "purpose": { "type": "string", "minLength": 1 },
                      "evidenceRef": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "interactionInventory": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["interactionRef", "kind", "ownerRef", "entryStateRef", "outcomeRef", "evidenceRef"],
                    "properties": {
                      "interactionRef": { "type": "string", "minLength": 1 },
                      "kind": {
                        "enum": ["search", "filter", "navigation", "disclosure", "selection", "mutation", "progress", "recovery", "scroll", "drag", "overlay", "keyboard", "other"]
                      },
                      "ownerRef": { "type": "string", "minLength": 1 },
                      "entryStateRef": { "type": "string", "minLength": 1 },
                      "outcomeRef": { "type": "string", "minLength": 1 },
                      "evidenceRef": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "responsiveStateInventory": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["viewport", "stateRef", "requestedWidthPx", "requestedHeightPx", "observedWidthPx", "observedHeightPx", "rasterFingerprint", "evidenceRef"],
                    "properties": {
                      "viewport": { "enum": ["wide", "intermediate", "compact"] },
                      "stateRef": { "type": "string", "minLength": 1 },
                      "requestedWidthPx": { "type": "integer", "minimum": 240, "maximum": 10000 },
                      "requestedHeightPx": { "type": "integer", "minimum": 240, "maximum": 10000 },
                      "observedWidthPx": { "type": "integer", "minimum": 240, "maximum": 10000 },
                      "observedHeightPx": { "type": "integer", "minimum": 240, "maximum": 10000 },
                      "rasterFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                      "evidenceRef": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gaps": {
          "description": "Exact blockers or authority gaps.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceRefs": {
          "description": "Exact evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "handoff": {
          "description": "Typed cross-domain continuation, only when the outcome requires it.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skillId",
                "missionRef",
                "resumeState",
                "inputRef"
              ],
              "properties": {
                "skillId": {
                  "enum": [
                    "starci-business-process",
                    "starci-backend-process",
                    "starci-quality-assure",
                    "starci-uat-verify"
                  ]
                },
                "missionRef": {
                  "type": "string",
                  "minLength": 1
                },
                "resumeState": {
                  "type": "string",
                  "minLength": 1
                },
                "inputRef": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
