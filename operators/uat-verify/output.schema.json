{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/uat-verify/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "uat.verify" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["passed", "failed", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "fixtureNamespace": { "type": "string", "pattern": "^uat-[A-Za-z0-9._-]+$" },
    "checkpoint": { "enum": ["entry", "commitment", "feedback", "recovery", "terminal"] },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "freeze",
        "publication",
        "lanes",
        "caseResults",
        "cleanup",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "uat-flow-verification" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "freeze": { "oneOf": [{ "$ref": "#/$defs/freeze" }, { "type": "null" }] },
        "publication": { "oneOf": [{ "$ref": "#/$defs/publication" }, { "type": "null" }] },
        "lanes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/lane" }
        },
        "caseResults": { "type": "array", "items": { "$ref": "#/$defs/caseResult" } },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": { "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] },
        "resume": { "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "backendSourceRef",
        "sourceHead",
        "feature",
        "flow",
        "runId",
        "artifactRootRef",
        "protocolFingerprint",
        "templateFingerprint",
        "runtimeGeneration",
        "blindVisualPassRef",
        "qualityPassRef",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "$ref": "#/$defs/slug" },
        "backendSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "$ref": "#/$defs/sourceHead" },
        "feature": { "$ref": "#/$defs/slug" },
        "flow": { "$ref": "#/$defs/slug" },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "protocolFingerprint": { "$ref": "#/$defs/fingerprint" },
        "templateFingerprint": { "$ref": "#/$defs/fingerprint" },
        "runtimeGeneration": { "type": "integer", "minimum": 1 },
        "blindVisualPassRef": { "type": "string", "minLength": 1 },
        "qualityPassRef": { "type": "string", "minLength": 1 },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotRef",
        "snapshotFingerprint",
        "frozenAt",
        "fixtureNamespace",
        "account",
        "frozenCases"
      ],
      "properties": {
        "snapshotRef": {
          "type": "string",
          "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/snapshot\\.json$"
        },
        "snapshotFingerprint": { "$ref": "#/$defs/fingerprint" },
        "frozenAt": { "type": "string", "format": "date-time" },
        "fixtureNamespace": { "$ref": "#/$defs/fixtureNamespace" },
        "account": {
          "oneOf": [{ "$ref": "#/$defs/accountRecord" }, { "$ref": "#/$defs/anonymousRecord" }]
        },
        "frozenCases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "order", "requiredCheckpoints"],
            "properties": {
              "caseId": { "$ref": "#/$defs/slug" },
              "order": { "type": "integer", "minimum": 1 },
              "requiredCheckpoints": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/checkpoint" }
              }
            }
          }
        }
      }
    },
    "accountRecord": {
      "description": "Closed non-secret record. Every field is a const, a fingerprint, or a scheme-bound opaque reference, so no field can hold a password, cookie, token, or OTP.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityKind",
        "accountRef",
        "provisioningMode",
        "provisioningOwnerRef",
        "identityRecordRef",
        "applicationRecordRef",
        "principalFingerprint",
        "fixtureNamespace",
        "credentialCustody",
        "state"
      ],
      "properties": {
        "identityKind": { "const": "account" },
        "accountRef": { "type": "string", "pattern": "^account://fresh/[A-Za-z0-9._~/-]+$" },
        "provisioningMode": { "const": "control-panel-auto-create" },
        "provisioningOwnerRef": { "type": "string", "pattern": "^control-panel://[A-Za-z0-9._~/-]+$" },
        "identityRecordRef": { "type": "string", "pattern": "^keycloak-user://[A-Za-z0-9._~/-]+$" },
        "applicationRecordRef": { "type": "string", "pattern": "^database-user://[A-Za-z0-9._~/-]+$" },
        "principalFingerprint": { "$ref": "#/$defs/fingerprint" },
        "fixtureNamespace": { "$ref": "#/$defs/fixtureNamespace" },
        "credentialCustody": { "const": "control-panel-ephemeral" },
        "state": { "const": "authenticated" }
      }
    },
    "anonymousRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityKind", "anonymousRef", "fixtureNamespace"],
      "properties": {
        "identityKind": { "const": "anonymous" },
        "anonymousRef": { "type": "string", "pattern": "^anonymous://explicit/[A-Za-z0-9._~/-]+$" },
        "fixtureNamespace": { "$ref": "#/$defs/fixtureNamespace" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultRef", "resultFingerprint", "snapshotFingerprint", "verdict", "publishedAt"],
      "properties": {
        "resultRef": {
          "type": "string",
          "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/result\\.json$"
        },
        "resultFingerprint": { "$ref": "#/$defs/fingerprint" },
        "snapshotFingerprint": { "$ref": "#/$defs/fingerprint" },
        "verdict": { "enum": ["passed", "failed"] },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "verdict", "statement", "evidenceRefs"],
      "properties": {
        "lane": { "enum": ["behavior", "ux", "ui"] },
        "verdict": { "enum": ["pass", "fail", "unavailable"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "order",
        "executedAt",
        "outcome",
        "postExecutionMutation",
        "captures",
        "statement"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/slug" },
        "order": { "type": "integer", "minimum": 1 },
        "executedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["pass", "fail", "blocked"] },
        "postExecutionMutation": { "type": "boolean" },
        "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureRef", "checkpoint", "framing", "assertionId", "runtimeEvidenceRef"],
      "properties": {
        "captureRef": { "type": "string", "minLength": 1 },
        "checkpoint": { "$ref": "#/$defs/checkpoint" },
        "framing": { "enum": ["full-viewport", "crop"] },
        "assertionId": { "type": "string", "minLength": 1 },
        "runtimeEvidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "usesUatFlag", "namespace"],
      "properties": {
        "performed": { "type": "boolean" },
        "usesUatFlag": { "type": "boolean" },
        "namespace": {
          "oneOf": [{ "$ref": "#/$defs/fixtureNamespace" }, { "type": "null" }]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "state", "caseId", "lane", "statement"],
      "properties": {
        "code": {
          "enum": [
            "BEHAVIOR_CONTRADICTION",
            "UX_CONTRADICTION",
            "UI_CONTRADICTION",
            "FIXTURE_MANUFACTURED_OUTCOME",
            "EVIDENCE_UNPAIRED",
            "CHECKPOINT_UNCAPTURED",
            "CONTINUITY_LOST"
          ]
        },
        "severity": { "enum": ["hard", "soft"] },
        "state": { "enum": ["open", "resolved"] },
        "caseId": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
        "lane": { "enum": ["behavior", "ux", "ui", "fixture"] },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "caseIds", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "ADMISSION_MISSING",
            "PROVISIONING_UNAVAILABLE",
            "LEASE_INVALID",
            "RUNTIME_UNAVAILABLE",
            "EVIDENCE_UNAVAILABLE",
            "FIXTURE_VIOLATION",
            "CANONICAL_WRITE_DENIED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "caseIds": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["control-panel", "runtime", "frontend", "backend", "quality", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
