{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/core/handoff-ack/input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "core/handoff-ack" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["handoffRef", "handoffSha256", "objectiveId", "artifacts"],
      "properties": {
        "handoffRef": { "description": "Exact immutable handoff being acknowledged.", "type": "string", "minLength": 1, "maxLength": 1024 },
        "handoffSha256": { "description": "Hash of the immutable handoff.", "$ref": "#/$defs/sha256" },
        "objectiveId": { "description": "Objective carried by the handoff.", "type": "string", "minLength": 1, "maxLength": 256 },
        "artifacts": { "description": "Complete artifact identity set carried by the handoff.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["objectiveId", "consumerCapability", "acceptedArtifacts"],
      "properties": {
        "objectiveId": { "description": "Objective the consumer accepts.", "type": "string", "minLength": 1, "maxLength": 256 },
        "consumerCapability": { "description": "Capability accepting the handoff.", "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
        "acceptedArtifacts": { "description": "Complete exact artifact set accepted by the consumer.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 1024 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
