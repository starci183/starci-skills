{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/core/handoff-emit/input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "core/handoff-emit" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["artifacts", "nextCandidates"],
      "properties": {
        "artifacts": { "description": "Exact immutable artifacts retained for the consumer.", "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
        "nextCandidates": { "description": "Exact capability candidates and resume identities allowed after the handoff.", "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/candidate" } }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["objectiveId", "fromCapability", "terminalCode"],
      "properties": {
        "objectiveId": { "description": "Objective continued by the handoff.", "type": "string", "minLength": 1, "maxLength": 256 },
        "fromCapability": { "description": "Capability that produced the handoff.", "$ref": "#/$defs/capability" },
        "terminalCode": { "description": "Exact producer terminal code.", "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 1024 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["capability", "resumeRef", "requiresMutationApproval", "approvalRef"], "properties": { "capability": { "$ref": "#/$defs/capability" }, "resumeRef": { "type": "string", "minLength": 1, "maxLength": 1024 }, "requiresMutationApproval": { "type": "boolean" }, "approvalRef": { "type": ["string", "null"], "minLength": 1, "maxLength": 1024 } } }
  }
}
