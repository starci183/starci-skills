{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/core/handoff-emit/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "core/handoff-emit" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "handoffRef", "handoffSha256", "retainedArtifactRefs", "evidenceRefs", "reason"],
      "properties": {
        "outcome": { "description": "Whether the immutable handoff was emitted.", "enum": ["emitted", "blocked"] },
        "handoffRef": { "description": "Immutable handoff reference, or null when blocked.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "handoffSha256": { "description": "Immutable handoff hash, or null when blocked.", "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "retainedArtifactRefs": { "description": "Artifact references the runtime retains until consumer acknowledgement.", "$ref": "#/$defs/refs" },
        "evidenceRefs": { "description": "Evidence that the emitted handoff matches the supplied artifacts and candidates.", "$ref": "#/$defs/refs" },
        "reason": { "description": "Bounded blocker explanation, or null when emitted.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
  }
}
