  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starci.dev/v7/operators/content/e2e/output.schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","operatorId","output"],
  "properties":{"schemaVersion":{"const":7},"operatorId":{"const":"content/e2e"},"output":{"type":"object","additionalProperties":false,"required":["outcome","aiExecution","iterations","trackResults","contractFingerprint","evidenceRefs","reason"],"properties":{
