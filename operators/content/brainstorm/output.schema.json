{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starci.dev/v7/operators/content/brainstorm/output.schema.json",
  "type":"object","additionalProperties":false,"required":["schemaVersion","operatorId","output"],
  "properties":{"schemaVersion":{"const":7},"operatorId":{"const":"content/brainstorm"},"output":{"type":"object","additionalProperties":false,"required":["outcome","aiExecution","briefRef","learnerInputRefs","learnerOutputRefs","exampleRefs","interviewOutcomeRefs","dispositions","evidenceRefs","reason"],"properties":{
    "outcome":{"description":"Typed result consumed by the content Skill.","enum":["ready","blocked"]},
    "aiExecution":{"description":"Runtime-attested single fresh Sol teacher execution.","$ref":"#/$defs/solExecution"},
    "briefRef":{"description":"Frozen inspectable lesson brief, or null when blocked.","oneOf":[{"$ref":"#/$defs/ref"},{"type":"null"}]},
    "learnerInputRefs":{"description":"Exact prerequisites and assumed learner-input references.","$ref":"#/$defs/refs"},
    "learnerOutputRefs":{"description":"Observable learner-output references used for assessment.","$ref":"#/$defs/refs"},
    "exampleRefs":{"description":"Required happy, edge, failure, and contrast example references.","$ref":"#/$defs/refs"},
    "interviewOutcomeRefs":{"description":"Required interview questions, follow-ups, and answer-quality references.","$ref":"#/$defs/refs"},
    "dispositions":{"description":"Explicit add, change, and remove decisions for this content unit.","type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["direction","disposition","rationale","evidenceRef"],"properties":{"direction":{"enum":["add","change","remove"]},"disposition":{"enum":["adopted","rejected","not-applicable"]},"rationale":{"type":"string","minLength":1,"maxLength":2048},"evidenceRef":{"$ref":"#/$defs/ref"}}}},
    "evidenceRefs":{"description":"Exact evidence supporting the teacher brief.","$ref":"#/$defs/refs"},
    "reason":{"description":"Bounded blocker reason, otherwise null.","type":["string","null"],"minLength":1,"maxLength":2048}
  }}},
  "$defs":{"ref":{"type":"string","minLength":1,"maxLength":1024},"refs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"solExecution":{"type":"object","additionalProperties":false,"required":["model","count","isolation","forkTurns","executionRef"],"properties":{"model":{"const":"gpt-5.6-sol"},"count":{"const":1},"isolation":{"const":"fresh"},"forkTurns":{"const":"none"},"executionRef":{"type":"string","pattern":"^execution://[0-9a-f]{64}$"}}}}
}
