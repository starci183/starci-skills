{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starci.dev/v7/operators/content/code/input.schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","operatorId","context","input"],
  "properties":{"schemaVersion":{"const":7},"operatorId":{"const":"content/code"},
    "context":{"type":"object","additionalProperties":false,"required":["briefRefs","articleRefs","behaviorContractRefs"],"properties":{
      "briefRefs":{"description":"Exact frozen teacher brief references.","$ref":"#/$defs/nonEmptyRefs"},
      "articleRefs":{"description":"Exact explanatory article references that code must illustrate.","$ref":"#/$defs/nonEmptyRefs"},
      "behaviorContractRefs":{"description":"Exact shared request, response, error, or executable behavior contracts.","$ref":"#/$defs/nonEmptyRefs"}
    }},
    "input":{"type":"object","additionalProperties":false,"required":["mode","implementationLanguages","trackTargetRefs","revisionFindingRefs"],"properties":{
      "mode":{"description":"Whether implementation code is required, optional, or disabled.","enum":["required","optional","none"]},
      "implementationLanguages":{"description":"Zero to four implementation languages sharing the same behavior.","type":"array","maxItems":4,"uniqueItems":true,"items":{"enum":["typescript","java","csharp","go"]}},
      "trackTargetRefs":{"description":"One bounded destination reference per requested implementation language.","$ref":"#/$defs/refs"},
      "revisionFindingRefs":{"description":"Exact final-review code findings to repair.","$ref":"#/$defs/refs"}
    }}
  },"$defs":{"ref":{"type":"string","minLength":1,"maxLength":1024},"refs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},"nonEmptyRefs":{"type":"array","minItems":1,"maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}}}
}
