{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/deployment/monitor/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "deployment/monitor"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextRefs",
        "sourceRefs"
      ],
      "properties": {
        "contextRefs": {
          "description": "Exact canonical references resolved with default repository or file search.",
          "$ref": "#/$defs/refs"
        },
        "sourceRefs": {
          "description": "Exact routed source references allowed for this job.",
          "$ref": "#/$defs/refs"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "objectiveRef",
        "sourceFingerprint"
      ],
      "properties": {
        "project": {
          "description": "Verified project identity for this job.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "objectiveRef": {
          "description": "Exact bounded objective reference.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceFingerprint": {
          "description": "Frozen fingerprint for the supplied source evidence.",
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
