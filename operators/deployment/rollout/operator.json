{
  "schemaVersion": 6,
  "id": "deployment/rollout",
  "domain": "deployment",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "deployment.lifecycle"
  ],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "deployment.rollout",
      "status": "ready",
      "allFacts": [
        "deployment-artifacts-published",
        "deployment-domain-ready"
      ],
      "noneFacts": []
    }
  ],
  "emits": [
    {
      "stage": "deployment.monitor",
      "status": "ready",
      "factsAdd": [
        "deployment-rollout-ready"
      ],
      "factsRemove": []
    },
    {
      "stage": "deployment.blocked",
      "status": "blocked",
      "factsAdd": [
        "deployment-rollout-partial"
      ],
      "factsRemove": []
    },
    {
      "stage": "deployment.blocked",
      "status": "blocked",
      "factsAdd": [
        "deployment-rollout-external-error"
      ],
      "factsRemove": []
    },
    {
      "stage": "deployment.blocked",
      "status": "blocked",
      "factsAdd": [
        "deployment-rollout-blocked"
      ],
      "factsRemove": []
    }
  ],
  "sideEffects": [
    "mutate declared remote runtime and release workflow state",
    "keep input, output, context, observations, and receipts in task-session memory only",
    "purge all intermediate session objects at every parent-skill terminal state"
  ],
  "stopConditions": [
    "required evidence is missing or stale",
    "the result would cross the declared boundary",
    "an external error or partial rollout cannot be represented with exact revisions"
  ]
}
