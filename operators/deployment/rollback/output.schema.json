{
  "$id": "https://starci.dev/v6/operators/deployment/rollback/output.schema.json",
  "title": "deployment/rollback operator output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "deployment.proof"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "deployment.blocked"
            },
            "status": {
              "const": "blocked"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "deployment.proof",
        "deployment.blocked"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rollbackReceiptRef",
        "decision",
        "evidenceRefs",
        "findings"
      ],
      "properties": {
        "rollbackReceiptRef": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "rolled-back",
            "blocked"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
