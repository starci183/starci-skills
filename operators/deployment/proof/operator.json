{
  "schemaVersion": 6,
  "id": "deployment/proof",
  "domain": "deployment",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "deployment.lifecycle"
  ],
  "sourceReferenceRefs": [],
  "accepts": [
    {
      "stage": "deployment.proof",
      "status": "ready",
      "allFacts": [
        "deployment-steady"
      ],
      "noneFacts": [
        "deployment-rolled-back"
      ]
    },
    {
      "stage": "deployment.proof",
      "status": "ready",
      "allFacts": [
        "deployment-rolled-back"
      ],
      "noneFacts": [
        "deployment-steady"
      ]
    }
  ],
  "emits": [
    {
      "stage": "delivery.proved",
      "status": "ready",
      "factsAdd": [
        "delivery-proof-ready"
      ],
      "factsRemove": []
    },
    {
      "stage": "deployment.rolled-back",
      "status": "complete",
      "factsAdd": [
        "deployment-rollback-proved"
      ],
      "factsRemove": [
        "deployment-rollback-required"
      ]
    },
    {
      "stage": "deployment.blocked",
      "status": "blocked",
      "factsAdd": [
        "deployment-proof-external-error"
      ],
      "factsRemove": []
    },
    {
      "stage": "deployment.blocked",
      "status": "blocked",
      "factsAdd": [
        "deployment-proof-blocked"
      ],
      "factsRemove": []
    }
  ],
  "sideEffects": [
    "keep input, output, context, observations, and receipts in task-session memory only",
    "purge all intermediate session objects at every parent-skill terminal state"
  ],
  "stopConditions": [
    "required evidence is missing or stale",
    "the result would cross the declared boundary"
  ]
}
