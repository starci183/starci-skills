{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/business-decide/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "business.decide" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "authority", "sourceRefs", "architectureRefs"],
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexRef", "fingerprint", "claims"],
          "properties": {
            "indexRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "claims": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": { "$ref": "#/$defs/claim" }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["businessesRootRef", "fingerprint", "heads"],
          "properties": {
            "businessesRootRef": { "$ref": "#/$defs/businessesRootRef" },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "heads": {
              "type": "array",
              "maxItems": 256,
              "items": { "$ref": "#/$defs/publishedHead" }
            }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "architectureRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "objective",
        "discovery",
        "publication",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "backendSourceRef", "sourceHead", "businessesRootRef"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "backendSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "$ref": "#/$defs/sourceHead" },
            "businessesRootRef": { "$ref": "#/$defs/businessesRootRef" }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectiveRef", "featureId", "intent"],
          "properties": {
            "objectiveRef": { "type": "string", "minLength": 1 },
            "featureId": { "$ref": "#/$defs/identifier" },
            "intent": { "enum": ["create", "revise", "reconcile", "retire"] }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consumers", "lifecycleBranches"],
          "properties": {
            "consumers": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["consumerId", "dimension", "sourceRef"],
                "properties": {
                  "consumerId": { "$ref": "#/$defs/identifier" },
                  "dimension": { "$ref": "#/$defs/coverageDimension" },
                  "sourceRef": { "type": "string", "minLength": 1 }
                }
              }
            },
            "lifecycleBranches": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/coverageDimension" }
            }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetState", "headRef", "approvalRef"],
          "properties": {
            "targetState": { "$ref": "#/$defs/authorityState" },
            "headRef": { "type": "string", "minLength": 1 },
            "approvalRef": {
              "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
            }
          }
        },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "businessesRootRef": { "type": "string", "pattern": "\\.worktrees/businesses$" },
    "authorityState": { "enum": ["pending", "in-progress", "implemented", "rejected"] },
    "claimKind": { "enum": ["fact", "intent", "example", "unknown", "contradiction"] },
    "coverageDimension": {
      "enum": [
        "actor-eligibility",
        "offer-entry",
        "read-entry",
        "purchase-side-effect",
        "external-payment",
        "settlement",
        "idempotency",
        "entitlement-consumer",
        "quota-consumer",
        "renewal",
        "cancellation",
        "expiry",
        "denial",
        "recovery",
        "refund",
        "legacy-create",
        "legacy-read",
        "legacy-settle"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "kind",
        "role",
        "statement",
        "sourceRef",
        "path",
        "lineStart",
        "lineEnd",
        "sourceHead"
      ],
      "properties": {
        "claimId": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/claimKind" },
        "role": { "type": "string", "minLength": 1, "maxLength": 256 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "sourceHead": {
          "oneOf": [{ "$ref": "#/$defs/sourceHead" }, { "type": "null" }]
        }
      }
    },
    "publishedHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "headRef", "state", "fingerprint"],
      "properties": {
        "featureId": { "$ref": "#/$defs/identifier" },
        "headRef": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/authorityState" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "$ref": "#/$defs/sourceHead" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  }
}
