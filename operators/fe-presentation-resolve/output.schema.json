{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-presentation-resolve/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.presentation.resolve" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["resolved", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "presentationProperty": {
      "enum": ["gap", "padding", "margin", "surface", "boundary", "font", "tone", "measure", "text-flow", "overflow"]
    },
    "nodePath": { "type": "string", "minLength": 1 },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "resolution",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "fe-presentation-resolution" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["resolved", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "resolution": {
          "oneOf": [{ "$ref": "#/$defs/resolution" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "frontendSourceRef",
        "sourceHead",
        "artifactRootRef",
        "targetId",
        "treeFingerprint",
        "knowledgeFingerprint",
        "grammarFingerprint",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "frontendSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "treeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "knowledgeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "grammarFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvedTreeRef",
        "resolvedTreeFingerprint",
        "contractEmission",
        "decisions",
        "contracts",
        "appliedRuleIds"
      ],
      "properties": {
        "resolvedTreeRef": { "type": "string", "minLength": 1 },
        "resolvedTreeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "contractEmission": { "enum": ["attribute", "receipt-only"] },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/decision" }
        },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "appliedRuleIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleId" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodePath", "property", "owner", "ruleId", "className", "condition"],
      "properties": {
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "property": { "$ref": "#/$defs/presentationProperty" },
        "owner": { "enum": ["app", "grammar", "none"] },
        "ruleId": {
          "oneOf": [{ "$ref": "#/$defs/ruleId" }, { "type": "null" }]
        },
        "className": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "condition": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodePath", "ruleIds"],
      "properties": {
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "nodePath", "property", "ruleId", "statement"],
      "properties": {
        "code": {
          "enum": [
            "GRAMMAR_OWNED",
            "COMMON_CAPABILITY_MISSING",
            "APP_REIMPLEMENTATION_REMOVED",
            "APP_OVERRIDE_REMOVED",
            "OFF_SCALE_REPLACED"
          ]
        },
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "property": { "$ref": "#/$defs/presentationProperty" },
        "ruleId": {
          "oneOf": [{ "$ref": "#/$defs/ruleId" }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "nodePaths", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "OWNER_CONFLICT",
            "KNOWLEDGE_UNBOUND",
            "UNKNOWN_RULE",
            "RULE_MISSING",
            "GRAMMAR_UNPUBLISHED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "nodePaths": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["frontend", "grammar", "knowledge", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
