{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-presentation-resolve/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.presentation.resolve" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "grammar", "sourceRefs", "directionRefs", "auditRefs"],
      "properties": {
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexRef", "fingerprint", "topics"],
          "properties": {
            "indexRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/knowledgeTopic" }
            }
          }
        },
        "grammar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageRef", "manifestRef", "fingerprint", "status", "ownedRelationships"],
          "properties": {
            "packageRef": { "type": "string", "minLength": 1 },
            "manifestRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "status": { "const": "published" },
            "ownedRelationships": {
              "type": "array",
              "items": { "$ref": "#/$defs/ownedRelationship" }
            }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "directionRefs": { "$ref": "#/$defs/contextRefArray" },
        "auditRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "target",
        "tree",
        "scope",
        "contractEmission",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "frontendSourceRef", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "frontendSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "ownerRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["page", "layout", "modal", "drawer", "flow", "block", "component"] },
            "ownerRef": { "type": "string", "minLength": 1 }
          }
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["treeRef", "fingerprint", "format", "nodeCount"],
          "properties": {
            "treeRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "format": { "enum": ["html", "tsx"] },
            "nodeCount": { "type": "integer", "minimum": 1 }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutableOwnerRefs", "observationOnlyOwnerRefs"],
          "properties": {
            "mutableOwnerRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "observationOnlyOwnerRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "contractEmission": { "enum": ["attribute", "receipt-only"] },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "presentationProperty": {
      "enum": ["gap", "padding", "margin", "surface", "boundary", "font", "tone", "measure", "text-flow", "overflow"]
    },
    "knowledgeTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "ref", "fingerprint", "ruleIds"],
      "properties": {
        "topic": { "$ref": "#/$defs/presentationProperty" },
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      }
    },
    "ownedRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "property", "ruleId"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "property": { "$ref": "#/$defs/presentationProperty" },
        "ruleId": { "$ref": "#/$defs/ruleId" }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
