{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/business/staleness-check/output.schema.json",
  "title": "business/staleness-check operator output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [{
    "oneOf": [
      { "properties": { "stage": { "const": "business.freshness" }, "status": { "const": "ready" }, "payload": { "properties": { "decision": { "const": "fresh" }, "state": { "properties": { "status": { "const": "completed" }, "code": { "const": "business-staleness-fresh" }, "emits": { "properties": { "stage": { "const": "business.freshness" }, "status": { "const": "ready" } } } } } } } }, "required": ["stage", "status", "payload"] },
      { "properties": { "stage": { "const": "business.evidence" }, "status": { "const": "ready" }, "payload": { "properties": { "decision": { "const": "initialize-required" }, "state": { "properties": { "status": { "const": "replan" }, "code": { "const": "business-staleness-initialize-required" }, "emits": { "properties": { "stage": { "const": "business.evidence" }, "status": { "const": "ready" } } } } } } } }, "required": ["stage", "status", "payload"] },
      { "properties": { "stage": { "const": "business.freshness" }, "status": { "const": "blocked" }, "payload": { "properties": { "decision": { "const": "blocked" }, "state": { "properties": { "status": { "const": "blocked" }, "code": { "const": "business-staleness-blocked" }, "emits": { "properties": { "stage": { "const": "business.freshness" }, "status": { "const": "blocked" } } } } } } } }, "required": ["stage", "status", "payload"] }
    ]
  }],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["business.freshness", "business.evidence"] },
    "status": { "enum": ["ready", "blocked"] },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["fresh", "initialize-required", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "status", "code", "retryable", "emits"],
          "properties": {
            "operator": { "const": "business/staleness-check" },
            "status": { "enum": ["completed", "replan", "blocked"] },
            "code": { "enum": ["business-staleness-fresh", "business-staleness-initialize-required", "business-staleness-blocked"] },
            "retryable": { "type": "boolean" },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status", "factsAdd", "factsRemove"],
              "properties": {
                "stage": { "enum": ["business.freshness", "business.evidence"] },
                "status": { "enum": ["ready", "blocked"] },
                "factsAdd": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "factsRemove": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["freshnessReceiptRef", "authorityPath", "businessRevision", "sourceCommit", "reason"],
          "properties": {
            "freshnessReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] },
            "authorityPath": { "type": "string", "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]*/businesses(?:/|$)" },
            "businessRevision": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "sourceCommit": { "$ref": "#/$defs/gitCommit" },
            "reason": { "enum": ["current", "missing", "unapproved", "invalid", "source-advanced", "route-drift", "refresh-limit"] }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref", "revision"],
                "properties": {
                  "kind": { "enum": ["business-metadata", "source-metadata"] },
                  "ref": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scratchRefs", "retention", "purgeAt"],
          "properties": {
            "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
            "retention": { "const": "until-skill-terminal" },
            "purgeAt": { "const": "skill-terminal" }
          }
        },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
