{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-direction-decide/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.direction.decide" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["decided", "blocked"] },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptType",
            "receiptId",
            "invocationId",
            "missionId",
            "status",
            "binding",
            "decision",
            "alternatives",
            "challenge",
            "evidenceRefs",
            "failure",
            "resume",
            "createdAt"
          ],
          "properties": {
            "receiptType": { "const": "fe-direction-decision" },
            "receiptId": { "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
            "invocationId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "status": { "enum": ["decided", "blocked"] },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projectId",
                "frontendSourceRef",
                "sourceHead",
                "artifactRootRef",
                "targetId",
                "targetKind",
                "intent",
                "changeLevel",
                "ownerCeilingFingerprint",
                "businessFingerprint",
                "backendFingerprint",
                "architectureFingerprint",
                "grammarFingerprint",
                "contextFingerprint",
                "inputFingerprint",
                "progressFingerprint"
              ],
              "properties": {
                "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "frontendSourceRef": { "type": "string", "minLength": 1 },
                "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                "artifactRootRef": { "type": "string", "minLength": 1 },
                "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "targetKind": { "enum": ["page", "layout", "modal", "drawer", "flow", "block", "component"] },
                "intent": { "enum": ["create", "modify", "audit-repair", "reconcile"] },
                "changeLevel": { "enum": ["new", "reconstruct", "refine"] },
                "ownerCeilingFingerprint": { "$ref": "#/$defs/sha256" },
                "businessFingerprint": { "$ref": "#/$defs/sha256" },
                "backendFingerprint": { "$ref": "#/$defs/nullableSha256" },
                "architectureFingerprint": { "$ref": "#/$defs/nullableSha256" },
                "grammarFingerprint": { "$ref": "#/$defs/sha256" },
                "contextFingerprint": { "$ref": "#/$defs/sha256" },
                "inputFingerprint": { "$ref": "#/$defs/sha256" },
                "progressFingerprint": { "$ref": "#/$defs/sha256" }
              }
            },
            "decision": {
              "oneOf": [
                { "$ref": "#/$defs/decision" },
                { "type": "null" }
              ]
            },
            "alternatives": {
              "type": "array",
              "maxItems": 4,
              "items": { "$ref": "#/$defs/alternative" }
            },
            "challenge": {
              "type": "object",
              "additionalProperties": false,
              "required": ["add", "change", "remove", "contradictions"],
              "properties": {
                "add": { "$ref": "#/$defs/findings" },
                "change": { "$ref": "#/$defs/findings" },
                "remove": { "$ref": "#/$defs/findings" },
                "contradictions": { "$ref": "#/$defs/findings" }
              }
            },
            "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "failure": {
              "oneOf": [
                { "$ref": "#/$defs/failure" },
                { "type": "null" }
              ]
            },
            "resume": {
              "oneOf": [
                { "$ref": "#/$defs/resume" },
                { "type": "null" }
              ]
            },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "decided" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "status": { "const": "decided" },
                  "decision": { "$ref": "#/$defs/decision" },
                  "failure": { "type": "null" },
                  "resume": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "blocked" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "status": { "const": "blocked" },
                  "decision": { "type": "null" },
                  "failure": { "$ref": "#/$defs/failure" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "refArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "nonEmptyTextArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "directionId",
        "directionRef",
        "directionFingerprint",
        "selectedAlternativeId",
        "visualArtifactRefs",
        "purpose",
        "actorTasks",
        "regionModel",
        "actionModel",
        "stateMatrix",
        "responsiveModel",
        "accessibilityModel",
        "contentModel",
        "mediaDecisions",
        "grammarBindings",
        "preservedDecisions",
        "changedDecisions",
        "implementationConstraints",
        "downstreamProofRefs"
      ],
      "properties": {
        "classification": { "enum": ["locked-refine", "approved-reuse", "dominant", "selected-alternative"] },
        "directionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "directionRef": { "type": "string", "pattern": "^direction://" },
        "directionFingerprint": { "$ref": "#/$defs/sha256" },
        "selectedAlternativeId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "visualArtifactRefs": { "$ref": "#/$defs/refArray" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "actorTasks": { "$ref": "#/$defs/nonEmptyTextArray" },
        "regionModel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "responsibility", "order"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "responsibility": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "actionModel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "feedback", "recovery"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "feedback": { "type": "string", "minLength": 1 },
              "recovery": { "type": "string", "minLength": 1 }
            }
          }
        },
        "stateMatrix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "entry", "presentation", "exit"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "entry": { "type": "string", "minLength": 1 },
              "presentation": { "type": "string", "minLength": 1 },
              "exit": { "type": "string", "minLength": 1 }
            }
          }
        },
        "responsiveModel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "transformation", "invariant"],
            "properties": {
              "condition": { "type": "string", "minLength": 1 },
              "transformation": { "type": "string", "minLength": 1 },
              "invariant": { "type": "string", "minLength": 1 }
            }
          }
        },
        "coverage": { "$ref": "#/$defs/coverage" },
        "accessibilityModel": { "$ref": "#/$defs/nonEmptyTextArray" },
        "contentModel": { "$ref": "#/$defs/nonEmptyTextArray" },
        "mediaDecisions": { "$ref": "#/$defs/refArray" },
        "grammarBindings": { "$ref": "#/$defs/nonEmptyRefArray" },
        "preservedDecisions": { "$ref": "#/$defs/nonEmptyTextArray" },
        "changedDecisions": { "$ref": "#/$defs/refArray" },
        "implementationConstraints": { "$ref": "#/$defs/nonEmptyTextArray" },
        "downstreamProofRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "pointerRoute", "keyboardRoute", "states"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "pointerRoute": { "type": "string", "minLength": 1 },
              "keyboardRoute": { "type": "string", "minLength": 1 },
              "states": { "$ref": "#/$defs/nonEmptyTextArray" },
              "pendingPaths": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "settlement"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "settlement": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "regions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "idiomRef", "compositionRef"],
            "properties": {
              "region": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "idiomRef": { "type": "string", "minLength": 1 },
              "compositionRef": { "type": "string", "minLength": 1 }
            }
          }
        },
        "states": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["meaning", "carrier"],
            "properties": {
              "meaning": { "type": "string", "minLength": 1 },
              "carrier": { "type": "string", "minLength": 1 }
            }
          }
        },
        "responsive": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["branch", "owner"],
            "properties": {
              "branch": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "directionRef", "fingerprint", "visualArtifactRefs", "materialDifference", "tradeoffs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "directionRef": { "type": "string", "pattern": "^direction://" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "visualArtifactRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "materialDifference": { "type": "string", "minLength": 1 },
        "tradeoffs": { "$ref": "#/$defs/nonEmptyTextArray" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "statement", "evidenceRefs"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "severity": { "enum": ["info", "warning", "error"] },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/finding" }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "ROUTE_UNVERIFIED",
            "SOURCE_DRIFT",
            "SCOPE_UNFROZEN",
            "CHANGE_LEVEL_AMBIGUOUS",
            "OWNER_CEILING_INVALID",
            "BUSINESS_REQUIRED",
            "BACKEND_REQUIRED",
            "ARCHITECTURE_REQUIRED",
            "GRAMMAR_REQUIRED",
            "EVIDENCE_MISSING",
            "REFERENCE_EVIDENCE_EXHAUSTED",
            "NO_VIABLE_DIRECTION",
            "DIRECTION_CHOICE_REQUIRED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": { "enum": ["frontend", "business", "backend", "architecture", "grammar", "workspace"] }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta", "candidateAlternativeIds"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyTextArray" },
        "candidateAlternativeIds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    }
  }
}
