{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-direction-decide/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.direction.decide" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestRefs",
        "business",
        "backend",
        "architecture",
        "grammar",
        "knowledgeRefs",
        "sourceRefs",
        "uatRefs",
        "auditRefs",
        "visualRefs",
        "previousDirectionRefs",
        "externalReferenceRefs"
      ],
      "properties": {
        "requestRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "business": { "$ref": "#/$defs/authorityBinding" },
        "backend": {
          "oneOf": [
            { "$ref": "#/$defs/authorityBinding" },
            { "type": "null" }
          ]
        },
        "architecture": {
          "oneOf": [
            { "$ref": "#/$defs/authorityBinding" },
            { "type": "null" }
          ]
        },
        "grammar": { "$ref": "#/$defs/grammarBinding" },
        "knowledgeRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contextRef" }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contextRef" }
        },
        "uatRefs": { "$ref": "#/$defs/contextRefArray" },
        "auditRefs": { "$ref": "#/$defs/contextRefArray" },
        "visualRefs": { "$ref": "#/$defs/contextRefArray" },
        "previousDirectionRefs": { "$ref": "#/$defs/contextRefArray" },
        "externalReferenceRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "objectiveRef",
        "project",
        "target",
        "intent",
        "changeLevel",
        "scope",
        "approvedDirection",
        "decisionPolicy",
        "constraints",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "objectiveRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "frontendSourceRef", "repository", "branch", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "frontendSourceRef": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "ownerRef"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "kind": { "enum": ["page", "layout", "modal", "drawer", "flow", "block", "component"] },
            "ownerRef": { "type": "string", "minLength": 1 }
          }
        },
        "intent": { "enum": ["create", "modify", "audit-repair", "reconcile"] },
        "changeLevel": { "enum": ["new", "reconstruct", "refine"] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inclusionRefs", "exclusionRefs", "ownerCeiling"],
          "properties": {
            "inclusionRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "exclusionRefs": { "$ref": "#/$defs/refArray" },
            "ownerCeiling": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "mutableOwnerRefs", "observationOnlyOwnerRefs"],
              "properties": {
                "kind": { "enum": ["surface-only", "surface-and-nested-layouts", "ancestor-layouts-authorized"] },
                "mutableOwnerRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
                "observationOnlyOwnerRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          }
        },
        "approvedDirection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["directionRef", "directionFingerprint", "approvalRef"],
              "properties": {
                "directionRef": { "type": "string", "pattern": "^direction://" },
                "directionFingerprint": { "$ref": "#/$defs/sha256" },
                "approvalRef": { "type": "string", "pattern": "^direction-approval://" }
              }
            },
            { "type": "null" }
          ]
        },
        "decisionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "alternativeCount", "comparisonAuthorityRef"],
          "properties": {
            "mode": { "enum": ["preserve", "dominant", "compare"] },
            "alternativeCount": { "type": ["integer", "null"], "minimum": 3, "maximum": 4 },
            "comparisonAuthorityRef": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resume": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs", "selectedAlternativeId"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "pattern": "^receipt:" },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" },
                "selectedAlternativeId": {
                  "type": ["string", "null"],
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "intent": { "const": "create" } }, "required": ["intent"] },
          "then": { "properties": { "changeLevel": { "const": "new" } } }
        },
        {
          "if": { "properties": { "changeLevel": { "const": "new" } }, "required": ["changeLevel"] },
          "then": { "properties": { "intent": { "const": "create" } } }
        },
        {
          "if": { "properties": { "changeLevel": { "const": "refine" } }, "required": ["changeLevel"] },
          "then": {
            "properties": {
              "approvedDirection": { "type": "null" },
              "decisionPolicy": {
                "properties": {
                  "mode": { "const": "preserve" },
                  "alternativeCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "approvedDirection": { "type": "object" } }, "required": ["approvedDirection"] },
          "then": {
            "properties": {
              "decisionPolicy": {
                "properties": {
                  "mode": { "const": "preserve" },
                  "alternativeCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "decisionPolicy": { "properties": { "mode": { "const": "compare" } } } },
            "required": ["decisionPolicy"]
          },
          "then": {
            "properties": {
              "decisionPolicy": {
                "properties": {
                  "alternativeCount": { "type": "integer", "minimum": 3, "maximum": 4 },
                  "comparisonAuthorityRef": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "else": {
            "properties": {
              "decisionPolicy": {
                "properties": {
                  "alternativeCount": { "type": "null" },
                  "comparisonAuthorityRef": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "sourceHead": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptRef", "fingerprint", "status", "projectId", "scopeRef"],
      "properties": {
        "receiptRef": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "status": { "const": "accepted" },
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "scopeRef": { "type": "string", "minLength": 1 }
      }
    },
    "grammarBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageRef", "manifestRef", "fingerprint", "status", "exportRefs"],
      "properties": {
        "packageRef": { "type": "string", "minLength": 1 },
        "manifestRef": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "status": { "const": "published" },
        "exportRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
