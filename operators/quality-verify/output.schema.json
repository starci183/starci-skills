{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/quality-verify/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "quality.verify" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["verified", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gate": {
      "enum": [
        "format",
        "lint",
        "typecheck",
        "build",
        "unit-coverage",
        "integration",
        "e2e",
        "sonar"
      ]
    },
    "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "verification",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "quality-verification" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "verification": {
          "oneOf": [{ "$ref": "#/$defs/verification" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "sourceRef",
        "sourceHead",
        "artifactRootRef",
        "deliveryId",
        "deliveryKind",
        "predecessorRefs",
        "predecessorFingerprint",
        "gatePlanFingerprint",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "sourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "deliveryId": { "type": "string", "minLength": 1 },
        "deliveryKind": { "enum": ["backend", "frontend", "shared", "content"] },
        "predecessorRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "predecessorFingerprint": { "$ref": "#/$defs/fingerprint" },
        "gatePlanFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannedGates",
        "requiredGates",
        "results",
        "coverage",
        "sonarScope",
        "debts",
        "verdict"
      ],
      "properties": {
        "plannedGates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate" }
        },
        "requiredGates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result" }
        },
        "coverage": {
          "oneOf": [{ "$ref": "#/$defs/coverage" }, { "type": "null" }]
        },
        "sonarScope": {
          "oneOf": [{ "enum": ["new-code", "overall"] }, { "type": "null" }]
        },
        "debts": { "type": "array", "items": { "$ref": "#/$defs/debt" } },
        "verdict": { "enum": ["pass", "fail"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "commandRef",
        "evidenceRef",
        "exitCode",
        "classification",
        "statement"
      ],
      "properties": {
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "enum": ["pass", "fail", "external-blocker", "skipped-not-requested"] },
        "commandRef": { "type": "string", "minLength": 1 },
        "evidenceRef": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "exitCode": {
          "oneOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "classification": {
          "oneOf": [
            { "enum": ["in-boundary", "boundary-drift", "flaky", "external-blocker"] },
            { "type": "null" }
          ]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statements", "lines", "functions", "branches", "thresholds", "evidenceRef"],
      "properties": {
        "statements": { "$ref": "#/$defs/percentage" },
        "lines": { "$ref": "#/$defs/percentage" },
        "functions": { "$ref": "#/$defs/percentage" },
        "branches": { "$ref": "#/$defs/percentage" },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statements", "lines", "functions", "branches"],
          "properties": {
            "statements": { "$ref": "#/$defs/percentage" },
            "lines": { "$ref": "#/$defs/percentage" },
            "functions": { "$ref": "#/$defs/percentage" },
            "branches": { "$ref": "#/$defs/percentage" }
          }
        },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["debtId", "gate", "approvalRef", "ownerRef", "expiresAt", "statement"],
      "properties": {
        "debtId": { "type": "string", "minLength": 1 },
        "gate": { "$ref": "#/$defs/gate" },
        "approvalRef": { "type": "string", "minLength": 1 },
        "ownerRef": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "gate", "statement"],
      "properties": {
        "code": {
          "enum": [
            "PREDECESSOR_CONSUMED",
            "SONAR_NEW_CODE_ONLY",
            "E2E_NOT_REQUESTED",
            "COVERAGE_BELOW_THRESHOLD",
            "FLAKY_CONFIRMED",
            "DEBT_DECLARED"
          ]
        },
        "gate": {
          "oneOf": [{ "$ref": "#/$defs/gate" }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "gates", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "PREDECESSOR_MIXED",
            "PREDECESSOR_STALE",
            "GATE_UNAVAILABLE",
            "DEBT_UNAPPROVED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["backend", "frontend", "platform", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
