{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://starci.dev/v6/operators/be/repair-prerequisite-check/output.schema.json",
  "title":"be/repair-prerequisite-check operator output",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","runId","stage","status","facts","payload"],
  "allOf":[{"oneOf":[
    {"properties":{"stage":{"const":"be.coding-scope"},"status":{"const":"ready"},"payload":{"properties":{"decision":{"const":"ready"}}}}},
    {"properties":{"stage":{"const":"request.received"},"status":{"const":"ready"},"payload":{"properties":{"decision":{"const":"route-required"}}}}},
    {"properties":{"stage":{"const":"business.freshness"},"status":{"const":"ready"},"payload":{"properties":{"decision":{"const":"business-refresh-required"}}}}},
    {"properties":{"stage":{"const":"architecture.boundary"},"status":{"const":"ready"},"payload":{"properties":{"decision":{"const":"replan-required"}}}}},
    {"properties":{"stage":{"const":"be.blocked"},"status":{"const":"blocked"},"payload":{"properties":{"decision":{"const":"blocked"}}}}}
  ]}],
  "properties":{
    "schemaVersion":{"const":6},"runId":{"type":"string","minLength":1},
    "stage":{"enum":["be.coding-scope","request.received","business.freshness","architecture.boundary","be.blocked"]},
    "status":{"enum":["ready","blocked"]},"facts":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "payload":{"type":"object","additionalProperties":false,"required":["decision","state","produced","context","cleanup","evidenceRefs","findings"],"properties":{
      "decision":{"enum":["ready","route-required","business-refresh-required","replan-required","blocked"]},
      "state":{"type":"object","additionalProperties":false,"required":["operator","status","code","retryable","emits"],"properties":{
        "operator":{"const":"be/repair-prerequisite-check"},"status":{"enum":["completed","replan","blocked"]},
        "code":{"enum":["repair-prerequisites-ready","repair-route-required","repair-business-refresh-required","repair-boundary-replan-required","repair-prerequisites-blocked"]},
        "retryable":{"type":"boolean"},"emits":{"type":"object","additionalProperties":false,"required":["stage","status","factsAdd"],"properties":{
          "stage":{"enum":["be.coding-scope","request.received","business.freshness","architecture.boundary","be.blocked"]},"status":{"enum":["ready","blocked"]},
          "factsAdd":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }}
      }},
      "produced":{"type":"object","additionalProperties":false,"required":["prerequisiteReceiptRef"],"properties":{"prerequisiteReceiptRef":{"anyOf":[{"$ref":"#/$defs/sessionRef"},{"type":"null"}]}}},
      "context":{"type":"object","additionalProperties":false,"required":["used"],"properties":{"used":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["kind","ref","revision"],"properties":{"kind":{"enum":["route-metadata","business-freshness","approved-boundary","repair-finding"]},"ref":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1}}}}}},
      "cleanup":{"type":"object","additionalProperties":false,"required":["scratchRefs","retention","purgeAt"],"properties":{"scratchRefs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/sessionRef"}},"retention":{"const":"until-skill-terminal"},"purgeAt":{"const":"skill-terminal"}}},
      "evidenceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sessionRef"}},
      "findings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
    }}
  },
  "$defs":{"sessionRef":{"type":"string","pattern":"^session://tasks/[A-Za-z0-9._-]+/.+$"}}
}
