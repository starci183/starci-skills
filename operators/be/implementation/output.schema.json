{
  "$id": "https://starci.dev/v6/operators/be/implementation/output.schema.json",
  "title": "be/implementation operator output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": { "const": "quality.format" },
            "status": { "const": "ready" }
          },
          "required": ["stage", "status"]
        },
        {
          "properties": {
            "stage": { "const": "architecture.boundary" },
            "status": { "const": "ready" }
          },
          "required": ["stage", "status"]
        },
        {
          "properties": {
            "stage": { "const": "be.blocked" },
            "status": { "const": "blocked" }
          },
          "required": ["stage", "status"]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["quality.format", "architecture.boundary", "be.blocked"] },
    "status": { "enum": ["ready", "blocked"] },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["ready", "source-drift", "boundary-drift", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "status", "code", "retryable", "emits"],
          "properties": {
            "operator": { "const": "be/implementation" },
            "status": { "enum": ["completed", "replan", "blocked"] },
            "code": {
              "enum": [
                "implementation-complete",
                "source-revision-drift",
                "approved-boundary-insufficient",
                "required-binding-unavailable"
              ]
            },
            "retryable": { "type": "boolean" },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status", "factsAdd"],
              "properties": {
                "stage": { "enum": ["quality.format", "architecture.boundary", "be.blocked"] },
                "status": { "enum": ["ready", "blocked"] },
                "factsAdd": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changeReceiptRef", "mutations"],
          "properties": {
            "changeReceiptRef": {
              "anyOf": [
                { "$ref": "#/$defs/sessionRef" },
                { "type": "null" }
              ]
            },
            "mutations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "beforeSha256", "afterSha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "beforeSha256": { "$ref": "#/$defs/sha256" },
                  "afterSha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref", "revision"],
                "properties": {
                  "kind": { "enum": ["worktree-business", "session-boundary", "qdrant-knowledge", "exact-source"] },
                  "ref": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scratchRefs", "retention", "purgeAt"],
          "properties": {
            "scratchRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/sessionRef" }
            },
            "retention": { "const": "until-skill-terminal" },
            "purgeAt": { "const": "skill-terminal" }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sessionRef" }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
