{
  "$id": "https://starci.dev/v6/operators/be/implementation/input.schema.json",
  "title": "be/implementation operator input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": { "const": "architecture.boundary.review" },
            "status": { "const": "approved" }
          },
          "required": ["stage", "status"]
        },
        {
          "properties": {
            "stage": { "const": "be.repair" },
            "status": { "const": "ready" }
          },
          "required": ["stage", "status"]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["architecture.boundary.review", "be.repair"] },
    "status": { "enum": ["approved", "ready"] },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "description": "References supplied by the previous machine state. The operator must not replace or broaden them.",
          "additionalProperties": false,
          "required": ["approvedBoundaryRef", "approvalReceiptRef", "businessHeadRef", "baselineCommitRef"],
          "properties": {
            "approvedBoundaryRef": { "$ref": "#/$defs/sessionRef" },
            "approvalReceiptRef": { "$ref": "#/$defs/sessionRef" },
            "businessHeadRef": { "$ref": "#/$defs/sessionRef" },
            "baselineCommitRef": { "type": "string", "pattern": "^git:[0-9a-f]{7,64}$" }
          }
        },
        "loads": {
          "type": "object",
          "description": "Bindings resolved by the runtime. These fields declare what will be loaded; they are not caller-controlled content.",
          "additionalProperties": false,
          "required": ["business", "boundary", "knowledge", "source", "orchestration"],
          "properties": {
            "business": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "authorityPath", "revision"],
              "properties": {
                "ref": { "$ref": "#/$defs/sessionRef" },
                "authorityPath": { "type": "string", "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]*/businesses/" },
                "revision": { "$ref": "#/$defs/sha256" }
              }
            },
            "boundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "revision"],
              "properties": {
                "ref": { "$ref": "#/$defs/sessionRef" },
                "revision": { "$ref": "#/$defs/sha256" }
              }
            },
            "knowledge": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "generation", "contentSha256", "loadMode"],
                "properties": {
                  "id": { "const": "be.implementation" },
                  "generation": { "type": "string", "minLength": 1 },
                  "contentSha256": { "$ref": "#/$defs/sha256" },
                  "loadMode": { "const": "qdrant-exact" }
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["loadMode", "repositoryContext", "targetFiles"],
              "properties": {
                "loadMode": { "const": "exact-files" },
                "repositoryContext": { "const": false },
                "targetFiles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "beforeSha256", "allowedChanges"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "beforeSha256": { "$ref": "#/$defs/sha256" },
                      "allowedChanges": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "profileRef", "providerRef"],
              "properties": {
                "mode": { "enum": ["economical", "balanced", "parallel"] },
                "profileRef": {
                  "enum": [
                    "orchestration/modes/economical.json",
                    "orchestration/modes/balanced.json",
                    "orchestration/modes/parallel.json"
                  ]
                },
                "providerRef": { "type": "string", "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$" }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "description": "Ephemeral task-local storage. No value in this object is a filesystem persistence path.",
          "additionalProperties": false,
          "required": ["taskId", "inputRef", "outputRef", "scratchPrefix", "retention"],
          "properties": {
            "taskId": { "type": "string", "minLength": 1 },
            "inputRef": { "$ref": "#/$defs/sessionRef" },
            "outputRef": { "$ref": "#/$defs/sessionRef" },
            "scratchPrefix": { "$ref": "#/$defs/sessionRef" },
            "retention": { "const": "until-skill-terminal" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
