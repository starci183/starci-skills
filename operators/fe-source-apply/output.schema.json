{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-source-apply/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.source.apply" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["applied", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "sourcePath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
    "nodePath": { "type": "string", "minLength": 1 },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "application",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "fe-source-application" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["applied", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "application": {
          "oneOf": [{ "$ref": "#/$defs/application" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "frontendSourceRef",
        "sourceHead",
        "artifactRootRef",
        "targetId",
        "resolutionReceiptRef",
        "resolutionFingerprint",
        "mutableOwners",
        "observationOnlyOwnerRefs",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "frontendSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "resolutionReceiptRef": { "type": "string", "minLength": 1 },
        "resolutionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "mutableOwners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ownerRef", "rootPath"],
            "properties": {
              "ownerRef": { "type": "string", "minLength": 1 },
              "rootPath": { "$ref": "#/$defs/sourcePath" }
            }
          }
        },
        "observationOnlyOwnerRefs": { "$ref": "#/$defs/refArray" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appliedResolution",
        "contractEmission",
        "declaredWriteSet",
        "writes",
        "resolutionClassNames",
        "appliedRuleIds"
      ],
      "properties": {
        "appliedResolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receiptRef", "fingerprint", "resolvedTreeRef", "resolvedTreeFingerprint"],
          "properties": {
            "receiptRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "resolvedTreeRef": { "type": "string", "minLength": 1 },
            "resolvedTreeFingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "contractEmission": { "enum": ["attribute", "receipt-only"] },
        "declaredWriteSet": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "ownerRef", "intent"],
            "properties": {
              "path": { "$ref": "#/$defs/sourcePath" },
              "ownerRef": { "type": "string", "minLength": 1 },
              "intent": { "enum": ["create", "modify"] }
            }
          }
        },
        "writes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/write" }
        },
        "resolutionClassNames": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "appliedRuleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "ownerRef",
        "action",
        "fingerprintBefore",
        "fingerprintAfter",
        "nodePaths",
        "classNames",
        "ruleIds",
        "contractAttributeWritten"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/sourcePath" },
        "ownerRef": { "type": "string", "minLength": 1 },
        "action": { "enum": ["created", "modified", "unchanged"] },
        "fingerprintBefore": {
          "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
        },
        "fingerprintAfter": { "$ref": "#/$defs/fingerprint" },
        "nodePaths": { "type": "array", "items": { "$ref": "#/$defs/nodePath" } },
        "classNames": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ruleIds": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
        "contractAttributeWritten": { "type": "boolean" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "statement"],
      "properties": {
        "code": {
          "enum": [
            "FILE_CREATED",
            "FILE_UNCHANGED",
            "CONTRACT_ATTRIBUTE_WRITTEN",
            "CONTRACT_ATTRIBUTE_OMITTED",
            "WRITE_SET_PATH_UNUSED"
          ]
        },
        "path": { "$ref": "#/$defs/sourcePath" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "paths", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "OWNER_CONFLICT",
            "RESOLUTION_STALE",
            "WRITE_REJECTED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "paths": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["frontend", "resolution", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
