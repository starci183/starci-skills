{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-source-apply/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.source.apply" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "sourceRefs", "directionRefs", "auditRefs"],
      "properties": {
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptRef",
            "receiptId",
            "fingerprint",
            "resolvedTreeRef",
            "resolvedTreeFingerprint",
            "contractEmission",
            "classNames",
            "appliedRuleIds"
          ],
          "properties": {
            "receiptRef": { "type": "string", "minLength": 1 },
            "receiptId": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "resolvedTreeRef": { "type": "string", "minLength": 1 },
            "resolvedTreeFingerprint": { "$ref": "#/$defs/fingerprint" },
            "contractEmission": { "enum": ["attribute", "receipt-only"] },
            "classNames": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "appliedRuleIds": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/ruleId" }
            }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "directionRefs": { "$ref": "#/$defs/contextRefArray" },
        "auditRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "target",
        "resolution",
        "scope",
        "writeSet",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "frontendSourceRef", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "frontendSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "ownerRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["page", "layout", "modal", "drawer", "flow", "block", "component"] },
            "ownerRef": { "type": "string", "minLength": 1 }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receiptRef", "fingerprint"],
          "properties": {
            "receiptRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutableOwners", "observationOnlyOwnerRefs"],
          "properties": {
            "mutableOwners": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/mutableOwner" }
            },
            "observationOnlyOwnerRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "writeSet": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/writeSetEntry" }
        },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "sourcePath": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\][^\\\\]*$" },
    "mutableOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerRef", "rootPath"],
      "properties": {
        "ownerRef": { "type": "string", "minLength": 1 },
        "rootPath": { "$ref": "#/$defs/sourcePath" }
      }
    },
    "writeSetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "ownerRef", "intent"],
      "properties": {
        "path": { "$ref": "#/$defs/sourcePath" },
        "ownerRef": { "type": "string", "minLength": 1 },
        "intent": { "enum": ["create", "modify"] }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
