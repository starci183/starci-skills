{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-surface-audit/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.surface.audit" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "applied", "sourceRefs", "auditRefs"],
      "properties": {
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexRef", "fingerprint", "topics"],
          "properties": {
            "indexRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/knowledgeTopic" }
            }
          }
        },
        "applied": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receiptRef",
            "receiptId",
            "fingerprint",
            "appliedSourceHead",
            "contractEmission",
            "claims"
          ],
          "properties": {
            "receiptRef": { "type": "string", "minLength": 1 },
            "receiptId": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "appliedSourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "contractEmission": { "enum": ["attribute", "receipt-only"] },
            "claims": {
              "type": "array",
              "items": { "$ref": "#/$defs/claim" }
            }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "auditRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "target",
        "runtime",
        "matrix",
        "scope",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "frontendSourceRef", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "frontendSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "ownerRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["page", "layout", "modal", "drawer", "flow", "block", "component"] },
            "ownerRef": { "type": "string", "minLength": 1 }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpointRef", "routePath", "readinessProbe"],
          "properties": {
            "endpointRef": { "type": "string", "minLength": 1 },
            "routePath": { "type": "string", "minLength": 1, "pattern": "^/" },
            "readinessProbe": { "enum": ["route-served", "route-and-data-served"] }
          }
        },
        "matrix": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/matrixEntry" }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observedOwnerRefs"],
          "properties": {
            "observedOwnerRefs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "rulePrefix": { "type": "string", "pattern": "^[A-Z][A-Z-]*[A-Z]$" },
    "claimedIdentifier": { "type": "string", "minLength": 1 },
    "nodePath": { "type": "string", "minLength": 1 },
    "knowledgeTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "ref", "fingerprint", "rulePrefix", "ruleIds"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "rulePrefix": { "$ref": "#/$defs/rulePrefix" },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodePath", "claimedIdentifiers"],
      "properties": {
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "claimedIdentifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimedIdentifier" }
        }
      }
    },
    "matrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "viewportWidth", "viewportHeight", "colorScheme", "state"],
      "properties": {
        "matrixId": { "type": "string", "minLength": 1 },
        "viewportWidth": { "type": "integer", "minimum": 240 },
        "viewportHeight": { "type": "integer", "minimum": 240 },
        "colorScheme": { "enum": ["light", "dark"] },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
