{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/fe-surface-audit/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "fe.surface.audit" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["audited", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z-]*-(?:[0-9]+|AUTO)$" },
    "claimedIdentifier": { "type": "string", "minLength": 1 },
    "nodePath": { "type": "string", "minLength": 1 },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "baseVerdict": {
      "enum": [
        "PASS",
        "COMMON_CAPABILITY_MISSING",
        "COMMON_IMPLEMENTATION_GLITCH",
        "FAMILY_OVERRIDE_GLITCH",
        "APP_REIMPLEMENTATION",
        "APP_OVERRIDE",
        "APP_WORKAROUND",
        "PROOF_MISSING"
      ]
    },
    "causeTag": {
      "enum": [
        "VALUE_DRIFT",
        "VENDOR_LEAK",
        "WRONG_OWNER",
        "OFF_SCALE_VALUE",
        "DOUBLE_OWNER",
        "PHYSICAL_SIDE_DRIFT",
        "STATE_OR_VIEWPORT_DRIFT"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "audit",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "fe-surface-audit" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["audited", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "audit": {
          "oneOf": [{ "$ref": "#/$defs/audit" }, { "type": "null" }]
        },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "frontendSourceRef",
        "sourceHead",
        "artifactRootRef",
        "targetId",
        "appliedReceiptRef",
        "appliedFingerprint",
        "appliedSourceHead",
        "knowledgeFingerprint",
        "boundRuleIds",
        "runtimeEndpointRef",
        "routePath",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "frontendSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 },
        "appliedReceiptRef": { "type": "string", "minLength": 1 },
        "appliedFingerprint": { "$ref": "#/$defs/fingerprint" },
        "appliedSourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "knowledgeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "boundRuleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        },
        "runtimeEndpointRef": { "type": "string", "minLength": 1 },
        "routePath": { "type": "string", "minLength": 1, "pattern": "^/" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captures", "observations", "findings"],
      "properties": {
        "captures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capture" }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixId",
        "evidenceRef",
        "fingerprint",
        "viewportWidth",
        "viewportHeight",
        "colorScheme",
        "state",
        "observedAt"
      ],
      "properties": {
        "matrixId": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "viewportWidth": { "type": "integer", "minimum": 240 },
        "viewportHeight": { "type": "integer", "minimum": 240 },
        "colorScheme": { "enum": ["light", "dark"] },
        "state": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixId",
        "nodePath",
        "property",
        "measuredValue",
        "claimedRuleIds",
        "unknownClaimedIdentifiers"
      ],
      "properties": {
        "matrixId": { "type": "string", "minLength": 1 },
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "property": { "type": "string", "minLength": 1 },
        "measuredValue": { "type": "string", "minLength": 1 },
        "claimedRuleIds": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
        "unknownClaimedIdentifiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimedIdentifier" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "matrixId",
        "nodePath",
        "property",
        "verdict",
        "causeTags",
        "ruleId",
        "claimedIdentifier",
        "evidenceRef",
        "statement"
      ],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "matrixId": { "type": "string", "minLength": 1 },
        "nodePath": { "$ref": "#/$defs/nodePath" },
        "property": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/baseVerdict" },
        "causeTags": { "type": "array", "items": { "$ref": "#/$defs/causeTag" } },
        "ruleId": {
          "oneOf": [{ "$ref": "#/$defs/ruleId" }, { "type": "null" }]
        },
        "claimedIdentifier": {
          "oneOf": [{ "$ref": "#/$defs/claimedIdentifier" }, { "type": "null" }]
        },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "matrixIds", "nodePaths", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "RUNTIME_UNAVAILABLE",
            "EVIDENCE_MISSING",
            "UNKNOWN_RULE",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "matrixIds": { "$ref": "#/$defs/refArray" },
        "nodePaths": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["frontend", "knowledge", "runtime", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
