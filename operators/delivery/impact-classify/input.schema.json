{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/delivery/impact-classify/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "delivery/impact-classify"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "business",
        "knowledge",
        "sourceMetadata"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exactBinding"
          },
          "description": "artifacts bound to this atomic job."
        },
        "business": {
          "$ref": "#/$defs/exactBinding",
          "description": "business bound to this atomic job."
        },
        "knowledge": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/knowledgeBinding"
          },
          "description": "knowledge bound to this atomic job."
        },
        "sourceMetadata": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "headCommitRef",
              "contentVisible",
              "loadMode"
            ],
            "properties": {
              "role": {
                "enum": [
                  "fe",
                  "be",
                  "chart",
                  "shared"
                ]
              },
              "headCommitRef": {
                "$ref": "#/$defs/gitRef"
              },
              "contentVisible": {
                "const": false
              },
              "loadMode": {
                "const": "metadata-only"
              }
            }
          },
          "description": "sourceMetadata bound to this atomic job."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionRef",
        "businessHeadRef",
        "routeReceiptSetRef"
      ],
      "properties": {
        "missionRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "missionRef bound to this atomic job."
        },
        "businessHeadRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "businessHeadRef bound to this atomic job."
        },
        "routeReceiptSetRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "routeReceiptSetRef bound to this atomic job."
        }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "gitRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "exactBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "revision", "loadMode"],
      "properties": {
        "ref": { "$ref": "#/$defs/sessionRef" },
        "revision": { "$ref": "#/$defs/sha256" },
        "loadMode": { "const": "session-exact" }
      }
    },
    "knowledgeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "generation", "contentSha256", "loadMode"],
      "properties": {
        "id": { "const": "architecture.decision-analysis" },
        "generation": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "loadMode": { "const": "default-search" }
      }
    }
  }
}
