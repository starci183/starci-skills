{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/delivery/impact-classify/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "delivery/impact-classify"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "evidenceRefs"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "backend-required",
            "frontend-only",
            "blocked"
          ],
          "description": "Typed atomic result consumed only by the parent Skill machine."
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "description": "Evidence references supporting this result."
        }
      }
    }
  }
}
