{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/delivery/mission-proof/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "delivery/mission-proof"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "knowledge"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/binding"
          },
          "description": "artifacts bound to this atomic job."
        },
        "knowledge": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/knowledge"
          },
          "description": "knowledge bound to this atomic job."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionRef",
        "impactReceiptRef",
        "frontendProductProofRef",
        "backendDeliveryProofRef",
        "businessHeadRef",
        "finalSourceHeadsRef"
      ],
      "properties": {
        "missionRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "missionRef bound to this atomic job."
        },
        "impactReceiptRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "impactReceiptRef bound to this atomic job."
        },
        "frontendProductProofRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "frontendProductProofRef bound to this atomic job."
        },
        "backendDeliveryProofRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/sessionRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "backendDeliveryProofRef bound to this atomic job."
        },
        "businessHeadRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "businessHeadRef bound to this atomic job."
        },
        "finalSourceHeadsRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "finalSourceHeadsRef bound to this atomic job."
        }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "exactBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "revision", "loadMode"],
      "properties": {
        "ref": { "$ref": "#/$defs/sessionRef" },
        "revision": { "$ref": "#/$defs/sha256" },
        "loadMode": { "const": "session-exact" }
      }
    },
    "knowledgeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "generation", "contentSha256", "loadMode"],
      "properties": {
        "id": { "const": "quality.source-gates" },
        "generation": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "loadMode": { "const": "default-search" }
      }
    }
  }
}
