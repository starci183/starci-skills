{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/delivery/mission-resume/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [{ "oneOf": [
    { "properties": { "stage": { "const": "delivery.mission.resume" }, "status": { "const": "ready" }, "payload": { "properties": { "decision": { "const": "ready" }, "state": { "properties": { "status": { "const": "completed" }, "code": { "const": "delivery-mission-resume-ready" }, "emits": { "properties": { "stage": { "const": "delivery.mission.resume" }, "status": { "const": "ready" } } } } } } } } },
    { "properties": { "stage": { "const": "delivery.blocked" }, "status": { "const": "blocked" }, "payload": { "properties": { "decision": { "const": "blocked" }, "state": { "properties": { "status": { "const": "blocked" }, "code": { "const": "delivery-mission-resume-blocked" }, "emits": { "properties": { "stage": { "const": "delivery.blocked" }, "status": { "const": "blocked" } } } } } } } } }
  ] }],
  "properties": {
    "schemaVersion": { "const": 6 }, "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["delivery.mission.resume", "delivery.blocked"] }, "status": { "enum": ["ready", "blocked"] },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["ready", "blocked"] },
        "state": { "type": "object", "additionalProperties": false, "required": ["operator", "status", "code", "retryable", "emits"], "properties": { "operator": { "const": "delivery/mission-resume" }, "status": { "enum": ["completed", "blocked"] }, "code": { "enum": ["delivery-mission-resume-ready", "delivery-mission-resume-blocked"] }, "retryable": { "type": "boolean" }, "emits": { "type": "object", "additionalProperties": false, "required": ["stage", "status", "factsAdd"], "properties": { "stage": { "enum": ["delivery.mission.resume", "delivery.blocked"] }, "status": { "enum": ["ready", "blocked"] }, "factsAdd": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } } } },
        "produced": { "type": "object", "additionalProperties": false, "required": ["continuationReceiptRef"], "properties": { "continuationReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] } } },
        "context": { "type": "object", "additionalProperties": false, "required": ["used"], "properties": { "used": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/contextRef" } } } },
        "cleanup": { "type": "object", "additionalProperties": false, "required": ["scratchRefs", "retention", "purgeAt"], "properties": { "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "retention": { "const": "until-skill-terminal" }, "purgeAt": { "const": "skill-terminal" } } },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "contextRef": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "revision"], "properties": { "kind": { "const": "session-artifact" }, "ref": { "$ref": "#/$defs/sessionRef" }, "revision": { "type": "string", "minLength": 1 } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["scratchRefs", "retention", "purgeAt"], "properties": { "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "retention": { "const": "until-skill-terminal" }, "purgeAt": { "const": "skill-terminal" } } }
  }
}
