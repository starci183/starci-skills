{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/delivery/mission-resume/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "delivery/mission-resume"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/binding"
          },
          "description": "artifacts bound to this atomic job."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionRef",
        "impactReceiptRef",
        "backendDeliveryProofRef"
      ],
      "properties": {
        "missionRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "missionRef bound to this atomic job."
        },
        "impactReceiptRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "impactReceiptRef bound to this atomic job."
        },
        "backendDeliveryProofRef": {
          "$ref": "#/$defs/sessionRef",
          "description": "backendDeliveryProofRef bound to this atomic job."
        }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "exactBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "revision", "loadMode"],
      "properties": {
        "ref": { "$ref": "#/$defs/sessionRef" },
        "revision": { "$ref": "#/$defs/sha256" },
        "loadMode": { "const": "session-exact" }
      }
    }
  }
}
