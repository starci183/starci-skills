{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/platform/tunnel-plan/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/tunnel-plan" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "observedState"],
      "properties": {
        "authority": {
          "description": "Exact account, zone, owner, route revision, and credential-custody authority for this ingress.",
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "zoneId", "owner", "routeRevision", "credentialCustodyRef", "evidenceRef"],
          "properties": {
            "accountId": { "$ref": "#/$defs/id" },
            "zoneId": { "$ref": "#/$defs/id" },
            "owner": { "$ref": "#/$defs/id" },
            "routeRevision": { "type": "string", "minLength": 1 },
            "credentialCustodyRef": { "type": "string", "minLength": 1 },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "observedState": {
          "description": "Value-safe current metadata for only the declared tunnel, hostname, DNS record, and origin.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tunnel", "dns", "route", "evidenceRefs"],
          "properties": {
            "tunnel": { "anyOf": [{ "$ref": "#/$defs/tunnel" }, { "type": "null" }] },
            "dns": { "anyOf": [{ "$ref": "#/$defs/dns" }, { "type": "null" }] },
            "route": { "anyOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedIngress"],
      "properties": {
        "requestedIngress": {
          "description": "The single desired tunnel, hostname, origin, and protocol tuple to plan.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tunnelId", "hostname", "origin", "protocol", "proxied"],
          "properties": {
            "tunnelId": { "$ref": "#/$defs/id" },
            "hostname": { "$ref": "#/$defs/hostname" },
            "origin": { "$ref": "#/$defs/origin" },
            "protocol": { "enum": ["http", "https"] },
            "proxied": { "const": true }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "hostname": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
    "origin": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "tunnel": {
      "type": "object", "additionalProperties": false,
      "required": ["tunnelId", "owner", "revision"],
      "properties": { "tunnelId": { "$ref": "#/$defs/id" }, "owner": { "$ref": "#/$defs/id" }, "revision": { "type": "string", "minLength": 1 } }
    },
    "dns": {
      "type": "object", "additionalProperties": false,
      "required": ["hostname", "target", "proxied", "owner", "revision"],
      "properties": { "hostname": { "$ref": "#/$defs/hostname" }, "target": { "type": "string", "minLength": 1 }, "proxied": { "type": "boolean" }, "owner": { "$ref": "#/$defs/id" }, "revision": { "type": "string", "minLength": 1 } }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["hostname", "origin", "owner", "revision"],
      "properties": { "hostname": { "$ref": "#/$defs/hostname" }, "origin": { "$ref": "#/$defs/origin" }, "owner": { "$ref": "#/$defs/id" }, "revision": { "type": "string", "minLength": 1 } }
    }
  }
}
