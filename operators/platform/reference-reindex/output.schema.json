{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/platform/reference-reindex/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [{ "oneOf": [
    { "properties": { "status": { "const": "ready" }, "payload": { "properties": {
      "decision": { "const": "ready" },
      "state": { "properties": { "status": { "const": "completed" }, "code": { "const": "platform-reference-index-ready" }, "emits": { "properties": { "status": { "const": "ready" } } } } }
    } } } },
    { "properties": { "status": { "const": "blocked" }, "payload": { "properties": {
      "decision": { "const": "blocked" },
      "state": { "properties": { "status": { "const": "blocked" }, "code": { "const": "platform-reference-index-blocked" }, "emits": { "properties": { "status": { "const": "blocked" } } } } },
      "findings": { "minItems": 1 }
    } } } }
  ] }],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "platform.mcp.publish" },
    "status": { "enum": ["ready", "blocked"] },
    "facts": { "$ref": "#/$defs/strings" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["ready", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "status", "code", "retryable", "emits"],
          "properties": {
            "operator": { "const": "platform/reference-reindex" },
            "status": { "enum": ["completed", "blocked"] },
            "code": { "enum": ["platform-reference-index-ready", "platform-reference-index-blocked"] },
            "retryable": { "type": "boolean" },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status", "factsAdd"],
              "properties": {
                "stage": { "const": "platform.mcp.publish" },
                "status": { "enum": ["ready", "blocked"] },
                "factsAdd": { "$ref": "#/$defs/strings" }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "runtime", "references", "durableWrites"],
          "properties": {
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision", "strategy", "manualFull", "incrementalCostCeiling", "maxAffectedRecordRatio", "maxDeleteRatio"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "revision": { "$ref": "#/$defs/sha256" },
                "strategy": { "const": "adaptive-budget" },
                "manualFull": { "type": "boolean" },
                "incrementalCostCeiling": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "maxAffectedRecordRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "maxDeleteRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stateRoot", "codexUrl", "clientAction", "protocolProved", "queryProved"],
              "properties": {
                "stateRoot": { "const": ".workspaces/local/state/reference-context" },
                "codexUrl": { "type": "string", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost):[0-9]+/mcp/?$" },
                "clientAction": { "enum": ["unchanged", "merged", "not-committed"] },
                "protocolProved": { "type": "boolean" },
                "queryProved": { "type": "boolean" }
              }
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "beforeRevision", "afterRevision", "action", "reason", "generation", "metrics"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "beforeRevision": { "type": ["string", "null"], "minLength": 1 },
                  "afterRevision": { "type": ["string", "null"], "minLength": 1 },
                  "action": { "enum": ["noop", "incremental", "full", "not-committed"] },
                  "reason": { "enum": ["no-eligible-drift", "compatible-delta", "manual-full", "generation-missing-or-corrupt", "index-contract-changed", "history-not-comparable", "incremental-cost-crossed", "affected-record-budget-crossed", "delete-budget-crossed", "blocked"] },
                  "generation": { "type": ["string", "null"], "minLength": 1 },
                  "metrics": { "$ref": "#/$defs/metrics" }
                }
              }
            },
            "durableWrites": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref", "revision"],
                "properties": {
                  "kind": { "enum": ["session-artifact", "reference-worktree", "qdrant-partition", "local-runtime", "drift-policy"] },
                  "ref": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scratchRefs", "retention", "purgeAt"],
          "properties": {
            "scratchRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
            "retention": { "const": "until-skill-terminal" },
            "purgeAt": { "const": "skill-terminal" }
          }
        },
        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "$ref": "#/$defs/strings" }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "strings": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addedFiles", "modifiedFiles", "deletedFiles", "unchangedFiles", "changedBytes", "totalBytes", "affectedRecords", "totalRecords", "incrementalCost", "fullCost", "deleteRatio", "affectedRecordRatio"],
      "properties": {
        "addedFiles": { "type": "integer", "minimum": 0 },
        "modifiedFiles": { "type": "integer", "minimum": 0 },
        "deletedFiles": { "type": "integer", "minimum": 0 },
        "unchangedFiles": { "type": "integer", "minimum": 0 },
        "changedBytes": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "affectedRecords": { "type": "integer", "minimum": 0 },
        "totalRecords": { "type": "integer", "minimum": 0 },
        "incrementalCost": { "type": "number", "minimum": 0 },
        "fullCost": { "type": "number", "exclusiveMinimum": 0 },
        "deleteRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "affectedRecordRatio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
