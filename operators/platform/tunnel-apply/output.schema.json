{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/platform/tunnel-apply/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/tunnel-apply" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "receiptRef", "mutations", "checks", "reason", "evidenceRefs"],
      "properties": {
        "outcome": { "enum": ["proved", "blocked"], "description": "Observed convergence result; only the Skill machine chooses the next state." },
        "receiptRef": { "type": ["string", "null"], "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$", "description": "Fresh convergence proof when proved; otherwise null." },
        "mutations": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation" }, "description": "Every coordinator-owned Cloudflare mutation with before and after revisions; empty for an idempotent no-op." },
        "checks": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/check" }, "description": "Exactly the DNS target, tunnel route, TLS, and public HTTPS postcondition checks." },
        "reason": { "type": ["string", "null"], "enum": [null, "authority-drift", "concurrent-drift", "execution-failed", "proof-failed"], "description": "One bounded failure reason when blocked; null when proved." },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs", "description": "Approval, execution, resource revision, and postcondition evidence." }
      }
    }
  },
  "$defs": {
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "resourceRef", "beforeRevision", "afterRevision"],
      "properties": {
        "effect": { "enum": ["create-tunnel", "update-tunnel-route", "upsert-proxied-dns"] },
        "resourceRef": { "type": "string", "minLength": 1 },
        "beforeRevision": { "type": ["string", "null"], "minLength": 1 },
        "afterRevision": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidenceRef"],
      "properties": {
        "name": { "enum": ["dns-target", "tunnel-route", "tls", "public-https"] },
        "status": { "enum": ["passed", "failed"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
