{
  "$id": "https://starci.dev/v6/operators/platform/tunnel-apply/output.schema.json", "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "platform/tunnel-apply operator output",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 }, "runId": { "type": "string", "minLength": 1 }, "stage": { "enum": ["platform.tunnel.proved", "platform.blocked"] }, "status": { "enum": ["complete", "blocked"] }, "facts": { "$ref": "#/$defs/strings" },
    "payload": { "type": "object", "additionalProperties": false, "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"], "properties": {
      "decision": { "enum": ["proved", "blocked"] },
      "state": { "type": "object", "additionalProperties": false, "required": ["operator", "status", "code", "retryable", "emits"], "properties": { "operator": { "const": "platform/tunnel-apply" }, "status": { "enum": ["completed", "blocked"] }, "code": { "enum": ["platform-tunnel-apply-proved", "platform-tunnel-apply-blocked"] }, "retryable": { "type": "boolean" }, "emits": { "type": "object", "additionalProperties": false, "required": ["stage", "status", "factsAdd", "factsRemove"], "properties": { "stage": { "enum": ["platform.tunnel.proved", "platform.blocked"] }, "status": { "enum": ["complete", "blocked"] }, "factsAdd": { "$ref": "#/$defs/strings" }, "factsRemove": { "$ref": "#/$defs/strings" } } } } },
      "produced": { "type": "object", "additionalProperties": false, "required": ["tunnelReceiptRef", "artifacts", "mutations"], "properties": { "tunnelReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] }, "artifacts": { "$ref": "#/$defs/artifacts" }, "mutations": { "$ref": "#/$defs/mutations" } } },
      "context": { "type": "object", "additionalProperties": false, "required": ["used"], "properties": { "used": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/contextUse" } } } },
      "cleanup": { "type": "object", "additionalProperties": false, "required": ["taskId", "scratchRefs", "retention", "purgeAt"], "properties": { "taskId": { "type": "string", "minLength": 1 }, "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "retention": { "const": "until-skill-terminal" }, "purgeAt": { "const": "skill-terminal" } } },
      "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "findings": { "$ref": "#/$defs/strings" }
    } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }, "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "contextUse": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "revision"], "properties": { "kind": { "enum": ["session-artifact", "qdrant-knowledge", "exact-source", "exact-command", "external-resource", "credential-handle", "orchestration"] }, "ref": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } },
    "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256"], "properties": { "kind": { "enum": ["receipt", "evidence", "report"] }, "ref": { "$ref": "#/$defs/sessionRef" }, "sha256": { "$ref": "#/$defs/sha256" } } } },
    "mutations": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["target", "kind", "beforeRevision", "afterRevision", "appliedBy"], "properties": { "target": { "type": "string", "minLength": 1 }, "kind": { "enum": ["provider", "record"] }, "beforeRevision": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }, "afterRevision": { "type": "string", "minLength": 1 }, "appliedBy": { "const": "coordinator" } } } }
  }
}
