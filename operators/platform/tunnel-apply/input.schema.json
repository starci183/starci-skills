{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/platform/tunnel-apply/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/tunnel-apply" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedPlan", "approval", "credentialCapability", "observedState"],
      "properties": {
        "approvedPlan": {
          "description": "Exact value-free tunnel plan produced for this ingress.",
          "type": "object", "additionalProperties": false,
          "required": ["ref", "sha256", "accountId", "zoneId", "tunnelId", "hostname", "origin", "protocol", "effects"],
          "properties": {
            "ref": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "accountId": { "$ref": "#/$defs/id" },
            "zoneId": { "$ref": "#/$defs/id" },
            "tunnelId": { "$ref": "#/$defs/id" },
            "hostname": { "$ref": "#/$defs/hostname" },
            "origin": { "$ref": "#/$defs/origin" },
            "protocol": { "enum": ["http", "https"] },
            "effects": { "$ref": "#/$defs/effects" }
          }
        },
        "approval": {
          "description": "Exact authorization binding the plan hash and allowed effect classes.",
          "type": "object", "additionalProperties": false,
          "required": ["ref", "planSha256", "allowedEffects", "evidenceRef"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "planSha256": { "$ref": "#/$defs/sha256" },
            "allowedEffects": { "$ref": "#/$defs/effects" },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "credentialCapability": {
          "description": "Opaque, value-free capability handle limited to the required Cloudflare writes.",
          "type": "object", "additionalProperties": false,
          "required": ["handleRef", "capabilities", "custodyEvidenceRef"],
          "properties": {
            "handleRef": { "type": "string", "minLength": 1 },
            "capabilities": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["tunnel:write", "dns:write"] } },
            "custodyEvidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "observedState": {
          "description": "Exact pre-mutation resource fingerprint and evidence for concurrency protection.",
          "type": "object", "additionalProperties": false,
          "required": ["resourceFingerprint", "evidenceRefs"],
          "properties": {
            "resourceFingerprint": { "$ref": "#/$defs/sha256" },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution"],
      "properties": {
        "execution": {
          "description": "Expected plan identity, bounded helper, and single public HTTPS probe for this convergence.",
          "type": "object", "additionalProperties": false,
          "required": ["expectedPlanSha256", "helperRef", "publicProbeUrl"],
          "properties": {
            "expectedPlanSha256": { "$ref": "#/$defs/sha256" },
            "helperRef": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
            "publicProbeUrl": { "type": "string", "pattern": "^https://[^\\s]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "hostname": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$" },
    "origin": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "effects": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["create-tunnel", "update-tunnel-route", "upsert-proxied-dns"] } },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
