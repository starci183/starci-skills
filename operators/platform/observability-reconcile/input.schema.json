{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/platform/observability-reconcile/input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/observability-reconcile" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "credentialCapability", "observedState"],
      "properties": {
        "authority": {
          "description": "Exact approval binding the observability plan hash, writable resources, and allowed effects.",
          "type": "object", "additionalProperties": false,
          "required": ["approvalRef", "planSha256", "writableResourceRefs", "allowedEffects", "evidenceRef"],
          "properties": {
            "approvalRef": { "type": "string", "minLength": 1 },
            "planSha256": { "$ref": "#/$defs/sha256" },
            "writableResourceRefs": { "$ref": "#/$defs/resourceRefs" },
            "allowedEffects": { "$ref": "#/$defs/effects" },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "credentialCapability": {
          "description": "Opaque capability for only the declared remote-write destination.",
          "type": "object", "additionalProperties": false,
          "required": ["handleRef", "destinationRef", "capability", "custodyEvidenceRef"],
          "properties": {
            "handleRef": { "type": "string", "minLength": 1 },
            "destinationRef": { "type": "string", "minLength": 1 },
            "capability": { "const": "metrics:remote-write" },
            "custodyEvidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "observedState": {
          "description": "Current metadata for only the declared stack resources and one concurrency fingerprint.",
          "type": "object", "additionalProperties": false,
          "required": ["configurationFingerprint", "resourceRefs", "evidenceRefs"],
          "properties": {
            "configurationFingerprint": { "$ref": "#/$defs/sha256" },
            "resourceRefs": { "$ref": "#/$defs/resourceRefs" },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["desiredState"],
      "properties": {
        "desiredState": {
          "description": "One exact observability plan covering services, targets, dashboards, filtering, destination, and effect classes.",
          "type": "object", "additionalProperties": false,
          "required": ["planSha256", "services", "scrapeTargets", "dashboardRefs", "remoteWriteDestinationRef", "sensitiveDataPolicyRef", "effects"],
          "properties": {
            "planSha256": { "$ref": "#/$defs/sha256" },
            "services": { "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["cadvisor", "prometheus", "grafana"] } },
            "scrapeTargets": { "$ref": "#/$defs/resourceRefs" },
            "dashboardRefs": { "$ref": "#/$defs/resourceRefs" },
            "remoteWriteDestinationRef": { "type": "string", "minLength": 1 },
            "sensitiveDataPolicyRef": { "type": "string", "minLength": 1 },
            "effects": { "$ref": "#/$defs/effects" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "effects": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["update-config", "restart-service", "upsert-dashboard", "update-remote-write"] } },
    "resourceRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
