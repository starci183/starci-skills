{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/platform/observability-reconcile/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/observability-reconcile" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "receiptRef", "mutations", "checks", "reason", "evidenceRefs"],
      "properties": {
        "outcome": { "enum": ["proved", "blocked"], "description": "Observed stack convergence result; only the Skill machine routes it." },
        "receiptRef": { "type": ["string", "null"], "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$", "description": "Fresh bounded proof when every required postcondition passes; otherwise null." },
        "mutations": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation" }, "description": "Every coordinator-owned configuration, runtime, dashboard, or destination mutation." },
        "checks": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/check" }, "description": "Exactly the seven required health, boundary, delivery, ordering, retry, and filtering checks." },
        "reason": { "type": ["string", "null"], "enum": [null, "authority-drift", "concurrent-drift", "execution-failed", "health-failed", "remote-write-failed", "data-boundary-failed"], "description": "One bounded failure reason when blocked; null when proved." },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs", "description": "Approval, mutation, health, remote-write, and sensitive-data evidence." }
      }
    }
  },
  "$defs": {
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "resourceRef", "beforeRevision", "afterRevision"],
      "properties": {
        "effect": { "enum": ["update-config", "restart-service", "upsert-dashboard", "update-remote-write"] },
        "resourceRef": { "type": "string", "minLength": 1 },
        "beforeRevision": { "type": ["string", "null"], "minLength": 1 },
        "afterRevision": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "evidenceRef"],
      "properties": {
        "name": { "enum": ["service-health", "target-boundary", "label-boundary", "remote-write-delivery", "sample-ordering", "retry-backoff", "sensitive-data-filter"] },
        "status": { "enum": ["passed", "failed"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
