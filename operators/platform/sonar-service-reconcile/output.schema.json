{
  "$id":"https://starci.dev/v6/operators/platform/sonar-service-reconcile/output.schema.json","title":"platform/sonar-service-reconcile operator output","$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
