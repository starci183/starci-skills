{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/platform/sonar-service-reconcile/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/sonar-service-reconcile" },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "receiptRef", "mutations", "checks", "reason", "evidenceRefs"],
      "properties": {
        "outcome": { "enum": ["proved", "blocked"], "description": "Observed Sonar convergence result; only the Skill machine routes it." },
        "receiptRef": { "type": ["string", "null"], "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$", "description": "Fresh post-apply proof when every declared binding is converged; otherwise null." },
        "mutations": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation" }, "description": "Every coordinator-owned Sonar mutation with before and after revisions." },
        "checks": { "type": "array", "minItems": 6, "maxItems": 251, "uniqueItems": true, "items": { "$ref": "#/$defs/check" }, "description": "Reread service and per-project association/enforcement checks covering every required check kind." },
        "reason": { "type": ["string", "null"], "enum": [null, "authority-drift", "provider-unavailable", "concurrent-drift", "execution-failed", "proof-failed"], "description": "One bounded failure reason when blocked; null when proved." },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs", "description": "Approval, provider revision, mutation, and reread evidence." }
      }
    }
  },
  "$defs": {
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["effect", "resourceRef", "beforeRevision", "afterRevision"],
      "properties": {
        "effect": { "enum": ["create-project", "assign-profile", "assign-gate", "enforce-setting"] },
        "resourceRef": { "type": "string", "minLength": 1 },
        "beforeRevision": { "type": ["string", "null"], "minLength": 1 },
        "afterRevision": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "resourceRef", "status", "evidenceRef"],
      "properties": {
        "kind": { "enum": ["service-available", "project-exists", "source-revision", "profile-assigned", "gate-assigned", "enforcement-active"] },
        "resourceRef": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
