{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/platform/sonar-service-reconcile/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "platform/sonar-service-reconcile" },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "credentialCapability", "observedState"],
      "properties": {
        "authority": {
          "description": "Exact approval binding the desired Sonar plan hash and allowed effect classes.",
          "type": "object", "additionalProperties": false,
          "required": ["approvalRef", "planSha256", "allowedEffects", "evidenceRef"],
          "properties": {
            "approvalRef": { "type": "string", "minLength": 1 },
            "planSha256": { "$ref": "#/$defs/sha256" },
            "allowedEffects": { "$ref": "#/$defs/effects" },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "credentialCapability": {
          "description": "Opaque Sonar capability handle with no secret value in the operator contract.",
          "type": "object", "additionalProperties": false,
          "required": ["handleRef", "capability", "custodyEvidenceRef"],
          "properties": {
            "handleRef": { "type": "string", "minLength": 1 },
            "capability": { "const": "sonar:project-admin" },
            "custodyEvidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "observedState": {
          "description": "Current value-safe Sonar service and declared-project metadata with one concurrency fingerprint.",
          "type": "object", "additionalProperties": false,
          "required": ["serviceAvailable", "providerFingerprint", "projects", "evidenceRefs"],
          "properties": {
            "serviceAvailable": { "type": "boolean" },
            "providerFingerprint": { "$ref": "#/$defs/sha256" },
            "projects": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/observedProject" } },
            "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
          }
        }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["desiredState"],
      "properties": {
        "desiredState": {
          "description": "One exact Sonar plan containing the declared project set and required effect classes.",
          "type": "object", "additionalProperties": false,
          "required": ["planSha256", "serviceRef", "projects", "effects"],
          "properties": {
            "planSha256": { "$ref": "#/$defs/sha256" },
            "serviceRef": { "type": "string", "minLength": 1 },
            "projects": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "#/$defs/desiredProject" } },
            "effects": { "$ref": "#/$defs/effects" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "effects": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["create-project", "assign-profile", "assign-gate", "enforce-setting"] } },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "observedProject": {
      "type": "object", "additionalProperties": false,
      "required": ["projectKey", "revision", "sourceRevision", "profileKey", "gateKey", "enforcementActive"],
      "properties": {
        "projectKey": { "$ref": "#/$defs/key" },
        "revision": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": ["string", "null"], "minLength": 1 },
        "profileKey": { "type": ["string", "null"], "minLength": 1 },
        "gateKey": { "type": ["string", "null"], "minLength": 1 },
        "enforcementActive": { "type": "boolean" }
      }
    },
    "desiredProject": {
      "type": "object", "additionalProperties": false,
      "required": ["projectKey", "sourceRevision", "profileKey", "gateKey", "enforcementActive"],
      "properties": {
        "projectKey": { "$ref": "#/$defs/key" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "profileKey": { "$ref": "#/$defs/key" },
        "gateKey": { "$ref": "#/$defs/key" },
        "enforcementActive": { "const": true }
      }
    }
  }
}
