{
  "$id": "https://starci.dev/v6/operators/platform/source-index/output.schema.json",
  "title": "platform/source-index operator output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [{ "oneOf": [
    { "properties": { "status": { "const": "ready" }, "payload": { "properties": {
      "decision": { "const": "ready" },
      "state": { "properties": { "status": { "const": "completed" }, "code": { "const": "platform-source-index-ready" }, "emits": { "properties": { "status": { "const": "ready" } } } } },
      "produced": { "properties": { "sourceIndexReceiptRef": { "$ref": "#/$defs/sessionRef" }, "indexAction": { "enum": ["unchanged", "upserted", "replaced"] }, "partitionGenerationRef": { "type": "string", "minLength": 1 } } }
    } } } },
    { "properties": { "status": { "const": "blocked" }, "payload": { "properties": {
      "decision": { "const": "blocked" },
      "state": { "properties": { "status": { "const": "blocked" }, "code": { "const": "platform-source-index-blocked" }, "emits": { "properties": { "status": { "const": "blocked" } } } } },
      "produced": { "properties": { "sourceIndexReceiptRef": { "type": "null" }, "indexAction": { "const": "not-committed" }, "partitionGenerationRef": { "type": "null" }, "durableWrites": { "maxItems": 0 } } },
      "findings": { "minItems": 1 }
    } } } }
  ] }],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "platform.mcp.publish" },
    "status": { "enum": ["ready", "blocked"] },
    "facts": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["ready", "blocked"] },
        "state": { "type": "object", "additionalProperties": false, "required": ["operator", "status", "code", "retryable", "emits"], "properties": {
          "operator": { "const": "platform/source-index" }, "status": { "enum": ["completed", "blocked"] }, "code": { "enum": ["platform-source-index-ready", "platform-source-index-blocked"] }, "retryable": { "type": "boolean" },
          "emits": { "type": "object", "additionalProperties": false, "required": ["stage", "status", "factsAdd"], "properties": { "stage": { "const": "platform.mcp.publish" }, "status": { "enum": ["ready", "blocked"] }, "factsAdd": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } } } }
        } },
        "produced": { "type": "object", "additionalProperties": false, "required": ["sourceIndexReceiptRef", "indexAction", "partitionGenerationRef", "durableWrites"], "properties": {
          "sourceIndexReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] }, "indexAction": { "enum": ["unchanged", "upserted", "replaced", "not-committed"] }, "partitionGenerationRef": { "type": ["string", "null"], "minLength": 1 }, "durableWrites": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
        } },
        "context": { "type": "object", "additionalProperties": false, "required": ["used"], "properties": { "used": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "revision"], "properties": { "kind": { "enum": ["session-artifact", "qdrant-knowledge", "worktree-business", "generated-contract-json", "qdrant-partition"] }, "ref": { "type": "string", "minLength": 1, "maxLength": 512 }, "revision": { "type": "string", "minLength": 1, "maxLength": 160 } } } } } },
        "cleanup": { "type": "object", "additionalProperties": false, "required": ["scratchRefs", "retention", "purgeAt"], "properties": { "scratchRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }, "retention": { "const": "until-skill-terminal" }, "purgeAt": { "const": "skill-terminal" } } },
        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    }
  },
  "$defs": { "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" } }
}
