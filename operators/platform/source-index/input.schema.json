{
  "$id":"https://starci.dev/v6/operators/platform/source-index/input.schema.json","title":"platform/source-index operator input","$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,
  "required":["schemaVersion","runId","stage","status","facts","payload"],
  "properties":{
    "schemaVersion":{"const":6},"runId":{"type":"string","minLength":1},"stage":{"const":"platform.mcp.index"},"status":{"const":"ready"},"facts":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "payload":{"type":"object","additionalProperties":false,"required":["provided","loads","session"],"properties":{
      "provided":{"type":"object","additionalProperties":false,"required":["mcpConfigReceiptRef","routeSetRef","exclusionPolicyRef"],"properties":{"mcpConfigReceiptRef":{"$ref":"#/$defs/sessionRef"},"routeSetRef":{"$ref":"#/$defs/sessionRef"},"exclusionPolicyRef":{"$ref":"#/$defs/sessionRef"}}},
      "loads":{"type":"object","additionalProperties":false,"required":["artifacts","knowledge","business","frontendContracts","index","orchestration"],"properties":{
        "artifacts":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["ref","revision","loadMode"],"properties":{"ref":{"$ref":"#/$defs/sessionRef"},"revision":{"$ref":"#/$defs/sha256"},"loadMode":{"const":"session-exact"}}}},
        "knowledge":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","generation","contentSha256","loadMode"],"properties":{"id":{"const":"platform.source-index"},"generation":{"type":"string","minLength":1},"contentSha256":{"$ref":"#/$defs/sha256"},"loadMode":{"const":"qdrant-exact"}}}},
        "business":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["documentId","ref","authorityPath","revision","contentSha256","loadMode"],"properties":{"documentId":{"type":"string","minLength":1},"ref":{"$ref":"#/$defs/sessionRef"},"authorityPath":{"type":"string","pattern":"^\\.worktrees/[A-Za-z0-9._-]+/businesses/"},"revision":{"$ref":"#/$defs/sha256"},"contentSha256":{"$ref":"#/$defs/sha256"},"loadMode":{"const":"metadata-first"}}}},
        "frontendContracts":{"type":"array","minItems":0,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["documentId","ref","cachePath","sourceRevision","sourceFingerprint","contentSha256","schemaVersion","generatorVersion","generatorSha256","generatorConfigSha256","loadMode"],"properties":{"documentId":{"type":"string","minLength":1},"ref":{"$ref":"#/$defs/sessionRef"},"cachePath":{"type":"string","pattern":"^\\.worktrees/[A-Za-z0-9._-]+/coding-context/frontend/"},"sourceRevision":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"sourceFingerprint":{"$ref":"#/$defs/sha256"},"contentSha256":{"$ref":"#/$defs/sha256"},"schemaVersion":{"type":"integer","minimum":1},"generatorVersion":{"type":"string","minLength":1},"generatorSha256":{"$ref":"#/$defs/sha256"},"generatorConfigSha256":{"$ref":"#/$defs/sha256"},"loadMode":{"const":"metadata-first"}}}},
        "index":{"type":"object","additionalProperties":false,"required":["projectId","partitionId","generation","revision","currentDocuments","loadMode"],"properties":{"projectId":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},"partitionId":{"type":"string","minLength":1},"generation":{"type":["string","null"],"minLength":1},"revision":{"type":["string","null"],"minLength":1},"currentDocuments":{"type":"array","uniqueItems":true,"items":{"oneOf":[{"type":"object","additionalProperties":false,"required":["documentId","documentKind","contentSha256"],"properties":{"documentId":{"type":"string","minLength":1},"documentKind":{"const":"business"},"contentSha256":{"$ref":"#/$defs/sha256"}}},{"type":"object","additionalProperties":false,"required":["documentId","documentKind","sourceRevision","sourceFingerprint","contentSha256","schemaVersion","generatorVersion","generatorSha256","generatorConfigSha256"],"properties":{"documentId":{"type":"string","minLength":1},"documentKind":{"const":"frontend-contract"},"sourceRevision":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"sourceFingerprint":{"$ref":"#/$defs/sha256"},"contentSha256":{"$ref":"#/$defs/sha256"},"schemaVersion":{"type":"integer","minimum":1},"generatorVersion":{"type":"string","minLength":1},"generatorSha256":{"$ref":"#/$defs/sha256"},"generatorConfigSha256":{"$ref":"#/$defs/sha256"}}}]}},"loadMode":{"const":"metadata-only"}}},
        "orchestration":{"type":"object","additionalProperties":false,"required":["mode","profileRef","providerRef"],"properties":{"mode":{"enum":["economical","balanced","parallel"]},"profileRef":{"enum":["orchestration/modes/economical.json","orchestration/modes/balanced.json","orchestration/modes/parallel.json"]},"providerRef":{"type":"string","pattern":"^orchestration/providers/[a-z0-9-]+\\.json$"}}}
      }},
      "session":{"type":"object","additionalProperties":false,"required":["taskId","inputRef","outputRef","scratchPrefix","retention"],"properties":{"taskId":{"type":"string","minLength":1},"inputRef":{"$ref":"#/$defs/sessionRef"},"outputRef":{"$ref":"#/$defs/sessionRef"},"scratchPrefix":{"$ref":"#/$defs/sessionRef"},"retention":{"const":"until-skill-terminal"}}}
    }}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"sessionRef":{"type":"string","pattern":"^session://tasks/[A-Za-z0-9._-]+/.+$"}}
}
