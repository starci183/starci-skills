{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/content-generate/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "content.generate" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["generated", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "naturalLanguage": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "implementationLanguage": { "type": "string", "pattern": "^[a-z][a-z0-9+#.-]*$" },
    "stageMode": { "enum": ["required", "optional", "disabled"] },
    "stage": { "enum": ["brief", "write", "image", "code", "e2e", "critique"] },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "nullableScore": {
      "oneOf": [{ "$ref": "#/$defs/score" }, { "type": "null" }]
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionRef", "model", "isolation", "forkTurns"],
      "properties": {
        "executionRef": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "isolation": { "enum": ["fresh", "inherited"] },
        "forkTurns": { "enum": ["none", "inherited"] }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "unit",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "content-generation-receipt" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["generated", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "unit": {
          "oneOf": [{ "$ref": "#/$defs/unit" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "contentSourceRef",
        "sourceHead",
        "artifactRootRef",
        "unitId",
        "mode",
        "naturalLanguages",
        "implementationLanguages",
        "stageModes",
        "minimumScore",
        "reviewRound",
        "curriculumFingerprint",
        "briefFingerprint",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "contentSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "unitId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["generate", "refactor"] },
        "naturalLanguages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/naturalLanguage" }
        },
        "implementationLanguages": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/implementationLanguage" }
        },
        "stageModes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "code", "e2e"],
          "properties": {
            "image": { "$ref": "#/$defs/stageMode" },
            "code": { "$ref": "#/$defs/stageMode" },
            "e2e": { "$ref": "#/$defs/stageMode" }
          }
        },
        "minimumScore": { "const": 85 },
        "reviewRound": { "type": "integer", "minimum": 1 },
        "curriculumFingerprint": { "$ref": "#/$defs/fingerprint" },
        "briefFingerprint": {
          "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
        },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief", "articles", "image", "tracks", "e2e", "critique", "approvedArtifactRefs"],
      "properties": {
        "brief": { "$ref": "#/$defs/brief" },
        "articles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/article" }
        },
        "image": {
          "oneOf": [{ "$ref": "#/$defs/image" }, { "type": "null" }]
        },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
        "e2e": {
          "oneOf": [{ "$ref": "#/$defs/e2e" }, { "type": "null" }]
        },
        "critique": { "$ref": "#/$defs/critique" },
        "approvedArtifactRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "briefRef",
        "fingerprint",
        "execution",
        "learnerInputRefs",
        "learnerOutcomeRefs",
        "claimRefs",
        "exampleRefs",
        "dispositions"
      ],
      "properties": {
        "briefRef": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "execution": { "$ref": "#/$defs/execution" },
        "learnerInputRefs": { "$ref": "#/$defs/refArray" },
        "learnerOutcomeRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "claimRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "exampleRefs": { "$ref": "#/$defs/refArray" },
        "dispositions": { "type": "array", "items": { "$ref": "#/$defs/disposition" } }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetRef", "statement"],
      "properties": {
        "kind": { "enum": ["add", "change", "remove"] },
        "targetRef": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "articleRef", "coveredOutcomeRefs", "interviewQuestionCount", "execution"],
      "properties": {
        "language": { "$ref": "#/$defs/naturalLanguage" },
        "articleRef": { "type": "string", "minLength": 1 },
        "coveredOutcomeRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "interviewQuestionCount": { "type": "integer", "minimum": 1 },
        "execution": { "$ref": "#/$defs/execution" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageRef", "promptRef", "generator", "claimRefs", "inspection"],
      "properties": {
        "imageRef": { "type": "string", "minLength": 1 },
        "promptRef": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "claimRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["legible", "hierarchyReadable", "claimFidelity", "evidenceRef"],
          "properties": {
            "legible": { "type": "boolean" },
            "hierarchyReadable": { "type": "boolean" },
            "claimFidelity": { "type": "boolean" },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "sourceRef", "buildCommand", "exitCode", "evidenceRef"],
      "properties": {
        "language": { "$ref": "#/$defs/implementationLanguage" },
        "sourceRef": { "type": "string", "minLength": 1 },
        "buildCommand": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": 0 },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractFingerprintBefore", "contractFingerprintAfter", "iterations", "runs"],
      "properties": {
        "contractFingerprintBefore": { "$ref": "#/$defs/fingerprint" },
        "contractFingerprintAfter": { "$ref": "#/$defs/fingerprint" },
        "iterations": { "type": "integer", "minimum": 1 },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/e2eRun" }
        }
      }
    },
    "e2eRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "command", "exitCode", "assertionsRef"],
      "properties": {
        "language": { "$ref": "#/$defs/implementationLanguage" },
        "command": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": 0 },
        "assertionsRef": { "type": "string", "minLength": 1 }
      }
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewRef",
        "execution",
        "verdict",
        "scores",
        "findings",
        "receivedArtifactRefs",
        "producerRationaleReceived"
      ],
      "properties": {
        "reviewRef": { "type": "string", "minLength": 1 },
        "execution": { "$ref": "#/$defs/execution" },
        "verdict": { "enum": ["approved", "revision-required"] },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correctness",
            "pedagogy",
            "interviewValue",
            "language",
            "visualFidelity",
            "codeQuality",
            "e2eProof"
          ],
          "properties": {
            "correctness": { "$ref": "#/$defs/score" },
            "pedagogy": { "$ref": "#/$defs/score" },
            "interviewValue": { "$ref": "#/$defs/score" },
            "language": { "$ref": "#/$defs/score" },
            "visualFidelity": { "$ref": "#/$defs/nullableScore" },
            "codeQuality": { "$ref": "#/$defs/nullableScore" },
            "e2eProof": { "$ref": "#/$defs/nullableScore" }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/critiqueFinding" } },
        "receivedArtifactRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "producerRationaleReceived": { "const": false }
      }
    },
    "critiqueFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owningStage", "severity", "statement", "evidenceRef"],
      "properties": {
        "owningStage": { "$ref": "#/$defs/stage" },
        "severity": { "enum": ["error", "improvement"] },
        "statement": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "ref", "statement"],
      "properties": {
        "code": {
          "enum": [
            "STAGE_DISABLED",
            "DISPOSITION_APPLIED",
            "REVISION_REQUIRED",
            "PRODUCER_RATIONALE_WITHHELD"
          ]
        },
        "stage": { "$ref": "#/$defs/stage" },
        "ref": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message", "refs", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "BRIEF_UNBOUND",
            "OUTCOME_UNCOVERED",
            "CODE_BUILD_FAILED",
            "E2E_FAILED",
            "CONTRACT_WEAKENED",
            "IMAGE_UNAVAILABLE",
            "REVIEW_REVISION_REQUIRED",
            "REVIEW_ROUNDS_EXHAUSTED",
            "NO_PROGRESS"
          ]
        },
        "stage": { "$ref": "#/$defs/stage" },
        "message": { "type": "string", "minLength": 1 },
        "refs": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["content", "curriculum", "engineering", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
