{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/architecture/alternatives/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "architecture/alternatives"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "aiExecution",
        "resultRef",
        "directionCount",
        "visualPanelRefs",
        "evidenceRefs",
        "findings",
        "reason"
      ],
      "properties": {
        "aiExecution": {
          "description": "Runtime-attested single fresh Sol execution provenance.",
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "isolation", "forkTurns", "executionRef"],
          "properties": {
            "model": { "const": "gpt-5.6-sol" },
            "count": { "const": 1 },
            "isolation": { "const": "fresh" },
            "forkTurns": { "const": "none" },
            "executionRef": { "type": "string", "pattern": "^execution://[0-9a-f]{64}$" }
          }
        },
        "outcome": {
          "description": "Typed result consumed by the parent Skill machine.",
          "enum": [
            "ready"
          ]
        },
        "resultRef": {
          "description": "Exact inspectable visualize HTML comparison artifact.",
          "type": "string",
          "pattern": "\\.html$",
          "minLength": 1,
          "maxLength": 1024
        },
        "directionCount": {
          "description": "Number of materially different architecture directions rendered.",
          "type": "integer",
          "minimum": 3,
          "maximum": 4
        },
        "visualPanelRefs": {
          "description": "One exact visible panel reference for every rendered architecture direction.",
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "evidenceRefs": {
          "description": "Exact references supporting the result.",
          "$ref": "#/$defs/refs"
        },
        "findings": {
          "description": "Bounded observable findings produced by this job.",
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "reason": {
          "description": "Bounded explanation when the result cannot be produced, otherwise null.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
