{
  "$id": "https://starci.dev/v6/operators/architecture/source-discovery/input.schema.json",
  "title": "architecture/source-discovery operator input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "architecture.source"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "architecture.source"
      ]
    },
    "status": {
      "enum": [
        "ready"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided",
        "loads",
        "session"
      ],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "businessHeadRef",
            "planningContextRef",
            "routeReceiptRef",
            "sourcePartitionRef"
          ],
          "properties": {
            "businessHeadRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "planningContextRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "routeReceiptRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "sourcePartitionRef": {
              "$ref": "#/$defs/sessionRef"
            }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifacts",
            "knowledge",
            "business",
            "source",
            "orchestration"
          ],
          "properties": {
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "revision",
                  "loadMode"
                ],
                "properties": {
                  "ref": {
                    "$ref": "#/$defs/sessionRef"
                  },
                  "revision": {
                    "$ref": "#/$defs/sha256"
                  },
                  "loadMode": {
                    "const": "session-exact"
                  }
                }
              }
            },
            "knowledge": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "generation",
                  "contentSha256",
                  "loadMode"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "be.boundary-planning"
                    ]
                  },
                  "generation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contentSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "loadMode": {
                    "const": "qdrant-exact"
                  }
                }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profileRef",
                "providerRef"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "economical",
                    "balanced",
                    "parallel"
                  ]
                },
                "profileRef": {
                  "enum": [
                    "orchestration/modes/economical.json",
                    "orchestration/modes/balanced.json",
                    "orchestration/modes/parallel.json"
                  ]
                },
                "providerRef": {
                  "type": "string",
                  "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$"
                }
              }
            },
            "business": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "authorityPath",
                "revision",
                "loadMode"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/sessionRef"
                },
                "authorityPath": {
                  "type": "string",
                  "pattern": "^\\.worktrees/[a-z0-9][a-z0-9-]*/businesses/"
                },
                "revision": {
                  "$ref": "#/$defs/sha256"
                },
                "loadMode": {
                  "const": "worktree-exact"
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "loadMode",
                "repositoryContext",
                "targetFiles"
              ],
              "properties": {
                "loadMode": {
                  "const": "exact-files"
                },
                "repositoryContext": {
                  "const": false
                },
                "targetFiles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "beforeSha256",
                      "purpose"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "beforeSha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "purpose": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taskId",
            "inputRef",
            "outputRef",
            "scratchPrefix",
            "retention"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "inputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "outputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "scratchPrefix": {
              "$ref": "#/$defs/sessionRef"
            },
            "retention": {
              "const": "until-skill-terminal"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    }
  }
}
