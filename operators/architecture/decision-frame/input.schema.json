{
  "$id": "https://starci.dev/v6/operators/architecture/decision-frame/input.schema.json",
  "title": "architecture/decision-frame operator input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "architecture.decision.frame"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "architecture.decision.frame"
      ]
    },
    "status": {
      "enum": [
        "ready"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "businessHeadRef",
        "objectiveRef",
        "constraintEvidenceRefs"
      ],
      "properties": {
        "businessHeadRef": {
          "type": "string",
          "minLength": 1
        },
        "objectiveRef": {
          "type": "string",
          "minLength": 1
        },
        "constraintEvidenceRefs": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
