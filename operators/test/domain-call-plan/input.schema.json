{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/domain-call-plan"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionId",
        "completedDomains"
      ],
      "properties": {
        "missionId": {
          "description": "Mission identity.",
          "type": "string",
          "minLength": 1
        },
        "completedDomains": {
          "description": "Already returned domains.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainOrder",
        "returnReceipts"
      ],
      "properties": {
        "domainOrder": {
          "description": "Ordered domain calls.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "business",
              "backend",
              "frontend",
              "quality",
              "uat"
            ]
          }
        },
        "returnReceipts": {
          "description": "Typed RETURN receipts already consumed.",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "receiptId",
              "type",
              "missionId",
              "skillId",
              "operatorId",
              "parentId",
              "childId",
              "timestamp",
              "progressFingerprint",
              "trace"
            ],
            "properties": {
              "version": {
                "const": "7.5.0-alpha.1"
              },
              "receiptId": {
                "type": "string",
                "pattern": "^receipt:[A-Za-z0-9._-]+$"
              },
              "type": {
                "enum": [
                  "CALL",
                  "RETURN",
                  "TRANSITION",
                  "WAIT",
                  "RESUME",
                  "SKIP",
                  "ERROR"
                ]
              },
              "missionId": {
                "type": "string",
                "minLength": 1
              },
              "skillId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "operatorId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "childId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "progressFingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "trace": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
