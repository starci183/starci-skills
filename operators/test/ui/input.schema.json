{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/test/ui/input.schema.json",
  "title": "UI Test operator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "test.ui.input"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "test.ui"
    },
    "status": {
      "const": "ready"
    },
    "facts": {
      "$ref": "#/$defs/strings"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRouteRef",
        "sourceReferenceRef",
        "manifestRef",
        "appUrl",
        "testAccountRef",
        "credentialProviderRef",
        "selectedFlowRef",
        "selectedFlowHash",
        "approvedLayoutRef",
        "approvedLayoutHash",
        "seedEvidenceRef",
        "seedEvidenceHash",
        "scenarioRefs",
        "viewportIds",
        "evidenceRoot"
      ],
      "properties": {
        "workspaceRouteRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceReferenceRef": {
          "const": "starci-academy-fe"
        },
        "manifestRef": {
          "type": "string",
          "minLength": 1
        },
        "appUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "testAccountRef": {
          "type": "string",
          "minLength": 1
        },
        "credentialProviderRef": {
          "type": "string",
          "minLength": 1
        },
        "selectedFlowRef": {
          "type": "string",
          "minLength": 1
        },
        "selectedFlowHash": {
          "type": "string",
          "minLength": 1
        },
        "approvedLayoutRef": {
          "type": "string",
          "minLength": 1
        },
        "approvedLayoutHash": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "seedEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "scenarioRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        },
        "viewportIds": {
          "type": "array",
          "prefixItems": [
            {
              "const": "wide"
            },
            {
              "const": "intermediate"
            },
            {
              "const": "compact"
            }
          ],
          "items": false
        },
        "evidenceRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scenarioReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "pageIds",
        "viewportIds",
        "interactionCount",
        "assertionCount",
        "screenshotRefs",
        "traceRef",
        "accessibilityRef",
        "status",
        "ordinaryUserPath",
        "secretsRedacted"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "pageIds": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        },
        "viewportIds": {
          "type": "array",
          "prefixItems": [
            {
              "const": "wide"
            },
            {
              "const": "intermediate"
            },
            {
              "const": "compact"
            }
          ],
          "items": false
        },
        "interactionCount": {
          "type": "integer",
          "minimum": 1
        },
        "assertionCount": {
          "type": "integer",
          "minimum": 1
        },
        "screenshotRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 3
        },
        "traceRef": {
          "type": "string",
          "minLength": 1
        },
        "accessibilityRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "ordinaryUserPath": {
          "const": true
        },
        "secretsRedacted": {
          "const": true
        }
      }
    }
  }
}
