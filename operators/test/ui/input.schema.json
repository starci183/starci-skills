{
  "$id": "https://starci.dev/v6/operators/test/ui/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test/ui operator input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "test.ui"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "test.ui"
      ]
    },
    "status": {
      "enum": [
        "ready"
      ]
    },
    "facts": {
      "$ref": "#/$defs/strings"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided",
        "loads",
        "session"
      ],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previousStateRef",
            "testPlanRef",
            "changeSetRef",
            "seedEvidenceRef"
          ],
          "properties": {
            "previousStateRef": {
              "$ref": "#/$defs/sessionRef",
              "description": "accepted previous-state output"
            },
            "testPlanRef": {
              "$ref": "#/$defs/sessionRef",
              "description": "exact scenarios, targets, commands, and observables"
            },
            "changeSetRef": {
              "$ref": "#/$defs/sessionRef",
              "description": "pinned change set under test"
            },
            "seedEvidenceRef": {
              "$ref": "#/$defs/sessionRef",
              "description": "isolated seed evidence"
            }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "business",
            "knowledge",
            "source",
            "commands",
            "external",
            "orchestration"
          ],
          "properties": {
            "business": {
              "type": "null"
            },
            "knowledge": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "generation",
                    "contentSha256",
                    "loadMode"
                  ],
                  "properties": {
                    "id": {
                      "const": "fe.ui-testing"
                    },
                    "generation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contentSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "loadMode": {
                      "const": "qdrant-exact"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "generation",
                    "contentSha256",
                    "loadMode"
                  ],
                  "properties": {
                    "id": {
                      "const": "fe.customer-journey"
                    },
                    "generation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contentSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "loadMode": {
                      "const": "qdrant-exact"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "generation",
                    "contentSha256",
                    "loadMode"
                  ],
                  "properties": {
                    "id": {
                      "const": "fe.layout-composition"
                    },
                    "generation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contentSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "loadMode": {
                      "const": "qdrant-exact"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "generation",
                    "contentSha256",
                    "loadMode"
                  ],
                  "properties": {
                    "id": {
                      "const": "fe.state-modeling"
                    },
                    "generation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contentSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "loadMode": {
                      "const": "qdrant-exact"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "generation",
                    "contentSha256",
                    "loadMode"
                  ],
                  "properties": {
                    "id": {
                      "const": "fe.product-seeding"
                    },
                    "generation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contentSha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "loadMode": {
                      "const": "qdrant-exact"
                    }
                  }
                }
              ],
              "items": false
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "loadMode",
                "repositoryContext",
                "targetFiles"
              ],
              "properties": {
                "loadMode": {
                  "const": "exact-files"
                },
                "repositoryContext": {
                  "const": false
                },
                "targetFiles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "beforeSha256",
                      "access",
                      "purpose"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "beforeSha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "access": {
                        "enum": [
                          "read"
                        ]
                      },
                      "purpose": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "loadMode",
                "commandRefs"
              ],
              "properties": {
                "loadMode": {
                  "const": "declared-only"
                },
                "commandRefs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/sessionRef"
                  }
                }
              }
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resourceRefs",
                "credentialHandleRefs"
              ],
              "properties": {
                "resourceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/sessionRef"
                  }
                },
                "credentialHandleRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/sessionRef"
                  }
                }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "profileRef",
                "providerRef"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "economical",
                    "balanced",
                    "parallel"
                  ]
                },
                "profileRef": {
                  "enum": [
                    "orchestration/modes/economical.json",
                    "orchestration/modes/balanced.json",
                    "orchestration/modes/parallel.json"
                  ]
                },
                "providerRef": {
                  "type": "string",
                  "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$"
                }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taskId",
            "inputRef",
            "outputRef",
            "scratchPrefix",
            "retention"
          ],
          "properties": {
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "inputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "outputRef": {
              "$ref": "#/$defs/sessionRef"
            },
            "scratchPrefix": {
              "$ref": "#/$defs/sessionRef"
            },
            "retention": {
              "const": "until-skill-terminal"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
