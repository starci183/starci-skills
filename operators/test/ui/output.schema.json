{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/test/ui/output.schema.json",
  "title": "UI Test operator output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "appId",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "test.ui.output"
    },
    "schemaVersion": {
      "const": 6
    },
    "appId": {
      "const": "fe-design-layout"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "proof.run",
        "code.repair",
        "test.review",
        "layout.review"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "repair",
        "rejected",
        "blocked"
      ]
    },
    "facts": {
      "$ref": "#/$defs/strings"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uiEvidenceRef",
        "uiEvidenceHash",
        "testAccountRef",
        "scenarioReceipts",
        "selected",
        "passed",
        "failed",
        "skipped",
        "failedScenarioIds",
        "boundaryDriftReasons",
        "stopReasons",
        "secretsRedacted"
      ],
      "properties": {
        "uiEvidenceRef": {
          "type": "string",
          "minLength": 1
        },
        "uiEvidenceHash": {
          "type": "string",
          "minLength": 1
        },
        "testAccountRef": {
          "type": "string",
          "minLength": 1
        },
        "scenarioReceipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenarioReceipt"
          }
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "failedScenarioIds": {
          "$ref": "#/$defs/strings"
        },
        "boundaryDriftReasons": {
          "$ref": "#/$defs/strings"
        },
        "stopReasons": {
          "$ref": "#/$defs/strings"
        },
        "secretsRedacted": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scenarioReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "pageIds",
        "viewportIds",
        "interactionCount",
        "assertionCount",
        "screenshotRefs",
        "traceRef",
        "accessibilityRef",
        "status",
        "ordinaryUserPath",
        "secretsRedacted"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "pageIds": {
          "$ref": "#/$defs/strings",
          "minItems": 1
        },
        "viewportIds": {
          "type": "array",
          "prefixItems": [
            {
              "const": "wide"
            },
            {
              "const": "intermediate"
            },
            {
              "const": "compact"
            }
          ],
          "items": false
        },
        "interactionCount": {
          "type": "integer",
          "minimum": 1
        },
        "assertionCount": {
          "type": "integer",
          "minimum": 1
        },
        "screenshotRefs": {
          "$ref": "#/$defs/strings",
          "minItems": 3
        },
        "traceRef": {
          "type": "string",
          "minLength": 1
        },
        "accessibilityRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "ordinaryUserPath": {
          "const": true
        },
        "secretsRedacted": {
          "const": true
        }
      }
    }
  }
}
