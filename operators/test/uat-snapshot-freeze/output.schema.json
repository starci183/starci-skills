{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/uat-snapshot-freeze"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "canonicalRef",
        "contentFingerprint",
        "evidenceRefs",
        "gaps"
      ],
      "properties": {
        "outcome": {
          "description": "Typed proof result.",
          "enum": [
            "frozen",
            "blocked"
          ]
        },
        "canonicalRef": {
          "description": "Exact backend-owned canonical UAT snapshot.json reference.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/snapshot\\.json$"
        },
        "contentFingerprint": {
          "description": "Fingerprint of the parsed canonical snapshot content.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidenceRefs": {
          "description": "Independent evidence used.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "description": "Exact blockers.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
