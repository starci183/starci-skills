{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/uat-snapshot-freeze"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendSourceRef",
        "authorityRefs",
        "sourceFingerprint"
      ],
      "properties": {
        "backendSourceRef": {
          "description": "Verified backend Source owning canonical UAT authority.",
          "type": "string",
          "minLength": 1
        },
        "authorityRefs": {
          "description": "Frozen business, source, runtime, and lens authority.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "sourceFingerprint": {
          "description": "Exact immutable source fingerprint inherited from Quality PASS.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "flow",
        "account"
      ],
      "properties": {
        "feature": {
          "description": "Canonical feature key.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "flow": {
          "description": "Canonical flow key.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "account": {
          "description": "Non-secret Control-Panel-provisioned account record to persist in the canonical snapshot.",
          "type": "object",
          "additionalProperties": false,
          "required": ["accountRef", "provisioningMode", "provisioningOwnerRef", "identityRecordRef", "applicationRecordRef", "principalFingerprint", "fixtureNamespace", "credentialCustody", "state"],
          "properties": {
            "accountRef": { "type": "string", "pattern": "^account://fresh(?:[/?#].*)?$" },
            "provisioningMode": { "const": "control-panel-auto-create" },
            "provisioningOwnerRef": { "type": "string", "minLength": 1 },
            "identityRecordRef": { "type": "string", "pattern": "^keycloak-user://.+$" },
            "applicationRecordRef": { "type": "string", "pattern": "^database-user://.+$" },
            "principalFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "fixtureNamespace": { "type": "string", "minLength": 1 },
            "credentialCustody": { "const": "control-panel-ephemeral" },
            "state": { "const": "authenticated" }
          }
        }
      }
    }
  }
}
