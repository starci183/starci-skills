{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/uat-snapshot-freeze"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backendSourceRef",
        "authorityRefs"
      ],
      "properties": {
        "backendSourceRef": {
          "description": "Verified backend Source owning canonical UAT authority.",
          "type": "string",
          "minLength": 1
        },
        "authorityRefs": {
          "description": "Frozen business, source, runtime, and lens authority.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "flow"
      ],
      "properties": {
        "feature": {
          "description": "Canonical feature key.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "flow": {
          "description": "Canonical flow key.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  }
}
