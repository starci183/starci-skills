{
  "schemaVersion": 6,
  "id": "test/unit",
  "domain": "test",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "knowledgeRefs": [
    "fe.unit-testing"
  ],
  "sourceReferenceRefs": [
    "starci-academy-fe",
    "starci-academy-be"
  ],
  "accepts": [
    {
      "stage": "test.unit",
      "status": "ready",
      "allFacts": [
        "seed-evidence"
      ]
    }
  ],
  "emits": [
    {
      "when": "all focused unit tests pass",
      "stage": "test.e2e",
      "status": "ready",
      "factsAdd": [
        "unit-pass",
        "unit-evidence"
      ]
    },
    {
      "when": "a unit assertion or changed-owner coverage fails",
      "stage": "code.repair",
      "status": "repair",
      "factsAdd": [
        "unit-failed",
        "in-boundary-repair"
      ]
    },
    {
      "when": "the unit harness or environment cannot produce a verdict",
      "stage": "test.review",
      "status": "blocked",
      "factsAdd": [
        "unit-blocked"
      ]
    }
  ],
  "sideEffects": [
    "run manifest-owned focused unit commands",
    "write task-session unit evidence only"
  ],
  "stopConditions": [
    "zero selected tests",
    "skipped target test",
    "missing manifest command",
    "stale workspace route",
    "failed assertion",
    "suppressed failure",
    "unsanitized secret"
  ]
}
