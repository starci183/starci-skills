{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/uat-ux-proof"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotRef",
        "behaviorProofReturnReceiptRef",
        "sourceFingerprint"
      ],
      "properties": {
        "snapshotRef": {
          "description": "Frozen canonical snapshot.",
          "type": "string",
          "minLength": 1
        },
        "behaviorProofReturnReceiptRef": {
          "description": "Exact validated behavior-proof RETURN receipt.",
          "type": "string",
          "pattern": "^receipt:[A-Za-z0-9._-]+$"
        },
        "sourceFingerprint": {
          "description": "Exact source fingerprint inherited from behavior proof.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs",
        "browserSessionRef",
        "accountRef"
      ],
      "properties": {
        "evidenceRefs": {
          "description": "Exact browser, account, behavior, UX, or UI evidence.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "browserSessionRef": {
          "description": "Exact visible-browser session.",
          "type": "string",
          "minLength": 1
        },
        "accountRef": {
          "description": "Fresh run-scoped isolated account or explicitly declared anonymous identity.",
          "type": "string",
          "pattern": "^(?:account://fresh(?:[/?#].*)?|anonymous://explicit(?:[/?#].*)?)$"
        }
      }
    }
  }
}
