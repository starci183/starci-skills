{
  "$id": "https://starci.dev/v6/operators/test/ui-quality-audit/input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test/ui-quality-audit operator input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [
    {
      "oneOf": [
        { "properties": { "stage": { "const": "test.ui" }, "status": { "const": "ready" } }, "required": ["stage", "status"] },
        { "properties": { "stage": { "const": "ui.quality.audit" }, "status": { "const": "ready" } }, "required": ["stage", "status"] }
      ]
    }
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["test.ui", "ui.quality.audit"] },
    "status": { "const": "ready" },
    "facts": { "$ref": "#/$defs/strings" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previousStateRef", "routeReceiptRef", "auditPlanRef", "targetSetRef", "baselineRef"],
          "properties": {
            "previousStateRef": { "$ref": "#/$defs/sessionRef" },
            "routeReceiptRef": { "$ref": "#/$defs/sessionRef" },
            "auditPlanRef": { "$ref": "#/$defs/sessionRef" },
            "targetSetRef": { "$ref": "#/$defs/sessionRef" },
            "baselineRef": { "$ref": "#/$defs/sessionRef" }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["business", "knowledge", "source", "commands", "external", "cache", "orchestration"],
          "properties": {
            "business": { "type": "null" },
            "knowledge": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "generation", "contentSha256", "loadMode"],
                  "properties": {
                    "id": { "const": "fe.ui-quality-review" },
                    "generation": { "type": "string", "minLength": 1 },
                    "contentSha256": { "$ref": "#/$defs/sha256" },
                    "loadMode": { "const": "qdrant-exact" }
                  }
                }
              ],
              "items": false
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["loadMode", "repositoryContext", "targetFiles"],
              "properties": {
                "loadMode": { "const": "exact-files" },
                "repositoryContext": { "const": false },
                "targetFiles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path", "beforeSha256", "access", "purpose"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "beforeSha256": { "$ref": "#/$defs/sha256" },
                      "access": { "const": "read" },
                      "purpose": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            "commands": {
              "type": "object",
              "additionalProperties": false,
              "required": ["loadMode", "commandRefs"],
              "properties": {
                "loadMode": { "const": "declared-only" },
                "commandRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }
              }
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resourceRefs", "credentialHandleRefs"],
              "properties": {
                "resourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
                "credentialHandleRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }
              }
            },
            "cache": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lookupMode", "fingerprintRef", "candidateReceiptRef"],
              "properties": {
                "lookupMode": { "const": "exact-only" },
                "fingerprintRef": { "$ref": "#/$defs/sessionRef" },
                "candidateReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] }
              }
            },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "profileRef", "providerRef"],
              "properties": {
                "mode": { "enum": ["economical", "balanced", "parallel"] },
                "profileRef": { "enum": ["orchestration/modes/economical.json", "orchestration/modes/balanced.json", "orchestration/modes/parallel.json"] },
                "providerRef": { "type": "string", "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$" }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "inputRef", "outputRef", "scratchPrefix", "retention"],
          "properties": {
            "taskId": { "type": "string", "minLength": 1 },
            "inputRef": { "$ref": "#/$defs/sessionRef" },
            "outputRef": { "$ref": "#/$defs/sessionRef" },
            "scratchPrefix": { "$ref": "#/$defs/sessionRef" },
            "retention": { "const": "until-skill-terminal" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
