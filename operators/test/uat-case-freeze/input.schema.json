{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/uat-case-freeze"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotRef"
      ],
      "properties": {
        "snapshotRef": {
          "description": "Frozen canonical snapshot.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceRefs",
        "browserSessionRef",
        "accountRef",
        "sessionLease"
      ],
      "properties": {
        "evidenceRefs": {
          "description": "Exact browser, account, behavior, UX, or UI evidence.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "browserSessionRef": {
          "description": "Exact visible-browser session.",
          "type": "string",
          "minLength": 1
        },
        "accountRef": {
          "description": "Fresh run-scoped isolated account or explicitly declared anonymous identity.",
          "type": "string",
          "pattern": "^(?:account://fresh(?:[/?#].*)?|anonymous://explicit(?:[/?#].*)?)$"
        },
        "sessionLease": {
          "description": "Opaque mission-scoped browser/auth continuity contract; contains no secret.",
          "type": "object",
          "additionalProperties": false,
          "required": ["leaseRef", "missionRef", "browserContextRef", "principalFingerprint", "runtimeGeneration", "origin", "fixtureNamespace", "state", "executionMode", "executionOwnerRef", "consumerTabRef", "evidenceBrokerRef", "materializationStatus", "materializationEvidenceRefs"],
          "properties": {
            "leaseRef": { "type": "string", "pattern": "^browser-lease://" },
            "missionRef": { "type": "string", "minLength": 1 },
            "browserContextRef": { "type": "string", "minLength": 1 },
            "principalFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "runtimeGeneration": { "type": "integer", "minimum": 1 },
            "origin": { "const": "http://localhost:3000" },
            "fixtureNamespace": { "type": "string", "minLength": 1 },
            "state": { "enum": ["leased", "authenticated", "released", "invalidated"] },
            "executionMode": { "enum": ["consumer-materialized", "broker-executed"] },
            "executionOwnerRef": { "type": "string", "minLength": 1 },
            "consumerTabRef": { "type": ["string", "null"], "minLength": 1 },
            "evidenceBrokerRef": { "type": ["string", "null"], "minLength": 1 },
            "materializationStatus": { "enum": ["materialized", "failed", "not-applicable"] },
            "materializationEvidenceRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "allOf": [
            {
              "if": { "properties": { "executionMode": { "const": "consumer-materialized" } } },
              "then": { "properties": { "materializationStatus": { "const": "materialized" }, "consumerTabRef": { "type": "string", "minLength": 1 }, "evidenceBrokerRef": { "type": "null" } } }
            },
            {
              "if": { "properties": { "executionMode": { "const": "broker-executed" } } },
              "then": { "properties": { "materializationStatus": { "enum": ["failed", "not-applicable"] }, "consumerTabRef": { "type": "null" }, "evidenceBrokerRef": { "type": "string", "minLength": 1 } } }
            }
          ]
        }
      }
    }
  }
}
