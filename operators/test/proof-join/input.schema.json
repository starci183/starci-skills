{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "test/proof-join"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missionId"
      ],
      "properties": {
        "missionId": {
          "description": "Mission identity.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualityReturn",
        "uatReturn"
      ],
      "properties": {
        "qualityReturn": {
          "description": "Correlated quality assurance RETURN receipt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "receiptId",
            "type",
            "missionId",
            "skillId",
            "operatorId",
            "parentId",
            "childId",
            "timestamp",
            "progressFingerprint",
            "trace"
          ],
          "properties": {
            "version": {
              "const": "7.6.0-beta.1"
            },
            "receiptId": {
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "type": {
              "enum": [
                "CALL",
                "RETURN",
                "TRANSITION",
                "WAIT",
                "RESUME",
                "SKIP",
                "ERROR"
              ]
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": [
                "string",
                "null"
              ]
            },
            "operatorId": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "childId": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "progressFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "type": "object"
            }
          }
        },
        "uatReturn": {
          "description": "Correlated independent UAT RETURN receipt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "receiptId",
            "type",
            "missionId",
            "skillId",
            "operatorId",
            "parentId",
            "childId",
            "timestamp",
            "progressFingerprint",
            "trace"
          ],
          "properties": {
            "version": {
              "const": "7.6.0-beta.1"
            },
            "receiptId": {
              "type": "string",
              "pattern": "^receipt:[A-Za-z0-9._-]+$"
            },
            "type": {
              "enum": [
                "CALL",
                "RETURN",
                "TRANSITION",
                "WAIT",
                "RESUME",
                "SKIP",
                "ERROR"
              ]
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "skillId": {
              "type": [
                "string",
                "null"
              ]
            },
            "operatorId": {
              "type": [
                "string",
                "null"
              ]
            },
            "parentId": {
              "type": [
                "string",
                "null"
              ]
            },
            "childId": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "progressFingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
