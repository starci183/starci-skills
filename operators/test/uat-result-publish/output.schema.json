{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "test/uat-result-publish" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "result", "gaps", "evidenceRefs"],
      "properties": {
        "outcome": { "description": "Typed final UAT result routed by the Skill machine.", "enum": ["passed", "frontend-counterevidence", "failed", "blocked"] },
        "result": {
          "description": "Canonical PASS or fresh frontend-owned counterevidence product; null for ordinary failure/blocking.",
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["summary", "artifactRefs", "counterevidence"],
              "properties": {
                "summary": { "type": "string", "minLength": 1 },
                "artifactRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "counterevidence": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["findingRef", "ownerSkillId", "resumeState", "snapshotRef", "sourceFingerprint", "evidenceFingerprint", "priorVisualPassRef", "observedAt", "evidenceRefs"],
                      "properties": {
                        "findingRef": { "type": "string", "minLength": 1 },
                        "ownerSkillId": { "const": "starci-fe-process" },
                        "resumeState": { "const": "reapply" },
                        "snapshotRef": { "type": "string", "minLength": 1 },
                        "sourceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                        "evidenceFingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
                        "priorVisualPassRef": { "type": "string", "minLength": 1 },
                        "observedAt": { "type": "string", "format": "date-time" },
                        "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                      }
                    },
                    { "type": "null" }
                  ]
                }
              }
            },
            { "type": "null" }
          ]
        },
        "gaps": { "description": "Exact blockers or frontend counterevidence gaps.", "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidenceRefs": { "description": "Exact evidence consumed by publication.", "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
