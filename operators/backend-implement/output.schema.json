{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/backend-implement/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "backend.implement" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["implemented", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decisionId": { "type": "string", "pattern": "^BA-[0-9]+$" },
    "contractFacet": {
      "enum": [
        "transport",
        "writer",
        "store",
        "transaction",
        "idempotency",
        "migration",
        "exception-identity",
        "authorization",
        "concurrency"
      ]
    },
    "proofKind": {
      "enum": ["unit", "integration", "migration-replay", "conformance-read", "runtime-probe"]
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "implementation",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "backend-implementation" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["implemented", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "implementation": {
          "oneOf": [{ "$ref": "#/$defs/implementation" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "backendSourceRef",
        "sourceHead",
        "artifactRootRef",
        "outcomeId",
        "contractRef",
        "contractFingerprint",
        "authorityFingerprint",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "backendSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "outcomeId": { "type": "string", "minLength": 1 },
        "contractRef": { "type": "string", "minLength": 1 },
        "contractFingerprint": { "$ref": "#/$defs/fingerprint" },
        "authorityFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "changes", "conformance", "proofs", "appliedOperationIds"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operationId", "transport", "facets", "proofKinds", "authorityDecisionIds"],
            "properties": {
              "operationId": { "type": "string", "minLength": 1 },
              "transport": {
                "enum": [
                  "graphql-mutation",
                  "graphql-query",
                  "rest",
                  "worker",
                  "cron",
                  "event-consumer"
                ]
              },
              "facets": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/contractFacet" }
              },
              "proofKinds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/proofKind" }
              },
              "authorityDecisionIds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/decisionId" }
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/change" }
        },
        "conformance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conformance" }
        },
        "proofs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/proof" }
        },
        "appliedOperationIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileRef", "operationId", "changeKind", "beforeHash", "afterHash", "statement"],
      "properties": {
        "fileRef": { "type": "string", "minLength": 1 },
        "operationId": { "type": "string", "minLength": 1 },
        "changeKind": { "enum": ["added", "modified", "deleted"] },
        "beforeHash": {
          "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
        },
        "afterHash": {
          "oneOf": [{ "$ref": "#/$defs/fingerprint" }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "facet", "verdict", "evidenceRef", "statement"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "facet": { "$ref": "#/$defs/contractFacet" },
        "verdict": { "enum": ["conforms", "widened", "narrowed"] },
        "evidenceRef": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "proofKind", "commandRef", "resultRef", "result", "statement"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "proofKind": { "$ref": "#/$defs/proofKind" },
        "commandRef": { "type": "string", "minLength": 1 },
        "resultRef": { "type": "string", "minLength": 1 },
        "result": { "enum": ["passed", "failed"] },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "operationId", "fileRef", "statement"],
      "properties": {
        "code": {
          "enum": [
            "PATTERN_BOUND",
            "NEW_CONVENTION_REFUSED",
            "SNAPSHOT_REVALIDATED",
            "MIGRATION_INCLUDED",
            "EXCEPTION_IDENTITY_REUSED",
            "BUSINESS_QUESTION_RAISED"
          ]
        },
        "operationId": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "fileRef": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "operationIds",
        "fileRefs",
        "missingRefs",
        "retryable",
        "owningDomain"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "CONTRACT_UNFROZEN",
            "CONTRACT_WIDENED",
            "BUSINESS_AUTHORITY_MISSING",
            "OWNER_CONFLICT",
            "PATTERN_UNBOUND",
            "PROOF_UNAVAILABLE",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "operationIds": { "$ref": "#/$defs/refArray" },
        "fileRefs": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["backend", "business", "contract", "platform", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
