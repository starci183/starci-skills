{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/platform-operate/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "platform.operate" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "authority", "capabilities", "inventory", "sourceRefs", "auditRefs"],
      "properties": {
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexRef", "fingerprint", "records"],
          "properties": {
            "indexRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/knowledgeRecord" }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalRef", "planSha256", "allowedEffects", "evidenceRef"],
          "properties": {
            "approvalRef": { "type": "string", "minLength": 1 },
            "planSha256": { "$ref": "#/$defs/fingerprint" },
            "allowedEffects": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/effect" }
            },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityBinding" }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventoryRef", "fingerprint", "resources", "portHolders", "evidenceRefs"],
          "properties": {
            "inventoryRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "resources": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/inventoriedResource" }
            },
            "portHolders": {
              "type": "array",
              "items": { "$ref": "#/$defs/portHolder" }
            },
            "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "auditRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "service",
        "desiredState",
        "portClaims",
        "scope",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "workspaceSourceRef", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "workspaceSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "serviceRef", "ownerRef"],
          "properties": {
            "kind": { "$ref": "#/$defs/serviceKind" },
            "serviceRef": { "type": "string", "minLength": 1 },
            "ownerRef": { "type": "string", "minLength": 1 }
          }
        },
        "desiredState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planSha256", "resourceRefs", "effects", "requiredCheckNames"],
          "properties": {
            "planSha256": { "$ref": "#/$defs/fingerprint" },
            "resourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/effect" }
            },
            "requiredCheckNames": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/checkName" }
            }
          }
        },
        "portClaims": {
          "type": "array",
          "items": { "$ref": "#/$defs/portClaim" }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutableResourceRefs", "observationOnlyResourceRefs"],
          "properties": {
            "mutableResourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "observationOnlyResourceRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "serviceKind": { "enum": ["observability", "sonar", "tunnel"] },
    "knowledgeId": {
      "enum": ["platform.observability", "platform.sonar", "platform.tunnel"]
    },
    "effect": {
      "enum": [
        "update-config",
        "restart-service",
        "upsert-dashboard",
        "update-remote-write",
        "create-project",
        "assign-profile",
        "assign-gate",
        "enforce-setting",
        "create-tunnel",
        "update-tunnel-route",
        "upsert-proxied-dns"
      ]
    },
    "checkName": {
      "enum": [
        "service-health",
        "target-boundary",
        "label-boundary",
        "remote-write-delivery",
        "sample-ordering",
        "retry-backoff",
        "sensitive-data-filter",
        "service-available",
        "project-exists",
        "source-revision",
        "profile-assigned",
        "gate-assigned",
        "enforcement-active",
        "dns-target",
        "tunnel-route",
        "tls",
        "public-https"
      ]
    },
    "capability": {
      "enum": ["metrics:remote-write", "sonar:project-admin", "tunnel:write", "dns:write"]
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "knowledgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeId", "ref", "fingerprint"],
      "properties": {
        "knowledgeId": { "$ref": "#/$defs/knowledgeId" },
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handleRef", "capability", "custodyEvidenceRef"],
      "properties": {
        "handleRef": { "type": "string", "pattern": "^capability://[A-Za-z0-9._/-]+$" },
        "capability": { "$ref": "#/$defs/capability" },
        "custodyEvidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "inventoriedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "kind", "revision", "ownerRef"],
      "properties": {
        "resourceRef": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/serviceKind" },
        "revision": { "type": "string", "minLength": 1 },
        "ownerRef": { "type": "string", "minLength": 1 }
      }
    },
    "portHolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "holderRef", "evidenceRef"],
      "properties": {
        "port": { "$ref": "#/$defs/port" },
        "holderRef": { "type": "string", "minLength": 1 },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "portClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "resourceRef"],
      "properties": {
        "port": { "$ref": "#/$defs/port" },
        "resourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
