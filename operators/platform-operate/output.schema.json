{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/platform-operate/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "platform.operate" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["operated", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "serviceKind": { "enum": ["observability", "sonar", "tunnel"] },
    "effect": {
      "enum": [
        "update-config",
        "restart-service",
        "upsert-dashboard",
        "update-remote-write",
        "create-project",
        "assign-profile",
        "assign-gate",
        "enforce-setting",
        "create-tunnel",
        "update-tunnel-route",
        "upsert-proxied-dns"
      ]
    },
    "checkName": {
      "enum": [
        "service-health",
        "target-boundary",
        "label-boundary",
        "remote-write-delivery",
        "sample-ordering",
        "retry-backoff",
        "sensitive-data-filter",
        "service-available",
        "project-exists",
        "source-revision",
        "profile-assigned",
        "gate-assigned",
        "enforcement-active",
        "dns-target",
        "tunnel-route",
        "tls",
        "public-https"
      ]
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "operation",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "platform-operation-receipt" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["operated", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "operation": {
          "oneOf": [{ "$ref": "#/$defs/operation" }, { "type": "null" }]
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "resume": {
          "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "workspaceSourceRef",
        "sourceHead",
        "artifactRootRef",
        "serviceRef",
        "serviceKind",
        "ownerRef",
        "planSha256",
        "knowledgeFingerprint",
        "inventoryFingerprint",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "workspaceSourceRef": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "serviceRef": { "type": "string", "minLength": 1 },
        "serviceKind": { "$ref": "#/$defs/serviceKind" },
        "ownerRef": { "type": "string", "minLength": 1 },
        "planSha256": { "$ref": "#/$defs/fingerprint" },
        "knowledgeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inventoryFingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convergence",
        "inventoriedResourceRefs",
        "observedPortHolders",
        "appliedEffects",
        "mutations",
        "checks",
        "receiptArtifactRef",
        "receiptArtifactFingerprint"
      ],
      "properties": {
        "convergence": { "enum": ["converged", "already-converged"] },
        "inventoriedResourceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "observedPortHolders": {
          "type": "array",
          "items": { "$ref": "#/$defs/observedPortHolder" }
        },
        "appliedEffects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "mutations": { "type": "array", "items": { "$ref": "#/$defs/mutation" } },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        "receiptArtifactRef": { "type": "string", "minLength": 1 },
        "receiptArtifactFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "observedPortHolder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "holderRef"],
      "properties": {
        "port": { "$ref": "#/$defs/port" },
        "holderRef": { "type": "string", "minLength": 1 }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "resourceRef", "beforeRevision", "afterRevision"],
      "properties": {
        "effect": { "$ref": "#/$defs/effect" },
        "resourceRef": { "type": "string", "minLength": 1 },
        "beforeRevision": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "afterRevision": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "resourceRef", "status", "evidenceRef"],
      "properties": {
        "name": { "$ref": "#/$defs/checkName" },
        "resourceRef": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "resourceRef", "port", "holderRef", "statement"],
      "properties": {
        "code": {
          "enum": [
            "SHARED_SERVICE_INVENTORIED",
            "PORT_COORDINATION_REQUIRED",
            "ALREADY_CONVERGED",
            "PARTIAL_MUTATION",
            "PRODUCT_DEPLOYMENT_DECLINED"
          ]
        },
        "resourceRef": { "type": "string", "minLength": 1 },
        "port": {
          "oneOf": [{ "$ref": "#/$defs/port" }, { "type": "null" }]
        },
        "holderRef": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "resourceRefs", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "SOURCE_DRIFT",
            "AUTHORITY_DRIFT",
            "INVENTORY_DRIFT",
            "CAPABILITY_MISSING",
            "PORT_CONFLICT",
            "EFFECT_UNAUTHORIZED",
            "SERVICE_UNAVAILABLE",
            "PROOF_FAILED",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "resourceRefs": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["platform", "provider", "product", "knowledge", "workspace", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
