{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/architecture-decide/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "architecture.decide" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["businessRefs", "sourceRefs", "inventory", "patternRefs", "priorDecisionRefs"],
      "properties": {
        "businessRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "sourceRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventoryRef", "fingerprint", "components"],
          "properties": {
            "inventoryRef": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "components": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["componentId", "layer", "name", "version", "evidenceRef"],
                "properties": {
                  "componentId": { "$ref": "#/$defs/identifier" },
                  "layer": {
                    "enum": ["runtime", "framework", "persistence", "communication", "build", "deployment", "operations"]
                  },
                  "name": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "version": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "evidenceRef": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "patternRefs": { "$ref": "#/$defs/contextRefArray" },
        "priorDecisionRefs": { "$ref": "#/$defs/contextRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "objective",
        "constraints",
        "selectionPolicy",
        "approval",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "backendSourceRef", "sourceHead", "artifactRootRef"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "backendSourceRef": { "type": "string", "minLength": 1 },
            "sourceHead": { "$ref": "#/$defs/sourceHead" },
            "artifactRootRef": { "type": "string", "minLength": 1 }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["objectiveRef", "decisionId", "tradeoffAxes"],
          "properties": {
            "objectiveRef": { "type": "string", "minLength": 1 },
            "decisionId": { "$ref": "#/$defs/identifier" },
            "tradeoffAxes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 11,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/tradeoffAxis" }
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraintId", "kind", "statement"],
            "properties": {
              "constraintId": { "$ref": "#/$defs/identifier" },
              "kind": { "enum": ["fixed-intent", "measurable", "preference", "assumption", "unknown"] },
              "statement": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        },
        "selectionPolicy": { "enum": ["approval-required", "automatic"] },
        "approval": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["approvalRef", "approvedAlternativeId", "fingerprint"],
              "properties": {
                "approvalRef": { "type": "string", "minLength": 1 },
                "approvedAlternativeId": { "$ref": "#/$defs/identifier" },
                "fingerprint": { "$ref": "#/$defs/fingerprint" }
              }
            }
          ]
        },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceHead": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "tradeoffAxis": {
      "enum": [
        "correctness",
        "ownership",
        "consistency",
        "security",
        "failure",
        "recovery",
        "capacity",
        "cost",
        "latency",
        "migration",
        "operability"
      ]
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "$ref": "#/$defs/sourceHead" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    }
  }
}
