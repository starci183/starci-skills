{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/source/conversation-record/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "source/conversation-record" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "writeAuthority", "currentHead"],
      "properties": {
        "policy": {
          "description": "Active redaction policy and scanner identity that the receipt must match.",
          "type": "object",
          "additionalProperties": false,
          "required": ["policyVersion", "scannerVersion", "evidenceRef"],
          "properties": {
            "policyVersion": { "type": "string", "minLength": 1 },
            "scannerVersion": { "type": "string", "minLength": 1 },
            "evidenceRef": { "type": "string", "minLength": 1 }
          }
        },
        "writeAuthority": {
          "description": "Exact authority for appending a provenance head for this project and role.",
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "project", "role", "authorityRef"],
          "properties": {
            "allowed": { "type": "boolean" },
            "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "authorityRef": { "type": "string", "minLength": 1 }
          }
        },
        "currentHead": {
          "description": "Current durable head for the identity, or null when the append creates its first head.",
          "anyOf": [{ "$ref": "#/$defs/currentHead" }, { "type": "null" }]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "snapshot", "redactionReceipt", "artifactRefs", "sourceRevision"],
      "properties": {
        "identity": {
          "description": "The single provider-neutral identity whose immutable head is being compared and set.",
          "$ref": "#/$defs/identity"
        },
        "snapshot": {
          "description": "Reference and hash for the already-redacted snapshot; raw provider content is outside this boundary.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "sha256", "redacted"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "redacted": { "const": true }
          }
        },
        "redactionReceipt": {
          "description": "Exact proof that the snapshot was produced by the active policy and passed prohibited-category scanning.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "policyVersion", "inputSha256", "outputSha256", "scannerVersion", "prohibitedCategoriesPassed"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "policyVersion": { "type": "string", "minLength": 1 },
            "inputSha256": { "$ref": "#/$defs/sha256" },
            "outputSha256": { "$ref": "#/$defs/sha256" },
            "scannerVersion": { "type": "string", "minLength": 1 },
            "prohibitedCategoriesPassed": { "const": true }
          }
        },
        "artifactRefs": {
          "description": "Bounded immutable artifacts linked to the snapshot head.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceRevision": {
          "description": "Exact source revision associated with the snapshot.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "conversationId", "project", "role"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "conversationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "currentHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "headRef", "headSha256", "snapshotSha256", "evidenceRef"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "headRef": { "type": "string", "minLength": 1 },
        "headSha256": { "$ref": "#/$defs/sha256" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "evidenceRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
