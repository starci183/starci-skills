{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/source/conversation-query/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "source/conversation-query" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "index", "candidateHeads"],
      "properties": {
        "policy": {
          "description": "Revision-bound provenance policy governing authorization and data minimization.",
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "returnRawBodies"],
          "properties": {
            "revision": { "type": "string", "minLength": 1 },
            "returnRawBodies": { "const": false }
          }
        },
        "index": {
          "description": "Exact default-search result generation from which the bounded candidates were resolved.",
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "status", "headsFingerprint", "evidenceRef"],
          "properties": {
            "generation": { "type": "string", "minLength": 1 },
            "status": { "enum": ["current", "stale"] },
            "headsFingerprint": { "$ref": "#/$defs/sha256" },
            "evidenceRef": { "$ref": "#/$defs/evidenceRef" }
          }
        },
        "candidateHeads": {
          "description": "Default-search candidate metadata for only the requested provider-neutral identity; transcript bodies are forbidden.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/head" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "authorizedScope"],
      "properties": {
        "identity": {
          "description": "The single provider-neutral conversation identity to resolve; it contains identifiers only, never query prose or transcript text.",
          "$ref": "#/$defs/identity"
        },
        "authorizedScope": {
          "description": "Exact project and role scope the caller is authorized to inspect.",
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "role", "evidenceRef"],
          "properties": {
            "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "evidenceRef": { "$ref": "#/$defs/evidenceRef" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "conversationId", "project", "role"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "conversationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "headRef", "headSha256", "snapshotSha256", "artifactRefs", "sourceRevision", "evidenceRef"],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "headRef": { "type": "string", "minLength": 1 },
        "headSha256": { "$ref": "#/$defs/sha256" },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "artifactRefs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactRef" } },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "evidenceRef": { "$ref": "#/$defs/evidenceRef" }
      }
    }
  }
}
