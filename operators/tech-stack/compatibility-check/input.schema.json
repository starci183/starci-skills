{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/tech-stack/compatibility-check/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/compatibility-check" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stackModel", "compatibilityEvidence", "deploymentEvidence"],
      "properties": {
        "stackModel": { "$ref": "#/$defs/artifactBinding", "description": "Exact stack-model artifact selected by default file search." },
        "compatibilityEvidence": { "$ref": "#/$defs/evidenceBindings", "description": "Exact compatibility files selected by default file search." },
        "deploymentEvidence": { "$ref": "#/$defs/evidenceBindings", "description": "Exact deployment files selected by default file search." }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "objectiveRef", "expectedModelSha256"],
      "properties": {
        "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Project whose stack model is being checked." },
        "objectiveRef": { "type": "string", "minLength": 1, "description": "Exact objective that defines the required operational compatibility." },
        "expectedModelSha256": { "$ref": "#/$defs/sha256", "description": "Hash of the one stack model authorized for this check." }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "contentSha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactBinding" }
    }
  }
}
