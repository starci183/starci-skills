{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.2/operators/tech-stack/compatibility-check/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/compatibility-check" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "checkedModelSha256", "receiptRef", "checks", "contradictions"],
      "properties": {
        "outcome": { "enum": ["compatible", "revise", "blocked"], "description": "Observed compatibility outcome; only the Skill machine maps it to a next state." },
        "checkedModelSha256": { "$ref": "#/$defs/sha256", "description": "Hash of the exact stack model evaluated." },
        "receiptRef": { "type": ["string", "null"], "minLength": 1, "description": "Ephemeral compatibility receipt for a completed evaluation; null only when evidence blocks evaluation." },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "One typed result for every required compatibility axis.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["axis", "status", "evidenceRefs"],
            "properties": {
              "axis": { "enum": ["runtime-version", "deployable-unit", "communication-failure", "datastore-ownership", "backup-restore"] },
              "status": { "enum": ["passed", "failed", "unknown"] },
              "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "contradictions": {
          "type": "array",
          "uniqueItems": true,
          "description": "Evidence-backed incompatibilities found during the one evaluation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "statement", "evidenceRefs"],
            "properties": {
              "code": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
              "severity": { "enum": ["critical", "major", "minor"] },
              "statement": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
