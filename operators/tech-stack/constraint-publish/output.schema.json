{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/tech-stack/constraint-publish/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/constraint-publish" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "techStackHeadRef", "techStackHeadSha256", "evidenceRefs", "reason"],
      "properties": {
        "outcome": { "description": "Whether the immutable head was published.", "enum": ["published", "blocked"] },
        "techStackHeadRef": { "description": "Published head reference, or null when blocked.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "techStackHeadSha256": { "description": "Published head hash, or null when blocked.", "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "evidenceRefs": { "description": "Exact write and verification evidence for publication.", "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "reason": { "description": "Bounded blocker explanation, or null when published.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
