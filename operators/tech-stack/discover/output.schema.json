{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/tech-stack/discover/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/discover" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "inventoryRef", "inventorySha256", "evidenceRefs", "contradictions", "reason"],
      "properties": {
        "outcome": { "description": "Whether one evidence-bound observed inventory was produced.", "enum": ["ready", "blocked"] },
        "inventoryRef": { "description": "Reference to the observed inventory, or null when blocked.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "inventorySha256": { "description": "Hash of the observed inventory, or null when blocked.", "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "evidenceRefs": { "description": "Exact source evidence supporting inventory facts.", "$ref": "#/$defs/refs" },
        "contradictions": { "description": "Contradictions observed while collecting the inventory.", "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/contradiction" } },
        "reason": { "description": "Bounded blocker explanation, or null when ready.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "contradiction": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "claim", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "severity": { "enum": ["minor", "major", "critical"] }, "claim": { "type": "string", "minLength": 1, "maxLength": 2048 }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
  }
}
