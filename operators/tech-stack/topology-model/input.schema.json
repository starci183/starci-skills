{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/tech-stack/topology-model/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/topology-model" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryRef", "inventorySha256", "businessConstraintRefs", "approvedDecisionRefs"],
      "properties": {
        "inventoryRef": { "description": "Exact observed inventory produced by discovery.", "type": "string", "minLength": 1, "maxLength": 1024 },
        "inventorySha256": { "description": "Hash of the observed inventory.", "$ref": "#/$defs/sha256" },
        "businessConstraintRefs": { "description": "Exact approved business constraints applicable to the topology.", "$ref": "#/$defs/refs" },
        "approvedDecisionRefs": { "description": "Exact approved architecture or operational decisions applicable to the topology.", "$ref": "#/$defs/refs" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "objectiveRef"],
      "properties": {
        "project": { "description": "Project that owns the target topology.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "objectiveRef": { "description": "Objective the target topology must satisfy.", "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
  }
}
