{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/tech-stack/topology-model/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "tech-stack/topology-model" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "stackModelRef", "stackModelSha256", "evidenceRefs", "contradictions", "reason"],
      "properties": {
        "outcome": { "description": "Whether the model is ready, needs a bounded revision, or is blocked.", "enum": ["ready", "revise", "blocked"] },
        "stackModelRef": { "description": "Candidate stack model reference, or null when no model can be emitted.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 },
        "stackModelSha256": { "description": "Candidate stack model hash, or null when no model can be emitted.", "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "evidenceRefs": { "description": "Exact inventory, constraint, and decision evidence used by the model.", "$ref": "#/$defs/refs" },
        "contradictions": { "description": "Structured contradictions that affect model readiness.", "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/contradiction" } },
        "reason": { "description": "Bounded revision or blocker explanation, otherwise null.", "type": ["string", "null"], "minLength": 1, "maxLength": 1024 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "contradiction": { "type": "object", "additionalProperties": false, "required": ["id", "severity", "claim", "evidenceRefs"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "severity": { "enum": ["minor", "major", "critical"] }, "claim": { "type": "string", "minLength": 1, "maxLength": 2048 }, "evidenceRefs": { "$ref": "#/$defs/refs" } } }
  }
}
