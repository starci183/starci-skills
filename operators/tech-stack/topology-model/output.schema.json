{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/tech-stack/topology-model/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "tech-stack.model"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "revise",
        "blocked"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "state",
        "produced",
        "context",
        "cleanup",
        "evidenceRefs",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ready",
            "revise",
            "blocked"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "status",
            "code",
            "retryable",
            "emits"
          ],
          "properties": {
            "operator": {
              "const": "tech-stack/topology-model"
            },
            "status": {
              "enum": [
                "completed",
                "revise",
                "blocked"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "status",
                "factsAdd",
                "factsRemove"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "tech-stack.model"
                  ]
                },
                "status": {
                  "enum": [
                    "ready",
                    "revise",
                    "blocked"
                  ]
                },
                "factsAdd": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "factsRemove": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stackModelRef",
            "stackModelSha256"
          ],
          "properties": {
            "stackModelRef": {
              "type": "string",
              "minLength": 1
            },
            "stackModelSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used"
          ],
          "properties": {
            "used": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratchRefs",
            "retention",
            "purgeAt"
          ],
          "properties": {
            "scratchRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "retention": {
              "const": "until-skill-terminal"
            },
            "purgeAt": {
              "const": "skill-terminal"
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

