{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/workspace/device-checkpoint/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "allOf": [
    {
      "oneOf": [
        { "properties": { "status": { "const": "complete" }, "payload": { "properties": { "decision": { "const": "published" } } } } },
        { "properties": { "status": { "const": "blocked" }, "payload": { "properties": { "decision": { "const": "blocked" } } } } }
      ]
    }
  ],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "workspace.device-checkpoint.result" },
    "status": { "enum": ["complete", "blocked"] },
    "facts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "state", "produced", "context", "cleanup", "evidenceRefs", "findings"],
      "properties": {
        "decision": { "enum": ["published", "blocked"] },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "status", "code", "retryable", "emits"],
          "properties": {
            "operator": { "const": "workspace/device-checkpoint" },
            "status": { "enum": ["completed", "blocked"] },
            "code": { "enum": ["workspace-device-checkpoint-published", "workspace-device-checkpoint-blocked"] },
            "retryable": { "type": "boolean" },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status", "factsAdd"],
              "properties": {
                "stage": { "const": "workspace.device-checkpoint.result" },
                "status": { "enum": ["complete", "blocked"] },
                "factsAdd": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpointReceiptRef", "sourcePushRefs", "releaseRef", "durableWrites"],
          "properties": {
            "checkpointReceiptRef": { "anyOf": [{ "$ref": "#/$defs/sessionRef" }, { "type": "null" }] },
            "sourcePushRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
            "releaseRef": { "anyOf": [{ "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/tag/.+$" }, { "type": "null" }] },
            "durableWrites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "ref", "revision"],
                "properties": {
                  "kind": { "enum": ["session-artifact", "exact-source"] },
                  "ref": { "type": "string", "minLength": 1 },
                  "revision": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scratchRefs", "retention", "purgeAt"],
          "properties": {
            "scratchRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
            "retention": { "const": "until-skill-terminal" },
            "purgeAt": { "const": "skill-terminal" }
          }
        },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } },
        "findings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" }
  }
}
