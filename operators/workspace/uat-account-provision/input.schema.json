{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/workspace/uat-account-provision/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "workspace/uat-account-provision" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRefs", "runtimeOwnerRef", "sourceFingerprint"],
      "properties": {
        "authorityRefs": { "description": "Exact UAT, runtime, and provisioning authority references.", "$ref": "#/$defs/refs" },
        "runtimeOwnerRef": { "description": "Exact ready centralized runtime-owner artifact reference.", "type": "string", "minLength": 1 },
        "sourceFingerprint": { "description": "Frozen source fingerprint bound to the UAT run.", "$ref": "#/$defs/sha256" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionRef", "project", "feature", "flow", "runId", "role", "origin", "accountRecordRef", "fixtureNamespace"],
      "properties": {
        "missionRef": { "description": "Canonical mission identity owning the account and Browser lease.", "type": "string", "minLength": 1 },
        "project": { "description": "Verified routed product project.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "feature": { "description": "Canonical UAT feature key.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "flow": { "description": "Canonical UAT flow key.", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "runId": { "description": "Fresh run identity used to isolate the account and fixtures.", "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "role": { "description": "Product role provisioned for this UAT flow.", "const": "learner" },
        "origin": { "description": "Exact frontend origin from the ready runtime owner.", "type": "string", "pattern": "^http://localhost:[1-9][0-9]{0,4}$" },
        "accountRecordRef": { "description": "Future canonical snapshot fragment that will persist the non-secret account record.", "type": "string", "pattern": "^\\.worktrees/uat/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/snapshot\\.json#account$" },
        "fixtureNamespace": { "description": "Exact run namespace applied to UAT-owned mutable records.", "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "refs": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
  }
}
