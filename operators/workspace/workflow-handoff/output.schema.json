{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starci.dev/v7/operators/workspace/workflow-handoff/output.schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","operatorId","output"],
  "properties":{"schemaVersion":{"const":7},"operatorId":{"const":"workspace/workflow-handoff"},"output":{"type":"object","additionalProperties":false,"required":["outcome","resultKind","checkpointTag","sourcePushRefs","resumeCapability","resumePoint","receiptRef","evidenceRefs","findings","reason"],"properties":{"outcome":{"enum":["published","resumed","blocked"],"description":"Typed atomic result consumed by the parent Skill machine."},"resultKind":{"enum":["published-checkpoint","resumed-checkpoint","none"],"description":"Domain result identity that agrees with outcome."},"checkpointTag":{"type":["string","null"],"pattern":"^starci-workflow/[a-z0-9][a-z0-9._-]*/[0-9]{8}-[1-9][0-9]*$","description":"Published or adopted continuation tag."},"sourcePushRefs":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^(?:git:|refs/).+","maxLength":1024},"description":"Mission-owned Git heads."},"resumeCapability":{"type":["string","null"],"pattern":"^starci-[a-z0-9-]+$","description":"Capability encoded in the checkpoint."},"resumePoint":{"type":["string","null"],"pattern":"^[a-z0-9][a-z0-9.-]*$","description":"Portable next-work marker."},"receiptRef":{"type":["string","null"],"pattern":"^session://tasks/[A-Za-z0-9._-]+/.+","description":"Ephemeral execution proof receipt."},"evidenceRefs":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024},"description":"Exact supporting evidence."},"findings":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":2048},"description":"Bounded findings."},"reason":{"type":["string","null"],"minLength":1,"maxLength":2048,"description":"Blocker explanation, otherwise null."}}}}
}
