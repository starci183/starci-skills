{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://starci.dev/v7/operators/workspace/workflow-handoff/input.schema.json","type":"object","additionalProperties":false,"required":["schemaVersion","operatorId","context","input"],
  "properties":{"schemaVersion":{"const":7},"operatorId":{"const":"workspace/workflow-handoff"},"context":{"type":"object","additionalProperties":false,"required":["routeReceiptRef","approvalRef","touchedCheckoutRefs"],"properties":{"routeReceiptRef":{"$ref":"#/$defs/exactRef","description":"Exact routed-checkout receipt."},"approvalRef":{"$ref":"#/$defs/exactRef","description":"Exact explicit-authorization receipt."},"touchedCheckoutRefs":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/exactRef"},"description":"Exact mission-owned checkout receipts."}}},"input":{"type":"object","additionalProperties":false,"required":["operation","missionId","checkpointTag","resumeCapability","resumePoint","durableArtifactRefs"],"properties":{"operation":{"enum":["publish","resume"],"description":"One portable checkpoint operation."},"missionId":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$","description":"Stable mission identity."},"checkpointTag":{"type":["string","null"],"pattern":"^starci-workflow/[a-z0-9][a-z0-9._-]*/[0-9]{8}-[1-9][0-9]*$","description":"Exact continuation tag for resume, null for publish."},"resumeCapability":{"type":"string","pattern":"^starci-[a-z0-9-]+$","description":"Capability that continues the mission."},"resumePoint":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*$","description":"Portable next-work marker without conversation content."},"durableArtifactRefs":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^(?:request|business|architecture|design|git|release):[^\\s]+$","maxLength":1024},"description":"Minimal durable references; session-only references are forbidden."}}}},
  "$defs":{"exactRef":{"type":"string","pattern":"^(?:session://tasks/[A-Za-z0-9._-]+/|git:|refs/).+","maxLength":1024}}
}
