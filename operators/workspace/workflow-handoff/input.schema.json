{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v6/operators/workspace/workflow-handoff/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "stage", "status", "facts", "payload"],
  "properties": {
    "schemaVersion": { "const": 6 },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "const": "workspace.workflow-handoff" },
    "status": { "const": "ready" },
    "facts": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provided", "loads", "session"],
      "properties": {
        "provided": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "routeReceiptRef", "approvalRef", "missionId", "checkpointTag", "resumeCapability", "resumeStage", "durableArtifactRefs", "touchedCheckoutRefs"],
          "properties": {
            "mode": { "enum": ["publish", "resume"] },
            "routeReceiptRef": { "$ref": "#/$defs/sessionRef" },
            "approvalRef": { "$ref": "#/$defs/reference" },
            "missionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
            "checkpointTag": {
              "anyOf": [
                { "type": "string", "pattern": "^starci-workflow/[a-z0-9][a-z0-9._-]{2,79}/[a-z0-9][a-z0-9._-]{0,79}$" },
                { "type": "null" }
              ]
            },
            "resumeCapability": {
              "anyOf": [
                { "type": "string", "pattern": "^starci-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                { "type": "null" }
              ]
            },
            "resumeStage": {
              "anyOf": [
                { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
                { "type": "null" }
              ]
            },
            "durableArtifactRefs": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/durableRef" } },
            "touchedCheckoutRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/sessionRef" } }
          }
        },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifacts", "knowledge", "orchestration"],
          "properties": {
            "artifacts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 52,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "revision", "loadMode"],
                "properties": {
                  "ref": { "$ref": "#/$defs/reference" },
                  "revision": { "$ref": "#/$defs/sha256" },
                  "loadMode": { "const": "session-exact" }
                }
              }
            },
            "knowledge": { "type": "array", "maxItems": 0 },
            "orchestration": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "profileRef", "providerRef"],
              "properties": {
                "mode": { "enum": ["economical", "balanced", "parallel"] },
                "profileRef": { "enum": ["orchestration/modes/economical.json", "orchestration/modes/balanced.json", "orchestration/modes/parallel.json"] },
                "providerRef": { "type": "string", "pattern": "^orchestration/providers/[a-z0-9-]+\\.json$" }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskId", "inputRef", "outputRef", "scratchPrefix", "retention"],
          "properties": {
            "taskId": { "type": "string", "minLength": 1 },
            "inputRef": { "$ref": "#/$defs/sessionRef" },
            "outputRef": { "$ref": "#/$defs/sessionRef" },
            "scratchPrefix": { "$ref": "#/$defs/sessionRef" },
            "retention": { "const": "until-skill-terminal" }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sessionRef": { "type": "string", "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$" },
    "reference": { "type": "string", "pattern": "^(?:session://tasks/[A-Za-z0-9._-]+/.+|receipt:sha256:[0-9a-f]{64})$" },
    "durableRef": { "type": "string", "pattern": "^(?:git:(?:commit|tag):[A-Za-z0-9._/-]+|request:[A-Za-z0-9._/-]+|artifact:sha256:[0-9a-f]{64}|receipt:sha256:[0-9a-f]{64})$" }
  }
}
