{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/workspace-bind/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "workspace.bind" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrapRefs",
        "declarationRefs",
        "portableRoute",
        "hydratedRoute",
        "identity",
        "runtime",
        "provenance",
        "cachedRouteReceipt",
        "hints"
      ],
      "properties": {
        "bootstrapRefs": { "$ref": "#/$defs/nonEmptyContextRefArray" },
        "declarationRefs": { "$ref": "#/$defs/contextRefArray" },
        "portableRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "fingerprint", "project", "role", "repository"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "project": { "$ref": "#/$defs/slug" },
            "role": { "$ref": "#/$defs/slug" },
            "repository": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "directory", "gitRepository", "branch"],
              "properties": {
                "kind": { "enum": ["source", "sibling"] },
                "directory": {
                  "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                },
                "gitRepository": { "type": "string", "minLength": 1 },
                "branch": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "hydratedRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "fingerprint",
            "project",
            "role",
            "sourceRootPath",
            "workspaceRootPath",
            "repository"
          ],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "project": { "$ref": "#/$defs/slug" },
            "role": { "$ref": "#/$defs/slug" },
            "sourceRootPath": { "type": "string", "minLength": 1 },
            "workspaceRootPath": { "type": "string", "minLength": 1 },
            "repository": {
              "type": "object",
              "additionalProperties": false,
              "required": ["diskPath", "gitRoot", "gitRepository", "branch"],
              "properties": {
                "diskPath": { "type": "string", "minLength": 1 },
                "gitRoot": { "type": "string", "minLength": 1 },
                "gitRepository": { "type": "string", "minLength": 1 },
                "branch": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "fingerprint", "machineId", "credentialRosterRef", "rosterEncrypted"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "machineId": { "$ref": "#/$defs/slug" },
            "credentialRosterRef": { "type": "string", "minLength": 1 },
            "rosterEncrypted": { "const": true }
          }
        },
        "runtime": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runtimeOwner" }]
        },
        "provenance": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/provenanceHead" }]
        },
        "cachedRouteReceipt": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cachedRouteReceipt" }]
        },
        "hints": {
          "type": "array",
          "items": { "$ref": "#/$defs/hint" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "role",
        "frozenSourceHead",
        "gitPolicy",
        "observedCheckout",
        "declaredWriteRoots",
        "runtimeNeed",
        "artifactRootRef",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/slug" },
        "role": { "$ref": "#/$defs/slug" },
        "frozenSourceHead": { "$ref": "#/$defs/gitHead" },
        "gitPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worktreeBranches", "mutationBranch"],
          "properties": {
            "worktreeBranches": { "enum": ["forbidden", "allowed"] },
            "mutationBranch": { "type": "string", "minLength": 1 }
          }
        },
        "observedCheckout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diskPath", "branch", "head", "originUrl", "dirtyPaths"],
          "properties": {
            "diskPath": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "minLength": 1 },
            "head": { "$ref": "#/$defs/gitHead" },
            "originUrl": { "type": "string", "minLength": 1 },
            "dirtyPaths": { "$ref": "#/$defs/refArray" }
          }
        },
        "declaredWriteRoots": { "$ref": "#/$defs/nonEmptyRefArray" },
        "runtimeNeed": { "enum": ["none", "consume"] },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "serviceKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "localOrigin": { "type": "string", "pattern": "^http://localhost:[0-9]{1,5}$" },
    "runtimeOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryRef",
        "fingerprint",
        "ownerTaskId",
        "generation",
        "status",
        "endpointBinding",
        "endpoints",
        "healthEvidenceRefs"
      ],
      "properties": {
        "registryRef": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "ownerTaskId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["starting", "ready", "degraded", "stopped"] },
        "endpointBinding": { "$ref": "#/$defs/endpointBinding" },
        "endpoints": { "$ref": "#/$defs/endpointTriple" },
        "healthEvidenceRefs": { "$ref": "#/$defs/refArray" }
      }
    },
    "endpointBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "project", "application", "services", "authorityFingerprint"],
      "properties": {
        "authority": { "const": "workspace-route-port-projection" },
        "project": { "$ref": "#/$defs/slug" },
        "application": { "$ref": "#/$defs/slug" },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frontend", "api", "identity"],
          "properties": {
            "frontend": { "$ref": "#/$defs/serviceKey" },
            "api": { "$ref": "#/$defs/serviceKey" },
            "identity": { "$ref": "#/$defs/serviceKey" }
          }
        },
        "authorityFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "endpointTriple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "api", "identity"],
      "properties": {
        "frontend": { "$ref": "#/$defs/localOrigin" },
        "api": { "$ref": "#/$defs/localOrigin" },
        "identity": { "$ref": "#/$defs/localOrigin" }
      }
    },
    "provenanceHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headRef", "headSha256", "snapshotSha256", "sourceRevision", "redacted"],
      "properties": {
        "headRef": { "type": "string", "minLength": 1 },
        "headSha256": { "$ref": "#/$defs/fingerprint" },
        "snapshotSha256": { "$ref": "#/$defs/fingerprint" },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "redacted": { "const": true }
      }
    },
    "cachedRouteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptRef", "project", "role", "routeFingerprint", "sourceHead", "status"],
      "properties": {
        "receiptRef": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/slug" },
        "role": { "$ref": "#/$defs/slug" },
        "routeFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": { "$ref": "#/$defs/gitHead" },
        "status": { "enum": ["fresh", "stale", "invalid"] }
      }
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "authoritative"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["similar-name", "sibling-directory", "working-directory", "browser-url"] },
        "authoritative": { "const": false }
      }
    },
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fingerprint", "sourceHead", "observedAt"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceHead": {
          "oneOf": [{ "$ref": "#/$defs/gitHead" }, { "type": "null" }]
        },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "contextRefArray": { "type": "array", "items": { "$ref": "#/$defs/contextRef" } },
    "nonEmptyContextRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contextRef" }
    },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
