{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/git-publish/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "context", "input"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "git.publish" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routeReceipt",
        "approval",
        "gitPolicy",
        "hookInventory",
        "remote",
        "completionProofRefs"
      ],
      "properties": {
        "routeReceipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "fingerprint", "status", "project", "role", "checkoutDiskPath", "sourceHead"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "status": { "const": "bound" },
            "project": { "$ref": "#/$defs/slug" },
            "role": { "$ref": "#/$defs/slug" },
            "checkoutDiskPath": { "type": "string", "minLength": 1 },
            "sourceHead": { "$ref": "#/$defs/gitHead" }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "fingerprint", "scopeUnit", "approvedAt"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "fingerprint": { "$ref": "#/$defs/fingerprint" },
            "scopeUnit": { "$ref": "#/$defs/boundaryUnit" },
            "approvedAt": { "type": "string", "format": "date-time" }
          }
        },
        "gitPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worktreeBranches", "mutationBranch", "forcePush", "historyRewrite"],
          "properties": {
            "worktreeBranches": { "enum": ["forbidden", "allowed"] },
            "mutationBranch": { "type": "string", "minLength": 1 },
            "forcePush": { "const": false },
            "historyRewrite": { "const": false }
          }
        },
        "hookInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hook", "ref", "fingerprint", "enforced"],
            "properties": {
              "hook": { "$ref": "#/$defs/hookName" },
              "ref": { "type": "string", "minLength": 1 },
              "fingerprint": { "$ref": "#/$defs/fingerprint" },
              "enforced": { "const": true }
            }
          }
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "ref", "remoteHead", "observedAt"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "ref": { "$ref": "#/$defs/branchRef" },
            "remoteHead": {
              "oneOf": [{ "$ref": "#/$defs/gitHead" }, { "type": "null" }]
            },
            "observedAt": { "type": "string", "format": "date-time" }
          }
        },
        "completionProofRefs": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationId",
        "missionId",
        "project",
        "boundary",
        "sourceHeads",
        "workingTree",
        "publication",
        "destructiveOperations",
        "artifactRootRef",
        "resume"
      ],
      "properties": {
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/slug" },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "targetRefs", "writeRoots", "exclusionRefs"],
          "properties": {
            "unit": { "$ref": "#/$defs/boundaryUnit" },
            "targetRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
            "writeRoots": { "$ref": "#/$defs/nonEmptyRefArray" },
            "exclusionRefs": { "$ref": "#/$defs/refArray" }
          }
        },
        "sourceHeads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkoutRef", "branch", "head", "upstreamHead", "aheadCount", "behindCount"],
            "properties": {
              "checkoutRef": { "type": "string", "minLength": 1 },
              "branch": { "type": "string", "minLength": 1 },
              "head": { "$ref": "#/$defs/gitHead" },
              "upstreamHead": {
                "oneOf": [{ "$ref": "#/$defs/gitHead" }, { "type": "null" }]
              },
              "aheadCount": { "type": "integer", "minimum": 0 },
              "behindCount": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "workingTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dirtyPaths", "untrackedPaths"],
          "properties": {
            "dirtyPaths": { "$ref": "#/$defs/refArray" },
            "untrackedPaths": { "$ref": "#/$defs/refArray" }
          }
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branchRef", "mode", "annotatedTag"],
          "properties": {
            "branchRef": { "$ref": "#/$defs/branchRef" },
            "mode": { "const": "fast-forward-only" },
            "annotatedTag": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "message", "annotated"],
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                    "message": { "type": "string", "minLength": 1 },
                    "annotated": { "const": true }
                  }
                }
              ]
            }
          }
        },
        "destructiveOperations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forcePush",
            "historyRewrite",
            "resetHard",
            "clean",
            "stash",
            "branchDelete",
            "hookBypass"
          ],
          "properties": {
            "forcePush": { "const": false },
            "historyRewrite": { "const": false },
            "resetHard": { "const": false },
            "clean": { "const": false },
            "stash": { "const": false },
            "branchDelete": { "const": false },
            "hookBypass": { "const": false }
          }
        },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "resume": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockedReceiptRef", "resumeToken", "addedContextRefs"],
              "properties": {
                "blockedReceiptRef": { "type": "string", "minLength": 1 },
                "resumeToken": { "type": "string", "minLength": 1 },
                "addedContextRefs": { "$ref": "#/$defs/refArray" }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "boundaryUnit": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "branchRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._\\-/]*$" },
    "hookName": { "enum": ["pre-commit", "commit-msg", "pre-push"] },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
