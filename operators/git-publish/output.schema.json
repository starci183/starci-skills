{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v8/operators/git-publish/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 8 },
    "operatorId": { "const": "git.publish" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receipt", "evidenceRefs", "artifactRefs", "handoff"],
      "properties": {
        "outcome": { "enum": ["published", "blocked"] },
        "receipt": { "$ref": "#/$defs/receipt" },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "artifactRefs": { "$ref": "#/$defs/refArray" },
        "handoff": { "type": "null" }
      }
    }
  },
  "$defs": {
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "boundaryUnit": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "branchRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._\\-/]*$" },
    "tagRef": { "type": "string", "pattern": "^refs/tags/[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "hookName": { "enum": ["pre-commit", "commit-msg", "pre-push"] },
    "refArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyRefArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "receiptId",
        "invocationId",
        "missionId",
        "status",
        "binding",
        "publication",
        "findings",
        "evidenceRefs",
        "failure",
        "resume",
        "createdAt"
      ],
      "properties": {
        "receiptType": { "const": "git-publication" },
        "receiptId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["published", "blocked"] },
        "binding": { "$ref": "#/$defs/binding" },
        "publication": { "oneOf": [{ "$ref": "#/$defs/publication" }, { "type": "null" }] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefArray" },
        "failure": { "oneOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }] },
        "resume": { "oneOf": [{ "$ref": "#/$defs/resume" }, { "type": "null" }] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "routeReceiptRef",
        "approvalRef",
        "boundaryUnit",
        "worktreeBranches",
        "mutationBranch",
        "frozenSourceHead",
        "artifactRootRef",
        "inputFingerprint",
        "progressFingerprint"
      ],
      "properties": {
        "projectId": { "$ref": "#/$defs/slug" },
        "routeReceiptRef": { "type": "string", "minLength": 1 },
        "approvalRef": { "type": "string", "minLength": 1 },
        "boundaryUnit": { "$ref": "#/$defs/boundaryUnit" },
        "worktreeBranches": { "enum": ["forbidden", "allowed"] },
        "mutationBranch": { "type": "string", "minLength": 1 },
        "frozenSourceHead": { "$ref": "#/$defs/gitHead" },
        "artifactRootRef": { "type": "string", "minLength": 1 },
        "inputFingerprint": { "$ref": "#/$defs/fingerprint" },
        "progressFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationRecordRef",
        "remoteName",
        "branchRef",
        "mode",
        "forced",
        "publishedHeads",
        "annotatedTag",
        "hookResults"
      ],
      "properties": {
        "publicationRecordRef": { "type": "string", "minLength": 1 },
        "remoteName": { "type": "string", "minLength": 1 },
        "branchRef": { "$ref": "#/$defs/branchRef" },
        "mode": { "const": "fast-forward-only" },
        "forced": { "const": false },
        "publishedHeads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publishedHead" }
        },
        "annotatedTag": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "ref", "head", "annotated"],
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                "ref": { "$ref": "#/$defs/tagRef" },
                "head": { "$ref": "#/$defs/gitHead" },
                "annotated": { "const": true }
              }
            }
          ]
        },
        "hookResults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hook", "ref", "outcome"],
            "properties": {
              "hook": { "$ref": "#/$defs/hookName" },
              "ref": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["passed", "failed"] }
            }
          }
        }
      }
    },
    "publishedHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkoutRef", "branch", "head", "previousRemoteHead", "commitCount"],
      "properties": {
        "checkoutRef": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "head": { "$ref": "#/$defs/gitHead" },
        "previousRemoteHead": {
          "oneOf": [{ "$ref": "#/$defs/gitHead" }, { "type": "null" }]
        },
        "commitCount": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subject", "statement"],
      "properties": {
        "code": {
          "enum": [
            "HOOK_ENFORCED",
            "BOUNDARY_CLEAN",
            "REMOTE_FAST_FORWARDED",
            "REMOTE_REF_CREATED",
            "CONTINUATION_TAG_PUBLISHED"
          ]
        },
        "subject": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "subjects", "missingRefs", "retryable", "owningDomain"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "ROUTE_UNVERIFIED",
            "APPROVAL_MISSING",
            "BRANCH_POLICY_VIOLATION",
            "DIRTY_OUTSIDE_BOUNDARY",
            "HOOK_BLOCKED",
            "NON_FAST_FORWARD",
            "SOURCE_DRIFT",
            "NO_PROGRESS"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "subjects": { "$ref": "#/$defs/refArray" },
        "missingRefs": { "$ref": "#/$defs/refArray" },
        "retryable": { "type": "boolean" },
        "owningDomain": {
          "enum": ["workspace", "source", "remote", "caller"]
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumeToken", "requiredDelta"],
      "properties": {
        "resumeToken": { "type": "string", "minLength": 1 },
        "requiredDelta": { "$ref": "#/$defs/nonEmptyRefArray" }
      }
    }
  }
}
