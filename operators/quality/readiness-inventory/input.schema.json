{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/quality/readiness-inventory/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "context",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "quality/readiness-inventory"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextRefs",
        "sourceRefs"
      ],
      "properties": {
        "contextRefs": {
          "description": "Exact canonical references resolved with default repository or file search.",
          "$ref": "#/$defs/refs"
        },
        "sourceRefs": {
          "description": "Exact routed source references allowed for this job.",
          "$ref": "#/$defs/refs"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "objectiveRef",
        "sourceFingerprint",
        "debtPolicy",
        "origin"
      ],
      "properties": {
        "project": {
          "description": "Verified project identity for this job.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "objectiveRef": {
          "description": "Exact bounded objective reference.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceFingerprint": {
          "description": "Frozen fingerprint for the supplied source evidence.",
          "$ref": "#/$defs/sha256"
        },
        "debtPolicy": {
          "description": "Exact mutation/debt policy projected from the Quality mission.",
          "enum": ["allowed", "forbidden"]
        },
        "origin": {
          "description": "Exact final frontend visual PASS projection for verification-only Quality, otherwise null.",
          "$ref": "#/$defs/feOrigin"
        }
      }
    }
  },
  "$defs": {
    "feOrigin": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromSkillId", "visualPassReturnReceiptRef", "sourceFingerprint", "evidenceFingerprint", "auditRefs"],
          "properties": {
            "fromSkillId": { "const": "starci-fe-process" },
            "visualPassReturnReceiptRef": { "type": "string", "pattern": "^receipt:[A-Za-z0-9._-]+$" },
            "sourceFingerprint": { "$ref": "#/$defs/sha256" },
            "evidenceFingerprint": { "$ref": "#/$defs/sha256" },
            "auditRefs": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "(^|[\\\\/])audit\\.md$" } }
          }
        },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
