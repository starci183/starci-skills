{
  "$id": "https://starci.dev/v6/operators/quality/finding-repair/output.schema.json",
  "title": "quality/finding-repair operator output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "status",
    "facts",
    "payload"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "stage": {
              "const": "quality.repair.result"
            },
            "status": {
              "const": "complete"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "quality.blocked"
            },
            "status": {
              "const": "blocked"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        },
        {
          "properties": {
            "stage": {
              "const": "quality.inventory"
            },
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "stage",
            "status"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "quality.repair.result",
        "quality.blocked",
        "quality.inventory"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "ready"
      ]
    },
    "facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "state",
        "produced",
        "context",
        "cleanup",
        "evidenceRefs",
        "findings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "repaired",
            "boundary-drift",
            "stale-finding",
            "external-blocker"
          ]
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "status",
            "code",
            "retryable",
            "emits"
          ],
          "properties": {
            "operator": {
              "const": "quality/finding-repair"
            },
            "status": {
              "enum": [
                "completed",
                "replan",
                "blocked"
              ]
            },
            "code": {
              "enum": [
                "quality-finding-repair-repaired",
                "quality-finding-repair-boundary-drift",
                "quality-finding-repair-stale-finding",
                "quality-finding-repair-external-blocker"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "emits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "status",
                "factsAdd"
              ],
              "properties": {
                "stage": {
                  "enum": [
                    "quality.repair.result",
                    "quality.blocked",
                    "quality.inventory"
                  ]
                },
                "status": {
                  "enum": [
                    "complete",
                    "blocked",
                    "ready"
                  ]
                },
                "factsAdd": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "produced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repairReceiptRef",
            "decisionProof",
            "durableWrites"
          ],
          "properties": {
            "repairReceiptRef": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sessionRef"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decisionProof": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "kind",
                "findingFingerprint",
                "approvalFingerprint",
                "observedBaseline",
                "changedTargets",
                "reinventoryRequired"
              ],
              "properties": {
                "ref": {
                  "$ref": "#/$defs/sessionRef"
                },
                "kind": {
                  "enum": [
                    "mutation-applied",
                    "finding-revision-mismatch",
                    "boundary-expansion-required",
                    "external-verdict-unavailable"
                  ]
                },
                "findingFingerprint": {
                  "$ref": "#/$defs/sha256"
                },
                "approvalFingerprint": {
                  "$ref": "#/$defs/sha256"
                },
                "observedBaseline": {
                  "$ref": "#/$defs/sha256"
                },
                "changedTargets": {
                  "type": "integer",
                  "minimum": 0
                },
                "reinventoryRequired": {
                  "type": "boolean"
                }
              }
            },
            "durableWrites": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used"
          ],
          "properties": {
            "used": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "ref",
                  "revision"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "session-artifact",
                      "worktree-business",
                      "qdrant-knowledge",
                      "exact-source",
                      "exact-command"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scratchRefs",
            "retention",
            "purgeAt"
          ],
          "properties": {
            "scratchRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/sessionRef"
              }
            },
            "retention": {
              "const": "until-skill-terminal"
            },
            "purgeAt": {
              "const": "skill-terminal"
            }
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sessionRef"
          }
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$"
    }
  }
}
