{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7/operators/quality/delivery-proof/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 7
    },
    "operatorId": {
      "const": "quality/delivery-proof"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "resultRef",
        "evidenceRefs",
        "findings",
        "reason",
        "adversarialDecision"
      ],
      "properties": {
        "outcome": {
          "description": "Typed atomic result consumed by the parent Skill machine.",
          "enum": [
            "blocked",
            "pass"
          ]
        },
        "resultRef": {
          "description": "Exact produced artifact or receipt reference, or null.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "evidenceRefs": {
          "description": "Exact references supporting the result.",
          "$ref": "#/$defs/refs"
        },
        "findings": {
          "description": "Bounded observable findings produced by this job.",
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "reason": {
          "description": "Bounded explanation when no result is produced, otherwise null.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        },
        "adversarialDecision": {
          "description": "Evidence-backed neutral consideration of adding, changing, and removing capability before terminal quality PASS.",
          "type": "object",
          "additionalProperties": false,
          "required": ["add", "change", "remove"],
          "properties": {
            "add": { "$ref": "#/$defs/adversarialDirection" },
            "change": { "$ref": "#/$defs/adversarialDirection" },
            "remove": { "$ref": "#/$defs/adversarialDirection" }
          }
        }
      }
    }
  },
  "$defs": {
    "adversarialDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "rationale", "evidenceRefs"],
      "properties": {
        "disposition": { "enum": ["adopt", "reject", "not-applicable"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" }
      }
    },
    "nonEmptyRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
