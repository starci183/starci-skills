{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v7.0/operators/context/freshness-check/output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operatorId", "output"],
  "properties": {
    "schemaVersion": { "const": 7 },
    "operatorId": { "const": "context/freshness-check" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "receiptRef", "reason", "evidenceRefs"],
      "properties": {
        "outcome": { "enum": ["fresh", "initialize-required", "blocked"], "description": "Observed freshness outcome; the Skill machine alone maps it to a next state." },
        "receiptRef": { "type": ["string", "null"], "pattern": "^session://tasks/[A-Za-z0-9._-]+/.+$", "description": "Exact cached receipt when the outcome is fresh; otherwise null." },
        "reason": { "enum": ["current", "missing", "identity-drift", "invalid"], "description": "Single evidence-backed reason for the observed outcome." },
        "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "Metadata evidence inspected for the comparison." }
      }
    }
  }
}
