{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/deployment/schema.json",
  "title": "StarCi deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "environment", "ownerRole", "roles", "stack", "infra", "host", "artifacts", "domains", "deploy", "monitor"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "project": {"$ref": "#/$defs/slug"},
    "environment": {"$ref": "#/$defs/slug"},
    "ownerRole": {"$ref": "#/$defs/slug"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "runtime", "credentialRefs"],
      "properties": {
        "root": {"type": "string", "pattern": "^\\.stacks/[^/]+$"},
        "runtime": {"enum": ["docker-swarm", "docker-compose", "kubernetes"]},
        "credentialRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "workingDirectories"],
      "properties": {
        "root": {"type": "string", "pattern": "^\\.infra/[a-z0-9][a-z0-9-]*$"},
        "workingDirectories": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "addressRef", "runtimeSetup"],
      "properties": {
        "transport": {"const": "ssh"},
        "addressRef": {"type": "string", "minLength": 1},
        "userRef": {"type": "string", "minLength": 1},
        "portRef": {"type": "string", "minLength": 1},
        "forbiddenAddressRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runtimeSetup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["driver", "path"],
          "properties": {
            "driver": {"enum": ["script", "terraform-template"]},
            "path": {"$ref": "#/$defs/relativePath"}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "source", "image", "target"],
        "properties": {
          "name": {"$ref": "#/$defs/slug"},
          "role": {"$ref": "#/$defs/slug"},
          "source": {"$ref": "#/$defs/relativePath"},
          "image": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "frontend": {"$ref": "#/$defs/frontendArtifact"}
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "owner", "driver", "definition"],
        "properties": {
          "hostname": {"$ref": "#/$defs/hostname"},
          "owner": {"enum": ["platform", "tenant", "shared"]},
          "driver": {"enum": ["terraform", "cloudflare-tunnel"]},
          "definition": {"$ref": "#/$defs/relativePath"},
          "artifact": {"$ref": "#/$defs/slug"},
          "primary": {"type": "boolean"},
          "origin": {"type": "string", "pattern": "^https?://"},
          "tunnel": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"driver": {"const": "cloudflare-tunnel"}}},
            "then": {"required": ["origin", "tunnel"]},
            "else": {"not": {"anyOf": [{"required": ["origin"]}, {"required": ["tunnel"]}]}}
          }
        ]
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "role", "workflow", "ref", "verification"],
      "properties": {
        "driver": {"enum": ["github-actions", "local"]},
        "role": {"$ref": "#/$defs/slug"},
        "workflow": {"$ref": "#/$defs/relativePath"},
        "ref": {"type": "string", "minLength": 1},
        "rollbackInput": {"type": "string", "minLength": 1},
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds", "steadySeconds", "timeoutSeconds", "probes"],
      "properties": {
        "intervalSeconds": {"type": "integer", "minimum": 5},
        "steadySeconds": {"type": "integer", "minimum": 0},
        "timeoutSeconds": {"type": "integer", "minimum": 30},
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "target"],
            "properties": {
              "name": {"$ref": "#/$defs/slug"},
              "kind": {"enum": ["http", "tcp", "swarm-service", "kubernetes", "command"]},
              "target": {"type": "string", "minLength": 1},
              "expectedStatus": {"type": "integer", "minimum": 100, "maximum": 599},
              "role": {"$ref": "#/$defs/slug"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "hostname": {"type": "string", "pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+"},
    "frontendArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "layout", "surface", "buildContext", "dockerfile", "stackDefinition"],
      "properties": {
        "framework": {"const": "nextjs"},
        "layout": {"enum": ["single-app", "monorepo"]},
        "surface": {"$ref": "#/$defs/slug"},
        "buildContext": {"$ref": "#/$defs/relativePath"},
        "dockerfile": {"$ref": "#/$defs/relativePath"},
        "stackDefinition": {"$ref": "#/$defs/relativePath"}
      }
    }
  }
}
