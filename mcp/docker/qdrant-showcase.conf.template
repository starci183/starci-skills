limit_req_zone $binary_remote_addr zone=qdrant_showcase:10m rate=20r/s;

upstream qdrant_private {
    server qdrant-context:6333;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 128k;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = / {
        return 302 /dashboard;
    }

    # Qdrant's visual explorer uses POST for read-only vector operations.
    location ~ ^/collections/starci-context-v1/points/(scroll|search|query|count|recommend|discover)$ {
        limit_req zone=qdrant_showcase burst=40 nodelay;
        if ($request_method !~ ^(POST|OPTIONS)$) { return 405; }
        proxy_pass http://qdrant_private;
        proxy_set_header api-key "${QDRANT_MCP_API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header api-key;
    }

    # Static dashboard assets and Qdrant's GET-only inspection endpoints.
    location / {
        limit_req zone=qdrant_showcase burst=80 nodelay;
        limit_except GET HEAD OPTIONS { deny all; }
        proxy_pass http://qdrant_private;
        proxy_set_header api-key "${QDRANT_MCP_API_KEY}";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header api-key;
    }
}
