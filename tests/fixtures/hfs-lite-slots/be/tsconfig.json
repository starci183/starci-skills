{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@modules/*": [
        "./src/modules/*"
      ],
      "@tests/*": [
        "./src/tests/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
