{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v5/platform/readiness/staleness/port-offset/schema.json",
  "title": "Source project port allocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "offset", "applications"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "offset": {"type": "integer", "minimum": 0},
    "applications": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
