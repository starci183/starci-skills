{
  "$schema": "../mode.schema.json",
  "schemaVersion": 6,
  "id": "balanced",
  "strategy": "bounded-parallel",
  "maxWorkers": 3,
  "workerPermissions": {
    "read": true,
    "analyze": true,
    "writeSource": false,
    "externalMutation": false
  },
  "joinPolicy": "coordinator-validates-all",
  "retention": "until-skill-terminal"
}
