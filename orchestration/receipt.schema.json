{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v4/orchestration/receipt.schema.json",
  "title": "Bounded agent orchestration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runtime", "skill", "envelopeAt", "coordinator", "phaseGates", "gateEvents", "tasks", "batches", "results", "sharedPaths", "sequentialFallback"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["planned", "running", "complete"]},
    "runtime": {"enum": ["codex", "claude", "sequential"]},
    "skill": {"enum": ["starci-fe-design-layout", "starci-fe-design-block", "starci-fe-layout-refactor"]},
    "envelopeAt": {"$ref": "#/$defs/hash"},
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "owns"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "owns": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/decision"}}
      }
    },
    "phaseGates": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityMode"],
      "properties": {
        "authorityMode": {"enum": ["preserve", "evolve"]},
        "cacheRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frozenContractAt": {"$ref": "#/$defs/hash"},
        "qualityReviewAt": {"$ref": "#/$defs/hash"},
        "sourceBoundaryAt": {"$ref": "#/$defs/hash"},
        "sourceApprovalAt": {"type": "string", "pattern": "^OK #2:[0-9a-f]{64}$"},
        "approvedSourcePaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "impactConeAt": {"$ref": "#/$defs/hash"},
        "impactCone": {"$ref": "#/$defs/impactCone"},
        "authorityProofAt": {"$ref": "#/$defs/hash"},
        "stableBuildAt": {"$ref": "#/$defs/hash"},
        "proofTargetsAt": {"$ref": "#/$defs/hash"}
        ,"proofRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "gateEvents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gateEvent"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "batches": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
    },
    "results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/result"}},
    "sharedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sequentialFallback": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "order", "preservesDependencies", "preservesWriterRegistry"],
      "properties": {
        "owner": {"const": "coordinator"},
        "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "preservesDependencies": {"const": true},
        "preservesWriterRegistry": {"const": true}
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "envelopeAt", "step", "kind", "model", "objective", "requiredInputs", "dependsOn", "dependsOnGates", "reads", "writes", "forbiddenDecisions", "output", "requiredProof", "stopConditions"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "skill": {"enum": ["starci-fe-design-layout", "starci-fe-design-block", "starci-fe-layout-refactor"]},
        "envelopeAt": {"$ref": "#/$defs/hash"},
        "step": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["read", "cache-write", "source-write", "proof"]},
        "model": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 12},
        "requiredInputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "dependsOnGates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frozenContractAt": {"$ref": "#/$defs/hash"},
        "qualityReviewAt": {"$ref": "#/$defs/hash"},
        "sourceApprovalAt": {"type": "string", "pattern": "^OK #2:[0-9a-f]{64}$"},
        "authorityProofAt": {"$ref": "#/$defs/hash"},
        "stableBuildAt": {"$ref": "#/$defs/hash"},
        "proofTargetsAt": {"$ref": "#/$defs/hash"},
        "forbiddenDecisions": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/decision"}},
        "output": {"type": "string", "minLength": 1},
        "requiredProof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "cache-write"}}, "required": ["kind"]}, "then": {"required": ["frozenContractAt", "qualityReviewAt"]}},
        {"if": {"properties": {"kind": {"const": "source-write"}}, "required": ["kind"]}, "then": {"required": ["sourceApprovalAt"]}},
        {"if": {"properties": {"kind": {"const": "proof"}}, "required": ["kind"]}, "then": {"required": ["stableBuildAt", "proofTargetsAt"]}}
      ]
    },
    "gateEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "at", "status", "dependsOn"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["contract-freeze", "quality-review", "source-approval", "impact-cone", "authority-proof", "stable-build", "proof-targets"]},
        "at": {"type": "string", "minLength": 1},
        "status": {"const": "passed"},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "impactCone": {
      "type": "object", "additionalProperties": false,
      "required": ["owners", "consumers", "tests", "requiredPaths", "inventoryProof"],
      "properties": {
        "owners": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}}},
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requiredPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inventoryProof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "status", "inputHashes", "observations", "changedPaths", "commandsAndProof", "unresolvedFindings", "boundaryDrift"],
      "properties": {
        "taskId": {"$ref": "#/$defs/slug"},
        "status": {"enum": ["passed", "failed", "stopped"]},
        "inputHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "provenance"], "properties": {"claim": {"type": "string", "minLength": 1}, "provenance": {"type": "string", "minLength": 1}}}},
        "changedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "commandsAndProof": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unresolvedFindings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "boundaryDrift": {"type": "boolean"}
      }
    },
    "decision": {"enum": ["journey-decision", "ui-direction", "state-ownership", "approval", "claude-authority", "shared-integration", "final-verdict"]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
