{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v4/orchestration/receipt.schema.json",
  "title": "Internal StarCi orchestration run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "runtime", "skill", "envelopeAt", "impact", "coordinator", "phaseGates", "gateEvents", "challenges", "tasks", "batches", "results", "sharedPaths", "sequentialFallback"],
  "properties": {
    "schemaVersion": {"const": 4}, "status": {"enum": ["planned", "running", "complete"]},
    "runtime": {"enum": ["codex", "claude", "sequential"]},
    "skill": {"$ref": "#/$defs/skill"},
    "envelopeAt": {"$ref": "#/$defs/hash"}, "impact": {"$ref": "#/$defs/impact"},
    "coordinator": {"type": "object", "additionalProperties": false, "required": ["id", "model", "owns"], "properties": {
      "id": {"$ref": "#/$defs/slug"}, "model": {"type": "string", "minLength": 1},
      "owns": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/decision"}}
    }},
    "independentReview": {"$ref": "#/$defs/independentReview"},
    "phaseGates": {"type": "object", "additionalProperties": false, "required": ["authorityMode", "approvalMode"], "properties": {
      "authorityMode": {"enum": ["preserve", "evolve"]}, "approvalMode": {"enum": ["manual", "auto"]}, "autoApprovalAt": {"$ref": "#/$defs/hash"},
      "cacheRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "frozenContractAt": {"$ref": "#/$defs/hash"}, "qualityReviewAt": {"$ref": "#/$defs/hash"},
      "writeBoundaryAt": {"$ref": "#/$defs/hash"}, "writeApprovalAt": {"$ref": "#/$defs/approval"},
      "approvedWriteTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "impactConeAt": {"$ref": "#/$defs/hash"}, "impactCone": {"$ref": "#/$defs/impactCone"}, "authorityProofAt": {"$ref": "#/$defs/hash"},
      "stableStateAt": {"$ref": "#/$defs/hash"}, "proofTargetsAt": {"$ref": "#/$defs/hash"}, "proofRoots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }, "allOf": [{"if": {"properties": {"approvalMode": {"const": "auto"}}, "required": ["approvalMode"]}, "then": {"required": ["autoApprovalAt"]}}]},
    "gateEvents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gateEvent"}},
    "challenges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/challenge"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "batches": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}},
    "results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/result"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "sharedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sequentialFallback": {"type": "object", "additionalProperties": false, "required": ["owner", "order", "preservesDependencies", "preservesWriterRegistry"], "properties": {
      "owner": {"const": "coordinator"}, "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
      "preservesDependencies": {"const": true}, "preservesWriterRegistry": {"const": true}
    }}
  },
  "$defs": {
    "impact": {"type": "object", "additionalProperties": false, "required": ["level", "workflow", "classificationAt"], "properties": {
      "level": {"enum": ["read-only", "record", "repository", "provider", "component", "page", "capability", "cross-domain"]}, "workflow": {"enum": ["audit", "record", "repository", "provider", "block", "layout", "full"]}, "classificationAt": {"$ref": "#/$defs/hash"}
    }},
    "independentReview": {"type": "object", "additionalProperties": false, "required": ["reviewerId", "model", "blindToRecommendation", "mayWrite", "status", "challengeIds"], "properties": {
      "reviewerId": {"$ref": "#/$defs/slug"}, "model": {"type": "string", "minLength": 1}, "blindToRecommendation": {"const": true}, "mayWrite": {"const": false},
      "status": {"const": "passed"}, "challengeIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
    }},
    "challenge": {"type": "object", "additionalProperties": false, "required": ["id", "raisedBy", "claim", "evidence", "status", "resolutionEvidence"], "properties": {
      "id": {"$ref": "#/$defs/slug"}, "raisedBy": {"$ref": "#/$defs/slug"}, "claim": {"type": "string", "minLength": 12},
      "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "status": {"const": "resolved"},
      "resolutionEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }},
    "task": {"type": "object", "additionalProperties": false, "required": ["id", "skill", "envelopeAt", "step", "kind", "model", "objective", "requiredInputs", "dependsOn", "dependsOnGates", "reads", "writes", "forbiddenDecisions", "output", "outputConsumers", "requiredProof", "stopConditions"], "properties": {
      "id": {"$ref": "#/$defs/slug"}, "skill": {"$ref": "#/$defs/skill"}, "envelopeAt": {"$ref": "#/$defs/hash"},
      "step": {"$ref": "#/$defs/slug"}, "kind": {"enum": ["read", "cache-write", "repository-write", "authority-write", "external-write", "proof"]}, "model": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 12},
      "requiredInputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
      "dependsOnGates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}, "reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "writes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "frozenContractAt": {"$ref": "#/$defs/hash"}, "qualityReviewAt": {"$ref": "#/$defs/hash"},
      "writeApprovalAt": {"$ref": "#/$defs/approval"}, "authorityProofAt": {"$ref": "#/$defs/hash"}, "stableStateAt": {"$ref": "#/$defs/hash"}, "proofTargetsAt": {"$ref": "#/$defs/hash"},
      "forbiddenDecisions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/decision"}}, "output": {"type": "string", "minLength": 1},
      "outputConsumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:task|gate):[a-z0-9]+(?:-[a-z0-9]+)*$|^delivery$"}},
      "requiredProof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    }, "allOf": [
      {"if": {"properties": {"kind": {"const": "cache-write"}}, "required": ["kind"]}, "then": {"required": ["frozenContractAt", "qualityReviewAt"]}},
      {"if": {"properties": {"kind": {"enum": ["repository-write", "authority-write", "external-write"]}}, "required": ["kind"]}, "then": {"required": ["writeApprovalAt"]}},
      {"if": {"properties": {"kind": {"const": "proof"}}, "required": ["kind"]}, "then": {"required": ["stableStateAt", "proofTargetsAt"]}}
    ]},
    "gateEvent": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "at", "status", "dependsOn", "requiredArtifacts"], "properties": {
      "id": {"$ref": "#/$defs/slug"}, "kind": {"enum": ["contract-freeze", "quality-review", "challenge-review", "write-approval", "impact-cone", "authority-proof", "stable-state", "proof-targets"]},
      "at": {"type": "string", "minLength": 1}, "status": {"const": "passed"}, "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
      "requiredArtifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }},
    "impactCone": {"type": "object", "additionalProperties": false, "required": ["owners", "consumers", "proofs", "requiredTargets", "inventoryProof"], "properties": {
      "owners": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "target"], "properties": {"id": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}},
      "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "proofs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "requiredTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "inventoryProof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
    }},
    "result": {"type": "object", "additionalProperties": false, "required": ["taskId", "status", "inputHashes", "observations", "changedPaths", "commandsAndProof", "unresolvedFindings", "boundaryDrift"], "properties": {
      "taskId": {"$ref": "#/$defs/slug"}, "status": {"enum": ["passed", "failed", "stopped"]}, "inputHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
      "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "provenance"], "properties": {"claim": {"type": "string", "minLength": 1}, "provenance": {"type": "string", "minLength": 1}}}},
      "changedPaths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "commandsAndProof": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "unresolvedFindings": {"type": "array", "items": {"type": "string", "minLength": 1}}, "boundaryDrift": {"type": "boolean"}
    }},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["startedAt", "finishedAt", "wallTimeMs", "tokenUsage", "coordinatorReworkCount", "approvalsChangedDecision", "uniqueDefectsCaught", "falsePositiveGates", "artifactsCreated", "artifactsUsed", "unusedArtifacts"], "properties": {
      "startedAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": "string", "format": "date-time"}, "wallTimeMs": {"type": "integer", "minimum": 1},
      "tokenUsage": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["measured", "unavailable"]}, "total": {"type": "integer", "minimum": 0}}},
      "coordinatorReworkCount": {"type": "integer", "minimum": 0}, "approvalsChangedDecision": {"type": "integer", "minimum": 0}, "uniqueDefectsCaught": {"type": "integer", "minimum": 0},
      "falsePositiveGates": {"type": "integer", "minimum": 0}, "artifactsCreated": {"type": "integer", "minimum": 0}, "artifactsUsed": {"type": "integer", "minimum": 0}, "unusedArtifacts": {"const": 0}
    }},
    "skill": {"enum": ["starci-architecture-analyze", "starci-be-approve", "starci-be-plan", "starci-business-analyze", "starci-cloudflare-tunnel-set", "starci-conversation-record", "starci-debt-repay", "starci-deploy", "starci-diagnose", "starci-fe-design-block", "starci-fe-design-layout", "starci-fe-design-refactor", "starci-fe-design-resolve", "starci-fe-ui-reconcile", "starci-grammar-refresh-references", "starci-init", "starci-repair", "starci-setup-mcp", "starci-setup-sonar", "starci-stale-list"]},
    "decision": {"enum": ["scope-decision", "authority-decision", "approval", "shared-integration", "final-verdict"]},
    "approval": {"type": "string", "pattern": "^(?:OK(?: #[12])?|AUTO:[0-9a-f]{64}:OK(?: #[12])?):[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
  }
}
