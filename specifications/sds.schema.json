{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci/specification@3",
  "title": "Source-independent Software Design Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "op", "status", "purpose", "businessRefs", "designRefs", "views", "decisions", "checks", "references", "limitations"],
  "properties": {
    "schema": {"const": "starci/specification@3"},
    "op": {"const": "architecture.decide"},
    "status": {"enum": ["draft", "blocked", "pass"]},
    "purpose": {"$ref": "#/$defs/text"},
    "businessRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/businessRef"}},
    "designRefs": {"type": "array", "items": {"$ref": "#/$defs/designRef"}},
    "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "limitations": {"$ref": "#/$defs/texts"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "texts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "nonemptyTexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "businessRef": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "requirementIds", "flowIds", "acceptanceIds"],
      "properties": {"nodeId": {"$ref": "#/$defs/text"}, "requirementIds": {"$ref": "#/$defs/nonemptyTexts"}, "flowIds": {"$ref": "#/$defs/texts"}, "acceptanceIds": {"$ref": "#/$defs/nonemptyTexts"}}
    },
    "designRef": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "viewIds"],
      "properties": {"nodeId": {"$ref": "#/$defs/text"}, "viewIds": {"$ref": "#/$defs/nonemptyTexts"}}
    },
    "view": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "content"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["overview", "structure", "contracts", "data", "runtime", "deployment", "concerns"]}, "title": {"$ref": "#/$defs/text"}, "content": {"type": "object"}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "overview"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/overview"}}}},
        {"if": {"properties": {"kind": {"const": "structure"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/structure"}}}},
        {"if": {"properties": {"kind": {"const": "contracts"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/contracts"}}}},
        {"if": {"properties": {"kind": {"const": "data"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/data"}}}},
        {"if": {"properties": {"kind": {"const": "runtime"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/runtime"}}}},
        {"if": {"properties": {"kind": {"const": "deployment"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/deployment"}}}},
        {"if": {"properties": {"kind": {"const": "concerns"}}}, "then": {"properties": {"content": {"$ref": "#/$defs/concerns"}}}}
      ]
    },
    "overview": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "drivers", "externalActors", "exclusions"],
      "properties": {"scope": {"$ref": "#/$defs/text"}, "drivers": {"$ref": "#/$defs/nonemptyTexts"}, "externalActors": {"$ref": "#/$defs/texts"}, "exclusions": {"$ref": "#/$defs/texts"}}
    },
    "structure": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "responsibilities", "exclusions", "dependencies"],
      "properties": {"owner": {"$ref": "#/$defs/text"}, "responsibilities": {"$ref": "#/$defs/nonemptyTexts"}, "exclusions": {"$ref": "#/$defs/texts"}, "dependencies": {"$ref": "#/$defs/texts"}}
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["caller", "receiver", "interaction", "request", "response", "errors", "authorization", "timeout", "retry", "idempotency", "compatibility"],
      "properties": {"caller": {"$ref": "#/$defs/text"}, "receiver": {"$ref": "#/$defs/text"}, "interaction": {"enum": ["sync", "async", "in-process"]}, "request": {"$ref": "#/$defs/nonemptyTexts"}, "response": {"$ref": "#/$defs/nonemptyTexts"}, "errors": {"$ref": "#/$defs/nonemptyTexts"}, "authorization": {"$ref": "#/$defs/text"}, "timeout": {"$ref": "#/$defs/text"}, "retry": {"$ref": "#/$defs/text"}, "idempotency": {"$ref": "#/$defs/text"}, "compatibility": {"$ref": "#/$defs/text"}}
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "classification", "authoritative", "storage", "isolation", "consistency", "lifecycle", "recovery"],
      "properties": {"owner": {"$ref": "#/$defs/text"}, "classification": {"$ref": "#/$defs/text"}, "authoritative": {"type": "boolean"}, "storage": {"$ref": "#/$defs/text"}, "isolation": {"$ref": "#/$defs/text"}, "consistency": {"$ref": "#/$defs/text"}, "lifecycle": {"$ref": "#/$defs/text"}, "recovery": {"$ref": "#/$defs/text"}}
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["businessFlowRefs", "participants", "steps", "failureReview"],
      "properties": {"businessFlowRefs": {"$ref": "#/$defs/texts"}, "participants": {"$ref": "#/$defs/nonemptyTexts"}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "failureReview": {"$ref": "#/$defs/text"}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "contractRefs", "dataRefs", "action", "commit", "failures", "retry"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "contractRefs": {"$ref": "#/$defs/texts"}, "dataRefs": {"$ref": "#/$defs/texts"}, "action": {"$ref": "#/$defs/text"}, "commit": {"$ref": "#/$defs/text"}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}, "retry": {"$ref": "#/$defs/text"}}
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["condition", "result", "recovery"],
      "properties": {"condition": {"$ref": "#/$defs/text"}, "result": {"$ref": "#/$defs/text"}, "recovery": {"$ref": "#/$defs/text"}}
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["placements", "connections", "failureDomains", "configuration", "rollout", "rollback"],
      "properties": {"placements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}}, "connections": {"$ref": "#/$defs/texts"}, "failureDomains": {"$ref": "#/$defs/nonemptyTexts"}, "configuration": {"$ref": "#/$defs/nonemptyTexts"}, "rollout": {"$ref": "#/$defs/text"}, "rollback": {"$ref": "#/$defs/text"}}
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "location", "stores"],
      "properties": {"component": {"$ref": "#/$defs/text"}, "location": {"$ref": "#/$defs/text"}, "stores": {"$ref": "#/$defs/texts"}}
    },
    "concerns": {
      "type": "object", "additionalProperties": false,
      "required": ["problem", "mechanism", "owner", "scenarios", "residualRisk"],
      "properties": {"problem": {"$ref": "#/$defs/text"}, "mechanism": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}, "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}, "residualRisk": {"$ref": "#/$defs/text"}}
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger", "impact", "response", "checkIds"],
      "properties": {"trigger": {"$ref": "#/$defs/text"}, "impact": {"$ref": "#/$defs/text"}, "response": {"$ref": "#/$defs/text"}, "checkIds": {"$ref": "#/$defs/nonemptyTexts"}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "problem", "choice", "alternatives", "rationale", "tradeoffs", "appliesTo", "referenceIds", "status", "blocking", "owner", "revisitWhen"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "problem": {"$ref": "#/$defs/text"}, "choice": {"$ref": "#/$defs/text"}, "alternatives": {"$ref": "#/$defs/nonemptyTexts"}, "rationale": {"$ref": "#/$defs/text"}, "tradeoffs": {"$ref": "#/$defs/text"}, "appliesTo": {"$ref": "#/$defs/nonemptyTexts"}, "referenceIds": {"$ref": "#/$defs/texts"}, "status": {"enum": ["proposed", "accepted", "deferred"]}, "blocking": {"type": "boolean"}, "owner": {"$ref": "#/$defs/text"}, "revisitWhen": {"$ref": "#/$defs/text"}}
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "businessAcceptanceRefs", "method", "expectedResult"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "businessAcceptanceRefs": {"$ref": "#/$defs/texts"}, "method": {"$ref": "#/$defs/text"}, "expectedResult": {"$ref": "#/$defs/text"}}
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "applicability"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "url": {"type": "string", "pattern": "^https://[^\\s]+$"}, "applicability": {"$ref": "#/$defs/text"}}
    }
  }
}
