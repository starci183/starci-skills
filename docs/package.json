{
  "name": "starci-skills-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Nextra site generated from the StarCi v3 trust records. Builds from a clean clone: no source repository, no machine path, no workspace route.",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "sync": "npm run sync:content",
    "predev": "npm run sync",
    "dev": "next dev -p 3032",
    "prestart": "npm run sync",
    "start": "next dev -p 3032",
    "prebuild": "npm run sync",
    "build": "next build",
    "preserve": "npm run sync",
    "serve": "serve out -l 3032",
    "clear": "node scripts/clear-generated.mjs"
  },
  "dependencies": {
    "next": "^16.3.1",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "serve": "^14.2.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
