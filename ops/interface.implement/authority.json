{
  "schema": "starci/op-authority@1",
  "op": "interface.implement",
  "primary": {
    "owns": [
      "the selected matrix cell result",
      "its final response and required criteria"
    ],
    "reads": [
      "target",
      "business",
      "architecture",
      "repo",
      "knowledge",
      "finding",
      "draws",
      "design",
      "environment",
      "workflow",
      "matrix",
      "profile",
      "assetSources"
    ],
    "writes": [
      {
        "id": "node",
        "path": "N/index.yaml"
      },
      {
        "id": "source",
        "path": "repository:<repo-id>/<write-ceiling>"
      },
      {
        "id": "evidence",
        "path": "E/manifest.yaml + E/draws-review.json + E/input-map.md + E/regression.json when repair + E/tests.json + E/render.png + E/render-review.md + E/runtime.json + E/lineage.json + E/result.md"
      },
      {
        "id": "handoff",
        "path": "E/response.json"
      },
      {
        "id": "flows",
        "path": "E/flows.json"
      },
      {
        "id": "matrixHandoff",
        "path": "E/job-result.json"
      },
      {
        "id": "assetManifest",
        "path": "E/assets.json + repository:<repo-id>/<write-ceiling> asset inventory references"
      }
    ],
    "allowedEffects": [
      "owned source edits",
      "scoped local commits when authorized",
      "authorized local preview/test actions",
      "reuse or create selected visual assets inside the owned frontend asset paths using available authorized tools"
    ],
    "canAdvanceWorkflow": false,
    "maxSecondary": 3,
    "calls": [
      {
        "op": "backend.implement",
        "role": "interface.backend",
        "authority": "secondary.json"
      }
    ],
    "rules": [
      "Use existing request authority only.",
      "Preserve business expectations and criteria.",
      "The coordinator gate, not this op, accepts the response and advances the workflow.",
      "Wait for the secondary response; then inspect backend changes and rerun affected FE integration/render checks before final response."
    ]
  }
}
