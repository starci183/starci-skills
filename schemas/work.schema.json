{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:work:metadata:1",
  "description": "Work metadata is YAML 1.2. Schema exported as YAML into .work/_schema/work.schema.yaml. Unknown reserved fields are rejected.",
  "oneOf": [
    {
      "$ref": "#/$defs/workspace"
    },
    {
      "$ref": "#/$defs/node"
    },
    {
      "$ref": "#/$defs/resource"
    },
    {
      "$ref": "#/$defs/evidence"
    }
  ],
  "$defs": {
    "string": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/id"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id"
      ],
      "properties": {
        "schema": {
          "const": "work/workspace@1"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "resourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "kind",
        "owner",
        "revision",
        "details"
      ],
      "properties": {
        "schema": {
          "const": "work/resource@1"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/string"
        },
        "owner": {
          "$ref": "#/$defs/string"
        },
        "revision": {
          "$ref": "#/$defs/string"
        },
        "details": {
          "type": "object"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceFile"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputDigest",
        "evidence"
      ],
      "properties": {
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "codeRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/commit"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "kind",
        "required"
      ],
      "properties": {
        "schema": {
          "const": "work/node@1"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/string"
        },
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "todo",
            "doing",
            "blocked",
            "done",
            "na",
            "suspended"
          ],
          "x-operational": true
        },
        "refs": {
          "$ref": "#/$defs/ids"
        },
        "dependsOn": {
          "$ref": "#/$defs/ids"
        },
        "assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/string"
          }
        },
        "completion": {
          "$ref": "#/$defs/completion",
          "x-operational": true
        },
        "blocker": {
          "$ref": "#/$defs/string",
          "x-operational": true
        },
        "suspensionReason": {
          "$ref": "#/$defs/string",
          "x-operational": true
        },
        "naReason": {
          "$ref": "#/$defs/string"
        },
        "timestamps": {
          "type": "object",
          "x-operational": true
        },
        "createdAt": {
          "type": "string",
          "x-operational": true
        },
        "updatedAt": {
          "type": "string",
          "x-operational": true
        },
        "extensions": {
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "assets": {
          "type": "array",
          "description": "Semantic input files owned by this node under assets/. Current bytes bind dependent work; output proof files belong in evidence asset references instead.",
          "items": {
            "$ref": "#/$defs/nodeAsset"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "suspended"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "suspensionReason"
            ]
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "not-run",
        "inconclusive"
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "observation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/string"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "observation": {
          "$ref": "#/$defs/string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/string"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "scope": {
          "enum": [
            "evidence",
            "node"
          ],
          "description": "Default evidence: relative to manifest directory. node: path must be within the primary evidence owner node assets/ directory."
        }
      }
    },
    "servedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "artifact"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/commit/properties/repository"
        },
        "commit": {
          "$ref": "#/$defs/commit/properties/commit"
        },
        "artifact": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "servedVersions",
        "tool",
        "capturedAt",
        "servedVersionEvidence"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "$ref": "#/$defs/id"
        },
        "anonymous": {
          "const": true
        },
        "servedVersions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/servedVersion"
          }
        },
        "tool": {
          "$ref": "#/$defs/string"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "servedVersionEvidence": {
          "$ref": "#/$defs/string"
        }
      },
      "oneOf": [
        {
          "required": [
            "actor"
          ],
          "not": {
            "required": [
              "anonymous"
            ]
          }
        },
        {
          "required": [
            "anonymous"
          ],
          "not": {
            "required": [
              "actor"
            ]
          }
        }
      ]
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "inputDigest"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "nodeId",
        "inputDigest",
        "outcome",
        "assertions",
        "assets"
      ],
      "properties": {
        "schema": {
          "const": "work/evidence@1"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceBinding"
          }
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "codeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "nodeAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/"
        }
      }
    }
  }
}
