{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v4/brainstorms/blocks/schema.json",
  "title": "Block UI direction audit or explicit anatomy brainstorm",
  "description": "Schema 3 binds the integrated frontend-quality review to each audited/corrected block UI direction. Three or four UI-direction anatomies are legal only in explicit owner brainstorm mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope", "anatomies"],
  "properties": {
    "schema": {"enum": [1, 2, 3]},
    "envelope": {"$ref": "#/$defs/envelope"},
    "anatomies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/anatomy"}
    },
    "stateReview": {"$ref": "#/$defs/stateReview"},
    "audit": {"$ref": "#/$defs/audit"},
    "refusal": {"$ref": "#/$defs/refusal"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema": {"enum": [2, 3]}}, "required": ["schema"]},
      "then": {
        "properties": {
          "anatomies": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/anatomy"},
                {"required": ["uiDirection"]}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 3}}, "required": ["schema"]},
      "then": {
        "properties": {
          "anatomies": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/anatomy"},
                {"required": ["qualityReview"]}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "project", "region", "parentAt"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "project": {"$ref": "#/$defs/slug"},
        "region": {"$ref": "#/$defs/slug"},
        "parentAt": {"$ref": "#/$defs/hash", "description": "Session-local digest of the current source parent page used for this review."},
        "parentPageId": {"$ref": "#/$defs/slug", "description": "The exact complete parent page identity used by every state-review view."},
        "contractAt": {"type": "string", "minLength": 1},
        "mode": {"enum": ["audit", "brainstorm"]},
        "stage": {"enum": ["direction", "states"]},
        "explicitRequest": {"type": "string", "minLength": 8, "description": "Required only for owner-requested brainstorm mode."}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["verdict", "findings"],
      "properties": {
        "verdict": {"enum": ["pass", "correct"]},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 12}},
        "correction": {"type": "string", "minLength": 12}
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axes", "states", "parts", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "axes": {"$ref": "#/$defs/axes"},
        "citesPrecedent": {
          "type": "string",
          "pattern": "^(none|[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?)$",
          "description": "A precedent id, or `none`. Written as one pattern rather than a choice, because `none` satisfies both branches and an ambiguous choice is not a choice."
        },
        "states": {
          "description": "Every condition this region can enter, enumerated before the anatomy is designed. `populated` alone is the happy path, which the block laws reject.",
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["populated", "empty", "pending", "failed", "partial", "forbidden"]}
        },
        "uiDirection": {"$ref": "#/$defs/uiDirection"},
        "qualityReview": {"$ref": "../frontend-quality/schema.json"},
        "sourceOwners": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/sourceOwner"}},
        "restingCount": {"type": "integer", "minimum": 1, "description": "Required when axes.repetition is `repeats`."},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
        "reason": {"type": "string", "minLength": 12}
      }
    },
    "uiDirection": {
      "description": "The separately printed block UI direction. Journey direction is inherited from the complete parent and never reauthored here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "hierarchy", "responsive", "emphasis"],
      "properties": {
        "summary": {"type": "string", "minLength": 12},
        "hierarchy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "responsive": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "emphasis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "stateReview": {
      "description": "The selected post-OK-#1 block state assurance and exact FE boundary. Each view is a complete-page family; its viewport captures do not multiply the family count.",
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "views", "sourceBoundary"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/slug"},
        "views": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/stateView"}},
        "sourceBoundary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "stateView": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pageId", "visibleStates", "viewports", "completePage"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "pageId": {"$ref": "#/$defs/slug"},
        "visibleStates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "viewports": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "completePage": {"const": true}
      }
    },
    "sourceOwner": {
      "description": "One exact member of the current block ownership/test chain that the post-approval source boundary must contain.",
      "type": "object", "additionalProperties": false, "required": ["role", "component", "path"],
      "properties": {
        "role": {"enum": ["drawing", "connected", "compositor", "entry", "contract", "test"]},
        "component": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataOwner", "repetition", "weight", "composition"],
      "properties": {
        "dataOwner": {"enum": ["block", "parent"]},
        "repetition": {"enum": ["single", "repeats"]},
        "weight": {"enum": ["populated", "absent"], "description": "Which state carries the block."},
        "composition": {"enum": ["one-part", "label-value", "label-visual-caption"]}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cites", "whyMatch"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "cites": {"$ref": "#/$defs/citation"},
        "optional": {"type": "boolean", "description": "Presence only. It does not distinguish pending from failed from empty — `states` does."},
        "whyMatch": {"type": "string", "minLength": 12}
      }
    },
    "citation": {
      "description": "Every cited name must exist in the frontend's vocabulary. A citation that cannot be checked is an invented name.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "verdict", "key"],
          "properties": {
            "kind": {"enum": ["entry", "leaf", "composite", "block"]},
            "verdict": {"const": "reuse"},
            "key": {"$ref": "#/$defs/name"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "verdict", "from", "to", "callSites", "why"],
          "properties": {
            "kind": {"enum": ["entry", "leaf", "composite", "block"]},
            "verdict": {"const": "generalize"},
            "from": {"$ref": "#/$defs/name"},
            "to": {"$ref": "#/$defs/name"},
            "callSites": {"type": "integer", "minimum": 0},
            "why": {
              "type": "string",
              "minLength": 12,
              "description": "The rewritten reason at the new width, written as the need it answers rather than the feature it came from. A widened name whose `why` still names the old feature is not findable by anyone who did not already know it."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "verdict", "key", "why"],
          "properties": {
            "kind": {"enum": ["entry", "leaf", "composite", "block"]},
            "verdict": {"const": "new"},
            "key": {"$ref": "#/$defs/name"},
            "why": {"type": "string", "minLength": 12}
          }
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "blocked"],
      "properties": {
        "missing": {"type": "string", "minLength": 12},
        "blocked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-zA-Z0-9]+([-a-zA-Z0-9]*)$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
