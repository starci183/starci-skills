{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/brainstorms/blocks/precedents/schema.json",
  "title": "Block precedent record",
  "description": "One accepted block anatomy, kept with what it beat. The anatomy shape is referenced, not restated: a precedent must not outlive its own definition of the artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "project", "region", "chosen", "rejected", "citedNames", "contractAt", "status"],
  "properties": {
    "schema": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "project": {"$ref": "#/$defs/slug"},
    "region": {"type": "string", "minLength": 1, "description": "The accepted region and its business reason."},
    "chosen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "anatomy"],
      "properties": {
        "hash": {"$ref": "#/$defs/hash"},
        "anatomy": {"$ref": "../schema.json#/$defs/anatomy"}
      }
    },
    "rejected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "axes", "states", "why"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "axes": {"$ref": "../schema.json#/$defs/axes"},
          "states": {"type": "array", "minItems": 1, "items": {"enum": ["populated", "empty", "pending", "failed", "partial", "forbidden"]}},
          "why": {"type": "string", "minLength": 12}
        }
      }
    },
    "citedNames": {
      "description": "Entries, leaves and composites. Checked against the current contract and component tree before use.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/name"}
    },
    "contractAt": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "stale", "retired", "overruled", "non-general"]},
    "supersededBy": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-zA-Z0-9]+([-a-zA-Z0-9]*)$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?$"}
  }
}
