{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/brainstorms/directions/schema.json",
  "title": "Visual direction batch",
  "description": "One transient round of visual-direction brainstorming. The owner selects one direction; it becomes hash-bound only when embedded in a layout candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope", "directions"],
  "properties": {
    "schema": {"const": 1},
    "envelope": {"$ref": "#/$defs/envelope"},
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/direction"}
    },
    "refusal": {"$ref": "#/$defs/refusal"}
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "round", "project", "surface", "prompt", "vocabularyAt"],
      "properties": {
        "session": {"$ref": "#/$defs/id"},
        "round": {"type": "integer", "minimum": 1},
        "project": {"$ref": "#/$defs/slug"},
        "surface": {"$ref": "#/$defs/slug"},
        "prompt": {"type": "string", "minLength": 1},
        "vocabularyAt": {"type": "string", "minLength": 1, "description": "The generated visual-token inventory these directions were checked against."}
      }
    },
    "direction": {
      "description": "A selectable direction. No timestamps, preview paths, or per-run ids; the chosen object is embedded unchanged in each layout candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vocabularyAt", "axes", "citesPrecedent", "personality", "roles", "rejects", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "vocabularyAt": {"type": "string", "minLength": 1, "description": "The frontend token state this direction was generated and validated against."},
        "axes": {"$ref": "#/$defs/axes"},
        "citesPrecedent": {
          "type": "string",
          "pattern": "^(none|[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?)$"
        },
        "personality": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/slug"}
        },
        "roles": {"$ref": "#/$defs/roles"},
        "rejects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 4}
        },
        "reason": {"type": "string", "minLength": 12}
      }
    },
    "axes": {
      "description": "The closed visual diversity set. Identical axis sets are one direction.",
      "type": "object",
      "additionalProperties": false,
      "required": ["contrast", "density", "shape", "depth", "motion"],
      "properties": {
        "contrast": {"enum": ["soft", "balanced", "strong"]},
        "density": {"enum": ["compact", "balanced", "spacious"]},
        "shape": {"enum": ["square", "soft", "rounded"]},
        "depth": {"enum": ["flat", "layered", "floating"]},
        "motion": {"enum": ["still", "measured", "expressive"]}
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ground", "surface", "content", "mutedContent", "accent", "separator", "display", "body", "label", "radius", "elevation", "duration", "easing"],
      "properties": {
        "ground": {"$ref": "#/$defs/tokenDecision"},
        "surface": {"$ref": "#/$defs/tokenDecision"},
        "content": {"$ref": "#/$defs/tokenDecision"},
        "mutedContent": {"$ref": "#/$defs/tokenDecision"},
        "accent": {"$ref": "#/$defs/tokenDecision"},
        "separator": {"$ref": "#/$defs/tokenDecision"},
        "display": {"$ref": "#/$defs/tokenDecision"},
        "body": {"$ref": "#/$defs/tokenDecision"},
        "label": {"$ref": "#/$defs/tokenDecision"},
        "radius": {"$ref": "#/$defs/optionalTokenDecision"},
        "elevation": {"$ref": "#/$defs/optionalTokenDecision"},
        "duration": {"$ref": "#/$defs/optionalTokenDecision"},
        "easing": {"$ref": "#/$defs/optionalTokenDecision"}
      }
    },
    "tokenDecision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "token"],
          "properties": {
            "verdict": {"const": "reuse"},
            "token": {"$ref": "#/$defs/token"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "token", "value", "why"],
          "properties": {
            "verdict": {"const": "new"},
            "token": {"$ref": "#/$defs/token"},
            "value": {"type": "string", "minLength": 1, "description": "The exact CSS value the preview and approval bind to."},
            "why": {"type": "string", "minLength": 12}
          }
        }
      ]
    },
    "optionalTokenDecision": {
      "oneOf": [
        {"$ref": "#/$defs/tokenDecision"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "why"],
          "properties": {
            "verdict": {"const": "none"},
            "why": {"type": "string", "minLength": 12}
          }
        }
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "blocked"],
      "properties": {
        "missing": {"type": "string", "minLength": 12},
        "blocked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "token": {"type": "string", "pattern": "^--[a-z0-9]+(-[a-z0-9]+)*$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?$"}
  }
}
