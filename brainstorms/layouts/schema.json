{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/brainstorms/layouts/schema.json",
  "title": "Layout candidate batch",
  "description": "One round of layout brainstorming. `candidates[i]` is what a hash binds to; `envelope` is what changes between runs and is deliberately outside the hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope", "candidates"],
  "properties": {
    "schema": {"enum": [1, 2, 3, 4, 5, 6, 7], "description": "Schema 7 separates page-anatomy approval from state expansion and source approval. Schema 6 remains compatibility input."},
    "envelope": {"$ref": "#/$defs/envelope"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "refusal": {"$ref": "#/$defs/refusal"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema": {"const": 2}}, "required": ["schema"]},
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/candidate"},
                {"properties": {"regions": {"items": {"allOf": [{"$ref": "#/$defs/region"}, {"required": ["geometry"]}]}}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 4}}, "required": ["schema"]},
      "then": {
        "properties": {
          "envelope": {"allOf": [{"$ref": "#/$defs/envelope"}, {"required": ["scope", "mode"]}]},
          "candidates": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/candidate"},
                {
                  "required": ["pages"],
                  "properties": {
                    "regions": {
                      "items": {
                        "allOf": [
                          {"$ref": "#/$defs/region"},
                          {"required": ["pageId", "change", "geometry", "brief"]}
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 5}}, "required": ["schema"]},
      "then": {
        "properties": {
          "envelope": {"allOf": [{"$ref": "#/$defs/envelope"}, {"required": ["scope"]}]},
          "candidates": {"items": {"allOf": [{"$ref": "#/$defs/candidate"}, {"required": ["systemId", "pageOverride", "pages"]}]}}
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 6}}, "required": ["schema"]},
      "then": {
        "properties": {
          "envelope": {"allOf": [{"$ref": "#/$defs/envelope"}, {"required": ["scope", "mode"]}]},
          "candidates": {"items": {"allOf": [{"$ref": "#/$defs/candidate"}, {"required": ["systemId", "pageOverride", "pages", "renderContract", "executionPrompt"]}]}}
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 7}}, "required": ["schema"]},
      "then": {
        "properties": {
          "envelope": {"allOf": [{"$ref": "#/$defs/envelope"}, {"required": ["scope", "mode", "stage"]}]},
          "candidates": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/candidate"},
                {"required": ["systemId", "pageOverride", "pages", "synthesis", "pageContract"]},
                {
                  "if": {"required": ["renderContract"]},
                  "then": {
                    "properties": {
                      "renderContract": {
                        "properties": {
                          "pages": {
                            "items": {
                              "properties": {
                                "regions": {"items": {"required": ["grammarScopes"]}}
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "envelope": {
      "description": "Never hashed. Two runs of the same decision must produce the same candidate hash, so nothing that varies per run may sit inside a candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "project", "surface"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "project": {"$ref": "#/$defs/slug"},
        "surface": {"$ref": "#/$defs/slug", "description": "Stable layout identity is the surface, not the prompt."},
        "prompt": {"type": "string", "minLength": 1},
        "contractAt": {"type": "string", "minLength": 1, "description": "The contract state these candidates were resolved against."},
        "scope": {"$ref": "#/$defs/scope"},
        "mode": {"enum": ["generate", "brainstorm", "expand-states"]},
        "stage": {"enum": ["pages", "states"], "description": "Pages is the cache-only page-anatomy review. States is the post-page-approval expansion and exact source-boundary review."},
        "baselineCandidateAt": {"$ref": "#/$defs/hash", "description": "Required only for explicit brainstorm mode after the owner has reviewed a complete generated baseline."},
        "approvedPageAt": {"$ref": "#/$defs/hash", "description": "Required in the states stage. SHA-256 of the canonical selected pageContract approved at the pages stage."}
      }
    },
    "scope": {
      "description": "How the owner supplied the experience. Candidate count is derived from the number of rendered page/overlay surfaces, never padded by habit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["page", "flow"]},
        "source": {"enum": ["screenshot", "description"]}
      }
    },
    "candidate": {
      "description": "Hashed. Canonical JSON, keys sorted, no timestamps, no per-run ids.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "axes", "regions", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "direction": {"$ref": "../directions/schema.json#/$defs/direction", "description": "Legacy session direction. Schema 5 uses MASTER instead."},
        "systemId": {"const": "starci-master"},
        "pageOverride": {
          "type": "object", "additionalProperties": false, "required": ["deviations"],
          "properties": {"deviations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["axis", "from", "to", "reason"], "properties": {"axis": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "reason": {"type": "string", "minLength": 16}}}}}
        },
        "axes": {"$ref": "#/$defs/axes"},
        "citesPrecedent": {
          "type": "string",
          "pattern": "^(none|[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?)$",
          "description": "A precedent id, or `none`. At least one candidate in a batch must be `none` — the departure. Written as one pattern rather than a choice between an id and a literal, because `none` satisfies both and an ambiguous choice is not a choice."
        },
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
        "synthesis": {"$ref": "#/$defs/synthesis"},
        "pageContract": {"$ref": "#/$defs/pageContract"},
        "renderContract": {"$ref": "#/$defs/renderContract"},
        "executionPrompt": {"$ref": "#/$defs/executionPrompt"},
        "reason": {"type": "string", "minLength": 12}
      }
    },
    "synthesis": {
      "description": "The explicit intersection of top-down customer journey and business truth with bottom-up component, contract and source capability evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pageIntents", "customerJourneys", "business", "capabilities", "intersections"],
      "properties": {
        "pageIntents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageIntent"}},
        "customerJourneys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/customerJourney"}},
        "business": {"$ref": "#/$defs/businessTruth"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentCapability"}},
        "intersections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/designIntersection"}}
      }
    },
    "pageIntent": {
      "description": "One page identified before either design track, including the closed visible outcomes the merged anatomy must render.",
      "type": "object", "additionalProperties": false,
      "required": ["pageId", "route", "actor", "entry", "intent", "decision", "outcome", "failureConsequence", "renderIntents"],
      "properties": {
        "pageId": {"$ref": "#/$defs/slug"}, "route": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1}, "entry": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1}, "failureConsequence": {"type": "string", "minLength": 1},
        "renderIntents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderIntent"}}
      }
    },
    "renderIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mustRender", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "mustRender": {"type": "string", "minLength": 12},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "customerJourney": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "actor", "goal", "entry", "outcome", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "actor": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/journeyStep"}}
      }
    },
    "journeyStep": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "intent", "decision", "action", "consequence", "pageId"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "intent": {"type": "string", "minLength": 1}, "decision": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}, "consequence": {"type": "string", "minLength": 1}, "pageId": {"$ref": "#/$defs/slug"}
      }
    },
    "businessTruth": {
      "type": "object", "additionalProperties": false,
      "required": ["feature", "head", "objective", "rules", "operations", "dataOwners"],
      "properties": {
        "feature": {"type": "string", "minLength": 1}, "head": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "dataOwners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "componentCapability": {
      "type": "object", "additionalProperties": false,
      "required": ["regionId", "verdict", "owner", "component", "contract", "sourcePaths", "why"],
      "properties": {
        "regionId": {"$ref": "#/$defs/slug"}, "verdict": {"enum": ["reuse", "generalize", "new-required"]},
        "owner": {"type": "string", "minLength": 1}, "component": {"type": "string", "minLength": 1}, "contract": {"type": "string", "minLength": 1},
        "sourcePaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "why": {"type": "string", "minLength": 12}
      }
    },
    "designIntersection": {
      "type": "object", "additionalProperties": false,
      "required": ["pageId", "journeyStepIds", "businessObligations", "regionIds", "bindings"],
      "properties": {
        "pageId": {"$ref": "#/$defs/slug"},
        "journeyStepIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "businessObligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "regionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mergeBinding"}}
      }
    },
    "mergeBinding": {
      "description": "One explicit merge row connecting an independently declared page render intent to journey/business demand and contract-backed regions.",
      "type": "object", "additionalProperties": false,
      "required": ["renderIntentId", "journeyStepIds", "businessObligations", "regionIds"],
      "properties": {
        "renderIntentId": {"$ref": "#/$defs/slug"},
        "journeyStepIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "businessObligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "regionIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "pageContract": {
      "description": "The cache-only page anatomy approved before state expansion. Its canonical hash must remain unchanged through the states stage.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "candidateId", "viewports", "pages", "stateInventory", "renders"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "candidateId": {"$ref": "#/$defs/slug"},
        "viewports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderViewport"}},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageAnatomy"}},
        "stateInventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageStateInventory"}},
        "renders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderCoverage"}}
      }
    },
    "pageAnatomy": {
      "type": "object", "additionalProperties": false,
      "required": ["pageId", "route", "representativeState", "journeyStepIds", "regions", "hierarchy", "density", "responsive", "visualPrecedent", "sourceFeasibility"],
      "properties": {
        "pageId": {"$ref": "#/$defs/slug"}, "route": {"type": "string", "minLength": 1}, "representativeState": {"$ref": "#/$defs/slug"},
        "journeyStepIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "hierarchy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "density": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "responsive": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "visualPrecedent": {"type": "string", "minLength": 1}, "sourceFeasibility": {"const": "passed"}
      }
    },
    "pageStateInventory": {
      "description": "All page-visible render conditions plus the subset that changes page architecture. A local block condition is never promoted into pageStates merely because proof captures the whole page.",
      "type": "object", "additionalProperties": false, "required": ["pageId", "states", "pageStates", "conditions"],
      "properties": {
        "pageId": {"$ref": "#/$defs/slug"},
        "states": {"description": "Every declared page-visible render condition, whether page-owned or block-owned.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "pageStates": {"description": "Only states that change region arrangement, hierarchy or active page-level composition; use default when no architectural page-state axis exists.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "renderContract": {
      "description": "The complete implementation authority for the selected preview. Pages, regions, page states, block states and transitions stay exhaustive; renders select at most five complete-page targets and cover every reference viewport for each selection.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidateId", "sourceBoundary", "viewports", "pages", "renders"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "candidateId": {"$ref": "#/$defs/slug"},
        "sourceBoundary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "viewports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderViewport"}},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderPage"}},
        "renders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderCoverage"}}
      }
    },
    "renderViewport": {
      "type": "object", "additionalProperties": false, "required": ["id", "width", "height"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "renderPage": {
      "type": "object", "additionalProperties": false, "required": ["id", "route", "states", "pageStates", "regions", "transitions"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"}, "route": {"type": "string", "minLength": 1},
        "states": {"description": "Every page-visible render condition across page and block owners.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "pageStates": {"description": "The architectural page-state subset only.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/renderRegion"}},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/renderTransition"}}
      }
    },
    "renderRegion": {
      "description": "One source-bound visual owner. These obligations replace execution-time interpretation of a brief.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "owner", "component", "contract", "anatomy", "data", "sourceOwnership", "visual"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "owner": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1},
        "anatomy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "grammarScopes": {
          "description": "Closed child targets whose facts deterministically bind the exact semantic owners used by this region.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/grammarScope"}
        },
        "data": {"type": "object", "additionalProperties": false, "required": ["owner", "source", "mapping", "states", "previewContent", "runtimeTruth"], "properties": {"owner": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "mapping": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "states": {"description": "Only page-visible render conditions owned or materially affected by this region; local block states stay here rather than becoming pageStates.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}, "previewContent": {"const": "representative-fixture"}, "runtimeTruth": {"const": "source-owned"}}},
        "sourceOwnership": {"$ref": "#/$defs/sourceOwnership"},
        "visual": {"type": "object", "additionalProperties": false, "required": ["typography", "controls", "surface", "geometry"], "properties": {"typography": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "controls": {"type": "array", "items": {"type": "string", "minLength": 1}}, "surface": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "geometry": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
      }
    },
    "grammarScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "facts", "decisions"],
      "properties": {
        "target": {"$ref": "#/$defs/slug"},
        "facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grammarDecision"}}
      }
    },
    "grammarDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "outcome", "component"],
      "properties": {
        "slot": {"$ref": "#/$defs/slug"},
        "outcome": {"$ref": "#/$defs/slug"},
        "component": {"type": "string", "minLength": 1}
      }
    },
    "sourceComponent": {
      "description": "One exact source component identity and file.",
      "type": "object", "additionalProperties": false, "required": ["component", "path"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "sourceOwnership": {
      "description": "The explicit SPLIT-6 ownership chain for this region. ComponentBase draws state, Component optionally reads the world, a PageBase/LayoutBase/OverlayBase composes that child, and its connected entry owns only that outer surface. Nesting child state under outer props is not an ownership transfer.",
      "type": "object", "additionalProperties": false,
      "required": ["stateOwner", "drawing", "connected", "compositorKind", "compositor", "entry", "parentUses"],
      "properties": {
        "stateOwner": {"enum": ["page", "layout", "overlay", "block"]},
        "drawing": {"$ref": "#/$defs/sourceComponent"},
        "connected": {"oneOf": [{"$ref": "#/$defs/sourceComponent"}, {"type": "null"}]},
        "compositorKind": {"enum": ["page", "layout", "overlay"]},
        "compositor": {"$ref": "#/$defs/sourceComponent"},
        "entry": {"$ref": "#/$defs/sourceComponent"},
        "parentUses": {"enum": ["connected-component", "drawing-component"]}
      }
    },
    "renderTransition": {
      "description": "One outgoing transition owned by its containing page. State endpoints name declared render conditions at their real page or block owner; they do not imply every endpoint is a page state.",
      "type": "object", "additionalProperties": false,
      "required": ["id", "fromPageId", "fromStateId", "toPageId", "toStateId", "trigger", "owner"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "fromPageId": {"$ref": "#/$defs/slug"}, "fromStateId": {"$ref": "#/$defs/slug"}, "toPageId": {"$ref": "#/$defs/slug"}, "toStateId": {"$ref": "#/$defs/slug"}, "trigger": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}}
    },
    "renderCoverage": {
      "type": "object", "additionalProperties": false, "required": ["pageId", "stateId", "viewportId", "regions"],
      "properties": {"pageId": {"$ref": "#/$defs/slug"}, "stateId": {"$ref": "#/$defs/slug"}, "viewportId": {"$ref": "#/$defs/slug"}, "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}}
    },
    "executionPrompt": {
      "description": "Canonical machine-readable handoff. Its identities and source boundary must equal the selected candidate and render contract.",
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "renderContractId", "sourceBoundary", "implementationMode", "reinterpretation", "proofMode", "instructions"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/slug"}, "renderContractId": {"$ref": "#/$defs/slug"},
        "sourceBoundary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "implementationMode": {"const": "exact-render-contract"},
        "reinterpretation": {"const": "forbidden"},
        "proofMode": {"const": "same-state-same-viewport-parity"},
        "instructions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}}
      }
    },
    "page": {
      "description": "One complete visible page in a page set. Nodes are ordered outermost to innermost and include every active overlay or floating surface visible in the reviewed state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "state", "nodes", "regions"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "route": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/slug"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compositionNode"}},
        "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "compositionNode": {
      "description": "One visible owner in the composed viewport. Existing owners are source-bound evidence and may not vary across candidates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "change"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["root-layout", "app-layout", "feature-layout", "page", "modal", "drawer", "popover", "floating-action", "panel"]},
        "change": {"enum": ["existing", "proposed", "new"]},
        "parentId": {"$ref": "#/$defs/slug"},
        "source": {"type": "string", "minLength": 1},
        "sourceHash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"change": {"const": "existing"}}, "required": ["change"]},
          "then": {"required": ["source", "sourceHash"]}
        }
      ]
    },
    "axes": {
      "description": "The closed diversity set. Two candidates with an identical set are one candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["navigation", "evidence", "secondary", "chrome"],
      "properties": {
        "navigation": {"enum": ["navbar", "rail", "none"]},
        "evidence": {"enum": ["beside", "below"]},
        "secondary": {"enum": ["route", "panel", "overlay"]},
        "chrome": {"enum": ["sticky", "scrolls"]}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entry", "assembler", "mount", "whyMatch"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "pageId": {"$ref": "#/$defs/slug"},
        "change": {"enum": ["existing", "proposed", "new"]},
        "entry": {"$ref": "#/$defs/entryVerdict"},
        "assembler": {"$ref": "#/$defs/pascal", "description": "A branch that exists in the frontend's branch inventory."},
        "mount": {"enum": ["mounts-once", "per-route", "overlay"]},
        "whyMatch": {"type": "string", "minLength": 12, "description": "The business reason this region and that entry share. Matching is on `why`, never on shape."},
        "geometry": {"$ref": "#/$defs/geometry"},
        "brief": {"$ref": "#/$defs/brief"}
      }
    },
    "geometry": {
      "description": "Hashed minimum bounding geometry owned by the layout. It positions the child without deciding its internal anatomy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "width", "height", "align"],
      "properties": {
        "placement": {"enum": ["header", "navbar", "rail", "main", "aside", "center", "footer", "overlay"]},
        "width": {"enum": ["intrinsic", "narrow", "medium", "wide", "full"]},
        "height": {"enum": ["content", "fill", "viewport"]},
        "align": {"enum": ["start", "center", "end", "stretch"]}
      }
    },
    "brief": {
      "description": "Legacy schema 3-5 impressionistic child brief. It remains non-authoritative wireframe evidence; in schema 6 the hashed renderContract is the sole implementation authority for anatomy, copy, states and data mapping.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "summary", "items"],
      "properties": {
        "kind": {"enum": ["form", "navigation", "summary", "flow", "content"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 12},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label"],
            "properties": {
              "role": {"enum": ["shortcut", "divider", "field", "choice", "link", "fact", "status", "step", "navigation", "text"]},
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "primaryAction": {"type": "string", "minLength": 1},
        "secondaryAction": {"type": "string", "minLength": 1}
      }
    },
    "entryVerdict": {
      "description": "Exactly one of three. `generalize` without a measured call-site count is refused, not guessed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "key"],
          "properties": {
            "verdict": {"const": "reuse"},
            "key": {"$ref": "#/$defs/slug"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "from", "to", "callSites", "why"],
          "properties": {
            "verdict": {"const": "generalize"},
            "from": {"$ref": "#/$defs/slug"},
            "to": {"$ref": "#/$defs/slug"},
            "callSites": {"type": "integer", "minimum": 0, "description": "Measured, not estimated. A shared branch among them makes this a product-wide change."},
            "why": {
              "type": "string",
              "minLength": 12,
              "description": "The REWRITTEN reason, at the new width. A widened name with its old narrow `why` is worse than no rename: `why` is what a lookup matches on, so the name promises generality the index does not deliver and the next reader invents a third entry. Write it as the need it answers — \"if you need a row comparing a name with one stored value on a shared baseline\" — not as the feature it came from."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "key", "why"],
          "properties": {
            "verdict": {"const": "new"},
            "key": {"$ref": "#/$defs/slug"},
            "why": {"type": "string", "minLength": 12, "description": "The sentence the new contract entry will carry."}
          }
        }
      ]
    },
    "refusal": {
      "description": "An output, not a failure. Ships alongside whatever resolved.",
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "blocked"],
      "properties": {
        "missing": {"type": "string", "minLength": 12},
        "blocked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "pascal": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}
  }
}
