{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starci-v3/brainstorms/layouts/schema.json",
  "title": "Layout candidate batch",
  "description": "One round of layout brainstorming. `candidates[i]` is what a hash binds to; `envelope` is what changes between runs and is deliberately outside the hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope", "candidates"],
  "properties": {
    "schema": {"enum": [1, 2, 3, 4], "description": "Artifact version. Schema 4 binds a composed page set: every visible page records its nested layouts, routed page, active overlays and target regions. Older accepted objects remain valid and are never rewritten."},
    "envelope": {"$ref": "#/$defs/envelope"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "refusal": {"$ref": "#/$defs/refusal"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema": {"const": 2}}, "required": ["schema"]},
      "then": {
        "properties": {
          "candidates": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/candidate"},
                {"properties": {"regions": {"items": {"allOf": [{"$ref": "#/$defs/region"}, {"required": ["geometry"]}]}}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema": {"const": 4}}, "required": ["schema"]},
      "then": {
        "properties": {
          "envelope": {"allOf": [{"$ref": "#/$defs/envelope"}, {"required": ["scope"]}]},
          "candidates": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/candidate"},
                {
                  "required": ["pages"],
                  "properties": {
                    "regions": {
                      "items": {
                        "allOf": [
                          {"$ref": "#/$defs/region"},
                          {"required": ["pageId", "change", "geometry", "brief"]}
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "envelope": {
      "description": "Never hashed. Two runs of the same decision must produce the same candidate hash, so nothing that varies per run may sit inside a candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "project", "surface"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "project": {"$ref": "#/$defs/slug"},
        "surface": {"$ref": "#/$defs/slug", "description": "Stable layout identity is the surface, not the prompt."},
        "prompt": {"type": "string", "minLength": 1},
        "contractAt": {"type": "string", "minLength": 1, "description": "The contract state these candidates were resolved against."},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "scope": {
      "description": "How the owner supplied the experience. Candidate count is derived from the number of rendered page/overlay surfaces, never padded by habit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"enum": ["page", "flow"]},
        "source": {"enum": ["screenshot", "description"]}
      }
    },
    "candidate": {
      "description": "Hashed. Canonical JSON, keys sorted, no timestamps, no per-run ids.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "axes", "regions", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "direction": {"$ref": "../directions/schema.json#/$defs/direction", "description": "The evidence-backed recommended direction, embedded so the owner's one layout approval binds both visual intent and skeleton."},
        "axes": {"$ref": "#/$defs/axes"},
        "citesPrecedent": {
          "type": "string",
          "pattern": "^(none|[a-z0-9]+(-[a-z0-9]+)*(/[0-9]{4}-[0-9]{2}-[0-9]{2})?)$",
          "description": "A precedent id, or `none`. At least one candidate in a batch must be `none` — the departure. Written as one pattern rather than a choice between an id and a literal, because `none` satisfies both and an ambiguous choice is not a choice."
        },
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/region"}},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
        "reason": {"type": "string", "minLength": 12}
      }
    },
    "page": {
      "description": "One complete visible page in a page set. Nodes are ordered outermost to innermost and include every active overlay or floating surface visible in the reviewed state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "state", "nodes", "regions"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "route": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/slug"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/compositionNode"}},
        "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "compositionNode": {
      "description": "One visible owner in the composed viewport. Existing owners are source-bound evidence and may not vary across candidates.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "change"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["root-layout", "app-layout", "feature-layout", "page", "modal", "drawer", "popover", "floating-action", "panel"]},
        "change": {"enum": ["existing", "proposed", "new"]},
        "parentId": {"$ref": "#/$defs/slug"},
        "source": {"type": "string", "minLength": 1},
        "sourceHash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"change": {"const": "existing"}}, "required": ["change"]},
          "then": {"required": ["source", "sourceHash"]}
        }
      ]
    },
    "axes": {
      "description": "The closed diversity set. Two candidates with an identical set are one candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": ["navigation", "evidence", "secondary", "chrome"],
      "properties": {
        "navigation": {"enum": ["navbar", "rail", "none"]},
        "evidence": {"enum": ["beside", "below"]},
        "secondary": {"enum": ["route", "panel", "overlay"]},
        "chrome": {"enum": ["sticky", "scrolls"]}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entry", "assembler", "mount", "whyMatch"],
      "properties": {
        "name": {"$ref": "#/$defs/slug"},
        "pageId": {"$ref": "#/$defs/slug"},
        "change": {"enum": ["existing", "proposed", "new"]},
        "entry": {"$ref": "#/$defs/entryVerdict"},
        "assembler": {"$ref": "#/$defs/pascal", "description": "A branch that exists in the frontend's branch inventory."},
        "mount": {"enum": ["mounts-once", "per-route", "overlay"]},
        "whyMatch": {"type": "string", "minLength": 12, "description": "The business reason this region and that entry share. Matching is on `why`, never on shape."},
        "geometry": {"$ref": "#/$defs/geometry"},
        "brief": {"$ref": "#/$defs/brief"}
      }
    },
    "geometry": {
      "description": "Hashed minimum bounding geometry owned by the layout. It positions the child without deciding its internal anatomy.",
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "width", "height", "align"],
      "properties": {
        "placement": {"enum": ["header", "navbar", "rail", "main", "aside", "center", "footer", "overlay"]},
        "width": {"enum": ["intrinsic", "narrow", "medium", "wide", "full"]},
        "height": {"enum": ["content", "fill", "viewport"]},
        "align": {"enum": ["start", "center", "end", "stretch"]}
      }
    },
    "brief": {
      "description": "Hashed impressionistic child brief owned by layout review. Representative labels, values and actions make purpose, density and reading order imaginable, but remain wireframe evidence and never authorize final anatomy, copy or states.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "summary", "items"],
      "properties": {
        "kind": {"enum": ["form", "navigation", "summary", "flow", "content"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 12},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label"],
            "properties": {
              "role": {"enum": ["shortcut", "divider", "field", "choice", "link", "fact", "status", "step", "navigation", "text"]},
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        },
        "primaryAction": {"type": "string", "minLength": 1},
        "secondaryAction": {"type": "string", "minLength": 1}
      }
    },
    "entryVerdict": {
      "description": "Exactly one of three. `generalize` without a measured call-site count is refused, not guessed.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "key"],
          "properties": {
            "verdict": {"const": "reuse"},
            "key": {"$ref": "#/$defs/slug"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "from", "to", "callSites", "why"],
          "properties": {
            "verdict": {"const": "generalize"},
            "from": {"$ref": "#/$defs/slug"},
            "to": {"$ref": "#/$defs/slug"},
            "callSites": {"type": "integer", "minimum": 0, "description": "Measured, not estimated. A shared branch among them makes this a product-wide change."},
            "why": {
              "type": "string",
              "minLength": 12,
              "description": "The REWRITTEN reason, at the new width. A widened name with its old narrow `why` is worse than no rename: `why` is what a lookup matches on, so the name promises generality the index does not deliver and the next reader invents a third entry. Write it as the need it answers — \"if you need a row comparing a name with one stored value on a shared baseline\" — not as the feature it came from."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["verdict", "key", "why"],
          "properties": {
            "verdict": {"const": "new"},
            "key": {"$ref": "#/$defs/slug"},
            "why": {"type": "string", "minLength": 12, "description": "The sentence the new contract entry will carry."}
          }
        }
      ]
    },
    "refusal": {
      "description": "An output, not a failure. Ships alongside whatever resolved.",
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "blocked"],
      "properties": {
        "missing": {"type": "string", "minLength": 12},
        "blocked": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "pascal": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}
  }
}
