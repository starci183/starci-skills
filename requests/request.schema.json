{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starci.dev/v1/requests/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "kind", "status", "project", "targetOwners", "need", "negativeBoundary", "acceptanceCriteria", "feedbackSessions", "review"],
  "properties": {
    "$schema": { "const": "./request.schema.json" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": { "const": "frontend-feedback-upgrade" },
    "status": { "enum": ["captured", "proven", "approved", "resolved", "rejected"] },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "targetOwners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["starci-runtime", "grammar", "local-only"] }
    },
    "need": { "type": "string", "minLength": 3 },
    "negativeBoundary": { "type": "string", "minLength": 3 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "feedbackSessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "sourceSkillId", "evidenceSha256", "accepts", "rejects", "targetOwners", "proofStatus"],
        "properties": {
          "fingerprint": { "$ref": "#/$defs/sha256" },
          "sourceSkillId": {
            "enum": [
              "starci-frontend-layout-delivery",
              "starci-frontend-block-reconcile",
              "starci-frontend-maintenance-apply",
              "starci-frontend-surface-reconcile"
            ]
          },
          "evidenceSha256": { "$ref": "#/$defs/sha256" },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "rejects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "targetOwners": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["starci-runtime", "grammar", "local-only"] }
          },
          "proofStatus": { "enum": ["captured", "partial", "proven", "blocked"] }
        }
      }
    },
    "review": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "priority", "evidenceSha256", "targetOwners", "rationale"],
          "properties": {
            "decision": { "enum": ["approved", "rejected"] },
            "priority": { "enum": ["normal", "urgent"] },
            "evidenceSha256": { "$ref": "#/$defs/sha256" },
            "targetOwners": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "enum": ["starci-runtime", "grammar", "local-only"] }
            },
            "rationale": { "type": "string", "minLength": 3 }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
